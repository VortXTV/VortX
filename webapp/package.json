{
  "name": "vortx-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VortX web client (web.vortx.tv). A direct/debrid/HLS-first web client that talks to the Stremio add-on protocol and Cinemeta straight from the browser. No streaming server, no native shell.",
  "packageManager": "npm@11.17.0+sha512.3eeaf18997b11070d313849268b23766b9db0068997dec9471073170fe43fa17f2b4d0337bf0f52330ee2274e7f5754b21b01052742e48f5c9c74d8b1e32ef43",
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.17.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.17.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "tsc && vite build && wrangler pages deploy dist --project-name=vortx-web",
    "test:pages-contract": "node scripts/cloudflare-pages-contract.test.mjs",
    "test": "node scripts/cloudflare-pages-contract.test.mjs && node --test src/lib/*.test.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "hls.js": "^1.6.16",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^8.0.16",
    "wrangler": "^4.122.0"
  }
}
