{
  "name": "vortx-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VortX web client (web.vortx.tv). A direct/debrid/HLS-first web client that talks to the Stremio add-on protocol and Cinemeta straight from the browser. No streaming server, no native shell.",
  "packageManager": "npm@12.2.0+sha512.66c2632a94e796649738b2d7894d710c2cc2e1696893823066687f6b0d8a52e5f2b54eeaeaa32ffdc513ecca1e49ff794a5c2ec3f9515d879f1b3182b291cf35",
  "engines": {
    "node": ">=22.23.3",
    "npm": "12.2.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.23.3",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "tsc && vite build && wrangler pages deploy dist --project-name=vortx-web",
    "test:pages-contract": "node scripts/cloudflare-pages-contract.test.mjs",
    "test": "node scripts/cloudflare-pages-contract.test.mjs && node --test src/lib/*.test.mjs src/views/login.auth-adoption.test.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "hls.js": "1.7.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.151.3"
  }
}
