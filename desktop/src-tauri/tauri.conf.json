{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VortX",
  "mainBinaryName": "vortx",
  "version": "0.5.6",
  "identifier": "com.vortx.desktop",
  "build": {
    "beforeDevCommand": "bash scripts/fetch-mpv.sh",
    "devUrl": "https://web.vortx.tv",
    "beforeBuildCommand": "bash scripts/fetch-mpv.sh",
    "frontendDist": "https://web.vortx.tv"
  },
  "app": {
    "windows": [
      {
        "title": "VortX",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
