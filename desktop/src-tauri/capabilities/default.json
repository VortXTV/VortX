{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The VortX web client in the main window: Tauri core events plus the shell's streaming-server and player commands, for the VortX web origin only.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://web.vortx.tv/*"]
  },
  "permissions": [
    "core:default",
    "allow-server-status",
    "allow-server-base-url",
    "allow-mpv-play",
    "allow-mpv-set-paused",
    "allow-mpv-seek-relative",
    "allow-mpv-stop",
    "allow-mpv-status"
  ]
}
