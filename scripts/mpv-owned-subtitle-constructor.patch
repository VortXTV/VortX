+// Worker-only detached primary text construction. This never opens a stream,
+// reads a demuxer or selects a player track. Own attachments on ENTRY, including
+// every failure. The caller must already hold native/global lifetime, and copy
+// all attachments under the live source owner BEFORE calling off-core.
+#define SUB_OWNED_TEXT_MAX_CUES 12000
+#define SUB_OWNED_TEXT_MAX_CUE_BYTES 16384
+#define SUB_OWNED_TEXT_MAX_BYTES (8 * 1024 * 1024)
+#define SUB_OWNED_TEXT_MAX_END_MS 91000000
+#define SUB_OWNED_TEXT_MAX_ATTACHMENTS 128
+#define SUB_OWNED_TEXT_MAX_ATTACHMENT_BYTES (16 * 1024 * 1024)
+#define SUB_OWNED_TEXT_MAX_ATTACHMENT_TOTAL (64 * 1024 * 1024)
+#define SUB_OWNED_TEXT_MAX_ATTACHMENT_NAME 4096
+#define SUB_OWNED_TEXT_MAX_LANGUAGE 255
+#define SUB_OWNED_TEXT_MAX_WORK_NS INT64_C(30000000000)
+
+struct sub_owned_text_cue {
+    uint64_t start_ms, end_ms;
+    const char *utf8; // Exact cue body, not SRT indices/timecode lines.
+    size_t length;
+};
+
+enum sub_owned_text_error {
+    SUB_OWNED_TEXT_OK,
+    SUB_OWNED_TEXT_INVALID_INPUT,
+    SUB_OWNED_TEXT_CANCELLED,
+    SUB_OWNED_TEXT_EXPIRED,
+    SUB_OWNED_TEXT_DECODER_FAILED,
+    SUB_OWNED_TEXT_PACKET_FAILED,
+    SUB_OWNED_TEXT_DECODE_FAILED,
+    SUB_OWNED_TEXT_INVALID_STATE,
+};
+
+// Validates and copies ALL cues, strict UTF-8 without NUL, strictly increasing
+// starts and start < end <= MAX_END_MS. Overlaps/markup are preserved through the
+// real FFmpeg SubRip -> ASS converter. Returns only a completely decoded object.
+// play_dir is a captured +1/-1; video_fps is captured finite >= 0. Cue/language
+// borrows end before return; attachments/sh/codec/packets are owned thereafter.
+// Deadline is absolute mp_time_ns(), <= 30s ahead. Cancellation is cooperative
+// between bounded steps, NOT preemption of libass/font-provider calls. It is
+// checked after such calls before any ready object is returned.
+struct dec_sub *sub_create_owned_text(
+    struct mpv_global *global, struct attachment_list *owned_attachments,
+    const char *language, const struct sub_owned_text_cue *cues, size_t count,
+    int play_dir, double video_fps, struct mp_cancel *cancel, int64_t deadline_ns,
+    enum sub_owned_text_error *error);
+
+// Existing OSD/decoder owner only, never under native core or host admission.
+// Refreshes this object's OWN subtitle/shared/filter caches. Hard/filter changes
+// decode the complete retained packet set with the checked path. On failure the
+// object is no longer renderable; caller must revoke it, not show partial text.
+// Font/style/filter work may run here. Calls must not overlap bitmap/text reads.
+bool sub_refresh_owned_text(struct dec_sub *sub, struct mp_cancel *cancel,
+                           int64_t deadline_ns, enum sub_owned_text_error *error);
+
+// Off-core, after removal from publication and ALL decoder readers quiesce.
+// Native/global/config/log lifetime must remain held through terminal cleanup.
+// Do not call demux/read/preload/reset/control APIs on an owned text object.
+void sub_destroy_owned_text(struct dec_sub *sub);
+
 bool sub_can_preload(struct dec_sub *sub);
 void sub_preload(struct dec_sub *sub);
 void sub_redecode_cached_packets(struct dec_sub *sub);
