+static void owned_text_error(enum sub_owned_text_error *error,
+                             enum sub_owned_text_error value)
+{
+    if (error)
+        *error = value;
+}
+
+static bool owned_text_budget(struct mp_cancel *cancel, int64_t deadline_ns,
+                              enum sub_owned_text_error *error)
+{
+    if (mp_cancel_test(cancel)) {
+        owned_text_error(error, SUB_OWNED_TEXT_CANCELLED);
+        return false;
+    }
+    int64_t now = mp_time_ns();
+    if (deadline_ns <= now) {
+        owned_text_error(error, SUB_OWNED_TEXT_EXPIRED);
+        return false;
+    }
+    if (deadline_ns - now > SUB_OWNED_TEXT_MAX_WORK_NS) {
+        owned_text_error(error, SUB_OWNED_TEXT_INVALID_INPUT);
+        return false;
+    }
+    return true;
+}
+
+static bool owned_text_attachments_valid(struct attachment_list *attachments)
+{
+    if (!attachments || attachments->num_entries < 0 ||
+        attachments->num_entries > SUB_OWNED_TEXT_MAX_ATTACHMENTS ||
+        (attachments->num_entries && !attachments->entries))
+        return false;
+    size_t total = 0;
+    for (int n = 0; n < attachments->num_entries; n++) {
+        struct demux_attachment *a = &attachments->entries[n];
+        if (!a->name || !a->type || (a->data_size && !a->data) ||
+            strnlen(a->name, SUB_OWNED_TEXT_MAX_ATTACHMENT_NAME + 1) >
+                SUB_OWNED_TEXT_MAX_ATTACHMENT_NAME ||
+            strnlen(a->type, SUB_OWNED_TEXT_MAX_ATTACHMENT_NAME + 1) >
+                SUB_OWNED_TEXT_MAX_ATTACHMENT_NAME ||
+            a->data_size > SUB_OWNED_TEXT_MAX_ATTACHMENT_BYTES ||
+            a->data_size > SUB_OWNED_TEXT_MAX_ATTACHMENT_TOTAL - total)
+            return false;
+        total += a->data_size;
+    }
+    return true;
+}
+
+static bool owned_text_decode_all(struct dec_sub *sub, struct mp_cancel *cancel,
+                                  int64_t deadline_ns,
+                                  enum sub_owned_text_error *error)
+{
+    if (!sub->sd->driver->decode_prepared) {
+        owned_text_error(error, SUB_OWNED_TEXT_DECODER_FAILED);
+        return false;
+    }
+    for (int n = 0; n < sub->num_cached_pkts; n++) {
+        if (!owned_text_budget(cancel, deadline_ns, error))
+            return false;
+        if (!sub->sd->driver->decode_prepared(sub->sd, sub->cached_pkts[n])) {
+            owned_text_error(error, SUB_OWNED_TEXT_DECODE_FAILED);
+            return false;
+        }
+    }
+    return owned_text_budget(cancel, deadline_ns, error);
+}
+
+struct dec_sub *sub_create_owned_text(
+    struct mpv_global *global, struct attachment_list *owned_attachments,
+    const char *language, const struct sub_owned_text_cue *cues, size_t count,
+    int play_dir, double video_fps, struct mp_cancel *cancel, int64_t deadline_ns,
+    enum sub_owned_text_error *error)
+{
+    owned_text_error(error, SUB_OWNED_TEXT_INVALID_INPUT);
+    if (!global || !cues || count == 0 || count > SUB_OWNED_TEXT_MAX_CUES ||
+        (play_dir != 1 && play_dir != -1) ||
+        !isfinite(video_fps) || video_fps < 0 ||
+        !owned_text_attachments_valid(owned_attachments))
+        goto invalid;
+
+    size_t lang_length = language
+        ? strnlen(language, SUB_OWNED_TEXT_MAX_LANGUAGE + 1) : 0;
+    if (lang_length > SUB_OWNED_TEXT_MAX_LANGUAGE ||
+        (language && bstr_validate_utf8((bstr){(unsigned char *)language,
+                                              lang_length}) < 0))
+        goto invalid;
+
+    size_t total = 0;
+    for (size_t n = 0; n < count; n++) {
+        if (!owned_text_budget(cancel, deadline_ns, error))
+            goto invalid;
+        const struct sub_owned_text_cue *cue = &cues[n];
+        if (!cue->utf8 || !cue->length ||
+            cue->length > SUB_OWNED_TEXT_MAX_CUE_BYTES ||
+            cue->length > SUB_OWNED_TEXT_MAX_BYTES - total ||
+            cue->start_ms >= cue->end_ms ||
+            cue->end_ms > SUB_OWNED_TEXT_MAX_END_MS ||
+            (n && cue->start_ms <= cues[n - 1].start_ms) ||
+            memchr(cue->utf8, 0, cue->length) ||
+            bstr_validate_utf8((bstr){(unsigned char *)cue->utf8,
+                                      cue->length}) < 0)
+            goto invalid;
+        total += cue->length;
+    }
+    if (!owned_text_budget(cancel, deadline_ns, error))
+        goto invalid;
+
+    struct sh_stream *sh = demux_alloc_sh_stream(STREAM_SUB);
+    sh->codec->codec = talloc_strdup(sh->codec, "subrip");
+    char *lang = language ? talloc_strndup(sh, language, lang_length) : NULL;
+    struct dec_sub *sub = sub_create_internal(global, sh, lang,
+                                              owned_attachments, 0, true);
+    // The internal constructor owns sh/codec/lang/attachments even on failure.
+    if (!sub) {
+        owned_text_error(error, SUB_OWNED_TEXT_DECODER_FAILED);
+        return NULL;
+    }
+    if (!owned_text_budget(cancel, deadline_ns, error))
+        goto failed;
+    sub->play_dir = play_dir;
+    sub->video_fps = video_fps;
+    update_subtitle_speed(sub);
+    if (!isfinite(sub->sub_speed) || sub->sub_speed <= 0) {
+        owned_text_error(error, SUB_OWNED_TEXT_INVALID_INPUT);
+        goto failed;
+    }
+
+    for (size_t n = 0; n < count; n++) {
+        if (!owned_text_budget(cancel, deadline_ns, error))
+            goto failed;
+        const struct sub_owned_text_cue *cue = &cues[n];
+        struct demux_packet *pkt = new_demux_packet(sub->packet_pool, cue->length);
+        if (!pkt) {
+            owned_text_error(error, SUB_OWNED_TEXT_PACKET_FAILED);
+            goto failed;
+        }
+        memcpy(pkt->buffer, cue->utf8, cue->length);
+        pkt->pts = cue->start_ms / 1000.0;
+        pkt->dts = pkt->pts;
+        pkt->duration = (cue->end_ms - cue->start_ms) / 1000.0;
+        pkt->pos = n;
+        MP_TARRAY_APPEND(sub, sub->cached_pkts, sub->num_cached_pkts, pkt);
+    }
+    sub->owned_text_bytes = total;
+    if (!owned_text_decode_all(sub, cancel, deadline_ns, error))
+        goto failed;
+    sub->owned_text_ready = true;
+    owned_text_error(error, SUB_OWNED_TEXT_OK);
+    return sub;
+
+failed:
+    sub_destroy(sub);
+    return NULL;
+invalid:
+    talloc_free(owned_attachments);
+    return NULL;
+}
+
+bool sub_refresh_owned_text(struct dec_sub *sub, struct mp_cancel *cancel,
+                           int64_t deadline_ns, enum sub_owned_text_error *error)
+{
+    owned_text_error(error, SUB_OWNED_TEXT_INVALID_STATE);
+    if (!sub || !sub->owned_text)
+        return false;
+    mp_mutex_lock(&sub->lock);
+    bool ok = sub->owned_text_ready;
+    if (!ok)
+        goto done;
+    if (!owned_text_budget(cancel, deadline_ns, error)) {
+        ok = false;
+        goto done;
+    }
+
+    struct m_config_cache *caches[] = {
+        sub->opts_cache, sub->shared_opts_cache, sub->owned_filter_cache,
+    };
+    uint64_t flags = 0;
+    for (int n = 0; n < MP_ARRAY_SIZE(caches); n++) {
+        caches[n]->change_flags = 0;
+        bool changed = m_config_cache_update(caches[n]);
+        if (n == 0 && changed)
+            update_subtitle_speed(sub);
+        flags |= caches[n]->change_flags;
+        // A cache rooted at this group excludes the root group's change mask.
+        // Its individual filter options have no flags, so retain that mask here.
+        if (changed && caches[n] == sub->owned_filter_cache)
+            flags |= mp_sub_filter_opts.change_flags;
+    }
+    if (!isfinite(sub->sub_speed) || sub->sub_speed <= 0) {
+        owned_text_error(error, SUB_OWNED_TEXT_INVALID_STATE);
+        ok = false;
+        goto done;
+    }
+    if (flags && (!sub->sd->driver->control ||
+                  sub->sd->driver->control(sub->sd, SD_CTRL_UPDATE_OPTS,
+                                           &flags) != CONTROL_OK)) {
+        owned_text_error(error, SUB_OWNED_TEXT_DECODER_FAILED);
+        ok = false;
+        goto done;
+    }
+    if (flags & (UPDATE_SUB_HARD | UPDATE_SUB_FILT))
+        ok = owned_text_decode_all(sub, cancel, deadline_ns, error);
+    else
+        ok = owned_text_budget(cancel, deadline_ns, error);
+    if (ok)
+        owned_text_error(error, SUB_OWNED_TEXT_OK);
+done:
+    sub->owned_text_ready = ok;
+    mp_mutex_unlock(&sub->lock);
+    return ok;
+}
+
+void sub_destroy_owned_text(struct dec_sub *sub)
+{
+    mp_assert(!sub || sub->owned_text);
+    sub_destroy(sub);
+}
