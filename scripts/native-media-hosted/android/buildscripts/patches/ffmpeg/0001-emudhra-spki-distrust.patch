+/* Called for EACH verified path certificate, including intermediate and anchor.
+ * Only add failure flags; never clear hostname/expiry/trust/revocation failures. */
+static int vortx_tls_verify(void *opaque, mbedtls_x509_crt *crt, int depth,
+                           uint32_t *flags)
+{
+    int rejected;
+    (void)opaque;
+    (void)depth;
+    if (!crt || !flags)
+        return MBEDTLS_ERR_X509_FATAL_ERROR;
+    rejected = vortx_tls_distrusted_spki(crt->pk_raw.p, crt->pk_raw.len);
+    if (rejected < 0) {
+        *flags |= MBEDTLS_X509_BADCERT_OTHER;
+        return MBEDTLS_ERR_X509_FATAL_ERROR;
+    }
+    if (rejected)
+        *flags |= MBEDTLS_X509_BADCERT_REVOKED;
+    return 0;
+}
