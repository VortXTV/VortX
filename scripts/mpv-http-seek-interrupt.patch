+    if (!s->seek_interruptible || offset < 0 ||
+        mp_cancel_test(s->cancel) || stream_io_interrupted(s))
+        return false;
+
+    // HTTP exports cookies learned during redirects/authentication. Keep that
+    // source-local state, but never substitute another source's global options.
+    if (av_opt_get(p->avio, "cookies", AV_OPT_SEARCH_CHILDREN, &cookies) < 0)
+        goto done;
+    if (cookies && cookies[0] &&
+        av_dict_set(&p->reopen_opts, "cookies", (char *)cookies, 0) < 0)
+        goto done;
+    if (av_dict_copy(&options, p->reopen_opts, 0) < 0 ||
+        av_dict_set_int(&options, "offset", offset, 0) < 0)
+        goto done;
+
+    AVIOInterruptCB cb = {.callback = interrupt_cb, .opaque = s};
+    if (avio_open2(&candidate, p->reopen_url, AVIO_FLAG_READ, &cb, &options) < 0)
+        goto done;
+    if (!(candidate->seekable & AVIO_SEEKABLE_NORMAL))
+        goto done;
