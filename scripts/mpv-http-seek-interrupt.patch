+static bool reopen_at(stream_t *s, int64_t offset)
+{
+    struct lavf_priv *p = s->priv;
+    AVIOContext *candidate = NULL;
+    AVDictionary *options = NULL;
+    uint8_t *cookies = NULL;
+    bool ok = false;
