+    int64_t position = avio_seek(candidate, offset, SEEK_SET);
+    candidate->direct = direct;
+    if (position != offset || avio_tell(candidate) != offset || candidate->error ||
+        mp_cancel_test(s->cancel) || stream_io_interrupted(s))
+        goto done;
+
+    avio_closep(&p->avio);
+    p->avio = candidate;
+    candidate = NULL;
+    s->recover_io = false;
+    ok = true;
+done:
+    avio_closep(&candidate);
+    av_dict_free(&options);
+    av_free(cookies);
+    return ok;
