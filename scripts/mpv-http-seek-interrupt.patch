+// Called under the demux lock, including before dropping it for blocking I/O.
+// Never reset s->cancel: stop/source retirement must remain permanently latched.
+void stream_request_seek_interrupt(stream_t *s)
+{
+    if (s && s->seek_interruptible)
+        atomic_fetch_add(&s->requested_io_epoch, 1);
+}
+
+bool stream_io_interrupted(stream_t *s)
+{
+    return s && s->seek_interruptible &&
+           atomic_load(&s->requested_io_epoch) != s->active_io_epoch;
+}
+
+void stream_begin_io(stream_t *s)
+{
+    if (!s || !s->seek_interruptible)
+        return;
+    s->active_io_epoch = atomic_load(&s->requested_io_epoch);
+    if (s->recover_io)
+        stream_drop_buffers(s);
+}
