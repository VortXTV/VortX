+        if identity(os.fstat(stream.fileno())) != identity(before):
+            raise ValueError("captured source tar changed before readback")
+        with tarfile.open(fileobj=LimitedReader(stream, MAX_UNCOMPRESSED), mode="r|") as archive:
+            for member in archive:
+                name = member_path(member.name)
