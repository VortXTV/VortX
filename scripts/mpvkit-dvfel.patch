+            elif stat.S_ISREG(info.st_mode):
+                row.update(type="file", bytes=info.st_size, sha256=digest(path))
+            else:
+                fail("non-file input node: " + str(path))
+            result.append(row)
+    return sorted(result, key=lambda row: row["path"])
