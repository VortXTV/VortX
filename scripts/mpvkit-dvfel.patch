+                elif member.issym():
+                    data = member.linkname.encode()
+                    actual = {"kind": "symlink", "mode": 0o777, "bytes": len(data),
+                              "mtime": archive_mtime(member.mtime),
+                              "sha256": digest(data), "target": member.linkname}
+                else:
+                    raise ValueError("captured source tar has an unsupported member")
+                if actual != {key: value for key, value in wanted.items() if key != "path"}:
+                    raise ValueError("captured source member differs from the retained raw archive")
+        if identity(os.fstat(stream.fileno())) != identity(before):
+            raise ValueError("captured source tar changed during readback")
+    if identity(snapshot.lstat()) != identity(before) or observed != set(expected):
+        raise ValueError("captured source tar changed or omitted release source members")
+    if read_inputs(archive_dir) != verified:
+        raise ValueError("retained release archive tuple changed during captured source readback")
+    reread = strict_json(read_regular(output / "crypto-release-sources.json", MAX_RECEIPT))
+    if canonical(reread) != canonical(receipt):
+        raise ValueError("captured source receipt changed during readback")
+    return receipt
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest="command", required=True)
+    item = commands.add_parser("prepare")
+    item.add_argument("work")
+    item.add_argument("local_archives")
+    item = commands.add_parser("verify")
+    item.add_argument("work")
+    item = commands.add_parser("capture")
+    item.add_argument("work")
+    item.add_argument("output")
+    item = commands.add_parser("verify-capture")
+    item.add_argument("output")
+    args = parser.parse_args()
+    if args.command == "prepare":
+        prepare(checked_path(args.work), checked_path(args.local_archives))
+    elif args.command == "verify":
+        verify(checked_path(args.work))
+    elif args.command == "capture":
+        capture(checked_path(args.work), checked_path(args.output))
+    else:
+        verify_capture(checked_path(args.output))
+    print("PASS " + PROFILE + " " + args.command)
+
+
+if __name__ == "__main__":
+    main()
