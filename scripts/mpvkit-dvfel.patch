+            let destination = outputRoot.appendingPathComponent("libsmbclient/\(parts[0])/thin/\(parts[1])/lib/pkgconfig/smbclient.pc")
+            try changes[key]!.write(to: destination, atomically: true, encoding: .utf8)
+        }
+    }
