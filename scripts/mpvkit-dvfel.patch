+        if row["kind"] == "symlink":
+            os.symlink(row["target"], destination / row["path"])
+    # Preserve authenticated release ordering for make's regeneration rules.
+    # Metadata writes happen after all child creation; directories are last.
+    for row in rows:
+        if row["kind"] != "directory":
+            nanoseconds = row["mtime"] * 1000000000
+            os.utime(destination / row["path"], ns=(nanoseconds, nanoseconds),
+                     follow_symlinks=False)
+    directories = sorted((row for row in rows if row["kind"] == "directory"),
+                         key=lambda row: len(row["path"].split("/")) if row["path"] else 0,
+                         reverse=True)
+    for row in directories:
+        nanoseconds = row["mtime"] * 1000000000
+        os.utime(destination / row["path"], ns=(nanoseconds, nanoseconds),
+                 follow_symlinks=False)
+    if actual_index(destination) != rows:
+        raise ValueError("extracted source tree differs from the release archive")
+
+
+def receipt_for(verified):
+    roots = []
+    for pin, blob, rows in verified:
+        roots.append({"id": pin["id"], "version": pin["version"],
+                      "url": pin["url"], "archive": "archives/" + pin["filename"],
+                      "archiveRoot": pin["archiveRoot"], "archiveBytes": len(blob),
+                      "archiveSHA256": pin["sha256"], "sourceRoot": "dist/" + pin["sourceRoot"],
+                      "membersSHA256": digest(canonical(rows)), "members": rows})
+    return {"schema": 1, "profile": PROFILE,
+            "identityBasis": "fixed-sha256-corroborated-by-package-maintainer-metadata",
+            "upstreamSignatureVerified": False, "roots": roots}
+
+
