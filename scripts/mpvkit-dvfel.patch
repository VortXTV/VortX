+def recipe_contract(work, library, platform, arch, sdk_tools):
+    """Exact source recipe fields, independent of the untrusted build record."""
+    dist = work / 'dist'
+    prefix = dist / library / platform / 'thin' / arch
+    scratch = dist / library / platform / 'scratch' / arch
+    _, target_os, minimum, host_os = PLATFORMS[platform]
+    target_cpu = 'x86_64' if arch == 'x86_64' else 'arm64'
+    host = target_cpu + '-' + host_os + '-darwin'
+    cflags = ['-arch', arch, '-isysroot', sdk_tools['sdkRoot'], '-target', target_cpu + '-apple-' + target_os, minimum]
+    if platform in ('tvos', 'tvsimulator'):
+        cflags.append('-DHAVE_FORK=0')
+    dependencies = () if library == 'gmp' else ('gmp',) if library == 'nettle' else ('gmp', 'nettle')
+    for dependency in dependencies:
+        cflags.append('-I' + str(dist / dependency / platform / 'thin' / arch / 'include'))
+    ldflags = ['-lc++', '-arch', arch, '-isysroot', sdk_tools['sdkRoot'], '-target', target_cpu + '-apple-' + target_os, minimum]
+    for dependency in dependencies:
+        ldflags.append('-L' + str(dist / dependency / platform / 'thin' / arch / 'lib'))
+        if library != 'gnutls':
+            ldflags.append('-l' + dependency)
+    flags = ' '.join(cflags)
+    environment = {'LC_CTYPE': 'C', 'CC': '/usr/bin/clang', 'CXX': '/usr/bin/clang++',
+                   'CURRENT_ARCH': arch, 'CFLAGS': flags + ' -O2', 'CPPFLAGS': flags,
+                   'CXXFLAGS': flags + ' -O2', 'ASMFLAGS': flags, 'LDFLAGS': ' '.join(ldflags),
+                   'PKG_CONFIG_LIBDIR': ':'.join(str(dist / name / platform / 'thin' / arch / 'lib/pkgconfig') for name in PKG_LIBRARIES) + ':' + str(scratch / 'vortx-sdk-pkgconfig'),
+                   'PKG_CONFIG_PATH': '', 'PATH': DEFAULT_PATH,
+                   'MAKEFLAGS': '-j1', 'CMAKE_BUILD_PARALLEL_LEVEL': '1', 'CARGO_BUILD_JOBS': '1',
+                   'AR': sdk_tools['ar']['selectedPath'], 'RANLIB': sdk_tools['ranlib']['selectedPath'],
+                   'CC_FOR_BUILD': '/usr/bin/clang'}
+    if library == 'gmp':
+        environment['ABI'] = '64'
+    if library == 'gnutls':
+        gmp = str(dist / 'gmp' / platform / 'thin' / arch)
+        nettle = str(dist / 'nettle' / platform / 'thin' / arch)
+        environment.update(GMP_CFLAGS='-I' + gmp + '/include', GMP_LIBS='-L' + gmp + '/lib -lgmp',
+                           NETTLE_CFLAGS='-I' + nettle + '/include', NETTLE_LIBS='-L' + nettle + '/lib -lnettle',
+                           HOGWEED_CFLAGS='-I' + nettle + '/include',
+                           HOGWEED_LIBS='-L' + nettle + '/lib -lhogweed -lnettle -L' + gmp + '/lib -lgmp')
+        if platform in ('tvos', 'tvsimulator'):
+            environment['ac_cv_func_fork'] = 'no'
+    return {'schema': 1, 'library': library, 'selector': SELECTORS[library],
+            'sourceDirectory': str(dist / (library + '-' + SELECTORS[library])),
+            'platform': platform, 'arch': arch,
+            'configureArguments': ['--prefix=' + str(prefix), *CONFIGURE_FLAGS[library], '--host=' + host],
+            'makeArguments': list(MAKE_ARGUMENTS),
+            'environment': environment, 'buildDirectory': str(scratch), 'prefix': str(prefix),
+            'compiled': True, 'installed': True}
+
+
+def build_record(work, library, platform, arch, sdk_tools, budget=None):
+    if budget is None:
+        budget = InlineBudget()
+    expected = recipe_contract(work, library, platform, arch, sdk_tools)
+    scratch = Path(expected['buildDirectory'])
+    record_path = scratch / 'vortx-crypto-build.json'
+    row, body = read_verified(record_path, work, MAX_HEADER)
+    record = strict_json(body)
+    if not isinstance(record, dict) or set(record) != set(expected) | {'generatedConfiguration'}:
+        fail('build record field set differs')
+    if not exact_equal({key: record[key] for key in expected}, expected):
+        fail('configured build recipe differs from the fixed source policy')
+    generated = record['generatedConfiguration']
+    names = GENERATED + EXTRA_GENERATED[library]
+    if not isinstance(generated, dict) or set(generated) != set(names):
+        fail('generated configuration set differs')
+    configurations = {}
+    for name in names:
+        observed = inline_file(scratch / name, work, MAX_CONFIGURATION, budget)
+        if not exact_equal(generated[name], {key: observed[key] for key in ('bytes', 'sha256')}):
+            fail('generated configuration differs from the actual build file')
+        configurations[name] = observed
+    installed = {}
+    for name, relative in INSTALLED_CONFIGURATION[library].items():
+        observed = inline_file(Path(expected['prefix']) / relative, work, MAX_CONFIGURATION, budget)
+        if any(observed[key] != configurations[name][key] for key in ('bytes', 'sha256')):
+            fail('installed generated header/pkg-config file differs from its build output')
+        installed[relative] = observed
+    # These two files are inputs from the existing bounded SDK metadata helper.
+    sdk_metadata = {name: inline_file(scratch / 'vortx-sdk-pkgconfig' / name, work, MAX_HEADER, budget)
+                    for name in ('zlib.pc', 'libxml-2.0.pc')}
+    return {'record': inline_row(row, body, MAX_HEADER, budget), 'generatedConfiguration': configurations,
+            'installedConfiguration': installed, 'sdkMetadata': sdk_metadata}
+
