@@ -0,0 +1,186 @@
+"""Root-only local libplacebo plain-view materializer/verifier. No subprocess or network."""
+from pathlib import Path
+import argparse
+import hashlib
+import json
+import os
+import stat
+import time
+
+ROOT = Path('/Users/daksh/VortXTV')
+WORK = ROOT / '.worktrees/MPVKit/beta-native-upgrades-20261027'
+TARGET = WORK / 'dist/libplacebo-7.387.0-275f7dea'
+PARENT = ROOT / '.worktrees/libplacebo/beta/libplacebo-7.387.0-275f7dea'
+HEAD = '275f7dea27924cdd34ab2e6c20e448b6bc4fab65'
+PARENT_RECEIPT = ROOT / '_recovery/resume-20261029/native-placebo-git-v1/RESULT.json'
+PARENT_SHA = '64835c27dff03c3d3ebd282a9d0a483d1a62c7d9db298e8ee5f7dfeef5db27b3'
+ACQUIRED = ROOT / '_recovery/resume-20261029/actual-placebo-gitlinks-v1.WJ5uFS'
+ACQUIRED_SHA = 'c8a06528a1d3463812daa35ff57d705a14f33dba839ed319fed8913e43418a18'
+READBACK_SHA = '88ec2e498b9e8667fc732eb6b587c8b84f80d3dc6e49f92c33ea8d46ed5e5d99'
+PINS = {
+    '3rdparty/Vulkan-Headers': ('Vulkan-Headers', '74d8a6cb930c68ef617b202c3ff3c59d919e086b'),
+    '3rdparty/fast_float': ('fast_float', '97b54ca9e75f5303507699d27c6b4f4efe4641a1'),
+    '3rdparty/glad': ('glad', '73db193f853e2ee079bf3ca8a64aa2eaf6459043'),
+    '3rdparty/jinja': ('jinja', '15206881c006c79667fe5154fe80c01c65410679'),
+    '3rdparty/markupsafe': ('markupsafe', '297fc8e356e6836a62087949245d09a28e9f1b13'),
+}
+EXCLUDED = {'demos/3rdparty/nuklear': '242f35efa067a46c595645eeda7b1771ea1f83b1'}
+MARKER = '.vortx-libplacebo-source.json'
+
+
+def need(ok, message):
+    if not ok:
+        raise RuntimeError(message)
+
+
+def sha(body):
+    return hashlib.sha256(body).hexdigest()
+
+
+def safe_relative(name):
+    need(isinstance(name, str) and name and not name.startswith('/')
+         and not any(c in name for c in '\x00\t\r\n')
+         and all(p not in ('', '.', '..', '.git') for p in name.split('/')), 'unsafe source path')
+    return name
+
+
+def real_ancestors(path):
+    need(path.is_absolute() and path.is_relative_to(ROOT) and ROOT.resolve() == ROOT, 'source outside real workspace root')
+    cursor = ROOT
+    for part in path.relative_to(ROOT).parts:
+        cursor /= part
+        need(part not in ('.', '..'), 'source path escape')
+        if os.path.lexists(cursor):
+            need(cursor.is_dir() and not cursor.is_symlink(), 'source directory is redirected')
+
+
+def regular(path):
+    real_ancestors(path.parent)
+    info = path.lstat()
+    need(stat.S_ISREG(info.st_mode) and not path.is_symlink(), 'source body is not a regular file')
+    body = path.read_bytes()
+    after = path.lstat()
+    need((info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns) ==
+         (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns), 'source changed during read')
+    return body, stat.S_IMODE(info.st_mode)
+
+
+def receipt(path, digest):
+    body, _ = regular(path)
+    need(sha(body) == digest, 'authenticated source receipt changed')
+    return json.loads(body)
+
+
+def plan():
+    parent = receipt(PARENT_RECEIPT, PARENT_SHA)
+    acquired = receipt(ACQUIRED / 'RESULT.json', ACQUIRED_SHA)
+    readback = receipt(ACQUIRED / 'ROOT-READBACK.json', READBACK_SHA)
+    need(parent['head'] == HEAD and parent['registeredWorktree'] == str(PARENT), 'wrong parent source')
+    need(acquired['parentHead'] == HEAD and acquired['parentReceiptSHA256'] == PARENT_SHA
+         and acquired['demos'] is False and readback['ownedGitGroupsSettled'] is True
+         and readback['actualResultSHA256'] == ACQUIRED_SHA and readback['registeredSources'] == 5, 'acquisition settlement not accepted')
+    links = {e['path']: e['gitObject'] for e in parent['index'] if e['gitMode'] == '160000'}
+    need(links == dict({p: value[1] for p, value in PINS.items()}, **EXCLUDED), 'wrong parent gitlink set')
+    result = {}
+    for entry in parent['index']:
+        if entry['gitMode'] == '160000':
+            continue
+        need(entry['gitMode'] in ('100644', '100755'), 'unresolved parent source entry')
+        path = safe_relative(entry['path'])
+        need(path != MARKER and path not in result, 'duplicate parent path')
+        result[path] = dict(entry, source=PARENT / path)
+    sources = acquired['sources']
+    need(len(sources) == 5 and {s['parentPath'] for s in sources} == set(PINS), 'wrong required provider inventory')
+    for source in sources:
+        prefix = source['parentPath']
+        name, commit = PINS[prefix]
+        provider = ROOT / ('.worktrees/' + name + '/beta/placebo-7.387.0-' + commit[:12])
+        need(source['name'] == name and source['commit'] == commit and source['registeredWorktree'] == str(provider)
+             and source['unresolvedEntries'] == [] and source['allRegularBodiesVerified'] is True
+             and source['registryWrittenAndReadBack'] is True and source['existingCanonicalStateConserved'] is True, 'incomplete authenticated provider')
+        for entry in source['files']:
+            need(entry['gitMode'] in ('100644', '100755'), 'unresolved provider source entry')
+            leaf = safe_relative(entry['path'])
+            path = safe_relative(prefix + '/' + leaf)
+            need(path not in result, 'provider source collision')
+            result[path] = dict(entry, path=path, source=provider / leaf)
+    need(sum(len(s['files']) for s in sources) == 602, 'required source body count changed')
+    patches = WORK / 'Sources/BuildScripts/patch/libplacebo'
+    if os.path.lexists(patches):
+        real_ancestors(patches)
+        need(not any(p.suffix == '.patch' for p in patches.iterdir()), 'plain view cannot skip a libplacebo patch')
+    return result
+
+
+def check_body(path, expected):
+    body, mode = regular(path)
+    need(mode == (0o755 if expected['gitMode'] == '100755' else 0o644), 'source body mode mismatch')
+    need(hashlib.sha1(b'blob ' + str(len(body)).encode() + b'\0' + body).hexdigest() == expected['gitObject'], 'source Git blob mismatch')
+    if 'sha256' in expected:
+        need(sha(body) == expected['sha256'] and len(body) == expected['bytes'], 'provider source body mismatch')
+    return body
+
+
+def marker(rows):
+    return {'schema': 1, 'parentHead': HEAD, 'parentReceiptSHA256': PARENT_SHA,
+            'acquiredResultSHA256': ACQUIRED_SHA, 'rootReadbackSHA256': READBACK_SHA,
+            'demos': False, 'excludedUnresolvedGitlinks': EXCLUDED, 'files': rows,
+            'completeNativeAcceptance': False, 'buildCompilerOrABIInvoked': False}
+
+
+def verify(expected):
+    real_ancestors(TARGET)
+    body, mode = regular(TARGET / MARKER)
+    need(mode == 0o644, 'source marker mode mismatch')
+    manifest = json.loads(body)
+    seen = set()
+    for directory, dirs, files in os.walk(TARGET, followlinks=False):
+        for name in dirs:
+            need(name != '.git' and not (Path(directory) / name).is_symlink(), 'Git or redirected directory in plain view')
+        for name in files:
+            relative = str((Path(directory) / name).relative_to(TARGET))
+            need(name != '.git', 'Git metadata in plain view')
+            seen.add(relative)
+    need(seen == set(expected) | {MARKER}, 'plain view has missing or extra files')
+    rows = []
+    for path, entry in sorted(expected.items()):
+        data = check_body(TARGET / path, entry)
+        rows.append({'path': path, 'gitMode': entry['gitMode'], 'gitObject': entry['gitObject'], 'bytes': len(data), 'sha256': sha(data)})
+    need(manifest == marker(rows), 'plain view manifest does not match complete authenticated bodies')
+    return manifest
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('operation', choices=('materialize', 'verify'))
+    parser.add_argument('source_directory')
+    options = parser.parse_args()
+    need(Path(options.source_directory) == TARGET, 'unexpected libplacebo view destination')
+    expected = plan()
+    if options.operation == 'materialize':
+        real_ancestors(TARGET.parent)
+        need(TARGET.parent.is_dir() and not os.path.lexists(TARGET), 'view destination must be fresh; preserve existing state')
+        TARGET.mkdir(mode=0o755)
+        rows = []
+        for path, entry in sorted(expected.items()):
+            data = check_body(entry['source'], entry)
+            target = TARGET / path
+            real_ancestors(target.parent)
+            target.parent.mkdir(parents=True, exist_ok=True)
+            with target.open('xb') as stream:
+                stream.write(data)
+            target.chmod(0o755 if entry['gitMode'] == '100755' else 0o644)
+            rows.append({'path': path, 'gitMode': entry['gitMode'], 'gitObject': entry['gitObject'], 'bytes': len(data), 'sha256': sha(data)})
+        # Completion marker is exclusively written LAST. A partial view cannot enter the bypass.
+        with (TARGET / MARKER).open('x', encoding='utf-8') as stream:
+            json.dump(marker(rows), stream, indent=2, sort_keys=True)
+            stream.write('\n')
+        (TARGET / MARKER).chmod(0o644)
+    result = verify(expected)
+    print(json.dumps({'operation': options.operation, 'source': str(TARGET), 'regularBodies': len(result['files']),
+                      'markerSHA256': sha((TARGET / MARKER).read_bytes()), 'demos': False,
+                      'completeNativeAcceptance': False, 'buildCompilerOrABIInvoked': False}, sort_keys=True))
+
+
+if __name__ == '__main__':
+    main()
