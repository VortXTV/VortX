+            if stat.S_ISLNK(info.st_mode):
+                if not path.resolve().is_relative_to(root):
+                    fail("input symlink escapes its root: " + str(path))
+                row.update(type="symlink", target=os.readlink(path))
+            elif stat.S_ISDIR(info.st_mode):
