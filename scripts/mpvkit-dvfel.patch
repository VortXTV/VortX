--- /dev/null
+++ b/Sources/BuildScripts/crypto-release-sources.py
@@ -0,0 +1,626 @@
+#!/usr/bin/env python3
+"""Fixed release-source input boundary for the proposed Apple crypto chain.
+
+This file is a recovery proposal. It performs no download and never bootstraps
+Git sources. The SHA-256 values are corroborated by retained Homebrew formula
+metadata; this is not a claim of upstream signature verification.
+"""
+
+import argparse
+import gzip
+import hashlib
+import io
+import json
+import lzma
+import os
+from pathlib import Path
+import stat
+import tarfile
+import uuid
+
+
+MAX_ARCHIVE = 8 * 1024 * 1024
+MAX_UNCOMPRESSED = 512 * 1024 * 1024
+MAX_MEMBERS = 100000
+MAX_FILE = 64 * 1024 * 1024
+MAX_RECEIPT = 64 * 1024 * 1024
+MAX_PATH = 4096
+MAX_MTIME = 4102444800
+PROFILE = "gmp630-nettle400-gnutls3813-release-sources-v1"
+PINS = (
+    {
+        "id": "gmp", "version": "6.3.0", "archiveRoot": "gmp-6.3.0",
+        "filename": "gmp-6.3.0.tar.xz", "compression": "xz", "bytes": 2094196,
+        "sha256": "a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898",
+        "sourceRoot": "gmp-6.3.0-a3c2b802",
+        "url": "https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz",
+    },
+    {
+        "id": "nettle", "version": "4.0", "archiveRoot": "nettle-4.0",
+        "filename": "nettle-4.0.tar.gz", "compression": "gz", "bytes": None,
+        "sha256": "3addbc00da01846b232fb3bc453538ea5468da43033f21bb345cb1e9073f5094",
+        "sourceRoot": "nettle-4.0-3addbc00",
+        "url": "https://ftp.gnu.org/gnu/nettle/nettle-4.0.tar.gz",
+    },
+    {
+        "id": "gnutls", "version": "3.8.13", "archiveRoot": "gnutls-3.8.13",
+        "filename": "gnutls-3.8.13.tar.xz", "compression": "xz", "bytes": 7275324,
+        "sha256": "ffed8ec1bf09c2426d4f14aae377de4753b53e537d685e604e99a8b16ca9c97e",
+        "sourceRoot": "gnutls-3.8.13-ffed8ec1",
+        "url": "https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-3.8.13.tar.xz",
+    },
+)
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def canonical(value):
+    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
+
+
+def identity(st):
+    return (st.st_dev, st.st_ino, st.st_size, st.st_mode, st.st_mtime_ns, st.st_ctime_ns)
+
+
+def archive_mtime(value):
+    if type(value) is not int or not 0 <= value <= MAX_MTIME:
+        raise ValueError("source mtime must be bounded integral seconds")
+    return value
+
+
+def filesystem_mtime(info):
+    if info.st_mtime_ns % 1000000000:
+        raise ValueError("source mtime no longer matches integral release metadata")
+    return archive_mtime(info.st_mtime_ns // 1000000000)
+
+
+def checked_path(value):
+    path = Path(value)
+    if not path.is_absolute() or ".." in path.parts:
+        raise ValueError("an absolute path without parent traversal is required")
+    current = Path(path.anchor)
+    for part in path.parts[1:]:
+        current /= part
+        try:
+            info = current.lstat()
+        except FileNotFoundError:
+            break
+        if stat.S_ISLNK(info.st_mode):
+            raise ValueError("linked path ancestor is not admitted")
+    return path
+
+
+def directory(path):
+    checked_path(path)
+    info = path.lstat()
+    if not stat.S_ISDIR(info.st_mode):
+        raise ValueError("a real directory is required")
+    return path
+
+
+def read_regular(path, maximum):
+    checked_path(path)
+    before = path.lstat()
+    if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or before.st_size > maximum:
+        raise ValueError("input must be a bounded, unlinked regular file")
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    with os.fdopen(fd, "rb") as stream:
+        opened = os.fstat(stream.fileno())
+        if identity(opened) != identity(before):
+            raise ValueError("input changed before reading")
+        data = stream.read(maximum + 1)
+        if len(data) > maximum or identity(os.fstat(stream.fileno())) != identity(opened):
+            raise ValueError("input changed or exceeded its bound")
+    if identity(path.lstat()) != identity(before) or len(data) != before.st_size:
+        raise ValueError("input changed while reading")
+    return data
+
+
+def write_new(path, data, mode=0o644):
+    directory(path.parent)
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
+    with os.fdopen(fd, "wb") as stream:
+        stream.write(data)
+        stream.flush()
+        os.fsync(stream.fileno())
+    os.chmod(path, mode, follow_symlinks=False)
+
+
+def member_path(value):
+    if (not isinstance(value, str) or not value or len(value.encode()) > MAX_PATH
+            or not value.isprintable() or value.startswith("/") or "\\" in value
+            or ":" in value or "\x00" in value):
+        raise ValueError("unsafe archive path")
+    parts = value.rstrip("/").split("/")
+    if any(part in ("", ".", "..") or part.casefold() == ".git" for part in parts):
+        raise ValueError("unsafe archive path component")
+    return "/".join(parts)
+
+
+def link_path(parent, target):
+    if (not isinstance(target, str) or not target or len(target.encode()) > MAX_PATH
+            or not target.isprintable() or target.startswith("/") or "\\" in target
+            or ":" in target or "\x00" in target):
+        raise ValueError("unsafe source symlink target")
+    parts = list(parent)
+    for part in target.split("/"):
+        if part in ("", "."):
+            continue
+        if part == "..":
+            if not parts:
+                raise ValueError("source symlink escapes its release root")
+            parts.pop()
+        elif part.casefold() == ".git":
+            raise ValueError("source symlink points through Git metadata")
+        else:
+            parts.append(part)
+    return "/".join(parts)
+
+
+class LimitedReader:
+    def __init__(self, stream, maximum):
+        self.stream, self.maximum, self.count = stream, maximum, 0
+
+    def read(self, size=-1):
+        allowance = self.maximum - self.count
+        if size < 0 or size > allowance + 1:
+            size = allowance + 1
+        block = self.stream.read(size)
+        self.count += len(block)
+        if self.count > self.maximum:
+            raise ValueError("decompressed source archive exceeds its bound")
+        return block
+
+
+class LimitedWriter:
+    def __init__(self, stream, maximum):
+        self.stream, self.maximum, self.count = stream, maximum, 0
+
+    def write(self, block):
+        if self.count + len(block) > self.maximum:
+            raise ValueError("captured source tar exceeds its aggregate bound")
+        written = self.stream.write(block)
+        self.count += written
+        return written
+
+
+def tar_stream(blob, compression):
+    raw = io.BytesIO(blob)
+    if compression == "xz":
+        decoded = lzma.LZMAFile(raw, "rb")
+    elif compression == "gz":
+        decoded = gzip.GzipFile(fileobj=raw, mode="rb")
+    elif compression == "none":
+        decoded = raw
+    else:
+        raise ValueError("unknown fixed source compression")
+    return tarfile.open(fileobj=LimitedReader(decoded, MAX_UNCOMPRESSED), mode="r|")
+
+
+def file_row(member, stream):
+    if member.size < 0 or member.size > MAX_FILE:
+        raise ValueError("source member exceeds its bound")
+    hasher, count = hashlib.sha256(), 0
+    while True:
+        block = stream.read(min(1024 * 1024, member.size - count + 1))
+        if not block:
+            break
+        count += len(block)
+        if count > member.size:
+            raise ValueError("source member exceeds its declared length")
+        hasher.update(block)
+    if count != member.size:
+        raise ValueError("truncated source member")
+    return {"kind": "file", "mode": 0o755 if member.mode & 0o111 else 0o644,
+            "mtime": archive_mtime(member.mtime),
+            "bytes": count, "sha256": hasher.hexdigest()}
+
+
+def finish_index(entries):
+    # Add implicit parent directories, then reject a file/link used as an ancestor.
+    for name in list(entries):
+        parts = name.split("/")
+        for end in range(1, len(parts)):
+            parent = "/".join(parts[:end])
+            row = entries.setdefault(parent, {"kind": "directory", "mode": 0o755, "mtime": 0})
+            if row["kind"] != "directory":
+                raise ValueError("non-directory source member has children")
+            if len(entries) > MAX_MEMBERS:
+                raise ValueError("source archive has too many explicit and implicit paths")
+    folded = {}
+    for name in entries:
+        if name.casefold() in folded and folded[name.casefold()] != name:
+            raise ValueError("source archive has case-colliding members")
+        folded[name.casefold()] = name
+
+    def resolve(name, visited=()):
+        if len(visited) >= 32:
+            raise ValueError("source symlink chain exceeds its bound")
+        parts = name.split("/") if name else []
+        for end in range(1, len(parts) + 1):
+            prefix = "/".join(parts[:end])
+            row = entries.get(prefix)
+            if row is None:
+                raise ValueError("dangling source symlink")
+            if row["kind"] == "symlink":
+                if prefix in visited:
+                    raise ValueError("cyclic source symlink")
+                destination = link_path(parts[:end - 1], row["target"])
+                tail = parts[end:]
+                following = "/".join(([destination] if destination else []) + tail)
+                return resolve(following, visited + (prefix,))
+            if end < len(parts) and row["kind"] != "directory":
+                raise ValueError("source symlink resolves through a non-directory")
+        return name
+
+    for name, row in entries.items():
+        if row["kind"] == "symlink":
+            resolve(name)
+    return [{"path": name, **entries[name]} for name in sorted(entries)]
+
+
+def index_archive(pin, blob):
+    if (len(blob) > MAX_ARCHIVE or (pin["bytes"] is not None and len(blob) != pin["bytes"])
+            or digest(blob) != pin["sha256"]):
+        raise ValueError("release source body differs from its fixed pin")
+    entries = {"": {"kind": "directory", "mode": 0o755, "mtime": 0}}
+    seen, total = set(), 0
+    with tar_stream(blob, pin["compression"]) as archive:
+        for member in archive:
+            if len(seen) >= MAX_MEMBERS:
+                raise ValueError("source archive has too many members")
+            full = member_path(member.name)
+            root, separator, name = full.partition("/")
+            if root != pin["archiveRoot"]:
+                raise ValueError("source archive has a foreign top-level root")
+            if full.casefold() in seen:
+                raise ValueError("duplicate or case-colliding source member")
+            seen.add(full.casefold())
+            if getattr(member, "sparse", None) or any("sparse" in key.casefold() for key in member.pax_headers):
+                raise ValueError("sparse source archive members are not admitted")
+            if not separator:
+                if not member.isdir():
+                    raise ValueError("source archive root is not a directory")
+                entries[""]["mtime"] = archive_mtime(member.mtime)
+                continue
+            if member.isdir():
+                row = {"kind": "directory", "mode": 0o755,
+                       "mtime": archive_mtime(member.mtime)}
+            elif member.isreg():
+                total += member.size
+                if total > MAX_UNCOMPRESSED:
+                    raise ValueError("source member total exceeds its bound")
+                stream = archive.extractfile(member)
+                if stream is None:
+                    raise ValueError("missing source member body")
+                with stream:
+                    row = file_row(member, stream)
+            elif member.issym():
+                link_path(name.split("/")[:-1], member.linkname)
+                data = member.linkname.encode()
+                row = {"kind": "symlink", "mode": 0o777, "bytes": len(data),
+                       "mtime": archive_mtime(member.mtime),
+                       "sha256": digest(data), "target": member.linkname}
+            else:
+                # In particular, do not turn hardlinks into silently independent files.
+                raise ValueError("hardlinks and special source members require a reviewed successor")
+            entries[name] = row
+    rows = finish_index(entries)
+    configure = next((row for row in rows if row["path"] == "configure"), None)
+    if configure is None or configure["kind"] != "file" or configure["mode"] != 0o755:
+        raise ValueError("release archive lacks a regular executable configure; bootstrap is forbidden")
+    return rows
+
+
+def actual_index(root):
+    directory(root)
+    info = root.lstat()
+    entries = {"": {"kind": "directory", "mode": stat.S_IMODE(info.st_mode),
+                    "mtime": filesystem_mtime(info)}}
+    for parent, dirs, files in os.walk(root, followlinks=False):
+        parent = Path(parent)
+        for name in sorted(dirs + files):
+            path = parent / name
+            relative = member_path(path.relative_to(root).as_posix())
+            info = path.lstat()
+            if stat.S_ISDIR(info.st_mode):
+                row = {"kind": "directory", "mode": stat.S_IMODE(info.st_mode),
+                       "mtime": filesystem_mtime(info)}
+            elif stat.S_ISREG(info.st_mode):
+                data = read_regular(path, MAX_FILE)
+                row = {"kind": "file", "mode": stat.S_IMODE(info.st_mode),
+                       "mtime": filesystem_mtime(info),
+                       "bytes": len(data), "sha256": digest(data)}
+            elif stat.S_ISLNK(info.st_mode):
+                target = os.readlink(path)
+                after = path.lstat()
+                if identity(after) != identity(info):
+                    raise ValueError("source symlink changed during readback")
+                link_path(relative.split("/")[:-1], target)
+                data = target.encode()
+                row = {"kind": "symlink", "mode": 0o777, "bytes": len(data),
+                       "mtime": filesystem_mtime(info),
+                       "sha256": digest(data), "target": target}
+            else:
+                raise ValueError("source tree contains a special file")
+            entries[relative] = row
+            if len(entries) > MAX_MEMBERS:
+                raise ValueError("source tree has too many paths")
+    return finish_index(entries)
+
+
+def extract_source(pin, blob, destination, rows):
+    # The complete virtual tree and every link were checked before any extraction.
+    destination.mkdir(mode=0o755)
+    os.chmod(destination, 0o755, follow_symlinks=False)
+    for row in rows:
+        if row["kind"] == "directory":
+            path = destination / row["path"]
+            path.mkdir(mode=0o755, parents=True, exist_ok=True)
+            os.chmod(path, 0o755, follow_symlinks=False)
+    expected = {row["path"]: row for row in rows}
+    with tar_stream(blob, pin["compression"]) as archive:
+        for member in archive:
+            full = member_path(member.name)
+            _, separator, name = full.partition("/")
+            if not separator or not member.isreg():
+                continue
+            target = destination / name
+            stream = archive.extractfile(member)
+            if stream is None:
+                raise ValueError("missing source member during extraction")
+            with stream:
+                data = stream.read(MAX_FILE + 1)
+            row = expected[name]
+            if len(data) != row["bytes"] or digest(data) != row["sha256"]:
+                raise ValueError("source member differs between validation and extraction")
+            write_new(target, data, row["mode"])
