+    for pin in PINS:
+        blob = read_regular(archive_directory / pin["filename"], MAX_ARCHIVE)
+        result.append((pin, blob, index_archive(pin, blob)))
+    return result
+
+
+def prepare(work, inputs):
+    directory(work)
