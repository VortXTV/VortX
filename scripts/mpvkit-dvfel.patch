+def xcframework_identity(package, target, binary_name):
+    root = package / 'artifacts' / (target + '.xcframework')
+    expected_slices = {slice_name for _, _, slice_name in MATRIX}
+    if root.resolve() != root or not root.is_dir() or {path.name for path in root.iterdir()} != expected_slices | {'Info.plist'}:
+        fail('XCFramework directory has missing or extra slices')
+    row, data = read_verified(root / 'Info.plist', package, MAX_HEADER)
+    metadata = plistlib.loads(data)
+    if (not isinstance(metadata, dict) or metadata.get('CFBundlePackageType') != 'XFWK'
+            or metadata.get('XCFrameworkFormatVersion') != '1.0'):
+        fail('invalid XCFramework container metadata')
+    available = metadata.get('AvailableLibraries')
+    if not isinstance(available, list) or len(available) != len(expected_slices):
+        fail('XCFramework slice declaration set differs')
+    declarations = {}
+    for library in available:
+        if not isinstance(library, dict):
+            fail('invalid XCFramework slice declaration')
+        identifier = library.get('LibraryIdentifier')
+        if type(identifier) is not str or identifier not in expected_slices or identifier in declarations:
+            fail('unknown or duplicate XCFramework slice declaration')
+        archs = sorted({arch for _, arch, slice_name in MATRIX if slice_name == identifier})
+        platform = 'macos' if identifier.startswith('macos-') else 'tvos' if identifier.startswith('tvos-') else 'ios'
+        expected = {'LibraryIdentifier': identifier, 'LibraryPath': binary_name + '.framework',
+                    'SupportedArchitectures': archs, 'SupportedPlatform': platform}
+        if identifier.endswith('-simulator'):
+            expected['SupportedPlatformVariant'] = 'simulator'
+        actual = dict(library)
+        actual_archs = actual.get('SupportedArchitectures')
+        if not isinstance(actual_archs, list) or any(type(value) is not str for value in actual_archs):
+            fail('invalid XCFramework architecture declaration')
+        actual['SupportedArchitectures'] = sorted(actual_archs)
+        if actual != expected:
+            fail('XCFramework platform/architecture/library metadata differs')
+        declarations[identifier] = expected
+    return row
