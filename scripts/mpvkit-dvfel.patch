+def local_manifest(package):
+    row, text = text_file(package / 'Package.swift', package)
+    for target, *_ in LIBRARIES:
+        pattern = (r'\.binaryTarget\s*\(\s*name:\s*"' + re.escape(target)
+                   + r'"\s*,\s*path:\s*"artifacts/' + re.escape(target) + r'\.xcframework"\s*\)')
+        if len(re.findall(pattern, text, re.S)) != 1:
+            fail('candidate must bind one local target ' + target)
+        remote = r'name:\s*"' + re.escape(target) + r'"\s*,\s*url:'
+        if re.search(remote, text):
+            fail('candidate retains a remote target ' + target)
+    return row
