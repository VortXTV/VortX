+// SPIKE: shared helpers for cloning a dependency at an exact commit. BaseBuild.beforeBuild
+// can only clone a tag/branch via `--branch`, which cannot express a SHA.
+enum SpikeGit {
+    static func clonePinned(url: String, sha: String, branch: String? = nil, into directoryURL: URL) throws {
+        if FileManager.default.fileExists(atPath: directoryURL.path) {
+            return
+        }
+        // Shallow-clone deep enough to contain the pin, then detach onto it. `branch` is
+        // required when the pin lives on a maintenance branch (FFmpeg release/9.0), because
+        // the default-branch clone would not contain that commit at any depth.
+        var cloneArgs = ["-c", "advice.detachedHead=false", "clone", "--depth", "150"]
+        if let branch {
+            cloneArgs += ["--branch", branch]
+        }
+        cloneArgs += [url, directoryURL.path]
+        try! Utility.launch(path: "/usr/bin/git", arguments: cloneArgs)
+        try! Utility.launch(path: "/usr/bin/git",
+                            arguments: ["-c", "advice.detachedHead=false", "checkout", sha],
+                            currentDirectoryURL: directoryURL)
+        try! Utility.launch(path: "/usr/bin/git",
+                            arguments: ["submodule", "update", "--init", "--recursive", "--depth", "1"],
+                            currentDirectoryURL: directoryURL)
+    }
+
+    static func applyPatches(for library: Library, in directoryURL: URL) throws {
+        let patch = URL.currentDirectory + "../Sources/BuildScripts/patch/\(library.rawValue)"
+        guard FileManager.default.fileExists(atPath: patch.path) else { return }
+        let fileNames = try! FileManager.default.contentsOfDirectory(atPath: patch.path).sorted()
+        for fileName in fileNames where fileName.hasSuffix(".patch") {
+            // Idempotent: skip anything already in the tree (re-runs reuse the clone).
+            let check = Utility.shell("git apply --reverse --check \"\((patch + fileName).path)\"",
+                                      currentDirectoryURL: directoryURL)
+            if check != nil { continue }
+            try! Utility.launch(path: "/usr/bin/git",
+                                arguments: ["apply", (patch + fileName).path],
+                                currentDirectoryURL: directoryURL)
+        }
+    }
 }
 
