+        count += len(block)
+        if count > member.size:
+            raise ValueError("source member exceeds its declared length")
+        hasher.update(block)
+    if count != member.size:
+        raise ValueError("truncated source member")
+    return {"kind": "file", "mode": 0o755 if member.mode & 0o111 else 0o644,
+            "mtimeNs": archive_mtime_ns(member),
+            "bytes": count, "sha256": hasher.hexdigest()}
+
+
+def finish_index(entries):
+    # Add implicit parent directories, then reject a file/link used as an ancestor.
+    for name in list(entries):
+        parts = name.split("/")
+        for end in range(1, len(parts)):
+            parent = "/".join(parts[:end])
+            row = entries.setdefault(parent, {"kind": "directory", "mode": 0o755, "mtimeNs": 0})
+            if row["kind"] != "directory":
+                raise ValueError("non-directory source member has children")
+            if len(entries) > MAX_MEMBERS:
+                raise ValueError("source archive has too many explicit and implicit paths")
+    folded = {}
+    for name in entries:
+        if name.casefold() in folded and folded[name.casefold()] != name:
+            raise ValueError("source archive has case-colliding members")
+        folded[name.casefold()] = name
+
+    def resolve(name, visited=()):
+        if len(visited) >= 32:
+            raise ValueError("source symlink chain exceeds its bound")
+        parts = name.split("/") if name else []
+        for end in range(1, len(parts) + 1):
+            prefix = "/".join(parts[:end])
+            row = entries.get(prefix)
+            if row is None:
+                raise ValueError("dangling source symlink")
+            if row["kind"] == "symlink":
+                if prefix in visited:
+                    raise ValueError("cyclic source symlink")
+                destination = link_path(parts[:end - 1], row["target"])
+                tail = parts[end:]
+                following = "/".join(([destination] if destination else []) + tail)
+                return resolve(following, visited + (prefix,))
+            if end < len(parts) and row["kind"] != "directory":
+                raise ValueError("source symlink resolves through a non-directory")
+        return name
+
+    for name, row in entries.items():
+        if row["kind"] == "symlink":
+            resolve(name)
+    return [{"path": name, **entries[name]} for name in sorted(entries)]
+
+
+
+def freetype_file_row(member, stream, name):
+    expected = FREETYPE_GIT_FILES.get(name)
+    if expected is None or not member.isreg() or not 0 <= member.size <= MAX_FILE:
+        raise ValueError("FreeType source is not one declared bounded regular Git blob")
+    body = stream.read(MAX_FILE + 1)
+    mode = 0o755 if member.mode & 0o111 else 0o644
+    if (len(body) != member.size or mode != expected[0]
+            or hashlib.sha1(b"blob " + str(len(body)).encode() + b"\0" + body).hexdigest() != expected[1]):
+        raise ValueError("FreeType Git blob bytes/executable mode differ")
+    return {"kind": "file", "mode": mode, "mtimeNs": archive_mtime_ns(member),
+            "bytes": len(body), "sha256": digest(body)}
+
+
+def freetype_members(rows):
+    actual = {row["path"]: row for row in rows}
+    if ({name for name, row in actual.items() if row["kind"] == "file"} != set(FREETYPE_GIT_FILES)
+            or any(row["kind"] not in {"directory", "file"} for row in rows)
+            or any(row["kind"] == "directory" and row["path"] not in FREETYPE_GIT_DIRS for row in rows)):
+        raise ValueError("FreeType source membership or explicitly empty dlg gitlink differs")
+    if any(name.startswith("subprojects/dlg/") for name in actual):
+        raise ValueError("FreeType unused dlg gitlink must stay empty")
+
+def index_archive(pin, blob):
+    if (len(blob) > min(MAX_ARCHIVE, pin.get("maximumBytes", MAX_ARCHIVE)) or (pin["bytes"] is not None and len(blob) != pin["bytes"])
+            or digest(blob) != pin["sha256"]):
+        raise ValueError("release source body differs from its fixed pin")
+    entries = {"": {"kind": "directory", "mode": 0o755, "mtimeNs": 0}}
+    seen, total = set(), 0
+    with tar_stream(blob, pin["compression"]) as archive:
+        for member in archive:
+            if len(seen) >= MAX_MEMBERS:
+                raise ValueError("source archive has too many members")
+            full = member_path(member.name)
+            root, separator, name = full.partition("/")
+            if root != pin["archiveRoot"]:
+                raise ValueError("source archive has a foreign top-level root")
+            if full.casefold() in seen:
+                raise ValueError("duplicate or case-colliding source member")
+            seen.add(full.casefold())
+            if getattr(member, "sparse", None) or any("sparse" in key.casefold() for key in member.pax_headers):
+                raise ValueError("sparse source archive members are not admitted")
+            if not separator:
+                if not member.isdir():
+                    raise ValueError("source archive root is not a directory")
+                entries[""]["mtimeNs"] = archive_mtime_ns(member)
+                continue
+            if member.isdir():
+                row = {"kind": "directory", "mode": 0o755,
+                       "mtimeNs": archive_mtime_ns(member)}
+            elif member.isreg():
+                total += member.size
+                if total > MAX_UNCOMPRESSED:
+                    raise ValueError("source member total exceeds its bound")
+                stream = archive.extractfile(member)
+                if stream is None:
+                    raise ValueError("missing source member body")
+                with stream:
+                    if pin["id"] == "libfreetype":
+                        row = freetype_file_row(member, stream, name)
+                    elif pin["id"] == "libbluray" and name in BLURAY_SOURCE_TRANSFORMS:
+                        data = stream.read(MAX_FILE + 1)
+                        if len(data) != member.size or len(data) > MAX_FILE:
+                            raise ValueError("libbluray transform member length differs")
+                        data = source_body(pin, name, data)
+                        row = {"kind": "file", "mode": 0o755 if member.mode & 0o111 else 0o644,
+                               "mtimeNs": archive_mtime_ns(member),
+                               "bytes": len(data), "sha256": digest(data)}
+                    else:
+                        row = file_row(member, stream)
+            elif member.issym():
+                link_path(name.split("/")[:-1], member.linkname)
+                data = member.linkname.encode()
+                row = {"kind": "symlink", "mode": 0o777, "bytes": len(data),
+                       "mtimeNs": archive_mtime_ns(member),
+                       "sha256": digest(data), "target": member.linkname}
+            else:
+                # In particular, do not turn hardlinks into silently independent files.
+                raise ValueError("hardlinks and special source members require a reviewed successor")
+            entries[name] = row
+    if pin["id"] == "libbluray" and not set(BLURAY_SOURCE_TRANSFORMS).issubset(entries):
+        raise ValueError("libbluray source is missing a fixed Apple transform input")
+    rows = finish_index(entries)
+    if pin["id"] == "libfreetype":
+        freetype_members(rows)
+    entry_point = pin.get("entryPoint", "configure")
+    entry = next((row for row in rows if row["path"] == entry_point), None)
+    if (entry is None or entry["kind"] != "file"
+            or (entry_point == "configure" and entry["mode"] != 0o755)):
+        raise ValueError("release archive lacks its fixed regular build entry point; bootstrap is forbidden")
+    return rows
+
+
+def actual_index(root):
+    directory(root)
+    info = root.lstat()
+    entries = {"": {"kind": "directory", "mode": stat.S_IMODE(info.st_mode),
+                    "mtimeNs": filesystem_mtime_ns(info)}}
+    for parent, dirs, files in os.walk(root, followlinks=False):
+        parent = Path(parent)
+        for name in sorted(dirs + files):
+            path = parent / name
+            relative = member_path(path.relative_to(root).as_posix())
+            info = path.lstat()
+            if stat.S_ISDIR(info.st_mode):
+                row = {"kind": "directory", "mode": stat.S_IMODE(info.st_mode),
+                       "mtimeNs": filesystem_mtime_ns(info)}
+            elif stat.S_ISREG(info.st_mode):
+                data = read_regular(path, MAX_FILE)
+                row = {"kind": "file", "mode": stat.S_IMODE(info.st_mode),
+                       "mtimeNs": filesystem_mtime_ns(info),
+                       "bytes": len(data), "sha256": digest(data)}
+            elif stat.S_ISLNK(info.st_mode):
+                target = os.readlink(path)
+                after = path.lstat()
+                if identity(after) != identity(info):
+                    raise ValueError("source symlink changed during readback")
+                link_path(relative.split("/")[:-1], target)
+                data = target.encode()
+                row = {"kind": "symlink", "mode": 0o777, "bytes": len(data),
+                       "mtimeNs": filesystem_mtime_ns(info),
+                       "sha256": digest(data), "target": target}
+            else:
+                raise ValueError("source tree contains a special file")
+            entries[relative] = row
+            if len(entries) > MAX_MEMBERS:
+                raise ValueError("source tree has too many paths")
+    return finish_index(entries)
+
+
+def extract_source(pin, blob, destination, rows):
+    # The complete virtual tree and every link were checked before any extraction.
+    destination.mkdir(mode=0o755)
+    os.chmod(destination, 0o755, follow_symlinks=False)
+    for row in rows:
+        if row["kind"] == "directory":
+            path = destination / row["path"]
+            path.mkdir(mode=0o755, parents=True, exist_ok=True)
+            os.chmod(path, 0o755, follow_symlinks=False)
+    expected = {row["path"]: row for row in rows}
+    with tar_stream(blob, pin["compression"]) as archive:
+        for member in archive:
+            full = member_path(member.name)
+            _, separator, name = full.partition("/")
+            if not separator or not member.isreg():
+                continue
+            target = destination / name
+            stream = archive.extractfile(member)
+            if stream is None:
+                raise ValueError("missing source member during extraction")
+            with stream:
+                data = stream.read(MAX_FILE + 1)
+            if len(data) != member.size or len(data) > MAX_FILE:
+                raise ValueError("source member raw length changed during extraction")
+            data = source_body(pin, name, data)
+            row = expected[name]
+            if len(data) != row["bytes"] or digest(data) != row["sha256"]:
+                raise ValueError("source member differs between validation and extraction")
+            write_new(target, data, row["mode"])
+    for row in rows:
+        if row["kind"] == "symlink":
+            os.symlink(row["target"], destination / row["path"])
+    # Preserve authenticated release ordering for make's regeneration rules.
+    # Metadata writes happen after all child creation; directories are last.
+    for row in rows:
+        if row["kind"] != "directory":
+            nanoseconds = checked_mtime_ns(row["mtimeNs"])
+            os.utime(destination / row["path"], ns=(nanoseconds, nanoseconds),
+                     follow_symlinks=False)
+    directories = sorted((row for row in rows if row["kind"] == "directory"),
+                         key=lambda row: len(row["path"].split("/")) if row["path"] else 0,
+                         reverse=True)
+    for row in directories:
+        nanoseconds = checked_mtime_ns(row["mtimeNs"])
+        os.utime(destination / row["path"], ns=(nanoseconds, nanoseconds),
+                 follow_symlinks=False)
+    if actual_index(destination) != rows:
+        raise ValueError("extracted source tree differs from the release archive")
+
+
+def receipt_for(verified):
+    roots = []
+    for pin, blob, rows in verified:
+        roots.append({"id": pin["id"], "version": pin["version"],
+                      "url": pin["url"], "archive": "archives/" + pin["filename"],
+                      "archiveRoot": pin["archiveRoot"], "archiveBytes": len(blob),
+                      "archiveSHA256": pin["sha256"], "sourceRoot": "dist/" + pin["sourceRoot"],
+                      "sourceTransformPolicy": pin.get("sourceTransformPolicy", "none"),
+                      "membersSHA256": digest(canonical(rows)), "members": rows})
+    return {"schema": 3, "profile": PROFILE,
+            "identityBasis": IDENTITY_BASIS,
+            "upstreamSignatureVerified": False, "roots": roots}
+
+
+def previous_receipt_for(verified):
+    if [pin["id"] for pin, _, _ in verified] != [pin["id"] for pin in PREVIOUS_PINS]:
+        raise ValueError("previous subtitle source tuple differs")
+    value = receipt_for(verified)
+    value["profile"] = PREVIOUS_PROFILE
+    value["identityBasis"] = PREVIOUS_IDENTITY_BASIS
+    return value
+
+
+def legacy_receipt_for(verified):
+    if [pin["id"] for pin, _, _ in verified] != [pin["id"] for pin in LEGACY_PINS]:
+        raise ValueError("legacy subtitle source tuple is not the exact three-root family")
+    roots = []
+    for pin, blob, rows in verified:
+        roots.append({"id": pin["id"], "version": pin["version"],
+                      "url": pin["url"], "archive": "archives/" + pin["filename"],
+                      "archiveRoot": pin["archiveRoot"], "archiveBytes": len(blob),
+                      "archiveSHA256": pin["sha256"], "sourceRoot": "dist/" + pin["sourceRoot"],
+                      "membersSHA256": digest(canonical(rows)), "members": rows})
+    return {"schema": 2, "profile": LEGACY_PROFILE,
+            "identityBasis": LEGACY_IDENTITY_BASIS,
+            "upstreamSignatureVerified": False, "roots": roots}
+
+
+def read_inputs(archive_directory, pins=PINS):
+    directory(archive_directory)
+    if {path.name for path in archive_directory.iterdir()} != {
+            pin["filename"] for pin in pins}:
+        raise ValueError("release source archive input set is not exact")
+    result = []
+    for pin in pins:
+        blob = read_regular(archive_directory / pin["filename"], min(MAX_ARCHIVE, pin.get("maximumBytes", MAX_ARCHIVE)))
+        result.append((pin, blob, index_archive(pin, blob)))
+    return result
+
+
+def prepare(work, inputs, previous=False):
+    pins = PREVIOUS_PINS if previous else PINS
+    state_name = PREVIOUS_STATE_NAME if previous else STATE_NAME
+    receipt_builder = previous_receipt_for if previous else receipt_for
+    directory(work)
+    dist = work / "dist"
+    if not dist.exists():
+        dist.mkdir(mode=0o755)
+    directory(dist)
+    destinations = [dist / pin["sourceRoot"] for pin in pins] + [dist / state_name]
+    if any(path.exists() or path.is_symlink() for path in destinations):
+        raise ValueError("release source preparation requires fresh exact destinations")
+    verified = read_inputs(inputs, pins)
+    stage = dist / (".subtitle-sources-v3-stage-" + uuid.uuid4().hex)
+    stage.mkdir(mode=0o755)
+    state = stage / state_name
+    state.mkdir(mode=0o755)
+    (state / "archives").mkdir(mode=0o755)
+    for pin, blob, rows in verified:
+        write_new(state / "archives" / pin["filename"], blob)
+        extract_source(pin, blob, stage / pin["sourceRoot"], rows)
+    write_new(state / "receipt.json", canonical(receipt_builder(verified)))
+    # No replacement or automatic recovery: an interrupted publication is retained.
+    for pin in pins:
+        os.rename(stage / pin["sourceRoot"], dist / pin["sourceRoot"])
+    os.rename(state, dist / state_name)
+    stage.rmdir()
+    (verify_previous if previous else verify_freetype)(work)
+
+
+def strict_json(data):
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            if key in result:
+                raise ValueError("duplicate receipt key")
+            result[key] = value
+        return result
+    return json.loads(data.decode("utf-8"), object_pairs_hook=pairs)
+
+
+def verify_state(work, state_name, pins, receipt_builder, receipt_sha256=None):
+    directory(work)
+    state = directory(work / "dist" / state_name)
+    if {path.name for path in state.iterdir()} != {"archives", "receipt.json"}:
+        raise ValueError("unexpected release source state input")
+    archive_dir = directory(state / "archives")
+    verified = read_inputs(archive_dir, pins)
+    receipt_body = read_regular(state / "receipt.json", MAX_RECEIPT)
+    if receipt_sha256 is not None and digest(receipt_body) != receipt_sha256:
+        raise ValueError("legacy release source receipt identity differs")
+    observed = strict_json(receipt_body)
+    expected = canonical(receipt_builder(verified))
+    if receipt_body != expected or canonical(observed) != expected:
+        raise ValueError("release source receipt differs from actual pinned archive members")
+    for pin, _, rows in verified:
+        if actual_index(work / "dist" / pin["sourceRoot"]) != rows:
+            raise ValueError("release source tree changed or contains extra paths")
+    return verified
+
+
+def verify_legacy(work):
+    return verify_state(work, LEGACY_STATE_NAME, LEGACY_PINS,
+                        legacy_receipt_for, LEGACY_RECEIPT_SHA256)
+
+
+def verify_previous(work):
+    return verify_state(work, PREVIOUS_STATE_NAME, PREVIOUS_PINS, previous_receipt_for)
+
+
+def verify(work):
+    return verify_state(work, STATE_NAME, PINS, receipt_for)
+
+
+def verify_freetype(work):
+    verified = verify(work)
+    pin, _, rows = verified[-1]
+    if pin != FREETYPE_PIN:
+        raise ValueError("FreeType source selector differs")
+    freetype_members(rows)
+    # Exact Git membership already authenticates this header; enforce the
+    # declared no-dlg feature at the source boundary as well.
+    body = read_regular(work / "dist" / pin["sourceRoot"] / "include/freetype/config/ftoption.h", MAX_FILE)
+    if re.search(rb"(?m)^\s*#\s*define\s+FT_DEBUG_LOGGING\b", body):
+        raise ValueError("FreeType dlg logging requires a separately pinned initialized submodule")
+    return verified
+
+
+def extend_bluray(work, inputs):
+    directory(work)
+    dist = directory(work / "dist")
+    legacy = verify_legacy(work)
+    bluray_root = dist / BLURAY_PIN["sourceRoot"]
+    state_destination = dist / PREVIOUS_STATE_NAME
+    if (bluray_root.exists() or bluray_root.is_symlink()
+            or state_destination.exists() or state_destination.is_symlink()):
+        raise ValueError("libbluray extension requires fresh exact destinations")
+    bluray = read_inputs(inputs, (BLURAY_PIN,))
+    verified = legacy + bluray
+    stage = dist / (".subtitle-bluray-extension-stage-" + uuid.uuid4().hex)
+    stage.mkdir(mode=0o755)
+    state = stage / PREVIOUS_STATE_NAME
+    state.mkdir(mode=0o755)
+    (state / "archives").mkdir(mode=0o755)
+    for pin, blob, _ in verified:
+        write_new(state / "archives" / pin["filename"], blob)
+    _, bluray_blob, bluray_rows = bluray[0]
+    staged_root = stage / BLURAY_PIN["sourceRoot"]
+    extract_source(BLURAY_PIN, bluray_blob, staged_root, bluray_rows)
+    receipt_body = canonical(previous_receipt_for(verified))
+    write_new(state / "receipt.json", receipt_body)
+    if (read_inputs(state / "archives", PREVIOUS_PINS) != verified
+            or read_regular(state / "receipt.json", MAX_RECEIPT) != receipt_body
+            or actual_index(staged_root) != bluray_rows
+            or verify_legacy(work) != legacy):
+        raise ValueError("libbluray staged extension differs from its fixed source closure")
+
+    published = []
+    try:
+        os.rename(staged_root, bluray_root)
+        published.append((bluray_root, staged_root))
+        os.rename(state, state_destination)
+        published.append((state_destination, state))
+        if verify_legacy(work) != legacy or verify_previous(work) != verified:
+            raise ValueError("libbluray extension changed after publication")
+    except Exception:
+        for destination, staged in reversed(published):
+            if ((destination.exists() or destination.is_symlink())
+                    and not (staged.exists() or staged.is_symlink())):
+                os.rename(destination, staged)
+        raise
+    stage.rmdir()
+
+
+def extend_freetype(work, inputs):
+    directory(work)
+    dist = directory(work / "dist")
+    legacy = verify_previous(work)
+    freetype_root = dist / FREETYPE_PIN["sourceRoot"]
+    state_destination = dist / STATE_NAME
+    if (freetype_root.exists() or freetype_root.is_symlink()
+            or state_destination.exists() or state_destination.is_symlink()):
+        raise ValueError("FreeType extension requires fresh exact destinations")
+    freetype = read_inputs(inputs, (FREETYPE_PIN,))
+    verified = legacy + freetype
+    stage = dist / (".subtitle-freetype-extension-stage-" + uuid.uuid4().hex)
+    stage.mkdir(mode=0o755)
+    state = stage / STATE_NAME
+    state.mkdir(mode=0o755)
+    (state / "archives").mkdir(mode=0o755)
+    for pin, blob, _ in verified:
+        write_new(state / "archives" / pin["filename"], blob)
+    _, freetype_blob, freetype_rows = freetype[0]
+    staged_root = stage / FREETYPE_PIN["sourceRoot"]
+    extract_source(FREETYPE_PIN, freetype_blob, staged_root, freetype_rows)
+    receipt_body = canonical(receipt_for(verified))
+    write_new(state / "receipt.json", receipt_body)
+    if (read_inputs(state / "archives") != verified
+            or read_regular(state / "receipt.json", MAX_RECEIPT) != receipt_body
+            or actual_index(staged_root) != freetype_rows
+            or verify_previous(work) != legacy):
+        raise ValueError("FreeType staged extension differs from its fixed source closure")
+
+    published = []
+    try:
+        os.rename(staged_root, freetype_root)
+        published.append((freetype_root, staged_root))
+        os.rename(state, state_destination)
+        published.append((state_destination, state))
+        if verify_previous(work) != legacy or verify_freetype(work) != verified:
+            raise ValueError("FreeType extension changed after publication")
+    except Exception:
+        for destination, staged in reversed(published):
+            if ((destination.exists() or destination.is_symlink())
+                    and not (staged.exists() or staged.is_symlink())):
+                os.rename(destination, staged)
+        raise
+    stage.rmdir()
+
+
+def tar_add(archive, path, full, row):
+    entry = tarfile.TarInfo(full)
+    entry.uid = entry.gid = 0
+    capture_mtime(entry, row["mtimeNs"])
+    entry.uname = entry.gname = ""
+    entry.mode = row["mode"]
+    if row["kind"] == "directory":
+        entry.type = tarfile.DIRTYPE
+        archive.addfile(entry)
+    elif row["kind"] == "symlink":
+        entry.type, entry.linkname = tarfile.SYMTYPE, row["target"]
+        archive.addfile(entry)
+    else:
+        data = read_regular(path, MAX_FILE)
+        if len(data) != row["bytes"] or digest(data) != row["sha256"]:
+            raise ValueError("source changed during source capture")
+        entry.size = len(data)
+        archive.addfile(entry, io.BytesIO(data))
+
+
+def capture(work, output):
+    verified = verify(work)
+    for protected in [work / "dist" / pin["sourceRoot"] for pin in PINS] + [
+            work / "dist" / PREVIOUS_STATE_NAME,
+            work / "dist" / STATE_NAME, work / "dist" / LEGACY_STATE_NAME]:
+        try:
+            output.relative_to(protected)
+        except ValueError:
+            continue
+        raise ValueError("source capture output cannot be inside a protected source/input root")
+    directory(output.parent)
+    if output.exists() or output.is_symlink():
+        raise ValueError("source capture output must be fresh")
+    output.mkdir(mode=0o755)
+    (output / "archives").mkdir(mode=0o755)
+    for pin, blob, _ in verified:
+        write_new(output / "archives" / pin["filename"], blob)
+    snapshot = output / "subtitle-release-sources.tar"
+    fd = os.open(snapshot, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
+    with os.fdopen(fd, "wb") as stream:
+        bounded = LimitedWriter(stream, MAX_UNCOMPRESSED)
+        with tarfile.open(fileobj=bounded, mode="w|", format=tarfile.PAX_FORMAT) as archive:
+            for pin, _, rows in verified:
+                for row in rows:
+                    full = pin["archiveRoot"] + ("/" + row["path"] if row["path"] else "")
+                    tar_add(archive, work / "dist" / pin["sourceRoot"] / row["path"],
+                            full, row)
+        stream.flush()
+        os.fsync(stream.fileno())
+    # A changed source tree or raw body cannot be blessed by capture's own receipt.
+    if verify(work) != verified:
+        raise ValueError("crypto input tuple changed during source capture")
+    write_new(output / "subtitle-release-sources.json", canonical(receipt_for(verified)))
+    verify_capture(output)
+
+
+def verify_capture(output):
+    directory(output)
+    if {path.name for path in output.iterdir()} != {
+            "archives", "subtitle-release-sources.tar", "subtitle-release-sources.json"}:
+        raise ValueError("captured crypto source artifact set is not exact")
+    archive_dir = directory(output / "archives")
