 private class BuildSmbclient: ZipBaseBuild {
     init() {
         super.init(library: .libsmbclient)
     }
 
+    override func validateDownloadedArchive(_ archive: URL) throws {
+        try SmbMetadataNormalizer.validateArchive(archive, version: library.version)
+    }
+
+    override func beforeBuild() throws {
+        guard library.version == SmbMetadataNormalizer.version else {
+            throw SmbMetadataNormalizer.fail("Unapproved SMB wrapper version")
+        }
+        let archive = directoryURL.appendingPathComponent("libsmbclient.zip")
+        // Reject cached zero/unknown/symlink inputs before ZipBaseBuild's cleanup branch.
+        let cached: Bool
+        do {
+            _ = try FileManager.default.attributesOfItem(atPath: archive.path)
+            cached = true
+        } catch let error as NSError where error.domain == NSCocoaErrorDomain &&
+            (error.code == NSFileNoSuchFileError || error.code == NSFileReadNoSuchFileError) {
+            cached = false
+        } catch {
+            throw error
+        }
+        if cached {
+            try validateDownloadedArchive(archive)
+        } else {
+            try SmbMetadataNormalizer.validateFreshDirectory(directoryURL)
+        }
+        try super.beforeBuild()
+        try SmbMetadataNormalizer.validateWrapper(directoryURL, version: library.version)
+    }
+
+    override func afterBuild() throws {
+        let requested = Set(BaseBuild.platforms.flatMap { platform in
+            architectures(platform).map { "\(platform.rawValue)/\($0.rawValue)" }
+        })
+        try SmbMetadataNormalizer.normalize(wrapper: directoryURL, outputRoot: URL.currentDirectory,
+                                            version: library.version, requested: requested)
+        try super.afterBuild()
+    }
 }
 
