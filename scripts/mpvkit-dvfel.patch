+    dv_need(dependencies.is_file() and consumer_archive.is_file(),'actual completed Meson consumer outputs')
+    value={'schema':1,'sourceCommit':'275f7dea27924cdd34ab2e6c20e448b6bc4fab65','platform':platform,'arch':arch,
+      'providerArchiveSHA256':digest(prefix/'lib/libdovi.a'),'providerHeaderSHA256':digest(prefix/'include/libdovi/rpu_parser.h'),
+      'providerPcSHA256':digest(prefix/'lib/pkgconfig/dovi.pc'),'dependencyBytesSHA256':digest(dependencies),
+      'consumerArchiveSHA256':digest(consumer_archive),'consumerArchiveBytes':consumer_archive.stat().st_size,'compiled':True,'installed':True}
+    with (scratch/'vortx-dovi-consumer.json').open('x') as stream:json.dump(value,stream,indent=2,sort_keys=True);stream.write('\n')
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("mode", choices=("verify", "build", "verify-consumer", "capture-consumer"))
+    parser.add_argument("work", type=Path)
+    parser.add_argument("platform", nargs="?")
+    parser.add_argument("arch", nargs="?")
+    args = parser.parse_args()
+    if args.mode == "verify":
+        load(args.work)
+    elif args.mode in ("verify-consumer", "capture-consumer"):
+        dovi_consumer(args.work, args.platform, args.arch, args.mode == "capture-consumer")
+    else:
+        if (args.platform, args.arch) not in {row[:2] for row in DOVI_MATRIX}:
