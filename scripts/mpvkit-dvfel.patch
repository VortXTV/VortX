+def dovi_bounded_run(command, *, cwd, env, stdout=None, timeout):
+    # Inherit the root-owned process group so its overall finite phase can stop
+    # every descendant. A child timeout is a failure, never settlement proof;
+    # root must retain its actual stop/settlement receipt before another phase.
+    return subprocess.run(command,cwd=cwd,env=env,stdout=stdout,stderr=subprocess.STDOUT,
+                          timeout=timeout,check=True,start_new_session=False)
+
+def dovi_consumer(work,platform,arch,capture):
+    load(work)
+    identity=next((row for row in DOVI_MATRIX if row[:2]==(platform,arch)),None)
+    dv_need(identity is not None,'consumer target is outside the selected matrix')
+    pins,mapping,vendor,bodies,policy=_dovi_ready_inputs(work)
+    prefix=work/'dist/libdovi'/platform/'thin'/arch
+    record=dv_json((work/'dist/libdovi'/platform/'scratch'/arch/'vortx-dovi-build.json').read_bytes())
+    current={str((prefix/name).relative_to(work)):{'path':str((prefix/name).relative_to(work)),'bytes':(prefix/name).stat().st_size,'sha256':digest(prefix/name)} for name in ('include/libdovi/rpu_parser.h','lib/pkgconfig/dovi.pc','lib/libdovi.a')}
+    dv_need(record['sourceCommit']==COMMIT and record['sourceInputsSHA256']==digest(work/'dist/dovi-inputs/inputs.json') and current=={row['path']:row for row in record['outputs']},'consumer exact current provider')
+    if not capture:
+        return
+    scratch=work/'dist/libplacebo'/platform/'scratch'/arch
