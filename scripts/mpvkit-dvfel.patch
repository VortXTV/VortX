+// Release archives are authenticated and prepared by crypto-release-sources.py.
+// Never route these sources through BaseBuild's autogen/bootstrap heuristics.
+private class PinnedCryptoReleaseBuild: BaseBuild {
+    private var workRoot: URL { URL.currentDirectory.deletingLastPathComponent() }
+
+    private func verifySources() throws {
+        let helper = workRoot.appendingPathComponent("Sources/BuildScripts/crypto-release-sources.py")
+        try Utility.launch(path: "python3", arguments: [helper.path, "verify", workRoot.path],
+                           currentDirectoryURL: URL.currentDirectory)
+    }
+
+    override func beforeBuild() throws {
+        try verifySources()
+        let expected: String
+        switch library {
+        case .gmp: expected = "gmp-6.3.0-a3c2b802"
+        case .nettle: expected = "nettle-4.0-3addbc00"
+        case .gnutls: expected = "gnutls-3.8.13-ffed8ec1"
+        default: throw NSError(domain: "VortXCryptoSource", code: 1,
+                               userInfo: [NSLocalizedDescriptionKey: "Unsupported release-source library"])
+        }
+        guard directoryURL.lastPathComponent == expected else {
+            throw NSError(domain: "VortXCryptoSource", code: 2,
+                          userInfo: [NSLocalizedDescriptionKey: "Release source selector differs from the fixed archive policy"])
+        }
+    }
+
+    override func generatesPackageManagerFile() -> Bool { false }
+
+    override func environment(platform: PlatformType, arch: ArchType) -> [String: String] {
+        var env = super.environment(platform: platform, arch: arch)
+        // Explicit GNU shipping optimization; leave base/Meson and native generators alone.
+        let shippingFlags = cFlags(platform: platform, arch: arch).joined(separator: " ") + " -O2"
+        env["CFLAGS"] = shippingFlags
+        env["CXXFLAGS"] = shippingFlags
+        env["AR"] = platform.xcrunFind(tool: "ar").trimmingCharacters(in: .whitespacesAndNewlines)
+        env["RANLIB"] = platform.xcrunFind(tool: "ranlib").trimmingCharacters(in: .whitespacesAndNewlines)
+        // Build-time generators must run on the build machine, without target SDK flags.
+        env["CC_FOR_BUILD"] = "/usr/bin/clang"
+        return env
+    }
+
+    override func build(platform: PlatformType, arch: ArchType) throws {
+        try verifySources()
+        let buildURL = scratch(platform: platform, arch: arch)
+        try FileManager.default.createDirectory(at: buildURL, withIntermediateDirectories: true)
+        let recordURL = buildURL.appendingPathComponent("vortx-crypto-build.json")
+        guard !FileManager.default.fileExists(atPath: recordURL.path) else {
+            throw NSError(domain: "VortXCryptoSource", code: 3,
+                          userInfo: [NSLocalizedDescriptionKey: "Fresh crypto build evidence required"])
+        }
+        var env = environment(platform: platform, arch: arch)
+        try SDKSystemMetadata.append(to: &env, sdkRoot: URL(fileURLWithPath: platform.isysroot), buildRoot: buildURL)
+        // These are authenticated release scripts. No network bootstrap or autogen runs.
+        let configure = directoryURL.appendingPathComponent("configure")
+        let args = ["--prefix=\(thinDir(platform: platform, arch: arch).path)"] + arguments(platform: platform, arch: arch)
+        try Utility.launch(path: "/bin/sh", arguments: [configure.path] + args,
+                           currentDirectoryURL: buildURL, environment: env)
+        // Authenticated archive mtimes are preserved by the preparer. A make
+        // rule attempting autotools regeneration still fails closed.
+        let makeArgs = ["-j1", "AUTOCONF=/usr/bin/false", "AUTOHEADER=/usr/bin/false",
+                        "AUTOMAKE=/usr/bin/false", "ACLOCAL=/usr/bin/false"]
+        try Utility.launch(path: "/usr/bin/make", arguments: makeArgs, currentDirectoryURL: buildURL, environment: env)
+        try Utility.launch(path: "/usr/bin/make", arguments: makeArgs + ["install"], currentDirectoryURL: buildURL, environment: env)
+        // Any tracked/release-tree change, including generated source files, fails closed.
+        try verifySources()
+        var generated: [String: [String: Any]] = [:]
+        var configurationNames = ["Makefile", "config.status", "config.log", "config.h"]
+        switch library {
+        case .gmp: configurationNames += ["gmp.h"]
+        case .nettle: configurationNames += ["config.make", "config.m4", "version.h", "nettle.pc", "hogweed.pc"]
+        case .gnutls: configurationNames += ["lib/gnutls.pc", "lib/includes/gnutls/gnutls.h"]
+        default: break
+        }
+        for name in configurationNames {
+            let path = buildURL.appendingPathComponent(name)
+            let info = try FileManager.default.attributesOfItem(atPath: path.path)
+            guard info[.type] as? FileAttributeType == .typeRegular,
+                  let size = info[.size] as? NSNumber, size.intValue > 0, size.intValue <= 16 * 1024 * 1024 else {
+                throw NSError(domain: "VortXCryptoSource", code: 4,
+                              userInfo: [NSLocalizedDescriptionKey: "Missing or unsafe generated crypto configuration: \(name)"])
+            }
+            let bytes = try Data(contentsOf: path)
+            generated[name] = ["bytes": bytes.count,
+                               "sha256": SHA256.hash(data: bytes).map { String(format: "%02x", $0) }.joined()]
+        }
+        let record: [String: Any] = ["schema": 1, "library": library.rawValue,
+            "sourceDirectory": directoryURL.path, "selector": library.version,
+            "platform": platform.rawValue, "arch": arch.rawValue,
+            "configureArguments": args, "makeArguments": makeArgs, "environment": env,
+            "buildDirectory": buildURL.path, "prefix": thinDir(platform: platform, arch: arch).path,
+            "generatedConfiguration": generated, "compiled": true, "installed": true]
+        try JSONSerialization.data(withJSONObject: record, options: [.sortedKeys, .prettyPrinted])
+            .write(to: recordURL, options: .withoutOverwriting)
+    }
+}
