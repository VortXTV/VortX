+        NSError(domain: "VortX.MPVKit.Pin", code: 1,
+                userInfo: [NSLocalizedDescriptionKey: message])
+    }
+
+    private static func output(_ command: String, in directoryURL: URL) throws -> String {
+        // Utility.shell returns an empty string on success unless isOutput is true. Every
+        // validation command below consumes stdout, so keep that flag explicit rather than
+        // accidentally treating a successful command as missing state.
+        guard let value = Utility.shell(command, isOutput: true, currentDirectoryURL: directoryURL) else {
+            throw failure("git command failed in \(directoryURL.path): \(command)")
+        }
+        return value.trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+
+    private static func succeeds(_ command: String, in directoryURL: URL) -> Bool {
+        Utility.shell(command, isOutput: true, currentDirectoryURL: directoryURL) != nil
+    }
+
+    private static func patchFiles(for library: Library) throws -> [String] {
+        let patchDirectory = URL.currentDirectory + "../Sources/BuildScripts/patch/\(library.rawValue)"
+        guard FileManager.default.fileExists(atPath: patchDirectory.path) else { return [] }
+        return try FileManager.default.contentsOfDirectory(atPath: patchDirectory.path)
+            .filter { $0.hasSuffix(".patch") }
+            .sorted()
+            .map { (patchDirectory + $0).path }
+    }
+
+    private static func approvedPaths(for patchPaths: [String], in directoryURL: URL) throws -> Set<String> {
+        let quotedPatches = patchPaths.map { "'\($0)'" }.joined(separator: " ")
+        let command = """
+        set -euo pipefail
+        for patch in \(quotedPatches); do
+            awk '
+                /^--- / || /^\\+\\+\\+ / {
+                    path=$2
+                    sub(/^a\\//, "", path)
+                    sub(/^b\\//, "", path)
+                    if (path != "/dev/null") print path
+                }
+            ' "$patch"
+        done | LC_ALL=C sort -u
+        """
+        let paths = try output(command, in: directoryURL)
+        return Set(paths.split(separator: "\n", omittingEmptySubsequences: true).map(String.init))
+    }
+
+    private static func validateStatus(_ status: String, approvedPaths: Set<String>, in directoryURL: URL) throws {
+        for line in status.split(separator: "\n", omittingEmptySubsequences: true).map(String.init) {
+            guard line.count >= 3 else {
+                throw failure("pinned checkout at \(directoryURL.path) has malformed Git status: \(line)")
+            }
+            let code = String(line.prefix(2))
+            let path = String(line.dropFirst(3))
+            guard !path.contains(" -> ") else {
+                throw failure("pinned checkout at \(directoryURL.path) has an unsupported rename status: \(line)")
+            }
+            guard approvedPaths.contains(path) else {
+                throw failure("pinned checkout at \(directoryURL.path) has dirty path not owned by the approved patch set: \(path)")
+            }
+            guard code == " M" || code == " D" || code == "??" else {
+                throw failure("pinned checkout at \(directoryURL.path) has unsupported Git status \(line)")
+            }
+        }
+    }
+
+    private static func matchesExactPatchTree(_ patchPaths: [String], in directoryURL: URL) -> Bool {
+        // A reverse `git apply --check` proves only that each patch's hunks can be removed. It
+        // does not prove that another edit was not made in the same file. Compare every tracked
+        // path with a clean HEAD archive after applying the approved patch set instead.
+        let quotedPatches = patchPaths
+            .map { "'\($0)'" }
+            .joined(separator: " ")
+        let command = """
+        set -euo pipefail
+        temporary=$(mktemp -d)
+        trap 'rm -rf \"$temporary\"' EXIT
+        git archive HEAD | tar -x -C \"$temporary\"
+        for patch in \(quotedPatches); do
+            (cd \"$temporary\" && git apply --unsafe-paths \"$patch\")
+        done
+        while IFS= read -r path; do
+            [ -f \"$temporary/$path\" ] || [ -L \"$temporary/$path\" ]
+            cmp -s \"$temporary/$path\" \"$path\" || {
+                echo \"approved patch tree mismatch: $path\" >&2
+                exit 1
+            }
+        done < <(find \"$temporary\" \\( -type f -o -type l \\) -print | sed \"s#^$temporary/##\")
+        while IFS= read -r path; do
+            [ -f \"$temporary/$path\" ] || [ -L \"$temporary/$path\" ]
+            cmp -s \"$temporary/$path\" \"$path\" || {
+                echo \"approved patch tree mismatch: $path\" >&2
+                exit 1
+            }
+        done < <(git ls-files -co --exclude-standard)
+        """
+        return succeeds(command, in: directoryURL)
+    }
+
+    private static func validateExisting(url directoryURL: URL, sha: String, library: Library) throws {
+        let head = try output("git rev-parse HEAD", in: directoryURL)
+        guard head == sha else {
+            throw failure("pinned checkout at \(directoryURL.path) is \(head), expected \(sha); refusing to switch it")
+        }
+        guard succeeds("git diff --cached --quiet", in: directoryURL) else {
+            throw failure("pinned checkout at \(directoryURL.path) has staged changes; refusing to reuse it")
+        }
+        // Preserve the leading porcelain status column. The generic output helper trims spaces,
+        // which would turn ` M path` into `M path` and corrupt the path extraction below.
+        guard let statusOutput = Utility.shell(
+            "git status --porcelain --untracked-files=all",
+            isOutput: true,
+            currentDirectoryURL: directoryURL
+        ) else {
+            throw failure("git status failed in \(directoryURL.path)")
+        }
+        let status = statusOutput.trimmingCharacters(in: .newlines)
+        guard !status.isEmpty else { return }
+
+        // A prior build may have applied MPVKit's exact library patch set before an interrupted
+        // compile. Permit only that explicit state; arbitrary tracked edits and partial/conflicting
+        // patch applications must stop rather than being repaired by a reset or checkout.
+        let patchPaths = try patchFiles(for: library)
+        guard !patchPaths.isEmpty else {
+            throw failure("pinned checkout at \(directoryURL.path) is dirty and has no known patch set to validate")
+        }
+        let approvedPaths = try approvedPaths(for: patchPaths, in: directoryURL)
+        try validateStatus(status, approvedPaths: approvedPaths, in: directoryURL)
+        guard matchesExactPatchTree(patchPaths, in: directoryURL) else {
+            throw failure("pinned checkout at \(directoryURL.path) has a conflicting, partial, or unrelated change; only the exact approved patch set may be reused")
+        }
+    }
+
+    static func clonePinned(url: String, sha: String, branch: String? = nil, initializeSubmodules: Bool = true, library: Library, into directoryURL: URL) throws {
+        if FileManager.default.fileExists(atPath: directoryURL.path) {
+            guard FileManager.default.fileExists(atPath: directoryURL.appendingPathComponent(".git").path) else {
+                throw failure("pinned source path exists but is not a Git checkout: \(directoryURL.path)")
+            }
+            try validateExisting(url: directoryURL, sha: sha, library: library)
+            return
+        }
+        // Fetch the exact commit explicitly. `branch` is required when the pin lives on a
+        // maintenance branch (FFmpeg release/9.0), because a default-branch clone need not contain
+        // that commit at any depth.
+        var cloneArgs = ["-c", "advice.detachedHead=false", "clone", "--no-checkout", "--depth", "150"]
+        if let branch {
+            cloneArgs += ["--branch", branch]
+        }
+        cloneArgs += [url, directoryURL.path]
+        try Utility.launch(path: "/usr/bin/git", arguments: cloneArgs)
+        try Utility.launch(path: "/usr/bin/git",
+                           arguments: ["fetch", "--quiet", "--depth", "1", "origin", sha],
+                           currentDirectoryURL: directoryURL)
+        try Utility.launch(path: "/usr/bin/git",
+                           arguments: ["-c", "advice.detachedHead=false", "checkout", "--detach", sha],
+                           currentDirectoryURL: directoryURL)
+        if initializeSubmodules {
+            try Utility.launch(path: "/usr/bin/git",
+                               arguments: ["submodule", "update", "--init", "--recursive", "--depth", "1"],
+                               currentDirectoryURL: directoryURL)
+        }
+        let head = try output("git rev-parse HEAD", in: directoryURL)
+        guard head == sha else {
+            throw failure("fresh clone at \(directoryURL.path) resolved to \(head), expected exact pin \(sha)")
+        }
+    }
+
+    static func applyPatches(for library: Library, in directoryURL: URL) throws {
+        let patchPaths = try patchFiles(for: library)
+        for patchPath in patchPaths {
+            // Idempotent only for an exact patch: apply forward when clean, skip when reverse-check
+            // proves it is already applied, and fail with context for a partial/conflicting state.
+            if succeeds("git apply --check \"\(patchPath)\"", in: directoryURL) {
+                try Utility.launch(path: "/usr/bin/git",
+                                   arguments: ["apply", patchPath],
+                                   currentDirectoryURL: directoryURL)
+            } else if succeeds("git apply --reverse --check \"\(patchPath)\"", in: directoryURL) {
+                continue
+            } else {
+                throw failure("patch neither applies cleanly nor is already applied: \(patchPath) in \(directoryURL.path)")
+            }
+        }
+    }
+}
