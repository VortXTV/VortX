+bool stream_reference_sent_request_copy_transport(
+    const struct stream_reference_sent_request *request,
+    struct avpriv_vortx_http_transport *out)
+{
+    if (!out || out->version || out->route || out->tls_backend || out->tls_policy ||
+        stream_reference_sent_request_cancelled(request) ||
+        request->sent.transport.version != VORTX_HTTP_TRANSPORT_VERSION)
+        return false;
+    struct avpriv_vortx_http_transport copy = request->sent.transport;
+    if (stream_reference_sent_request_cancelled(request))
+        return false;
+    *out = copy;
+    return true;
+}
