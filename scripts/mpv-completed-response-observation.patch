+// Owned, native-only completed-response HEADER observation. This does not turn
+// the retained INITIAL_REQUEST_ONLY lease into current-request/reader authority.
+// In particular, post-response learned cookies are not the headers sent on wire.
+struct stream_reference_observation;
+struct stream_reference_observation_values {
+    char *etag;
+    char *location;
+    int64_t response_generation;
+    int64_t source_generation;
+    uint64_t source_epoch;
+};
+
+// OWNER-ONLY, while s and its AVIO are alive and no source I/O can intervene.
+// Reads public AVOptions and owns every returned string; performs no I/O. Require
+// a finite absolute mp_time_ns deadline >now and at most30s ahead. out must be
+// NULL; failure never replaces an existing owning output or affects playback.
+// Missing/empty metadata, old producers, zero/exhausted tokens, cancellation,
+// source changes and allocation failure all return unavailable.
+// This is intentionally not connected to a demux/public command or a reader.
+bool stream_reference_source_observe_response(
+    struct stream *s, int64_t deadline_ns,
+    struct stream_reference_observation **out);
+
+// OWNER-ONLY, under the same stream/AVIO ownership discipline. Requires the exact
+// retained source object/generation/epoch and the same current response token
+// AND pair. Certifies only this owner instant; later publication still needs its
+// original owner/load/track/request fences. No URL/ETag equality substitutes for
+// a token. This never opens, reads, seeks, refreshes or mutates the live source.
+bool stream_reference_source_revalidate_observation(
+    struct stream *s, const struct stream_reference_observation *observation);
+
+// A move-only observation may cross to a worker; keep it alive through every
+// use and release once. Cancellation checks only the retained original source
+// observer/epoch plus deadline, never current AVIO metadata. Owner revalidation
+// remains mandatory. Values are owned copies, NOT a current-request capability;
+// URLs/tokens/credentials must not be logged, persisted or sent through Swift.
+bool stream_reference_observation_cancelled(
+    const struct stream_reference_observation *observation);
+// copy_values requires out initialized to {0} (or cleared). Existing owned
+// strings are refused; failure leaves out unchanged. Clear successful owning
+// outputs with values_clear before reusing them. Values are not a capability.
+bool stream_reference_observation_copy_values(
+    const struct stream_reference_observation *observation,
+    struct stream_reference_observation_values *out);
+void stream_reference_observation_values_clear(
+    struct stream_reference_observation_values *values);
+void stream_reference_observation_release(
+    struct stream_reference_observation **observation);
