+int avpriv_vortx_reference_revalidate_v1(
+    AVIOContext *owner, const struct avpriv_vortx_http_sent_request *expected,
+    size_t expected_size, const struct avpriv_vortx_reference_recipe *recipe)
+{
+    struct avpriv_vortx_http_sent_request current = {0};
+    struct sockaddr_storage peer, local;
+    socklen_t peer_len, local_len;
+    URLContext *h;
+    HTTPContext *s;
+    int ret;
+    if (expected_size != sizeof(*expected))
+        return AVERROR(EINVAL);
+    if (!expected || !recipe || !http_reference_sent_equal(expected, &recipe->sent))
+        return AVERROR(EINVAL);
+    ret = avpriv_vortx_http_copy_sent_request_v2(owner,
+                                               expected->response_generation,
+                                               &current);
+    if (ret < 0)
+        return ret;
+    ret = AVERROR(EAGAIN);
+    h = ffio_geturlcontext(owner); /* exact protocol/class/size checked above */
+    s = h->priv_data;
+    if (!h->vortx_reference_pin &&
+        recipe->lifetime == s->reference_lifetime &&
+        avpriv_vortx_reference_recipe_current(recipe) &&
+        http_reference_sent_equal(&current, &recipe->sent) &&
+        s->reference_original_total.generation == current.response_generation &&
+        s->reference_original_total.known == recipe->pin.entity_total_known &&
+        (!recipe->pin.entity_total_known ||
+         s->reference_original_total.value == recipe->pin.entity_total) &&
+        s->response_etag && !strcmp(s->response_etag, recipe->etag) &&
+        s->response_location && !strcmp(s->response_location, recipe->url) &&
+        http_reference_owner_peer(s, &peer, &peer_len, &local, &local_len) >= 0 &&
+        ff_vortx_reference_peer_equal(&recipe->pin.peer, recipe->pin.peer_len,
+                                      &peer, peer_len) &&
+        ff_vortx_reference_peer_equal(&recipe->pin.local, recipe->pin.local_len,
+                                      &local, local_len))
+        ret = 0;
+    avpriv_vortx_http_sent_request_clear_v2(&current);
+    return ret;
+}
+
+int avpriv_vortx_reference_capture_v1(
+    AVIOContext *owner, const struct avpriv_vortx_http_sent_request *expected,
+    size_t expected_size, const char *expected_etag, const char *prepared_url,
+    const AVDictionary *prepared_options, uint32_t max_bytes,
+    int64_t remaining_us, struct avpriv_vortx_reference_recipe **out)
+{
+    struct avpriv_vortx_reference_recipe *recipe = NULL;
+    struct avpriv_vortx_http_sent_request current = {0};
+    char *headers = NULL;
+    URLContext *h;
+    HTTPContext *s;
+    char proto[10], path[MAX_URL_SIZE];
+    int64_t now = av_gettime_relative();
+    int ret = AVERROR(EINVAL);
+    if (expected_size != sizeof(*expected))
+        return ret;
+    if (!expected || !out || *out || !max_bytes ||
+        max_bytes > VORTX_REFERENCE_READER_MAX_BYTES || remaining_us <= 0 ||
+        remaining_us > VORTX_REFERENCE_READER_MAX_US ||
+        now > INT64_MAX - remaining_us ||
+        !http_reference_strong_etag(expected_etag) ||
+        !http_response_location_valid(prepared_url))
+        return ret;
+    ret = avpriv_vortx_http_copy_sent_request_v2(owner,
+                                               expected->response_generation,
+                                               &current);
+    if (ret < 0)
+        goto done;
+    ret = AVERROR(EAGAIN);
+    h = ffio_geturlcontext(owner);
+    s = h->priv_data;
+    if (h->vortx_reference_pin || !http_reference_sent_equal(expected, &current) ||
+        !http_reference_transport_eligible(&current) ||
+        s->reference_original_total.generation != current.response_generation ||
+        strcmp(current.location, prepared_url) || !s->response_etag ||
+        strcmp(s->response_etag, expected_etag))
+        goto done;
+    headers = http_reference_prepared_headers(&current, expected_etag, max_bytes);
+    if (!headers || !http_reference_prepared_options(prepared_options, headers,
+                      max_bytes, remaining_us, !strncmp(prepared_url, "https://", 8)))
+        goto done;
+    recipe = av_mallocz(sizeof(*recipe));
+    if (!recipe) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+    recipe->sent = current;
+    current = (struct avpriv_vortx_http_sent_request){0};
+    recipe->lifetime = http_reference_lifetime_retain(s->reference_lifetime);
+    if (!recipe->lifetime) {
+        ret = AVERROR(EAGAIN);
+        goto done;
+    }
+    recipe->etag = av_strdup(expected_etag);
+    recipe->url = av_strdup(prepared_url);
+    ret = av_dict_copy(&recipe->options, prepared_options, 0);
+    if (!recipe->etag || !recipe->url || ret < 0) {
+        ret = AVERROR(ENOMEM);
+        goto done;
+    }
+    av_url_split(proto, sizeof(proto), NULL, 0,
+                 recipe->pin.hostname, sizeof(recipe->pin.hostname),
+                 &recipe->pin.port, path, sizeof(path), recipe->url);
+    if (recipe->pin.port < 0)
+        recipe->pin.port = !strcmp(proto, "https") ? 443 : 80;
+    recipe->pin.transport = recipe->sent.transport;
+    recipe->pin.etag = recipe->etag;
+    recipe->pin.max_bytes = max_bytes;
+    recipe->pin.entity_total_known = s->reference_original_total.known;
+    recipe->pin.entity_total = s->reference_original_total.value;
+    recipe->deadline_us = now + remaining_us;
+    ret = http_reference_owner_peer(s, &recipe->pin.peer, &recipe->pin.peer_len,
+                                     &recipe->pin.local, &recipe->pin.local_len);
+    if (ret < 0 || (ret = avpriv_vortx_reference_revalidate_v1(
+                            owner, expected, expected_size, recipe)) < 0)
+        goto done;
+    *out = recipe;
+    recipe = NULL;
+    ret = 0;
+done:
+    av_free(headers);
+    avpriv_vortx_http_sent_request_clear_v2(&current);
+    avpriv_vortx_reference_recipe_release_v1(&recipe);
+    return ret;
+}
+
+/* Private raw CRLF and byte-budget enforcement, before every header byte.
+ * Normal HTTP keeps its existing parser. No body prefetch or huge buffer. */
+static int http_reference_line(HTTPContext *s, char *line, size_t size,
+                               unsigned *header_bytes)
+{
+    size_t n = 0;
+    for (;;) {
+        unsigned char c;
+        int ret;
+        if (*header_bytes >= VORTX_REFERENCE_HEADER_MAX)
+            return AVERROR(ENOBUFS);
+        ret = ffurl_read(s->hd, &c, 1);
+        if (ret != 1)
+            return ret < 0 && ret != AVERROR_EOF ? ret : AVERROR_INVALIDDATA;
+        ++*header_bytes;
+        if (c == '\r') {
+            if (*header_bytes >= VORTX_REFERENCE_HEADER_MAX)
+                return AVERROR(ENOBUFS);
+            ret = ffurl_read(s->hd, &c, 1);
+            if (ret != 1 || c != '\n')
+                return ret < 0 && ret != AVERROR_EOF ? ret : AVERROR_INVALIDDATA;
+            ++*header_bytes;
+            line[n] = 0;
+            return 0;
+        }
+        if (c == '\n' || !c || c == 0x7f || (c < 0x20 && c != '\t') ||
+            n + 1 >= size)
+            return AVERROR_INVALIDDATA;
+        line[n++] = c;
+    }
+}
+
+static int http_reference_read_header(URLContext *h)
+{
+    HTTPContext *s = h->priv_data;
+    const struct FFVortXReferencePin *pin = h->vortx_reference_pin;
+    char line[MAX_URL_SIZE];
+    unsigned bytes = 0, etag_seen = 0, length_seen = 0, range_seen = 0;
+    unsigned encoding_seen = 0;
+    uint64_t length = 0, start = 0, end = 0, total = 0;
+    int ret;
+    s->reference_admitted = s->reference_complete_entity = 0;
+    if ((ret = http_reference_line(s, line, sizeof(line), &bytes)) < 0)
+        return ret;
+    if (!http_response_status_valid(line) ||
+        (memcmp(line + 9, "200", 3) && memcmp(line + 9, "206", 3)))
+        return AVERROR_INVALIDDATA;
+    s->http_code = line[11] == '0' ? 200 : 206;
+    for (;;) {
+        char *colon, *value, *last;
+        const char *p, *value_end;
+        size_t name_bytes;
+        if ((ret = http_reference_line(s, line, sizeof(line), &bytes)) < 0)
+            return ret;
+        if (!line[0])
+            break;
+        colon = strchr(line, ':');
+        if (!colon || colon == line)
+            return AVERROR_INVALIDDATA;
+        name_bytes = colon - line;
+        for (const unsigned char *c = (const unsigned char *)line;
+             c < (const unsigned char *)colon; c++) {
+            if (!((*c >= 'A' && *c <= 'Z') || (*c >= 'a' && *c <= 'z') ||
+                  (*c >= '0' && *c <= '9') || strchr("!#$%&'*+-.^_`|~", *c)))
+                return AVERROR_INVALIDDATA;
+        }
+        value = colon + 1;
+        while (*value == ' ' || *value == '\t')
+            value++;
+        last = value + strlen(value);
+        while (last > value && (last[-1] == ' ' || last[-1] == '\t'))
+            --last;
+        *last = 0;
+        if (http_reference_field(line, name_bytes, "ETag")) {
+            if (etag_seen++ || !http_reference_strong_etag(value) ||
+                strcmp(value, pin->etag))
+                return AVERROR_INVALIDDATA;
+        } else if (http_reference_field(line, name_bytes, "Content-Length")) {
+            if (length_seen++ || !http_reference_number(value, &length))
+                return AVERROR_INVALIDDATA;
+        } else if (http_reference_field(line, name_bytes, "Content-Range")) {
+            if (range_seen++ || strncmp(value, "bytes ", 6))
+                return AVERROR_INVALIDDATA;
+            p = value + 6;
+            value_end = value + strlen(value);
+            if (!http_reference_decimal(&p, value_end, &start) ||
+                p == value_end || *p++ != '-' ||
+                !http_reference_decimal(&p, value_end, &end) ||
+                p == value_end || *p++ != '/' ||
+                !http_reference_decimal(&p, value_end, &total) || p != value_end)
+                return AVERROR_INVALIDDATA;
+        } else if (http_reference_field(line, name_bytes, "Content-Encoding")) {
+            if (encoding_seen++ || av_strcasecmp(value, "identity"))
+                return AVERROR_INVALIDDATA;
+        } else if (http_reference_field(line, name_bytes, "Transfer-Encoding") ||
+                   http_reference_field(line, name_bytes, "Location") ||
+                   http_reference_field(line, name_bytes, "Icy-MetaInt") ||
+                   http_reference_field(line, name_bytes, "Trailer") ||
+                   (http_reference_field(line, name_bytes, "Content-Type") &&
+                    av_stristart(value, "multipart/", NULL))) {
+            return AVERROR_INVALIDDATA;
+        }
+    }
+    if (etag_seen != 1 || length_seen != 1 || length > pin->max_bytes ||
+        (s->http_code == 200 && range_seen) ||
+        (s->http_code == 206 && (range_seen != 1 || start != 0 ||
+         end < start || end >= pin->max_bytes || !total || end >= total ||
+         length != end + 1)))
+        return AVERROR_INVALIDDATA;
+    if (s->http_code == 200)
+        total = length;
+    if (pin->entity_total_known && total != pin->entity_total)
+        return AVERROR_INVALIDDATA;
+    s->reference_body_bytes = length;
+    s->reference_total_bytes = total;
+    s->reference_complete_entity = length == total;
+    s->reference_admitted = 1;
+    s->off = 0;
+    s->end_header = 1;
+    s->filesize = total;
+    s->range_end = length;
+    s->chunksize = UINT64_MAX;
+    return 0;
+}
+
+static int http_reference_interrupt(void *opaque)
+{
+    struct avpriv_vortx_reference_reader *reader = opaque;
+    return !avpriv_vortx_reference_recipe_current(reader->recipe) ||
+        av_gettime_relative() >= reader->recipe->deadline_us ||
+        (reader->owned_interrupt.callback && reader->owned_interrupt.callback(
+                                               reader->owned_interrupt.opaque));
+}
+
+void avpriv_vortx_reference_reader_close_v1(
+    struct avpriv_vortx_reference_reader **value)
+{
+    struct avpriv_vortx_reference_reader *reader;
+    if (!value || !(reader = *value))
+        return;
+    *value = NULL;
+    ffurl_closep(&reader->h); /* recipe and callback remain alive here */
+    av_free(reader);
+}
+
+int avpriv_vortx_reference_open_prefix_v1(
+    const struct avpriv_vortx_reference_recipe *recipe,
+    const AVIOInterruptCB *interrupt, struct avpriv_vortx_reference_reader **out)
+{
+    struct avpriv_vortx_reference_reader *reader = NULL;
+    AVDictionary *options = NULL;
+    AVIOInterruptCB callback;
+    HTTPContext *s;
+    int ret = AVERROR(EINVAL);
+    if (!recipe || !interrupt || !out || *out)
+        return ret;
+    reader = av_mallocz(sizeof(*reader));
+    if (!reader)
+        return AVERROR(ENOMEM);
+    reader->recipe = recipe;
+    reader->owned_interrupt = *interrupt;
+    if (http_reference_interrupt(reader)) {
+        ret = AVERROR_EXIT;
+        goto done;
+    }
+    callback = (AVIOInterruptCB){http_reference_interrupt, reader};
+    if ((ret = av_dict_copy(&options, recipe->options, 0)) < 0 ||
+        (ret = ffurl_alloc(&reader->h, recipe->url, AVIO_FLAG_READ, &callback)) < 0)
+        goto done;
+    reader->h->vortx_reference_pin = &recipe->pin;
+    /* Real alloc/options/connect path, with the recipe pin attached before
+     * HTTP can open TLS/TCP. No fabricated parent context or numeric URL. */
+    if ((ret = av_opt_set_dict(reader->h, &options)) < 0 ||
+        (ret = av_opt_set_dict(reader->h->priv_data, &options)) < 0 ||
+        (ret = ffurl_connect(reader->h, &options)) < 0)
+        goto done;
+    s = reader->h->priv_data;
+    if (!s->reference_admitted || !s->location || strcmp(s->location, recipe->url) ||
+        s->new_location || !http_reference_transport_matches(reader->h) ||
+        http_reference_interrupt(reader)) {
+        ret = AVERROR_INVALIDDATA;
+        goto done;
+    }
+    reader->declared_body_bytes = s->reference_body_bytes;
+    reader->complete_entity = s->reference_complete_entity;
+    *out = reader;
+    reader = NULL;
+    ret = 0;
+done:
+    av_dict_free(&options);
+    avpriv_vortx_reference_reader_close_v1(&reader);
+    return ret;
+}
+
+static int http_reference_terminal(struct avpriv_vortx_reference_reader *reader,
+                                   int error)
+{
+    if (error >= 0 || error == AVERROR_EOF)
+        error = AVERROR_INVALIDDATA;
+    reader->terminal_error = error;
+    return error;
+}
+
+int avpriv_vortx_reference_read_v1(struct avpriv_vortx_reference_reader *reader,
+                                  unsigned char *buffer, int buffer_size)
+{
+    uint64_t remaining;
+    HTTPContext *s;
+    int ret;
+    if (!reader)
+        return AVERROR(EINVAL);
+    if (reader->terminal_error)
+        return reader->terminal_error;
+    if (!buffer || buffer_size <= 0)
+        return http_reference_terminal(reader, AVERROR(EINVAL));
+    if (http_reference_interrupt(reader))
+        return http_reference_terminal(reader, AVERROR_EXIT);
+    if (reader->body_bytes > reader->declared_body_bytes ||
+        reader->body_bytes > reader->recipe->pin.max_bytes)
+        return http_reference_terminal(reader, AVERROR_INVALIDDATA);
+    remaining = reader->declared_body_bytes - reader->body_bytes;
+    if (!remaining) {
+        if (!reader->complete_entity)
+            return http_reference_terminal(reader, AVERROR(ENOBUFS));
+        reader->reached_entity_eof = 1;
+        return AVERROR_EOF; /* known complete entity framing, fully consumed */
+    }
+    if (reader->body_bytes == reader->recipe->pin.max_bytes)
+        return http_reference_terminal(reader, AVERROR(ENOBUFS));
+    buffer_size = FFMIN((uint64_t)buffer_size, remaining);
+    buffer_size = FFMIN((uint64_t)buffer_size,
+                        reader->recipe->pin.max_bytes - reader->body_bytes);
+    s = reader->h->priv_data;
+    ret = ffurl_read(s->hd, buffer, buffer_size);
+    if (ret <= 0)
+        return http_reference_terminal(reader, ret == AVERROR_EOF || !ret ?
+                                                AVERROR_INVALIDDATA : ret);
+    if (ret > buffer_size)
+        return http_reference_terminal(reader, AVERROR_INVALIDDATA);
+    reader->body_bytes += ret;
+    if (http_reference_interrupt(reader))
+        return http_reference_terminal(reader, AVERROR_EXIT);
+    return ret;
+}
+
+int avpriv_vortx_reference_stats_v1(
+    const struct avpriv_vortx_reference_reader *reader,
+    struct avpriv_vortx_reference_stats *out, size_t out_size)
+{
+    if (out_size != sizeof(*out))
+        return AVERROR(EINVAL);
+    if (!reader || !out || out->body_bytes || out->max_bytes ||
+        out->complete_entity || out->reached_entity_eof || out->terminal_error)
+        return AVERROR(EINVAL);
+    *out = (struct avpriv_vortx_reference_stats){
+        .body_bytes = reader->body_bytes,
+        .max_bytes = reader->recipe->pin.max_bytes,
+        .complete_entity = reader->complete_entity,
+        .reached_entity_eof = reader->reached_entity_eof,
+        .terminal_error = reader->terminal_error,
+    };
+    return 0;
+}
diff --git a/libavformat/vortx_reference_pin.h b/libavformat/vortx_reference_pin.h
new file mode 100644
--- /dev/null
+++ b/libavformat/vortx_reference_pin.h
@@ -0,0 +1,104 @@
+/* VortX source-private finite reader pin. SOURCE PROPOSAL, UNCOMPILED/UNRUN.
+ * No public option/symbol or global destination policy. The owning immutable
+ * recipe outlives all synchronous contexts borrowing this structure. */
+#ifndef AVFORMAT_VORTX_REFERENCE_PIN_H
+#define AVFORMAT_VORTX_REFERENCE_PIN_H
+
+#include <string.h>
+#include "network.h"
+struct avpriv_vortx_reference_sparse_reader;
+
+struct FFVortXReferencePin {
+    char hostname[1024];
+    int port;
+    struct sockaddr_storage peer;
+    socklen_t peer_len;
+    struct sockaddr_storage local;
+    socklen_t local_len;
+    struct avpriv_vortx_http_transport transport;
+    const char *etag;
+    uint32_t max_bytes;
+    int entity_total_known;
+    uint64_t entity_total;
+    /* NULL for the validated prefix API. A sparse open borrows this one
+     * worker-owned handle only through synchronous nested open/read/close;
+     * its copied request plan is immutable, its shared budget is worker-only. */
+    struct avpriv_vortx_reference_sparse_reader *sparse;
+};
+
+static inline int ff_vortx_reference_peer_valid(
+    const struct sockaddr_storage *peer, socklen_t peer_len)
+{
+    if (!peer || peer_len < sizeof(peer->ss_family) || peer_len > sizeof(*peer))
+        return 0;
+    if (peer->ss_family == AF_INET) {
+        const struct sockaddr_in *v4;
+        if (peer_len != sizeof(struct sockaddr_in))
+            return 0;
+        v4 = (const struct sockaddr_in *)peer;
+        return v4->sin_port != 0;
+    }
+#if HAVE_STRUCT_SOCKADDR_IN6
+    if (peer->ss_family == AF_INET6) {
+        const struct sockaddr_in6 *v6;
+        if (peer_len != sizeof(struct sockaddr_in6))
+            return 0;
+        v6 = (const struct sockaddr_in6 *)peer;
+        return v6->sin6_port != 0;
+    }
+#endif
+    return 0;
+}
+
+static inline int ff_vortx_reference_peer_equal(
+    const struct sockaddr_storage *a, socklen_t a_len,
+    const struct sockaddr_storage *b, socklen_t b_len)
+{
+    if (!ff_vortx_reference_peer_valid(a, a_len) ||
+        !ff_vortx_reference_peer_valid(b, b_len) ||
+        a->ss_family != b->ss_family)
+        return 0;
+    if (a->ss_family == AF_INET) {
+        const struct sockaddr_in *a4 = (const struct sockaddr_in *)a;
+        const struct sockaddr_in *b4 = (const struct sockaddr_in *)b;
+        return a4->sin_port == b4->sin_port &&
+               a4->sin_addr.s_addr == b4->sin_addr.s_addr;
+    }
+#if HAVE_STRUCT_SOCKADDR_IN6
+    if (a->ss_family == AF_INET6) {
+        const struct sockaddr_in6 *a6 = (const struct sockaddr_in6 *)a;
+        const struct sockaddr_in6 *b6 = (const struct sockaddr_in6 *)b;
+        return a6->sin6_port == b6->sin6_port &&
+               a6->sin6_scope_id == b6->sin6_scope_id &&
+               !memcmp(&a6->sin6_addr, &b6->sin6_addr, sizeof(a6->sin6_addr));
+    }
+#endif
+    return 0;
+}
+
+/* Kernel source endpoint equality, excluding the per-open ephemeral port.
+ * This proves no physical interface, route, namespace or VPN affinity. */
+static inline int ff_vortx_reference_local_equal(
+    const struct sockaddr_storage *a, socklen_t a_len,
+    const struct sockaddr_storage *b, socklen_t b_len)
+{
+    if (!ff_vortx_reference_peer_valid(a, a_len) ||
+        !ff_vortx_reference_peer_valid(b, b_len) ||
+        a->ss_family != b->ss_family)
+        return 0;
+    if (a->ss_family == AF_INET) {
+        const struct sockaddr_in *a4 = (const struct sockaddr_in *)a;
+        const struct sockaddr_in *b4 = (const struct sockaddr_in *)b;
+        return a4->sin_addr.s_addr == b4->sin_addr.s_addr;
+    }
+#if HAVE_STRUCT_SOCKADDR_IN6
+    if (a->ss_family == AF_INET6) {
+        const struct sockaddr_in6 *a6 = (const struct sockaddr_in6 *)a;
+        const struct sockaddr_in6 *b6 = (const struct sockaddr_in6 *)b;
+        return a6->sin6_scope_id == b6->sin6_scope_id &&
+               !memcmp(&a6->sin6_addr, &b6->sin6_addr, sizeof(a6->sin6_addr));
+    }
+#endif
+    return 0;
+}
+#endif
diff --git a/libavformat/vortx_reference_reader_stream.h b/libavformat/vortx_reference_reader_stream.h
new file mode 100644
--- /dev/null
+++ b/libavformat/vortx_reference_reader_stream.h
@@ -0,0 +1,97 @@
+/* Proposed source-private matched-component API; UNCOMPILED/UNRUN.
+ * No public Swift/AVOption API and no current reader activation. */
+#ifndef VORTX_PRIVATE_REFERENCE_READER_STREAM_H
+#define VORTX_PRIVATE_REFERENCE_READER_STREAM_H
+#include <stddef.h>
+#include <stdint.h>
+#include <libavformat/avio.h>
+#include <libavutil/dict.h>
+#include "vortx_http_request.h"
+
+#define VORTX_REFERENCE_READER_MAX_BYTES (128u * 1024u * 1024u)
+#define VORTX_REFERENCE_READER_MAX_US 30000000LL
+
+struct avpriv_vortx_reference_recipe;
+struct avpriv_vortx_reference_reader;
+struct avpriv_vortx_reference_stats {
+    uint64_t body_bytes;
+    uint32_t max_bytes;
+    int complete_entity;       /* admitted response covers whole entity */
+    int reached_entity_eof;    /* true media EOF actually reached */
+    int terminal_error;        /* non-EOF failure; partial data is unusable */
+};
+
+/* Original live AVIO owner only, excluded from I/O/seek/replace/teardown.
+ * expected is its retained exact v2 snapshot. Prepared URL/options come only
+ * from stream_reference_source_prepare_prefix_request, not current globals.
+ * Own all copies plus actual connected direct peer; retain no live owner/FD/
+ * cancel/options. Require plain HTTP or supported default verified TLS; proxy,
+ * custom CA/identity/host override and numeric TLS stay unavailable until
+ * reproducible. This restricts optional alignment, never ordinary playback or
+ * user-chosen private/Tailscale destinations. No network I/O. NULL out only;
+ * failure changes nothing. Check expected_size BEFORE structure access. */
+int avpriv_vortx_reference_capture_v1(
+    struct AVIOContext *owner,
+    const struct avpriv_vortx_http_sent_request *expected, size_t expected_size,
+    const char *expected_etag, const char *prepared_url,
+    const struct AVDictionary *prepared_options, uint32_t max_bytes,
+    int64_t remaining_us, struct avpriv_vortx_reference_recipe **out);
+
+/* Same original-owner exclusion. Compare current exact sent response, source
+ * peer, transport policy and strong validator; no network I/O. This remains
+ * only one part of final source/epoch/demux/selected-track/intent admission. */
+int avpriv_vortx_reference_revalidate_v1(
+    struct AVIOContext *owner,
+    const struct avpriv_vortx_http_sent_request *expected, size_t expected_size,
+    const struct avpriv_vortx_reference_recipe *recipe);
+
+/* Persistent publication-current check. Caller owns recipe throughout this
+ * call (publication/request lease remains retained until renderer quiescence).
+ * Read only the recipe's retained response-lifetime token; never borrow AVIO,
+ * socket, mutable options/job/result or an original owner pointer. Retirement
+ * is sticky and precedes original response/transport replacement or teardown.
+ * This has NO work-deadline expiry: the 30-second read limit is separate from
+ * how long a published timing map may remain valid. Returns 1 only while this
+ * exact original completed response is current, 0 after retirement/unavailable.
+ * Supported implementation requires compile-time always-lock-free atomic_uint
+ * and atomic_bool, bounded references, and matched target/build verification.
+ * Unsupported atomic policy or allocation/ref saturation disables optional
+ * capture only; it never alters normal HTTP playback. */
+int avpriv_vortx_reference_recipe_current(
+    const struct avpriv_vortx_reference_recipe *recipe);
+
+/* One utility worker only. The owned job keeps recipe and the callback's owned
+ * cancellation state alive until close. No borrowed original source pointer.
+ * Allocate a SMALL reader, never a max_bytes body buffer. Keep original URL,
+ * Host and SNI; enforce the captured numeric peer BEFORE connect/credentials.
+ * No DNS broadening, redirects, reconnects or nested requests. Validate exact
+ * conditional response/range/identity encoding and TLS before open succeeds.
+ * No request/URL/header/auth value may appear in new logs. */
+int avpriv_vortx_reference_open_prefix_v1(
+    const struct avpriv_vortx_reference_recipe *recipe,
+    const AVIOInterruptCB *interrupt,
+    struct avpriv_vortx_reference_reader **out);
+
+/* Incremental body reads only. Count actual returned bytes against max_bytes,
+ * enforce the same deadline/callback each time, and do not retry/reopen/seek.
+ * Return AVERROR_EOF only after an admitted COMPLETE ENTITY actually ends.
+ * EOF of a partial range or exhausted byte cap is an error, never media EOF.
+ * A failure invalidates every partial timing result. Caller must stop reading
+ * as soon as a useful complete timing prefix is obtained, then close. */
+int avpriv_vortx_reference_read_v1(
+    struct avpriv_vortx_reference_reader *reader,
+    unsigned char *buffer, int buffer_size);
+
+/* Worker-owned scalars only; out zeroed and exact size checked before access.
+ * Must be called before close. No readiness/permission is inferred from stats. */
+int avpriv_vortx_reference_stats_v1(
+    const struct avpriv_vortx_reference_reader *reader,
+    struct avpriv_vortx_reference_stats *out, size_t out_size);
+
+/* Close ALL new contexts before recipe/callback storage may be released.
+ * Never closes or interrupts the original playback AVIO/socket. */
+void avpriv_vortx_reference_reader_close_v1(
+    struct avpriv_vortx_reference_reader **reader);
+void avpriv_vortx_reference_recipe_release_v1(
+    struct avpriv_vortx_reference_recipe **recipe);
+#endif
diff --git a/libavformat/vortx_reference_sparse.h b/libavformat/vortx_reference_sparse.h
new file mode 100644
--- /dev/null
+++ b/libavformat/vortx_reference_sparse.h
@@ -0,0 +1,100 @@
+/* Source-private matched-component sparse HTTP API. SOURCE PROPOSAL ONLY;
+ * UNCOMPILED/UNRUN. This additive header preserves the adaeb9 prefix contract.
+ * Recipe remains opaque/native: no Swift/public option/serialized carrier. */
+#ifndef VORTX_PRIVATE_REFERENCE_SPARSE_H
+#define VORTX_PRIVATE_REFERENCE_SPARSE_H
+#include <stddef.h>
+#include <stdint.h>
+#include <libavformat/avio.h>
+
+#define VORTX_SPARSE_MAX_HTTP_BYTES (128u * 1024u * 1024u)
+#define VORTX_SPARSE_MAX_REQUESTS 256u
+#define VORTX_SPARSE_MAX_SPANS 1024u
+#define VORTX_SPARSE_MAX_SPAN_BYTES (1024u * 1024u)
+#define VORTX_SPARSE_MAX_BATCH_BYTES (4u * 1024u * 1024u)
+#define VORTX_SPARSE_MAX_RANGE_VALUE (32u * 1024u)
+
+struct avpriv_vortx_reference_recipe;
+struct avpriv_vortx_reference_sparse_budget;
+struct avpriv_vortx_reference_sparse_reader;
+struct avpriv_vortx_reference_sparse_span {
+    uint64_t start; /* absolute entity offset */
+    uint32_t bytes; /* 1..1MiB, end=start+bytes-1 checked before addition */
+};
+struct avpriv_vortx_reference_sparse_info {
+    uint64_t entity_bytes; /* known original total; never inferred from prefix */
+    uint64_t http_plaintext_bytes; /* outgoing request + ALL incoming HTTP */
+    uint32_t requests_started;
+    int active_handle;
+    int terminal_error;
+};
+struct avpriv_vortx_reference_sparse_part {
+    uint32_t plan_index;
+    uint64_t start;
+    uint32_t bytes;
+    uint64_t entity_bytes;
+};
+struct avpriv_vortx_reference_sparse_stats {
+    uint64_t payload_bytes;
+    uint32_t parts_complete;
+    int batch_validated; /* all parts, final delimiter, exact outer body length */
+    int terminal_error;
+};
+
+/* One worker owns budget and every handle, no concurrent budget operations.
+ * Create owns a complete immutable native recipe copy plus retained response
+ * lifetime token. Caller owns the input recipe throughout create; the budget
+ * retains no original owner/FD and thereafter owns its copy until release.
+ * Job owns callback storage until last close/budget release. Native publication
+ * ownership of the original recipe remains separate. Require known nonzero
+ * original total and current response lifetime. No network here. Inherit exact
+ * captured deadline, never renew30s or bytes/attempts on another open/close. */
+int avpriv_vortx_reference_sparse_budget_create_v1(
+    const struct avpriv_vortx_reference_recipe *recipe,
+    const AVIOInterruptCB *owned_interrupt,
+    struct avpriv_vortx_reference_sparse_budget **out);
+int avpriv_vortx_reference_sparse_budget_info_v1(
+    const struct avpriv_vortx_reference_sparse_budget *budget,
+    struct avpriv_vortx_reference_sparse_info *out, size_t out_size);
+
+/* Validate count<=1024 BEFORE multiplication/access; spans_size must exactly
+ * match. Copy ascending nonoverlapping spans, every end below original total.
+ * Each<=1MiB, sum<=4MiB; Range value<=32KiB and whole request still bounded.
+ * One active handle. Charge attempt before connection, request bytes before
+ * write and every received HTTP byte before read. 256attempts/128MiB shared.
+ * One span requires exact single206. Multiple require strict multipart206.
+ * Original URL/Host/SNI, credentials, strongETag, knownTOTAL, pinned endpoints
+ * and supported verified TLS remain exact. No redirect/retry/reconnect/seek. */
+int avpriv_vortx_reference_sparse_open_v1(
+    struct avpriv_vortx_reference_sparse_budget *budget,
+    const struct avpriv_vortx_reference_sparse_span *spans,
+    size_t spans_size, uint32_t span_count,
+    struct avpriv_vortx_reference_sparse_reader **out);
+
+/* All output structures must be cleared; exact out_size checked before access.
+ * 1=next strict admitted part header; 0=ENTIRE batch framing validated;
+ * negative=sticky operation failure. Prior part must be fully drained.
+ * A zero result is NEVER media EOF. No unrequested/coalesced/reordered parts. */
+int avpriv_vortx_reference_sparse_next_part_v1(
+    struct avpriv_vortx_reference_sparse_reader *reader,
+    struct avpriv_vortx_reference_sparse_part *out, size_t out_size);
+/* Positive current-part payload bytes; zero=current exact part drained;
+ * negative=sticky failure. Payload stays tentative until entire batch validates.
+ * Every operation checks current token, original deadline and owned callback.
+ * No binary boundary search, body-sized eager allocation, or synthetic holes. */
+int avpriv_vortx_reference_sparse_read_part_v1(
+    struct avpriv_vortx_reference_sparse_reader *reader,
+    unsigned char *buffer, int buffer_size);
+int avpriv_vortx_reference_sparse_stats_v1(
+    const struct avpriv_vortx_reference_sparse_reader *reader,
+    struct avpriv_vortx_reference_sparse_stats *out, size_t out_size);
+
+/* Close ALL duplicate contexts before recipe/callback release. An incomplete
+ * close invalidates the operation; bytes/attempts are never replenished.
+ * Budget release requires no active handle; misuse leaves budget owned and
+ * terminal rather than freeing storage underneath a live handle. */
+void avpriv_vortx_reference_sparse_close_v1(
+    struct avpriv_vortx_reference_sparse_reader **reader);
+void avpriv_vortx_reference_sparse_budget_release_v1(
+    struct avpriv_vortx_reference_sparse_budget **budget);
+#endif
diff --git a/libavformat/vortx_reference_sparse.inc b/libavformat/vortx_reference_sparse.inc
new file mode 100644
--- /dev/null
+++ b/libavformat/vortx_reference_sparse.inc
@@ -0,0 +1,820 @@
+/* SOURCE PROPOSAL ONLY, UNCOMPILED/UNRUN. Included immediately after the
+ * matched vortx_reference_reader.inc inside http.c. No public options/logs,
+ * borrowed original AVIO/FD, generic seek adapter, or media-EOF inference. */
+#include "vortx_reference_sparse.h"
+
+#define VORTX_SPARSE_OUTER_HEADERS (32u * 1024u)
+#define VORTX_SPARSE_PART_HEADERS (8u * 1024u)
+#define VORTX_SPARSE_BOUNDARY_MAX 70u
+
+struct avpriv_vortx_reference_sparse_budget {
+    struct avpriv_vortx_reference_recipe *recipe; /* owned immutable clone */
+    AVIOInterruptCB owned_interrupt;
+    struct avpriv_vortx_reference_sparse_reader *active;
+    uint64_t http_bytes;
+    uint32_t attempts;
+    int terminal_error;
+};
+
+struct avpriv_vortx_reference_sparse_reader {
+    struct avpriv_vortx_reference_sparse_budget *budget;
+    URLContext *h;
+    struct FFVortXReferencePin pin;
+    struct avpriv_vortx_reference_sparse_span spans[VORTX_SPARSE_MAX_SPANS];
+    uint32_t span_count;
+    uint32_t parts_complete;
+    uint64_t requested_bytes;
+    uint64_t outer_length;
+    uint64_t outer_read;
+    uint64_t payload_read;
+    uint32_t part_remaining;
+    char *range_value;
+    char *headers;
+    char boundary[VORTX_SPARSE_BOUNDARY_MAX + 1];
+    int request_charged;
+    int outer_admitted;
+    int multipart;
+    int part_active;
+    int batch_validated;
+};
+
+typedef struct HTTPVortXSparseReceipt {
+    uint64_t length, first, last, total;
+    unsigned lengths, ranges, etags, encodings, types;
+    char boundary[VORTX_SPARSE_BOUNDARY_MAX + 1];
+} HTTPVortXSparseReceipt;
+
+static int http_sparse_fail(struct avpriv_vortx_reference_sparse_budget *budget,
+                            int error)
+{
+    if (error >= 0 || error == AVERROR_EOF)
+        error = AVERROR_INVALIDDATA;
+    if (budget && !budget->terminal_error)
+        budget->terminal_error = error;
+    return budget && budget->terminal_error ? budget->terminal_error : error;
+}
+
+static int http_sparse_check(struct avpriv_vortx_reference_sparse_budget *budget)
+{
+    if (!budget)
+        return AVERROR(EINVAL);
+    if (budget->terminal_error)
+        return budget->terminal_error;
+    if (!avpriv_vortx_reference_recipe_current(budget->recipe) ||
+        av_gettime_relative() >= budget->recipe->deadline_us ||
+        (budget->owned_interrupt.callback && budget->owned_interrupt.callback(
+                                                 budget->owned_interrupt.opaque)))
+        return http_sparse_fail(budget, AVERROR_EXIT);
+    return 0;
+}
+
+static int http_sparse_interrupt(void *opaque)
+{
+    return http_sparse_check(opaque) < 0;
+}
+
+static int http_sparse_charge(struct avpriv_vortx_reference_sparse_budget *budget,
+                              uint64_t bytes)
+{
+    int ret = http_sparse_check(budget);
+    if (ret < 0)
+        return ret;
+    if (budget->http_bytes > VORTX_SPARSE_MAX_HTTP_BYTES ||
+        bytes > VORTX_SPARSE_MAX_HTTP_BYTES - budget->http_bytes)
+        return http_sparse_fail(budget, AVERROR(ENOBUFS));
+    budget->http_bytes += bytes;
+    return 0;
+}
+
+/* Reserve the maximum plaintext that this read can consume BEFORE calling the
+ * lower protocol. Release only the unused reservation; consumed bytes survive
+ * errors, cancellation, close and later requests. TLS wire overhead is not an
+ * HTTP plaintext byte and is not represented by this counter. */
+static int http_sparse_raw(struct avpriv_vortx_reference_sparse_reader *reader,
+                           unsigned char *buffer, int bytes, int body)
+{
+    struct avpriv_vortx_reference_sparse_budget *budget = reader->budget;
+    HTTPContext *s;
+    int ret;
+    if (bytes <= 0 || !buffer || !reader->h ||
+        !(s = reader->h->priv_data) || !s->hd)
+        return http_sparse_fail(budget, AVERROR(EINVAL));
+    if (body && (reader->outer_read > reader->outer_length ||
+                 (uint64_t)bytes > reader->outer_length - reader->outer_read))
+        return http_sparse_fail(budget, AVERROR_INVALIDDATA);
+    if ((ret = http_sparse_charge(budget, bytes)) < 0)
+        return ret;
+    ret = ffurl_read(s->hd, buffer, bytes);
+    if (ret <= 0 || ret > bytes) {
+        budget->http_bytes -= bytes; /* no accepted lower bytes consumed */
+        return http_sparse_fail(budget, ret <= 0 && ret != AVERROR_EOF ? ret :
+                                                               AVERROR_INVALIDDATA);
+    }
+    budget->http_bytes -= bytes - ret;
+    if (body)
+        reader->outer_read += ret;
+    if (http_sparse_check(budget) < 0)
+        return budget->terminal_error;
+    return ret;
+}
+
+static int http_sparse_literal(struct avpriv_vortx_reference_sparse_reader *reader,
+                               const char *text, size_t bytes)
+{
+    for (size_t n = 0; n < bytes; n++) {
+        unsigned char value;
+        int ret = http_sparse_raw(reader, &value, 1, 1);
+        if (ret < 0)
+            return ret;
+        if (value != (unsigned char)text[n])
+            return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    }
+    return 0;
+}
+
+/* Raw strict CRLF, read only at the next declared header/delimiter position.
+ * The parser never searches binary media for a MIME boundary. */
+static int http_sparse_line(struct avpriv_vortx_reference_sparse_reader *reader,
+                            char *line, size_t size, unsigned *used,
+                            unsigned limit, int body)
+{
+    size_t n = 0;
+    for (;;) {
+        unsigned char c;
+        int ret;
+        if (*used >= limit)
+            return http_sparse_fail(reader->budget, AVERROR(ENOBUFS));
+        if ((ret = http_sparse_raw(reader, &c, 1, body)) < 0)
+            return ret;
+        ++*used;
+        if (c == '\r') {
+            if (*used >= limit)
+                return http_sparse_fail(reader->budget, AVERROR(ENOBUFS));
+            if ((ret = http_sparse_raw(reader, &c, 1, body)) < 0)
+                return ret;
+            ++*used;
+            if (c != '\n')
+                return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+            line[n] = 0;
+            return 0;
+        }
+        if (c == '\n' || !c || c == 0x7f || (c < 0x20 && c != '\t') ||
+            n + 1 >= size)
+            return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+        line[n++] = c;
+    }
+}
+
+static int http_sparse_boundary_char(unsigned char c, int quoted)
+{
+    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+        (c >= '0' && c <= '9') || strchr("'+_-.", c))
+        return 1;
+    return quoted && strchr("(),/:=?", c) != NULL;
+}
+
+/* Deliberately small parameter grammar: one boundary, safe nonspace ASCII,
+ * no escapes, no extra parameters. Unsupported valid MIME remains optional. */
+static int http_sparse_boundary(const char *value, char *out)
+{
+    const char *p = value;
+    size_t n = 0;
+    int quoted;
+    if (av_strncasecmp(p, "multipart/byteranges", 20))
+        return 0;
+    p += 20;
+    while (*p == ' ' || *p == '\t')
+        p++;
+    if (*p++ != ';')
+        return 0;
+    while (*p == ' ' || *p == '\t')
+        p++;
+    if (av_strncasecmp(p, "boundary", 8))
+        return 0;
+    p += 8;
+    while (*p == ' ' || *p == '\t')
+        p++;
+    if (*p++ != '=')
+        return 0;
+    while (*p == ' ' || *p == '\t')
+        p++;
+    quoted = *p == '"';
+    if (quoted)
+        p++;
+    while (*p && (!quoted || *p != '"') && *p != ' ' && *p != '\t') {
+        if (n == VORTX_SPARSE_BOUNDARY_MAX ||
+            !http_sparse_boundary_char((unsigned char)*p, quoted))
+            return 0;
+        out[n++] = *p++;
+    }
+    if (!n || (quoted && *p++ != '"'))
+        return 0;
+    while (*p == ' ' || *p == '\t')
+        p++;
+    if (*p)
+        return 0;
+    out[n] = 0;
+    return 1;
+}
+
+static int http_sparse_range_value(const char *value,
+                                   HTTPVortXSparseReceipt *receipt)
+{
+    const char *p = value, *end = value + strlen(value);
+    if (end - p < 6 || memcmp(p, "bytes ", 6))
+        return 0;
+    p += 6;
+    return http_reference_decimal(&p, end, &receipt->first) &&
+        p < end && *p++ == '-' &&
+        http_reference_decimal(&p, end, &receipt->last) &&
+        p < end && *p++ == '/' &&
+        http_reference_decimal(&p, end, &receipt->total) && p == end &&
+        receipt->first <= receipt->last && receipt->last < receipt->total;
+}
+
+static int http_sparse_header_field(
+    struct avpriv_vortx_reference_sparse_reader *reader, char *line,
+    HTTPVortXSparseReceipt *receipt, int outer)
+{
+    char *colon = strchr(line, ':'), *value, *last;
+    size_t name_bytes;
+    if (!colon || colon == line)
+        return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    name_bytes = colon - line;
+    for (const unsigned char *p = (const unsigned char *)line;
+         p < (const unsigned char *)colon; p++) {
+        if (!((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') ||
+              (*p >= '0' && *p <= '9') || strchr("!#$%&'*+-.^_`|~", *p)))
+            return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    }
+    value = colon + 1;
+    while (*value == ' ' || *value == '\t')
+        value++;
+    last = value + strlen(value);
+    while (last > value && (last[-1] == ' ' || last[-1] == '\t'))
+        --last;
+    *last = 0;
+    if (http_reference_field(line, name_bytes, "ETag")) {
+        if (receipt->etags++ || !http_reference_strong_etag(value) ||
+            strcmp(value, reader->budget->recipe->etag))
+            return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    } else if (http_reference_field(line, name_bytes, "Content-Length")) {
+        if (receipt->lengths++ || !http_reference_number(value, &receipt->length))
+            return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    } else if (http_reference_field(line, name_bytes, "Content-Range")) {
+        if (receipt->ranges++ || !http_sparse_range_value(value, receipt))
+            return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    } else if (http_reference_field(line, name_bytes, "Content-Encoding")) {
+        if (receipt->encodings++ || av_strcasecmp(value, "identity"))
+            return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    } else if (http_reference_field(line, name_bytes, "Content-Type")) {
+        if (receipt->types++)
+            return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+        if (outer && reader->span_count > 1) {
+            if (!http_sparse_boundary(value, receipt->boundary))
+                return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+        } else if (av_stristart(value, "multipart/", NULL)) {
+            return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+        }
+    } else if (http_reference_field(line, name_bytes, "Transfer-Encoding") ||
+               http_reference_field(line, name_bytes, "Content-Transfer-Encoding") ||
+               http_reference_field(line, name_bytes, "Location") ||
+               http_reference_field(line, name_bytes, "Content-Location") ||
+               http_reference_field(line, name_bytes, "Trailer") ||
+               http_reference_field(line, name_bytes, "Icy-MetaInt") ||
+               http_reference_field(line, name_bytes, "Upgrade")) {
+        return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    }
+    return 0;
+}
+
+static int http_sparse_read_header(URLContext *h)
+{
+    HTTPContext *s = h->priv_data;
+    struct avpriv_vortx_reference_sparse_reader *reader =
+        h->vortx_reference_pin ? h->vortx_reference_pin->sparse : NULL;
+    HTTPVortXSparseReceipt receipt = {0};
+    char line[MAX_URL_SIZE];
+    unsigned used = 0;
+    int ret;
+    if (!reader || reader->h != h || !reader->request_charged ||
+        reader->outer_admitted || !http_reference_transport_matches(h))
+        return http_sparse_fail(reader ? reader->budget : NULL, AVERROR(EINVAL));
+    s->reference_admitted = s->reference_complete_entity = 0;
+    if ((ret = http_sparse_line(reader, line, sizeof(line), &used,
+                                VORTX_SPARSE_OUTER_HEADERS, 0)) < 0)
+        return ret;
+    if (!http_response_status_valid(line) || memcmp(line + 9, "206", 3))
+        return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    for (;;) {
+        if ((ret = http_sparse_line(reader, line, sizeof(line), &used,
+                                    VORTX_SPARSE_OUTER_HEADERS, 0)) < 0)
+            return ret;
+        if (!line[0])
+            break;
+        if ((ret = http_sparse_header_field(reader, line, &receipt, 1)) < 0)
+            return ret;
+    }
+    if (receipt.etags != 1 || receipt.lengths != 1 || !receipt.length)
+        return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    if (receipt.length > VORTX_SPARSE_MAX_HTTP_BYTES - reader->budget->http_bytes)
+        return http_sparse_fail(reader->budget, AVERROR(ENOBUFS));
+    if (reader->span_count == 1) {
+        const struct avpriv_vortx_reference_sparse_span *span = &reader->spans[0];
+        if (receipt.ranges != 1 || receipt.length != span->bytes ||
+            receipt.first != span->start ||
+            receipt.last != span->start + span->bytes - 1 ||
+            receipt.total != reader->pin.entity_total)
+            return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+        s->off = span->start;
+        s->range_end = span->start + span->bytes;
+    } else {
+        if (receipt.ranges || receipt.types != 1 || !receipt.boundary[0] ||
+            receipt.length <= reader->requested_bytes)
+            return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+        av_strlcpy(reader->boundary, receipt.boundary, sizeof(reader->boundary));
+        reader->multipart = 1;
+        s->off = s->range_end = 0;
+    }
+    reader->outer_length = receipt.length;
+    reader->outer_admitted = 1;
+    s->http_code = 206;
+    s->end_header = 1;
+    s->filesize = reader->pin.entity_total;
+    s->chunksize = UINT64_MAX;
+    s->reference_admitted = 1;
+    s->reference_body_bytes = receipt.length;
+    s->reference_total_bytes = reader->pin.entity_total;
+    return http_sparse_check(reader->budget);
+}
+
+static int http_sparse_before_request(URLContext *h, const char *wire, size_t bytes)
+{
+    struct avpriv_vortx_reference_sparse_reader *reader =
+        h->vortx_reference_pin ? h->vortx_reference_pin->sparse : NULL;
+    const char *line, *original_line;
+    size_t prefix, headers_bytes;
+    int ret;
+    if (!reader || reader->h != h || reader->request_charged ||
+        !http_sent_request_wire_valid(wire, bytes) ||
+        bytes > VORTX_HTTP_SENT_REQUEST_MAX_BYTES)
+        return http_sparse_fail(reader ? reader->budget : NULL, AVERROR(EINVAL));
+    line = strstr(wire, "\r\n");
+    original_line = strstr(reader->budget->recipe->sent.request, "\r\n");
+    if (!line || !original_line || line - wire !=
+        original_line - reader->budget->recipe->sent.request ||
+        memcmp(wire, reader->budget->recipe->sent.request, line - wire))
+        return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    prefix = line - wire + 2;
+    headers_bytes = strlen(reader->headers);
+    if (bytes < prefix || bytes - prefix != headers_bytes + 2 ||
+        memcmp(wire + prefix, reader->headers, headers_bytes) ||
+        memcmp(wire + prefix + headers_bytes, "\r\n", 2))
+        return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    if ((ret = http_sparse_charge(reader->budget, bytes)) < 0)
+        return ret;
+    /* Conservatively retain this reservation even on short/failed write.
+     * The parent hook rejects such writes and invalidates the whole budget. */
+    reader->request_charged = 1;
+    return 0;
+}
+
+static int http_sparse_after_request(URLContext *h)
+{
+    struct avpriv_vortx_reference_sparse_reader *reader =
+        h->vortx_reference_pin ? h->vortx_reference_pin->sparse : NULL;
+    if (!reader || reader->h != h || !reader->request_charged)
+        return http_sparse_fail(reader ? reader->budget : NULL, AVERROR(EINVAL));
+    return http_sparse_check(reader->budget);
+}
+
+static char *http_sparse_request_headers(
+    struct avpriv_vortx_reference_sparse_reader *reader)
+{
+    AVDictionaryEntry *entry = av_dict_get(reader->budget->recipe->options,
+                                          "headers", NULL, AV_DICT_MATCH_CASE);
+    AVBPrint range, headers;
+    const char *line, *end;
+    char *out = NULL;
+    unsigned replaced = 0;
+    if (!entry || strnlen(entry->value, VORTX_HTTP_SENT_REQUEST_MAX_BYTES + 1) >
+                  VORTX_HTTP_SENT_REQUEST_MAX_BYTES)
+        return NULL;
+    av_bprint_init(&range, 0, VORTX_SPARSE_MAX_RANGE_VALUE + 1);
+    av_bprintf(&range, "bytes=");
+    for (uint32_t n = 0; n < reader->span_count; n++) {
+        const struct avpriv_vortx_reference_sparse_span *span = &reader->spans[n];
+        av_bprintf(&range, "%s%"PRIu64"-%"PRIu64, n ? "," : "",
+                   span->start, span->start + span->bytes - 1);
+    }
+    if (!av_bprint_is_complete(&range) || range.len > VORTX_SPARSE_MAX_RANGE_VALUE) {
+        av_bprint_finalize(&range, NULL);
+        return NULL;
+    }
+    if (av_bprint_finalize(&range, &reader->range_value) < 0)
+        return NULL;
+    av_bprint_init(&headers, 0, VORTX_HTTP_SENT_REQUEST_MAX_BYTES);
+    line = entry->value;
+    end = line + strlen(line);
+    while (line < end) {
+        const char *next = strstr(line, "\r\n");
+        const char *colon = next ? memchr(line, ':', next - line) : NULL;
+        if (!next || !colon || colon == line)
+            goto fail;
+        if (http_reference_field(line, colon - line, "Range")) {
+            if (replaced++)
+                goto fail;
+            av_bprintf(&headers, "Range: %s\r\n", reader->range_value);
+        } else {
+            av_bprint_append_data(&headers, line, next - line + 2);
+        }
+        line = next + 2;
+    }
+    if (line != end || replaced != 1 || !av_bprint_is_complete(&headers))
+        goto fail;
+    if (av_bprint_finalize(&headers, &out) < 0) {
+        av_free(out);
+        return NULL;
+    }
+    return out;
+fail:
+    av_bprint_finalize(&headers, NULL);
+    return NULL;
+}
+
+static int http_sparse_recipe_clone(
+    const struct avpriv_vortx_reference_recipe *source,
+    struct avpriv_vortx_reference_recipe **out)
+{
+    struct avpriv_vortx_reference_recipe *copy;
+    int ret;
+    if (!avpriv_vortx_reference_recipe_current(source))
+        return AVERROR_EXIT;
+    copy = av_mallocz(sizeof(*copy));
+    if (!copy)
+        return AVERROR(ENOMEM);
+    copy->lifetime = http_reference_lifetime_retain(source->lifetime);
+    if (!copy->lifetime) {
+        ret = AVERROR_EXIT;
+        goto fail;
+    }
+    copy->pin = source->pin;
+    copy->pin.etag = NULL;
+    copy->pin.sparse = NULL;
+    copy->deadline_us = source->deadline_us;
+    copy->sent.request_bytes = source->sent.request_bytes;
+    copy->sent.response_generation = source->sent.response_generation;
+    copy->sent.version = source->sent.version;
+    copy->sent.transport = source->sent.transport;
+    copy->sent.location = av_strdup(source->sent.location);
+    copy->sent.request = av_strndup(source->sent.request, source->sent.request_bytes);
+    copy->etag = av_strdup(source->etag);
+    copy->url = av_strdup(source->url);
+    if (!copy->sent.location || !copy->sent.request || !copy->etag || !copy->url) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    copy->pin.etag = copy->etag;
+    if ((ret = av_dict_copy(&copy->options, source->options, 0)) < 0)
+        goto fail;
+    if (!avpriv_vortx_reference_recipe_current(copy)) {
+        ret = AVERROR_EXIT;
+        goto fail;
+    }
+    *out = copy;
+    return 0;
+fail:
+    avpriv_vortx_reference_recipe_release_v1(&copy);
+    return ret;
+}
+
+int avpriv_vortx_reference_sparse_budget_create_v1(
+    const struct avpriv_vortx_reference_recipe *recipe,
+    const AVIOInterruptCB *owned_interrupt,
+    struct avpriv_vortx_reference_sparse_budget **out)
+{
+    struct avpriv_vortx_reference_sparse_budget *budget;
+    if (!recipe || !owned_interrupt || !out || *out ||
+        !recipe->pin.entity_total_known || !recipe->pin.entity_total ||
+        recipe->pin.entity_total > INT64_MAX ||
+        !http_reference_transport_eligible(&recipe->sent) ||
+        !http_reference_strong_etag(recipe->etag) ||
+        !avpriv_vortx_reference_recipe_current(recipe) ||
+        av_gettime_relative() >= recipe->deadline_us)
+        return AVERROR(EINVAL);
+    budget = av_mallocz(sizeof(*budget));
+    if (!budget)
+        return AVERROR(ENOMEM);
+    {
+        int ret = http_sparse_recipe_clone(recipe, &budget->recipe);
+        if (ret < 0) {
+            av_free(budget);
+            return ret;
+        }
+    }
+    budget->owned_interrupt = *owned_interrupt;
+    if (http_sparse_check(budget) < 0) {
+        int ret = budget->terminal_error;
+        avpriv_vortx_reference_recipe_release_v1(&budget->recipe);
+        av_free(budget);
+        return ret;
+    }
+    *out = budget;
+    return 0;
+}
+
+int avpriv_vortx_reference_sparse_budget_info_v1(
+    const struct avpriv_vortx_reference_sparse_budget *budget,
+    struct avpriv_vortx_reference_sparse_info *out, size_t out_size)
+{
+    if (out_size != sizeof(*out))
+        return AVERROR(EINVAL);
+    if (!budget || !out || out->entity_bytes || out->http_plaintext_bytes ||
+        out->requests_started || out->active_handle || out->terminal_error)
+        return AVERROR(EINVAL);
+    *out = (struct avpriv_vortx_reference_sparse_info){
+        .entity_bytes = budget->recipe->pin.entity_total,
+        .http_plaintext_bytes = budget->http_bytes,
+        .requests_started = budget->attempts,
+        .active_handle = budget->active != NULL,
+        .terminal_error = budget->terminal_error,
+    };
+    return 0;
+}
+
+static void http_sparse_dispose(struct avpriv_vortx_reference_sparse_reader *reader)
+{
+    if (!reader)
+        return;
+    ffurl_closep(&reader->h); /* pin/recipe/budget/callback still alive */
+    if (reader->budget->active == reader)
+        reader->budget->active = NULL;
+    av_free(reader->range_value);
+    av_free(reader->headers);
+    av_free(reader);
+}
+
+int avpriv_vortx_reference_sparse_open_v1(
+    struct avpriv_vortx_reference_sparse_budget *budget,
+    const struct avpriv_vortx_reference_sparse_span *spans,
+    size_t spans_size, uint32_t span_count,
+    struct avpriv_vortx_reference_sparse_reader **out)
+{
+    struct avpriv_vortx_reference_sparse_reader *reader = NULL;
+    AVDictionary *options = NULL;
+    AVIOInterruptCB callback;
+    HTTPContext *s;
+    uint64_t previous_end = 0, total = 0;
+    int ret = http_sparse_check(budget);
+    if (ret < 0)
+        return ret;
+    if (!out || *out || !spans || budget->active || !span_count ||
+        span_count > VORTX_SPARSE_MAX_SPANS)
+        return http_sparse_fail(budget, AVERROR(EINVAL));
+    if (spans_size != (size_t)span_count * sizeof(*spans))
+        return http_sparse_fail(budget, AVERROR(EINVAL));
+    reader = av_mallocz(sizeof(*reader));
+    if (!reader)
+        return http_sparse_fail(budget, AVERROR(ENOMEM));
+    reader->budget = budget;
+    reader->span_count = span_count;
+    memcpy(reader->spans, spans, spans_size);
+    for (uint32_t n = 0; n < span_count; n++) {
+        const struct avpriv_vortx_reference_sparse_span *span = &reader->spans[n];
+        uint64_t end;
+        if (!span->bytes || span->bytes > VORTX_SPARSE_MAX_SPAN_BYTES ||
+            span->start >= budget->recipe->pin.entity_total ||
+            span->bytes > budget->recipe->pin.entity_total - span->start ||
+            total > VORTX_SPARSE_MAX_BATCH_BYTES - span->bytes) {
+            ret = http_sparse_fail(budget, AVERROR(EINVAL));
+            goto done;
+        }
+        end = span->start + span->bytes - 1;
+        if (n && span->start <= previous_end) {
+            ret = http_sparse_fail(budget, AVERROR(EINVAL));
+            goto done;
+        }
+        previous_end = end;
+        total += span->bytes;
+    }
+    reader->requested_bytes = total;
+    reader->pin = budget->recipe->pin;
+    reader->pin.sparse = reader;
+    reader->headers = http_sparse_request_headers(reader);
+    if (!reader->headers) {
+        ret = http_sparse_fail(budget, AVERROR(ENOMEM));
+        goto done;
+    }
+    if (budget->attempts >= VORTX_SPARSE_MAX_REQUESTS) {
+        ret = http_sparse_fail(budget, AVERROR(ENOBUFS));
+        goto done;
+    }
+    ++budget->attempts;
+    budget->active = reader;
+    callback = (AVIOInterruptCB){http_sparse_interrupt, budget};
+    if ((ret = av_dict_copy(&options, budget->recipe->options, 0)) < 0 ||
+        (ret = av_dict_set(&options, "headers", reader->headers, 0)) < 0 ||
+        (ret = av_dict_set_int(&options, "offset", span_count == 1 ?
+                                                    reader->spans[0].start : 0, 0)) < 0 ||
+        (ret = av_dict_set_int(&options, "end_offset", span_count == 1 ?
+                           reader->spans[0].start + reader->spans[0].bytes : 0, 0)) < 0 ||
+        (ret = ffurl_alloc(&reader->h, budget->recipe->url, AVIO_FLAG_READ, &callback)) < 0)
+        goto fail;
+    reader->h->vortx_reference_pin = &reader->pin;
+    if ((ret = av_opt_set_dict(reader->h, &options)) < 0 ||
+        (ret = av_opt_set_dict(reader->h->priv_data, &options)) < 0 ||
+        (ret = ffurl_connect(reader->h, &options)) < 0)
+        goto fail;
+    s = reader->h->priv_data;
+    if (!reader->outer_admitted || !s->location ||
+        strcmp(s->location, budget->recipe->url) || s->new_location ||
+        !http_reference_transport_matches(reader->h)) {
+        ret = AVERROR_INVALIDDATA;
+        goto fail;
+    }
+    if ((ret = http_sparse_check(budget)) < 0)
+        goto done;
+    *out = reader;
+    reader = NULL;
+    ret = 0;
+    goto done;
+fail:
+    ret = http_sparse_fail(budget, ret);
+done:
+    av_dict_free(&options);
+    http_sparse_dispose(reader);
+    return ret;
+}
+
+static int http_sparse_delimiter(
+    struct avpriv_vortx_reference_sparse_reader *reader, int closing)
+{
+    char expected[VORTX_SPARSE_BOUNDARY_MAX + 5];
+    char line[VORTX_SPARSE_BOUNDARY_MAX + 5];
+    unsigned used = 0;
+    int ret;
+    if ((ret = http_sparse_line(reader, line, sizeof(line), &used,
+                                sizeof(line) + 1, 1)) < 0)
+        return ret;
+    av_strlcpy(expected, "--", sizeof(expected));
+    av_strlcat(expected, reader->boundary, sizeof(expected));
+    if (closing)
+        av_strlcat(expected, "--", sizeof(expected));
+    if (strcmp(line, expected))
+        return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    return 0;
+}
+
+static int http_sparse_part_header(
+    struct avpriv_vortx_reference_sparse_reader *reader)
+{
+    HTTPVortXSparseReceipt receipt = {0};
+    const struct avpriv_vortx_reference_sparse_span *span =
+        &reader->spans[reader->parts_complete];
+    char line[VORTX_SPARSE_PART_HEADERS];
+    unsigned used = 0;
+    int ret;
+    for (;;) {
+        if ((ret = http_sparse_line(reader, line, sizeof(line), &used,
+                                    VORTX_SPARSE_PART_HEADERS, 1)) < 0)
+            return ret;
+        if (!line[0])
+            break;
+        if ((ret = http_sparse_header_field(reader, line, &receipt, 0)) < 0)
+            return ret;
+    }
+    if (receipt.ranges != 1 || receipt.first != span->start ||
+        receipt.last != span->start + span->bytes - 1 ||
+        receipt.total != reader->pin.entity_total ||
+        (receipt.lengths && receipt.length != span->bytes))
+        return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    return 0;
+}
+
+static int http_sparse_complete(
+    struct avpriv_vortx_reference_sparse_reader *reader)
+{
+    int ret;
+    if (reader->parts_complete != reader->span_count ||
+        reader->outer_read != reader->outer_length)
+        return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    if ((ret = http_sparse_check(reader->budget)) < 0)
+        return ret;
+    reader->batch_validated = 1;
+    return 0;
+}
+
+int avpriv_vortx_reference_sparse_next_part_v1(
+    struct avpriv_vortx_reference_sparse_reader *reader,
+    struct avpriv_vortx_reference_sparse_part *out, size_t out_size)
+{
+    int ret;
+    if (out_size != sizeof(*out))
+        return http_sparse_fail(reader ? reader->budget : NULL, AVERROR(EINVAL));
+    if (!reader || !out || out->plan_index || out->start || out->bytes ||
+        out->entity_bytes)
+        return http_sparse_fail(reader ? reader->budget : NULL, AVERROR(EINVAL));
+    if ((ret = http_sparse_check(reader->budget)) < 0)
+        return ret;
+    if (reader->batch_validated)
+        return 0;
+    if (!reader->outer_admitted || reader->parts_complete >= reader->span_count)
+        return http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    if (reader->part_active) {
+        if (reader->part_remaining)
+            return http_sparse_fail(reader->budget, AVERROR(EINVAL));
+        if (reader->multipart) {
+            if ((ret = http_sparse_literal(reader, "\r\n", 2)) < 0 ||
+                (ret = http_sparse_delimiter(reader,
+                         reader->parts_complete + 1 == reader->span_count)) < 0)
+                return ret;
+        }
+        reader->part_active = 0;
+        ++reader->parts_complete;
+        if (reader->parts_complete == reader->span_count)
+            return http_sparse_complete(reader);
+    } else if (reader->multipart) {
+        if ((ret = http_sparse_delimiter(reader, 0)) < 0)
+            return ret; /* first boundary only; no preamble scanning */
+    }
+    if (reader->multipart && (ret = http_sparse_part_header(reader)) < 0)
+        return ret;
+    reader->part_remaining = reader->spans[reader->parts_complete].bytes;
+    reader->part_active = 1;
+    *out = (struct avpriv_vortx_reference_sparse_part){
+        .plan_index = reader->parts_complete,
+        .start = reader->spans[reader->parts_complete].start,
+        .bytes = reader->part_remaining,
+        .entity_bytes = reader->pin.entity_total,
+    };
+    return 1;
+}
+
+int avpriv_vortx_reference_sparse_read_part_v1(
+    struct avpriv_vortx_reference_sparse_reader *reader,
+    unsigned char *buffer, int buffer_size)
+{
+    int ret;
+    if (!reader)
+        return AVERROR(EINVAL);
+    if ((ret = http_sparse_check(reader->budget)) < 0)
+        return ret;
+    if (!buffer || buffer_size <= 0 || !reader->part_active ||
+        reader->batch_validated)
+        return http_sparse_fail(reader->budget, AVERROR(EINVAL));
+    if (!reader->part_remaining)
+        return 0; /* exact part boundary, never AVERROR_EOF */
+    buffer_size = FFMIN((uint32_t)buffer_size, reader->part_remaining);
+    ret = http_sparse_raw(reader, buffer, buffer_size, 1);
+    if (ret < 0)
+        return ret;
+    reader->part_remaining -= ret;
+    reader->payload_read += ret;
+    return ret;
+}
+
+int avpriv_vortx_reference_sparse_stats_v1(
+    const struct avpriv_vortx_reference_sparse_reader *reader,
+    struct avpriv_vortx_reference_sparse_stats *out, size_t out_size)
+{
+    if (out_size != sizeof(*out))
+        return AVERROR(EINVAL);
+    if (!reader || !out || out->payload_bytes || out->parts_complete ||
+        out->batch_validated || out->terminal_error)
+        return AVERROR(EINVAL);
+    *out = (struct avpriv_vortx_reference_sparse_stats){
+        .payload_bytes = reader->payload_read,
+        .parts_complete = reader->parts_complete,
+        .batch_validated = reader->batch_validated,
+        .terminal_error = reader->budget->terminal_error,
+    };
+    return 0;
+}
+
+void avpriv_vortx_reference_sparse_close_v1(
+    struct avpriv_vortx_reference_sparse_reader **value)
+{
+    struct avpriv_vortx_reference_sparse_reader *reader;
+    if (!value || !(reader = *value))
+        return;
+    *value = NULL;
+    http_sparse_check(reader->budget);
+    if (!reader->batch_validated)
+        http_sparse_fail(reader->budget, AVERROR_INVALIDDATA);
+    http_sparse_dispose(reader);
+}
+
+void avpriv_vortx_reference_sparse_budget_release_v1(
+    struct avpriv_vortx_reference_sparse_budget **value)
+{
+    struct avpriv_vortx_reference_sparse_budget *budget;
+    if (!value || !(budget = *value))
+        return;
+    if (budget->active) {
+        http_sparse_fail(budget, AVERROR(EINVAL));
+        return; /* fail closed, do not free beneath the still-owned handle */
+    }
+    *value = NULL;
+    avpriv_vortx_reference_recipe_release_v1(&budget->recipe);
+    av_free(budget);
+}
