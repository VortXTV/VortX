+static int http_reference_field(const char *name, size_t bytes, const char *text)
+{
+    return strlen(text) == bytes && !av_strncasecmp(name, text, bytes);
+}
+
+static int http_reference_decimal(const char **cursor, const char *end,
+                                  uint64_t *value)
+{
+    const char *p = *cursor;
+    uint64_t v = 0;
+    if (p == end || *p < '0' || *p > '9')
+        return 0;
+    while (p < end && *p >= '0' && *p <= '9') {
+        unsigned digit = *p++ - '0';
+        if (v > (INT64_MAX - digit) / 10u)
+            return 0;
+        v = v * 10u + digit;
+    }
+    *cursor = p;
+    *value = v;
+    return 1;
+}
+
+static int http_reference_number(const char *text, uint64_t *value)
+{
+    const char *p = text, *end = text + strlen(text);
+    return http_reference_decimal(&p, end, value) && p == end;
+}
