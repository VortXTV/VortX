+static int http_reference_prepared_options(
+    const AVDictionary *options, const char *headers, uint32_t max_bytes,
+    int64_t remaining_us, int https)
+{
+    static const struct { const char *key, *value; } fixed[] = {
+        {"method", "GET"}, {"tls_verify", "1"}, {"http_proxy", ""},
+        {"cookies", ""}, {"icy", "0"}, {"seekable", "0"}, {"offset", "0"},
+        {"multiple_requests", "0"}, {"reconnect", "0"},
+        {"reconnect_at_eof", "0"}, {"reconnect_on_network_error", "0"},
+        {"reconnect_on_http_error", ""}, {"reconnect_streamed", "0"},
+        {"max_redirects", "0"},
+    };
+    const AVDictionaryEntry *entry = NULL;
+    unsigned dynamic = 0;
+    uint64_t timeout = 0, rw_timeout = 0;
+    while ((entry = av_dict_iterate(options, entry))) {
+        unsigned i;
+        for (i = 0; i < FF_ARRAY_ELEMS(fixed); i++) {
+            if (!strcmp(entry->key, fixed[i].key)) {
+                if (strcmp(entry->value, fixed[i].value))
+                    return 0;
+                break;
+            }
+        }
+        if (i < FF_ARRAY_ELEMS(fixed))
+            continue;
+        if (!strcmp(entry->key, "headers")) {
+            if (strnlen(entry->value, VORTX_HTTP_SENT_REQUEST_MAX_BYTES + 1) >
+                VORTX_HTTP_SENT_REQUEST_MAX_BYTES || strcmp(entry->value, headers))
+                return 0;
+            dynamic |= 1;
+        } else if (!strcmp(entry->key, "end_offset")) {
+            uint64_t value;
+            if (!http_reference_number(entry->value, &value) || value != max_bytes)
+                return 0;
+            dynamic |= 2;
+        } else if (!strcmp(entry->key, "timeout")) {
+            if (!http_reference_number(entry->value, &timeout))
+                return 0;
+            dynamic |= 4;
+        } else if (!strcmp(entry->key, "rw_timeout")) {
+            if (!http_reference_number(entry->value, &rw_timeout))
+                return 0;
+            dynamic |= 8;
+        } else if (!strcmp(entry->key, "protocol_whitelist")) {
+            if (strcmp(entry->value, https ? "https,tcp,tls" : "http,tcp"))
+                return 0;
+            dynamic |= 16;
+        } else if (!strcmp(entry->key, "protocol_blacklist")) {
+            if (!http_reference_blacklist(entry->value, https))
+                return 0;
+        } else {
+            return 0;
+        }
+    }
+    for (unsigned i = 0; i < FF_ARRAY_ELEMS(fixed); i++) {
+        if (!av_dict_get(options, fixed[i].key, NULL, AV_DICT_MATCH_CASE))
+            return 0;
+    }
+    return dynamic == 31 && timeout == rw_timeout &&
+        timeout >= remaining_us && timeout <= VORTX_REFERENCE_READER_MAX_US;
+}
