+static int http_reference_blacklist(const char *list, int https)
+{
+    const char *p = list;
+    if (strnlen(list, 4096) == 4096)
+        return 0;
+    while (*p) {
+        const char *end = strchr(p, ',');
+        size_t n;
+        if (!end)
+            end = p + strlen(p);
+        n = end - p;
+        if (!n || n > 32 || (n == 3 && !memcmp(p, "tcp", n)) ||
+            (https && n == 3 && !memcmp(p, "tls", n)) ||
+            (n == (https ? 5 : 4) && !memcmp(p, https ? "https" : "http", n)))
+            return 0;
+        for (const char *c = p; c < end; c++) {
+            if (!((*c >= 'a' && *c <= 'z') || (*c >= '0' && *c <= '9') ||
+                  *c == '_' || *c == '-' || *c == '+'))
+                return 0;
+        }
+        if (!*end)
+            break;
+        if (!*(p = end + 1))
+            return 0;
+    }
+    return 1;
+}
