+    avpriv_vortx_http_sent_request_clear_v2(&recipe->sent);
+    av_free(recipe->etag);
+    av_free(recipe->url);
+    av_dict_free(&recipe->options);
+    http_reference_lifetime_drop(recipe->lifetime);
+    av_free(recipe);
