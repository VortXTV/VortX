+int avpriv_vortx_reference_recipe_current(
+    const struct avpriv_vortx_reference_recipe *recipe)
+{
+#if VORTX_REFERENCE_LIFETIME_ATOMICS
+    return recipe && recipe->lifetime &&
+        !atomic_load_explicit(&recipe->lifetime->retired, memory_order_acquire);
+#else
+    (void)recipe;
+    return 0;
+#endif
