+/* SOURCE-ONLY PROPOSAL, UNCOMPILED/UNRUN. Included by matched http.c only.
+ * One original owner captures/revalidates; one utility worker owns each open.
+ * No borrowed playback object, descriptor, cancel state or mutable options. */
+#define VORTX_REFERENCE_HEADER_MAX (32u * 1024u)
+#if ATOMIC_INT_LOCK_FREE == 2 && ATOMIC_BOOL_LOCK_FREE == 2
+#define VORTX_REFERENCE_LIFETIME_ATOMICS 1
+struct HTTPReferenceLifetime {
+    atomic_uint references;
+    atomic_bool retired;
+};
+#else
+#define VORTX_REFERENCE_LIFETIME_ATOMICS 0
+struct HTTPReferenceLifetime { unsigned unavailable; };
+#endif
+#define VORTX_REFERENCE_LIFETIME_MAX_REFS (1u << 20)
+
+struct avpriv_vortx_reference_recipe {
+    struct avpriv_vortx_http_sent_request sent;
+    struct FFVortXReferencePin pin;
+    char *etag;
+    char *url;
+    AVDictionary *options;
+    int64_t deadline_us;
+    struct HTTPReferenceLifetime *lifetime;
+};
+struct avpriv_vortx_reference_reader {
+    const struct avpriv_vortx_reference_recipe *recipe;
+    AVIOInterruptCB owned_interrupt;
+    URLContext *h;
+    uint64_t body_bytes;
+    uint64_t declared_body_bytes;
+    int complete_entity;
+    int reached_entity_eof;
+    int terminal_error;
+};
+
+static void http_reference_lifetime_drop(struct HTTPReferenceLifetime *value)
+{
+#if VORTX_REFERENCE_LIFETIME_ATOMICS
+    if (value && atomic_fetch_sub_explicit(&value->references, 1,
+                                           memory_order_acq_rel) == 1)
+        av_free(value);
+#else
+    (void)value;
+#endif
+}
+
+/* Caller already owns a ref or is the excluded original HTTP owner. */
+static struct HTTPReferenceLifetime *http_reference_lifetime_retain(
+    struct HTTPReferenceLifetime *value)
+{
+#if VORTX_REFERENCE_LIFETIME_ATOMICS
+    unsigned old;
+    if (!value || atomic_load_explicit(&value->retired, memory_order_acquire))
+        return NULL;
+    old = atomic_load_explicit(&value->references, memory_order_relaxed);
+    do {
+        if (!old || old >= VORTX_REFERENCE_LIFETIME_MAX_REFS)
+            return NULL;
+    } while (!atomic_compare_exchange_weak_explicit(&value->references, &old,
+                 old + 1, memory_order_acquire, memory_order_relaxed));
+    if (atomic_load_explicit(&value->retired, memory_order_acquire)) {
+        http_reference_lifetime_drop(value);
+        return NULL;
+    }
+    return value;
+#else
+    (void)value;
+    return NULL;
+#endif
+}
+
+static void http_reference_lifetime_retire(HTTPContext *s)
+{
+    struct HTTPReferenceLifetime *value = s->reference_lifetime;
+#if VORTX_REFERENCE_LIFETIME_ATOMICS
+    if (value)
+        atomic_store_explicit(&value->retired, true, memory_order_release);
+#endif
+    s->reference_lifetime = NULL;
+    http_reference_lifetime_drop(value);
+}
+
+static void http_reference_lifetime_complete(HTTPContext *s)
+{
+    http_reference_lifetime_retire(s);
+#if VORTX_REFERENCE_LIFETIME_ATOMICS
+    if (s->response_generation > 0 && s->response_etag && s->response_location &&
+        s->sent_request && s->sent_location &&
+        s->sent_request_generation == s->response_generation &&
+        !strcmp(s->sent_location, s->response_location)) {
+        struct HTTPReferenceLifetime *value = av_mallocz(sizeof(*value));
+        if (value) {
+            atomic_init(&value->references, 1);
+            atomic_init(&value->retired, false);
+            s->reference_lifetime = value;
+        }
+    }
+#endif
+}
