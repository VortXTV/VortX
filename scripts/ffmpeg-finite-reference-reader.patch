+static void http_reference_total_reset(HTTPContext *s)
+{
+    s->reference_original_total = (HTTPReferenceTotal){0};
+    s->reference_header_crlf = 0;
+}
+
+/* Observe ORIGINAL raw header lines before the generic parser mutates them.
+ * This optional knowledge is deliberately stricter than generic filesize:
+ * duplicates, signs, overflow, unknown/chunked framing and syntax ambiguity
+ * remain unavailable. Ordinary playback keeps its exact existing behavior. */
+static void http_reference_total_header(HTTPContext *s, const char *line,
+                                        int line_count, int invalid, int crlf)
+{
+    HTTPReferenceTotal *t = &s->reference_original_total;
+    const char *colon, *value, *end, *p;
+    size_t bytes = strlen(line), name_bytes;
+    if (invalid || !crlf || bytes + 2 > VORTX_REFERENCE_HEADER_MAX ||
+        t->header_bytes > VORTX_REFERENCE_HEADER_MAX - (bytes + 2)) {
+        t->invalid = 1;
+        return;
+    }
+    t->header_bytes += bytes + 2;
+    if (!line_count) {
+        if (!http_response_status_valid(line)) {
+            t->invalid = 1;
+            return;
+        }
+        t->status = (line[9] - '0') * 100 + (line[10] - '0') * 10 + line[11] - '0';
+        return;
+    }
+    if (!bytes)
+        return;
+    colon = strchr(line, ':');
+    if (!colon || colon == line) {
+        t->invalid = 1;
+        return;
+    }
+    name_bytes = colon - line;
+    for (const unsigned char *c = (const unsigned char *)line;
+         c < (const unsigned char *)colon; c++) {
+        if (!((*c >= 'A' && *c <= 'Z') || (*c >= 'a' && *c <= 'z') ||
+              (*c >= '0' && *c <= '9') || strchr("!#$%&'*+-.^_`|~", *c))) {
+            t->invalid = 1;
+            return;
+        }
+    }
+    value = colon + 1;
+    end = line + bytes;
+    while (value < end && (*value == ' ' || *value == '\t'))
+        value++;
+    while (end > value && (end[-1] == ' ' || end[-1] == '\t'))
+        end--;
+    p = value;
+    if (http_reference_field(line, name_bytes, "Content-Length")) {
+        if (t->length_seen++ || !http_reference_decimal(&p, end, &t->length) || p != end)
+            t->invalid = 1;
+    } else if (http_reference_field(line, name_bytes, "Content-Range")) {
+        if (t->range_seen++ || end - value < 6 || memcmp(value, "bytes ", 6)) {
+            t->invalid = 1;
+            return;
+        }
+        p += 6;
+        if (!http_reference_decimal(&p, end, &t->start) ||
+            p == end || *p++ != '-' ||
+            !http_reference_decimal(&p, end, &t->end) ||
+            p == end || *p++ != '/' ||
+            !http_reference_decimal(&p, end, &t->total) || p != end ||
+            t->end < t->start || !t->total || t->end >= t->total)
+            t->invalid = 1;
+    } else if (http_reference_field(line, name_bytes, "Transfer-Encoding")) {
+        t->transfer_seen = 1;
+    } else if (http_reference_field(line, name_bytes, "Content-Encoding")) {
+        if (t->encoding_seen++ || end - value != 8 ||
+            av_strncasecmp(value, "identity", 8))
+            t->invalid = 1;
+    } else if (http_reference_field(line, name_bytes, "Icy-MetaInt") ||
+               http_reference_field(line, name_bytes, "Trailer") ||
+               (http_reference_field(line, name_bytes, "Content-Type") &&
+                end - value >= 10 && !av_strncasecmp(value, "multipart/", 10))) {
+        t->invalid = 1;
+    }
+}
+
+static void http_reference_total_publish(HTTPContext *s)
+{
+    HTTPReferenceTotal *t = &s->reference_original_total;
+    t->generation = s->response_generation;
+    t->known = 0;
+    t->value = 0;
+    if (t->generation <= 0 || t->invalid || t->transfer_seen ||
+        t->status != s->http_code || t->length_seen != 1)
+        return;
+    if (t->status == 200 && !t->range_seen) {
+        t->known = 1;
+        t->value = t->length;
+    } else if (t->status == 206 && t->range_seen == 1 &&
+               t->length == t->end - t->start + 1) {
+        t->known = 1;
+        t->value = t->total;
+    }
+}
