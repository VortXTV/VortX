+/* Kernel observation only: never retain this FD or its URLContext. */
+static int http_reference_owner_peer(HTTPContext *s,
+                                    struct sockaddr_storage *peer,
+                                    socklen_t *peer_len,
+                                    struct sockaddr_storage *local,
+                                    socklen_t *local_len)
+{
+    int fd, type = 0;
+    socklen_t type_len = sizeof(type);
+    if (!s->hd || !s->hd->is_connected ||
+        (fd = ffurl_get_file_handle(s->hd)) < 0)
+        return AVERROR(EAGAIN);
+    *peer = (struct sockaddr_storage){0};
+    *peer_len = sizeof(*peer);
+    *local = (struct sockaddr_storage){0};
+    *local_len = sizeof(*local);
+    if (getsockopt(fd, SOL_SOCKET, SO_TYPE, &type, &type_len) ||
+        type_len != sizeof(type) || type != SOCK_STREAM ||
+        getpeername(fd, (struct sockaddr *)peer, peer_len) ||
+        getsockname(fd, (struct sockaddr *)local, local_len) ||
+        !ff_vortx_reference_peer_valid(peer, *peer_len) ||
+        !ff_vortx_reference_peer_valid(local, *local_len) ||
+        peer->ss_family != local->ss_family)
+        return AVERROR(EAGAIN);
+    return 0;
+}
