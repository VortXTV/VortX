+/* The ordinary connection helper logs its URL on failure. This private
+ * optional path returns errors without logging any hostname or URL. The
+ * caller owns and closes fd on every failure. */
+static int tcp_connect_vortx_reference(URLContext *h, int fd,
+                                       const struct sockaddr *peer,
+                                       socklen_t peer_len, int64_t timeout_us)
+{
+    int ret, socket_error;
+    int64_t now = av_gettime_relative(), deadline;
+    socklen_t error_len;
+
+    if (timeout_us <= 0 || now > INT64_MAX - timeout_us)
+        return AVERROR(EINVAL);
+    deadline = now + timeout_us;
+    if (ff_socket_nonblock(fd, 1) < 0)
+        return ff_neterrno();
+    for (;;) {
+        if (ff_check_interrupt(&h->interrupt_callback))
+            return AVERROR_EXIT;
+        if (av_gettime_relative() >= deadline)
+            return AVERROR(ETIMEDOUT);
+        if (!connect(fd, peer, peer_len))
+            return 0;
+        ret = ff_neterrno();
+        if (ret == AVERROR(EISCONN))
+            return 0; /* an interrupted connect may have completed */
+        if (ret == AVERROR(EINTR))
+            continue;
+        if (ret != AVERROR(EINPROGRESS) && ret != AVERROR(EAGAIN) &&
+            ret != AVERROR(EALREADY))
+            return ret;
+        break;
+    }
+    for (;;) {
+        if (ff_check_interrupt(&h->interrupt_callback))
+            return AVERROR_EXIT;
+        now = av_gettime_relative();
+        if (now >= deadline)
+            return AVERROR(ETIMEDOUT);
+        ret = ff_network_wait_fd_timeout(fd, 1, deadline - now,
+                                         &h->interrupt_callback);
+        if (ret == AVERROR(EINTR))
+            continue;
+        if (ret < 0)
+            return ret;
+        do {
+            if (ff_check_interrupt(&h->interrupt_callback))
+                return AVERROR_EXIT;
+            if (av_gettime_relative() >= deadline)
+                return AVERROR(ETIMEDOUT);
+            socket_error = 0;
+            error_len = sizeof(socket_error);
+            ret = getsockopt(fd, SOL_SOCKET, SO_ERROR, &socket_error, &error_len);
+        } while (ret && ff_neterrno() == AVERROR(EINTR));
+        if (ret)
+            return ff_neterrno();
+        if (error_len != sizeof(socket_error))
+            return AVERROR(EIO);
+        return socket_error ? AVERROR(socket_error) : 0;
+    }
+}
+
+/* Optional finite reader only. Preserve the hostname URL for HTTP Host and TLS
+ * SNI, while connecting exactly one recipe-owned numeric sockaddr. No DNS,
+ * fallback address, proxy, caller-chosen local bind, listener or original FD
+ * is used. Bind the captured kernel local IP with a new ephemeral port; this
+ * does not establish physical interface or routing affinity. */
+static int tcp_open_vortx_reference(URLContext *h, TCPContext *s,
+                                    const char *hostname, int port, int flags)
+{
+    const struct FFVortXReferencePin *pin = h->vortx_reference_pin;
+    struct sockaddr_storage actual = {0};
+    struct sockaddr_storage actual_local = {0}, local;
+    socklen_t actual_len = sizeof(actual);
+    socklen_t actual_local_len = sizeof(actual_local);
+    int fd = -1, ret, timeout_ms;
+    unsigned peer_port;
+
+    if (!pin || !memchr(pin->hostname, 0, sizeof(pin->hostname)) ||
+        !pin->hostname[0] || strcmp(hostname, pin->hostname) ||
+        port != pin->port || port <= 0 || port >= 65536 ||
+        flags != AVIO_FLAG_READ_WRITE || s->listen ||
+        s->local_addr || s->local_port ||
+        !ff_vortx_reference_peer_valid(&pin->peer, pin->peer_len) ||
+        !ff_vortx_reference_peer_valid(&pin->local, pin->local_len) ||
+        pin->peer.ss_family != pin->local.ss_family ||
+        pin->transport.version != VORTX_HTTP_TRANSPORT_VERSION ||
+        pin->transport.route != VORTX_HTTP_ROUTE_DIRECT_TCP)
+        return AVERROR(EINVAL);
+    if (pin->peer.ss_family == AF_INET)
+        peer_port = ntohs(((const struct sockaddr_in *)&pin->peer)->sin_port);
+#if HAVE_STRUCT_SOCKADDR_IN6
+    else if (pin->peer.ss_family == AF_INET6)
+        peer_port = ntohs(((const struct sockaddr_in6 *)&pin->peer)->sin6_port);
+#endif
+    else
+        return AVERROR(EINVAL);
+    if (peer_port != port)
+        return AVERROR(EINVAL);
+    local = pin->local;
+    if (local.ss_family == AF_INET)
+        ((struct sockaddr_in *)&local)->sin_port = 0;
+#if HAVE_STRUCT_SOCKADDR_IN6
+    else
+        ((struct sockaddr_in6 *)&local)->sin6_port = 0;
+#endif
+
+    /* The shared owned interrupt also enforces the common absolute deadline.
+     * Keep this protocol's own wait bounded even if an option was omitted. */
+    if (s->open_timeout <= 0)
+        return AVERROR(EINVAL);
+    timeout_ms = s->open_timeout / 1000;
+    if (timeout_ms <= 0)
+        timeout_ms = 1;
+    if (timeout_ms > 30000)
+        timeout_ms = 30000;
+    if (h->rw_timeout <= 0 || h->rw_timeout > 30000000)
+        h->rw_timeout = 30000000;
+    if (ff_check_interrupt(&h->interrupt_callback))
+        return AVERROR_EXIT;
+
+    fd = ff_socket(pin->peer.ss_family, SOCK_STREAM, IPPROTO_TCP, h);
+    if (fd < 0)
+        return ff_neterrno();
+    ret = customize_fd(s, fd, pin->peer.ss_family);
+    if (ret < 0)
+        goto fail;
+    if (bind(fd, (const struct sockaddr *)&local, pin->local_len)) {
+        ret = ff_neterrno();
+        goto fail;
+    }
+    ret = tcp_connect_vortx_reference(h, fd,
+                    (const struct sockaddr *)&pin->peer, pin->peer_len,
+                    (int64_t)timeout_ms * 1000);
+    if (ret < 0)
+        goto fail;
+    if (ff_check_interrupt(&h->interrupt_callback)) {
+        ret = AVERROR_EXIT;
+        goto fail;
+    }
+    if (getpeername(fd, (struct sockaddr *)&actual, &actual_len) ||
+        getsockname(fd, (struct sockaddr *)&actual_local, &actual_local_len)) {
+        ret = ff_neterrno();
+        goto fail;
+    }
+    if (!ff_vortx_reference_peer_equal(&pin->peer, pin->peer_len,
+                                       &actual, actual_len) ||
+        !ff_vortx_reference_local_equal(&pin->local, pin->local_len,
+                                        &actual_local, actual_local_len)) {
+        ret = AVERROR(EIO);
+        goto fail;
+    }
+    h->is_streamed = 1;
+    s->fd = fd;
+    return 0;
+fail:
+    closesocket(fd);
+    return ret;
+}
