+        t->route != VORTX_HTTP_ROUTE_DIRECT_TCP)
+        return 0;
+    if (!strncmp(sent->location, "http://", 7))
+        return !t->tls_backend && !t->tls_policy;
+    return !strncmp(sent->location, "https://", 8) &&
+        (t->tls_backend == VORTX_HTTP_TLS_SECURETRANSPORT ||
+         t->tls_backend == VORTX_HTTP_TLS_MBEDTLS) &&
