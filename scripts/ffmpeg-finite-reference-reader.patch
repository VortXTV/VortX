+/* Reconstruct the existing MPV prefix producer's transformation from actual
+ * retained wire bytes. Replacement inputs alone never confer replay power. */
+static char *http_reference_prepared_headers(
+    const struct avpriv_vortx_http_sent_request *sent,
+    const char *etag, uint32_t max_bytes)
+{
+    static const char *const rejected[] = {
+        "Content-Length", "Transfer-Encoding", "Expect", "Upgrade", "Trailer",
+        "TE", "Proxy-Authorization", "Proxy-Connection", "If-Match",
+        "If-None-Match", "If-Modified-Since", "If-Unmodified-Since", "If-Range",
+        NULL,
+    };
+    AVBPrint headers;
+    const char *end = sent->request + sent->request_bytes;
+    const char *line = strstr(sent->request, "\r\n");
+    unsigned host = 0, agent = 0, accept = 0;
+    char *out = NULL;
+    if (!http_sent_request_wire_valid(sent->request, sent->request_bytes) || !line)
+        return NULL;
+    av_bprint_init(&headers, 0, VORTX_HTTP_SENT_REQUEST_MAX_BYTES);
+    line += 2;
+    while (line < end - 2) {
+        const char *next = strstr(line, "\r\n");
+        const char *colon = next ? memchr(line, ':', next - line) : NULL;
+        size_t n;
+        if (!next || next >= end - 2 || !colon || colon == line)
+            goto fail;
+        n = colon - line;
+        for (int i = 0; rejected[i]; i++) {
+            if (http_reference_field(line, n, rejected[i]))
+                goto fail;
+        }
+        if (!http_reference_field(line, n, "Range") &&
+            !http_reference_field(line, n, "Connection") &&
+            !http_reference_field(line, n, "Accept-Encoding") &&
+            !http_reference_field(line, n, "Icy-MetaData")) {
+            host += http_reference_field(line, n, "Host");
+            agent += http_reference_field(line, n, "User-Agent");
+            accept += http_reference_field(line, n, "Accept");
+            av_bprint_append_data(&headers, line, next - line + 2);
+        }
+        line = next + 2;
+    }
+    if (line != end - 2 || host != 1 || agent != 1 || accept != 1)
+        goto fail;
+    av_bprintf(&headers, "Range: bytes=0-%u\r\nIf-Match: %s\r\n"
+               "Connection: close\r\nAccept-Encoding: identity\r\n"
+               "Icy-MetaData: 0\r\n", (unsigned)(max_bytes - 1), etag);
+    if (!av_bprint_is_complete(&headers))
+        goto fail;
+    if (av_bprint_finalize(&headers, &out) < 0) {
+        av_free(out);
+        return NULL;
+    }
+    return out;
+fail:
+    av_bprint_finalize(&headers, NULL);
+    return NULL;
+}
