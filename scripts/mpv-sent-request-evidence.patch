diff --git a/stream/vortx_http_request.h b/stream/vortx_http_request.h
new file mode 100644
--- /dev/null
+++ b/stream/vortx_http_request.h
@@ -0,0 +1,33 @@
+/* VortX-private native bridge. Not a public FFmpeg, libmpv or Swift API.
+ * The identical contract is carried inside both matched source packages.
+ * Only the genuine AVIO owner may call copy while AVIO/HTTP remain alive and
+ * no I/O, seek, close, replacement or other owner operation can intervene.
+ * This observes sent GET bytes. It is NOT permission to open/replay a request,
+ * follow a redirect, choose a destination, or infer complete resource identity.
+ */
+#ifndef VORTX_PRIVATE_HTTP_SENT_REQUEST_H
+#define VORTX_PRIVATE_HTTP_SENT_REQUEST_H
+#include <stddef.h>
+#include <stdint.h>
+struct AVIOContext;
+#define VORTX_HTTP_SENT_REQUEST_VERSION 1u
+#define VORTX_HTTP_SENT_REQUEST_MAX_BYTES (32u * 1024u)
+struct avpriv_vortx_http_sent_request {
+    char *location;
+    char *request; /* exact successfully written request headers, including GET line */
+    size_t request_bytes; /* excludes the owned terminating NUL */
+    int64_t response_generation;
+    unsigned version;
+};
+/* out must be zero/cleared; failure leaves it unchanged. Returns 0 only for an
+ * owned snapshot of the expected current completed response. A nonzero result
+ * is optional unavailability and must not change playback. Credentials remain
+ * native memory only: never log, persist or expose these strings as AVOptions.
+ * New matched FFmpeg/MPV components and symbol/header parity are mandatory.
+ */
+int avpriv_vortx_http_copy_sent_request(
+    struct AVIOContext *owner, int64_t expected_generation,
+    struct avpriv_vortx_http_sent_request *out);
+void avpriv_vortx_http_sent_request_clear(
+    struct avpriv_vortx_http_sent_request *value);
+#endif
