+// This owns actual sent bytes, not initial options relabelled as a current
+// request. Its observation retains the original source/cancel/epoch lifetime.
+// It remains evidence only: no open/replay/redirect/reader permission is granted.
+struct stream_reference_sent_request {
+    struct stream_reference_observation *observation;
+    struct avpriv_vortx_http_sent_request sent;
+};
+
+bool stream_reference_sent_request_cancelled(
+    const struct stream_reference_sent_request *request)
+{
+    return !request || stream_reference_observation_cancelled(request->observation);
+}
+
+void stream_reference_sent_request_release(
+    struct stream_reference_sent_request **handle)
+{
+    if (!handle)
+        return;
+    struct stream_reference_sent_request *request = *handle;
+    *handle = NULL;
+    if (request) {
+        avpriv_vortx_http_sent_request_clear(&request->sent);
+        stream_reference_observation_release(&request->observation);
+        av_free(request);
+    }
+}
+
+static bool reference_sent_request_valid(
+    const struct avpriv_vortx_http_sent_request *sent,
+    const struct stream_reference_observation *observation)
+{
+    return sent->version == VORTX_HTTP_SENT_REQUEST_VERSION &&
+        sent->request && sent->location && sent->request_bytes > 0 &&
+        sent->request_bytes <= VORTX_HTTP_SENT_REQUEST_MAX_BYTES &&
+        strnlen(sent->request, sent->request_bytes + 1) == sent->request_bytes &&
+        sent->response_generation == observation->values.response_generation &&
+        !strcmp(sent->location, observation->values.location);
+}
+
+bool stream_reference_source_observe_sent_request(
+    stream_t *s, int64_t deadline_ns, struct stream_reference_sent_request **out)
+{
+    if (!out || *out)
+        return false;
+    struct stream_reference_observation *observation = NULL;
+    if (!stream_reference_source_observe_response(s, deadline_ns, &observation))
+        return false;
+    struct stream_reference_sent_request *request = av_mallocz(sizeof(*request));
+    if (!request) {
+        stream_reference_observation_release(&observation);
+        return false;
+    }
+    request->observation = observation;
+    struct lavf_priv *p = s->priv;
+    if (!reference_observation_matches_source(s, observation) || !p || !p->avio ||
+        avpriv_vortx_http_copy_sent_request(p->avio,
+            observation->values.response_generation, &request->sent) < 0 ||
+        !reference_sent_request_valid(&request->sent, observation) ||
+        !stream_reference_source_revalidate_observation(s, observation)) {
+        stream_reference_sent_request_release(&request);
+        return false;
+    }
+    *out = request;
+    return true;
+}
+
+bool stream_reference_source_revalidate_sent_request(
+    stream_t *s, const struct stream_reference_sent_request *request)
+{
+    struct avpriv_vortx_http_sent_request current = {0};
+    bool valid = false;
+    if (!request || !stream_reference_source_revalidate_observation(
+                        s, request->observation))
+        return false;
+    struct lavf_priv *p = s->priv;
+    if (p && p->avio && avpriv_vortx_http_copy_sent_request(p->avio,
+            request->sent.response_generation, &current) == 0) {
+        valid = reference_sent_request_valid(&current, request->observation) &&
+            current.request_bytes == request->sent.request_bytes &&
+            !memcmp(current.request, request->sent.request, current.request_bytes) &&
+            stream_reference_source_revalidate_observation(s, request->observation);
+    }
+    avpriv_vortx_http_sent_request_clear(&current);
+    return valid;
+}
+
+void stream_reference_sent_request_values_clear(
+    struct stream_reference_sent_request_values *values)
+{
+    if (!values)
+        return;
+    stream_reference_observation_values_clear(&values->response);
+    av_free(values->request);
+    *values = (struct stream_reference_sent_request_values){0};
+}
+
+bool stream_reference_sent_request_copy_values(
+    const struct stream_reference_sent_request *request,
+    struct stream_reference_sent_request_values *out)
+{
+    if (!out || out->request || out->request_bytes || out->response.etag ||
+        out->response.location || out->response.response_generation ||
+        out->response.source_generation || out->response.source_epoch ||
+        stream_reference_sent_request_cancelled(request))
+        return false;
+    struct stream_reference_sent_request_values copy = {0};
+    copy.request = av_strndup(request->sent.request, request->sent.request_bytes);
+    if (!copy.request || !stream_reference_observation_copy_values(
+                            request->observation, &copy.response) ||
+        stream_reference_sent_request_cancelled(request)) {
+        stream_reference_sent_request_values_clear(&copy);
+        return false;
+    }
+    copy.request_bytes = (uint32_t)request->sent.request_bytes;
+    *out = copy;
+    return true;
+}
+
