+/* These helpers expose metadata, not a generic resource-identity guarantee.
+ * NULL means unavailable, including malformed, weak, duplicate or oversized
+ * validators. Allocation failure disables only this optional observation. */
+static void http_response_etag_reset(HTTPContext *s)
+{
+    av_freep(&s->response_etag);
+    av_freep(&s->response_location);
+    s->response_etag_pending[0] = 0;
+    s->response_etag_seen = 0;
+    s->response_etag_invalid = 0;
+}
+
+static int http_response_status_valid(const char *line)
+{
+    if (strnlen(line, 13) < 13 ||
+        (strncmp(line, "HTTP/1.0 ", 9) && strncmp(line, "HTTP/1.1 ", 9)))
+        return 0;
+    for (int n = 9; n < 12; n++) {
+        if (line[n] < '0' || line[n] > '9')
+            return 0;
+    }
+    return line[12] == ' ';
+}
+
+static void http_response_etag_header(HTTPContext *s, const char *value)
+{
+    const unsigned char *start = (const unsigned char *)value;
+    const unsigned char *end;
+    size_t length = strnlen(value, MAX_URL_SIZE);
+    if (s->response_etag_seen || length == MAX_URL_SIZE) {
+        s->response_etag_invalid = 1;
+        return;
+    }
+    s->response_etag_seen = 1;
+    end = start + length;
+    while (start < end && (*start == ' ' || *start == '\t'))
+        start++;
+    while (end > start && (end[-1] == ' ' || end[-1] == '\t'))
+        end--;
+    length = end - start;
+    if (length < 2 || length > RESPONSE_ETAG_LIMIT ||
+        start[0] != '"' || end[-1] != '"') {
+        s->response_etag_invalid = 1;
+        return;
+    }
+    /* RFC9110 etagc: %x21 / %x23-7E / obs-text. W/ and comma lists
+     * cannot enter this path; even identical repeated fields are ambiguous. */
+    for (const unsigned char *c = start + 1; c < end - 1; c++) {
+        if (*c < 0x21 || *c == '"' || *c == 0x7f) {
+            s->response_etag_invalid = 1;
+            return;
+        }
+    }
+    memcpy(s->response_etag_pending, start, length);
+    s->response_etag_pending[length] = 0;
+}
+
+/* A completed response snapshot must not certify a truncated routing prefix.
+ * Whole-URL/path fit the actual MAX_URL_SIZE buffers; the conservative host
+ * bound leaves space in the actual 1024-byte host/transport join buffers.
+ * Reject userinfo/fragments/ambiguous ports instead of silently dropping them.
+ * This is bounded routing metadata, not TLS or resource equivalence authority.
+ */
+static int http_response_location_valid(const char *location)
+{
+    URLComponents parts;
+    size_t length;
+    if (!location || !(length = strnlen(location, MAX_URL_SIZE)) ||
+        length == MAX_URL_SIZE ||
+        (strncmp(location, "http://", 7) && strncmp(location, "https://", 8)))
+        return 0;
+    for (const unsigned char *p = (const unsigned char *)location; *p; p++) {
+        if (*p <= 0x20 || *p >= 0x7f)
+            return 0;
+    }
+    if (ff_url_decompose(&parts, location, location + length) < 0 ||
+        !URL_COMPONENT_HAVE(parts, authority) ||
+        !URL_COMPONENT_HAVE(parts, host) ||
+        URL_COMPONENT_HAVE(parts, userinfo) ||
+        URL_COMPONENT_HAVE(parts, fragment) ||
+        parts.port - parts.host > 900 ||
+        (parts.host[0] == '[' && parts.port - parts.host <= 2))
+        return 0;
+    if (URL_COMPONENT_HAVE(parts, port)) {
+        unsigned port = 0;
+        if (parts.path - parts.port < 2 || parts.path - parts.port > 6)
+            return 0;
+        for (const char *p = parts.port + 1; p < parts.path; p++) {
+            if (*p < '0' || *p > '9')
+                return 0;
+            port = port * 10 + (*p - '0');
+        }
+        if (!port || port > 65535)
+            return 0;
+    }
+    return 1;
+}
+
+static void http_response_etag_publish(URLContext *h)
+{
+    HTTPContext *s = h->priv_data;
+    if (!s->response_etag_invalid && s->response_etag_seen &&
+        s->response_etag_pending[0] && s->end_header &&
+        (s->http_code == 200 || s->http_code == 206) &&
+        !s->is_connected_server && h->prot &&
+        (!strcmp(h->prot->name, "http") || !strcmp(h->prot->name, "https")) &&
+        (h->flags & AVIO_FLAG_READ) && !(h->flags & AVIO_FLAG_WRITE) &&
+        !s->post_data && (!s->method || !strcmp(s->method, "GET")) &&
+        http_response_location_valid(s->location)) {
+        char *etag = av_strdup(s->response_etag_pending);
+        char *location = av_strdup(s->location);
+        if (etag && location) {
+            // Read consecutive getters only on the actual HTTP I/O owner, with
+            // no intervening I/O. No partial pair is published on allocation failure.
+            s->response_etag = etag;
+            s->response_location = location;
+        } else {
+            av_free(etag);
+            av_free(location);
+        }
+    }
+    s->response_etag_pending[0] = 0;
+}
