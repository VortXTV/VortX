+static inline void ff_tls_vortx_open_complete(TLSShared *s, URLContext *h,
+                                             unsigned backend)
+{
+    unsigned policy = 0;
+    h->vortx_transport.version = 0;
+    h->vortx_transport.tls_backend = 0;
+    h->vortx_transport.tls_policy = 0;
+    if (s->listen || s->external_sock || s->is_dtls || !s->tcp ||
+        !s->tcp->is_connected || !s->tcp->prot ||
+        (backend != VORTX_HTTP_TLS_SECURETRANSPORT &&
+         backend != VORTX_HTTP_TLS_MBEDTLS) ||
+        (h->vortx_transport.route != VORTX_HTTP_ROUTE_DIRECT_TCP &&
+         h->vortx_transport.route != VORTX_HTTP_ROUTE_HTTP_CONNECT) ||
+        strcmp(s->tcp->prot->name,
+               h->vortx_transport.route == VORTX_HTTP_ROUTE_DIRECT_TCP ?
+               "tcp" : "httpproxy"))
+        return;
+    if (s->verify == 1)
+        policy |= VORTX_HTTP_TLS_VERIFIED;
+    if (s->ca_file)
+        policy |= VORTX_HTTP_TLS_CUSTOM_CA;
+    if (s->cert_file || s->key_file || s->cert_buf || s->key_buf)
+        policy |= VORTX_HTTP_TLS_CLIENT_IDENTITY;
