+        policy |= VORTX_HTTP_TLS_HOST_OVERRIDE;
+    if (s->numerichost)
+        policy |= VORTX_HTTP_TLS_NUMERIC_HOST;
+    h->vortx_transport.tls_backend = backend;
+    h->vortx_transport.tls_policy = policy;
+    h->vortx_transport.version = VORTX_HTTP_TRANSPORT_VERSION;
