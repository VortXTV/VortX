+    // CPU option snapshots are safe while GPU resources are retired. Do not
+    // call update_options: it compiles shaders/creates renderer resources.
+    if (p->vortx_retired) {
+        m_config_cache_update(p->opts_cache);
+        m_config_cache_update(p->next_opts_cache);
+    }
+    p->vortx_frame_reason = vortx_frame_eligibility(vo, frame);
+    vortx_frame_report(p->vortx_frames, p->vortx_frame_reason);
+    mp_image_setrefp(&p->vortx_last_image, frame->current);
+    p->vortx_last_frame = *frame;
+    p->vortx_last_frame.current = p->vortx_last_image;
