+static int vortx_frame_mode(struct vo *vo, struct vortx_frame_mode_request *request)
+{
+    struct priv *p = vo->priv;
+    if (request->session != p->vortx_frames ||
+        !vortx_frame_owner_current(p->vortx_frames, request->subscription))
+        return MPV_VORTX_FRAME_STALE_OWNER;
+    if (!p->vortx_moltenvk || !vortx_frame_gpu_allowed(p->vortx_frames))
+        return MPV_VORTX_FRAME_GPU_BUSY;
+    if (!request->headless) {
+        if (!p->vortx_retired)
+            return MPV_VORTX_FRAME_READY;
+        if (create_gpu_resources(vo, true) < 0)
+            return MPV_VORTX_FRAME_GPU_BUSY;
+        if (!vortx_frame_owner_current(p->vortx_frames, request->subscription) ||
+            !vortx_frame_gpu_allowed(p->vortx_frames)) {
+            destroy_gpu_resources(vo, true);
+            return MPV_VORTX_FRAME_STALE_OWNER;
+        }
+        p->vortx_retired = false;
+        if (reconfig(vo, NULL) < 0) {
+            destroy_gpu_resources(vo, true);
+            p->vortx_retired = true;
+            return MPV_VORTX_FRAME_GPU_BUSY;
+        }
+        // Reconfiguration can block in the backend while detach invalidates
+        // this request. Revalidate AFTER it, not only after context creation.
+        if (!vortx_frame_owner_current(p->vortx_frames, request->subscription) ||
+            !vortx_frame_gpu_allowed(p->vortx_frames)) {
+            destroy_gpu_resources(vo, true);
+            p->vortx_retired = true;
+            return MPV_VORTX_FRAME_STALE_OWNER;
+        }
+        vortx_gpu_gate_reopen(&p->vortx_allocations);
+        vo->want_redraw = true;
+        return MPV_VORTX_FRAME_READY;
+    }
+    if (p->vortx_retired)
+        return MPV_VORTX_FRAME_READY;
+    if (request->captions_required)
+        return MPV_VORTX_FRAME_CAPTIONS_REQUIRED;
+    // The last image may be a paused redraw from before an option change.
+    // Refresh the real render configuration while GPU resources still exist.
+    update_options(vo);
+    struct vortx_frame_stamp stamp = vortx_frame_stamp(p->vortx_frames);
+    if (!p->vortx_last_image || stamp.file_epoch != p->vortx_last_frame.vortx_stamp.file_epoch ||
+        stamp.timeline_epoch != p->vortx_last_frame.vortx_stamp.timeline_epoch)
+        return MPV_VORTX_FRAME_NO_SOURCE;
+    int reason = vortx_frame_eligibility(vo, &p->vortx_last_frame);
+    if (reason != MPV_VORTX_FRAME_READY)
+        return reason;
+    if (p->hwdec_ctx.num_hwdecs != 1 ||
+        strcmp(p->hwdec_ctx.hwdecs[0]->driver->name, "videotoolbox"))
+        return MPV_VORTX_FRAME_NOT_VIDEOTOOLBOX;
+    struct timespec deadline;
+    timespec_get(&deadline, TIME_UTC);
+    deadline.tv_nsec += 100000000; // bounded allocation drain, not a playback timeout
+    if (deadline.tv_nsec >= 1000000000) {
+        deadline.tv_sec++;
+        deadline.tv_nsec -= 1000000000;
+    }
+    bool drained = vortx_gpu_gate_close(&p->vortx_allocations, &deadline);
+    mp_mutex_lock(&p->dr_lock);
+    bool has_buffers = p->num_dr_buffers != 0;
+    mp_mutex_unlock(&p->dr_lock);
+    if (!drained || has_buffers ||
+        !vortx_frame_owner_current(p->vortx_frames, request->subscription)) {
+        vortx_gpu_gate_reopen(&p->vortx_allocations);
+        return MPV_VORTX_FRAME_GPU_BUSY;
+    }
+    if (p->frame_pending)
+        flip_page(vo); // settle acquired swapchain frame while still foreground
+    destroy_gpu_resources(vo, true); // includes terminal backend waits, BEFORE ack
+    p->vortx_retired = true;
+    return vortx_frame_owner_current(p->vortx_frames, request->subscription)
+        ? MPV_VORTX_FRAME_READY : MPV_VORTX_FRAME_STALE_OWNER;
 }
 
