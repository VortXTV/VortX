diff --git a/include/mpv/vortx_apple_frame.h b/include/mpv/vortx_apple_frame.h
new file mode 100644
--- /dev/null
+++ b/include/mpv/vortx_apple_frame.h
@@ -0,0 +1,96 @@
+/* VortX native-frame ABI v1. SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef MPV_VORTX_APPLE_FRAME_H
+#define MPV_VORTX_APPLE_FRAME_H
+#include <stdbool.h>
+#include <stdint.h>
+#include "client.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define MPV_VORTX_APPLE_FRAME_ABI 1
+typedef struct mpv_vortx_apple_frame_session mpv_vortx_apple_frame_session;
+
+enum mpv_vortx_apple_frame_reason {
+    MPV_VORTX_FRAME_READY = 0,
+    MPV_VORTX_FRAME_NO_SOURCE,
+    MPV_VORTX_FRAME_STALE_OWNER,
+    MPV_VORTX_FRAME_NOT_VIDEOTOOLBOX,
+    MPV_VORTX_FRAME_DOLBY_VISION,
+    MPV_VORTX_FRAME_TRANSFORM_REQUIRED,
+    MPV_VORTX_FRAME_CAPTIONS_REQUIRED,
+    MPV_VORTX_FRAME_UNSUPPORTED_COLOR,
+    MPV_VORTX_FRAME_UNSUPPORTED_TIMING,
+    MPV_VORTX_FRAME_GPU_BUSY,
+    MPV_VORTX_FRAME_CLOSED,
+};
+
+struct mpv_vortx_apple_frame {
+    uint32_t abi_version;
+    uint32_t reason;
+    uint64_t subscription;
+    uint64_t owner;
+    uint64_t file_epoch;
+    uint64_t timeline_epoch;
+    uint64_t frame_id;
+    uint64_t lease;
+    /* CVPixelBufferRef, immutable. Valid until release_frame(session, lease).
+     * Callback may create a CMSampleBuffer retaining it, but must then release
+     * this lease promptly. At most TWO native leases may be outstanding. */
+    void *pixel_buffer;
+    double media_pts;
+    double media_duration;
+    double media_rate; // actual scheduled source-seconds / host-second
+    /* Two DIFFERENT clocks: source seconds above, raw mach host ns below.
+     * A zero host deadline means a paused/redraw sample, never a clock reset. */
+    uint64_t host_deadline_ns;
+    uint64_t host_observed_ns;
+    bool paused;
+};
+
+/* Invoked outside every client/VO/transport lock. It must not call libmpv or
+ * synchronously dispatch to its UI. Copy/enqueue bounded work only. An already
+ * admitted callback may finish after detach: validate its lease again before
+ * consuming it. Receiver context is retained until that callback returns. */
+typedef void (*mpv_vortx_apple_frame_callback)(void *context,
+    mpv_vortx_apple_frame_session *session,
+    const struct mpv_vortx_apple_frame *frame);
+typedef void (*mpv_vortx_apple_frame_destroy)(void *context);
+
+/* Session references are independent of mpv_handle lifetime. Keep a reference
+ * while calling ANY session operation, including duplicate/stale releases.
+ * These operations never call libmpv, submit GPU work, or await a UI thread. */
+MPV_EXPORT void mpv_vortx_apple_frame_retain(mpv_vortx_apple_frame_session *s);
+MPV_EXPORT void mpv_vortx_apple_frame_release(mpv_vortx_apple_frame_session *s);
+MPV_EXPORT void mpv_vortx_apple_frame_detach(mpv_vortx_apple_frame_session *s,
+                                          uint64_t subscription);
+MPV_EXPORT bool mpv_vortx_apple_frame_is_current(mpv_vortx_apple_frame_session *s,
+                                              uint64_t lease);
+MPV_EXPORT void mpv_vortx_apple_frame_release_frame(mpv_vortx_apple_frame_session *s,
+                                                uint64_t lease);
+/* Subscribe only after the application's matching FILE_LOADED admission.
+ * Returns an owned session reference and a nonzero subscription on success.
+ * No frame callback may synchronously enter libmpv, including destruction. */
+MPV_EXPORT int mpv_vortx_apple_frame_subscribe(mpv_handle *mpv, uint64_t owner,
+    mpv_vortx_apple_frame_callback callback, mpv_vortx_apple_frame_destroy destroy,
+    void *context, mpv_vortx_apple_frame_session **session, uint64_t *subscription);
+/* Supply actual app lifecycle authority before initialize, and before asking
+ * to recreate GPU presentation. Serialized with core/VO transitions, including
+ * fresh VO initialization; permission alone never creates GPU state. For PiP,
+ * revoke only after a successful foreground headless acknowledgement. The host
+ * must finish this lifecycle barrier before returning from willResignActive;
+ * it is not permission to drain or destroy a GPU after entering background. */
+MPV_EXPORT void mpv_vortx_apple_frame_set_foreground(mpv_handle *mpv, bool foreground);
+/* Synchronous native acknowledgement. Run off the UI thread while foreground.
+ * Positive reason means refusal; zero confirms the requested transition.
+ * Detach cancels the owner, including a request still waiting for GPU drain.
+ * On canceled retirement resources can already be retired: restore explicitly
+ * on foreground, never infer that cancellation permits background GPU work. */
+MPV_EXPORT int mpv_vortx_apple_frame_set_headless(mpv_handle *mpv,
+    mpv_vortx_apple_frame_session *session, uint64_t subscription, bool headless);
+MPV_EXPORT int mpv_vortx_apple_frame_reason(mpv_vortx_apple_frame_session *session);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/video/out/vortx_apple_frame.h b/video/out/vortx_apple_frame.h
new file mode 100644
--- /dev/null
+++ b/video/out/vortx_apple_frame.h
@@ -0,0 +1,65 @@
+/* Internal native-frame transport. SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef VORTX_APPLE_FRAME_INTERNAL_H
+#define VORTX_APPLE_FRAME_INTERNAL_H
+#include <pthread.h>
+#include <time.h>
+#include "mpv/vortx_apple_frame.h"
+
+struct vortx_frame_stamp {
+    uint64_t file_epoch, timeline_epoch;
+};
+struct vortx_frame_buffer {
+    void *value;
+    void (*retain)(void *);
+    void (*release)(void *);
+};
+/* A separate decoder-thread gate: close FIRST, await admitted allocation
+ * calls, inspect outstanding buffers, then drain GPU on the VO thread.
+ * Never hold this mutex while GPU work or callbacks execute. */
+struct vortx_gpu_gate {
+    pthread_mutex_t lock;
+    pthread_cond_t idle;
+    unsigned in_flight;
+    bool closed;
+    uint64_t generation;
+};
+void vortx_gpu_gate_init(struct vortx_gpu_gate *g);
+void vortx_gpu_gate_destroy(struct vortx_gpu_gate *g);
+bool vortx_gpu_gate_enter(struct vortx_gpu_gate *g);
+void vortx_gpu_gate_leave(struct vortx_gpu_gate *g);
+/* Timeout leaves the gate closed; caller must explicitly restore foreground
+ * admission or continue retiring the request. It is never a drain receipt. */
+bool vortx_gpu_gate_close(struct vortx_gpu_gate *g, const struct timespec *deadline);
+void vortx_gpu_gate_reopen(struct vortx_gpu_gate *g);
+
+mpv_vortx_apple_frame_session *vortx_frame_create(void);
+/* Retires callbacks/epochs, but does NOT resume a suspended GPU. */
+void vortx_frame_close(mpv_vortx_apple_frame_session *s);
+/* Successful subscribe owns context; failed subscribe does not. */
+uint64_t vortx_frame_subscribe(mpv_vortx_apple_frame_session *s, uint64_t owner,
+    mpv_vortx_apple_frame_callback callback,
+    mpv_vortx_apple_frame_destroy destroy, void *context);
+bool vortx_frame_owner_current(mpv_vortx_apple_frame_session *s, uint64_t cookie);
+bool vortx_frame_subscribed(mpv_vortx_apple_frame_session *s);
+void vortx_frame_source(mpv_vortx_apple_frame_session *s, bool loaded);
+void vortx_frame_reset(mpv_vortx_apple_frame_session *s, uint64_t frame_cutoff);
+struct vortx_frame_stamp vortx_frame_stamp(mpv_vortx_apple_frame_session *s);
+void vortx_frame_set_foreground(mpv_vortx_apple_frame_session *s, bool foreground);
+bool vortx_frame_gpu_allowed(mpv_vortx_apple_frame_session *s);
+void vortx_frame_report(mpv_vortx_apple_frame_session *s, int reason);
+bool vortx_frame_host_deadline(uint64_t raw, int64_t local_now,
+    int64_t scheduled, bool paused, uint64_t *deadline);
+struct vortx_frame_mode_request {
+    mpv_vortx_apple_frame_session *session;
+    uint64_t subscription;
+    bool headless;
+    bool captions_required;
+    int reason;
+};
+/* Caller still owns buffer. No retain if publication is denied. Source stamp
+ * must have been attached when the core queued this frame, not at callback. */
+bool vortx_frame_publish(mpv_vortx_apple_frame_session *s,
+    struct vortx_frame_stamp stamp, uint64_t frame_id,
+    struct vortx_frame_buffer buffer, double media_pts, double media_duration, double media_rate,
+    uint64_t host_deadline_ns, uint64_t host_observed_ns, bool paused);
+#endif
diff --git a/video/out/vortx_apple_frame.c b/video/out/vortx_apple_frame.c
new file mode 100644
--- /dev/null
+++ b/video/out/vortx_apple_frame.c
@@ -0,0 +1,414 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include <assert.h>
+#include <errno.h>
+#include <math.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include "vortx_apple_frame.h"
+
+struct vortx_frame_receiver {
+    atomic_uint refs;
+    /* Written once before publication, immutable thereafter. */
+    uint64_t subscription;
+    uint64_t owner;
+    mpv_vortx_apple_frame_callback callback;
+    mpv_vortx_apple_frame_destroy destroy;
+    void *context;
+};
+struct vortx_frame_slot {
+    uint64_t lease, subscription, file_epoch, timeline_epoch;
+    struct vortx_frame_buffer buffer;
+};
+struct mpv_vortx_apple_frame_session {
+    atomic_uint refs;
+    pthread_mutex_t lock;
+    struct vortx_frame_receiver *receiver;
+    struct vortx_frame_slot slots[2];
+    uint64_t next_subscription, next_lease;
+    uint64_t file_epoch, timeline_epoch, cutoff, last_frame;
+    bool loaded, closed;
+    bool foreground;
+    int reason;
+};
+
+static void receiver_release(struct vortx_frame_receiver *r)
+{
+    if (r && atomic_fetch_sub_explicit(&r->refs, 1, memory_order_acq_rel) == 1) {
+        if (r->destroy)
+            r->destroy(r->context);
+        free(r);
+    }
+}
+
+mpv_vortx_apple_frame_session *vortx_frame_create(void)
+{
+    mpv_vortx_apple_frame_session *s = calloc(1, sizeof(*s));
+    if (!s)
+        return NULL;
+    atomic_init(&s->refs, 1);
+    pthread_mutex_init(&s->lock, NULL);
+    s->file_epoch = s->timeline_epoch = 1;
+    s->foreground = true;
+    s->reason = MPV_VORTX_FRAME_NO_SOURCE;
+    return s;
+}
+
+void mpv_vortx_apple_frame_retain(mpv_vortx_apple_frame_session *s)
+{
+    atomic_fetch_add_explicit(&s->refs, 1, memory_order_relaxed);
+}
+
+void mpv_vortx_apple_frame_release(mpv_vortx_apple_frame_session *s)
+{
+    if (!s || atomic_fetch_sub_explicit(&s->refs, 1, memory_order_acq_rel) != 1)
+        return;
+    /* Each outstanding lease owns a session reference, so none remain. */
+    assert(!s->slots[0].lease && !s->slots[1].lease);
+    receiver_release(s->receiver);
+    pthread_mutex_destroy(&s->lock);
+    free(s);
+}
+
+uint64_t vortx_frame_subscribe(mpv_vortx_apple_frame_session *s, uint64_t owner,
+    mpv_vortx_apple_frame_callback callback,
+    mpv_vortx_apple_frame_destroy destroy, void *context)
+{
+    if (!s || !owner || !callback)
+        return 0;
+    pthread_mutex_lock(&s->lock);
+    if (s->closed || !s->loaded || s->next_subscription == UINT64_MAX) {
+        pthread_mutex_unlock(&s->lock);
+        return 0;
+    }
+    uint64_t cookie = ++s->next_subscription;
+    struct vortx_frame_receiver *r = malloc(sizeof(*r));
+    if (!r) {
+        pthread_mutex_unlock(&s->lock);
+        return 0;
+    }
+    *r = (struct vortx_frame_receiver){
+        .subscription = cookie, .owner = owner,
+        .callback = callback, .destroy = destroy, .context = context,
+    };
+    atomic_init(&r->refs, 1);
+    struct vortx_frame_receiver *old = s->receiver;
+    s->receiver = r;
+    s->last_frame = 0;
+    pthread_mutex_unlock(&s->lock);
+    receiver_release(old);
+    return cookie;
+}
+
+void mpv_vortx_apple_frame_detach(mpv_vortx_apple_frame_session *s, uint64_t cookie)
+{
+    if (!s || !cookie)
+        return;
+    struct vortx_frame_receiver *old = NULL;
+    pthread_mutex_lock(&s->lock);
+    if (s->receiver && s->receiver->subscription == cookie) {
+        old = s->receiver;
+        s->receiver = NULL;
+    }
+    pthread_mutex_unlock(&s->lock);
+    receiver_release(old);
+}
+
+bool vortx_frame_owner_current(mpv_vortx_apple_frame_session *s, uint64_t cookie)
+{
+    if (!s)
+        return false;
+    pthread_mutex_lock(&s->lock);
+    bool current = !s->closed && s->loaded && s->receiver &&
+                   s->receiver->subscription == cookie;
+    pthread_mutex_unlock(&s->lock);
+    return current;
+}
+
+bool vortx_frame_subscribed(mpv_vortx_apple_frame_session *s)
+{
+    if (!s)
+        return false;
+    pthread_mutex_lock(&s->lock);
+    bool subscribed = !s->closed && s->loaded && s->receiver;
+    pthread_mutex_unlock(&s->lock);
+    return subscribed;
+}
+
+void vortx_frame_close(mpv_vortx_apple_frame_session *s)
+{
+    if (!s)
+        return;
+    pthread_mutex_lock(&s->lock);
+    s->closed = true;
+    s->loaded = false;
+    s->foreground = false;
+    s->reason = MPV_VORTX_FRAME_CLOSED;
+    struct vortx_frame_receiver *old = s->receiver;
+    s->receiver = NULL;
+    pthread_mutex_unlock(&s->lock);
+    receiver_release(old);
+}
+
+void vortx_frame_source(mpv_vortx_apple_frame_session *s, bool loaded)
+{
+    if (!s)
+        return;
+    struct vortx_frame_receiver *old = NULL;
+    pthread_mutex_lock(&s->lock);
+    if (!loaded) {
+        /* START/END invalidation is native and cannot be undone by reusing a
+         * host owner number, even for an A -> B -> A transition. */
+        if (s->file_epoch == UINT64_MAX) {
+            s->closed = true;
+        } else {
+            s->file_epoch++;
+        }
+        s->timeline_epoch = 1;
+        s->cutoff = s->last_frame = 0;
+        old = s->receiver;
+        s->receiver = NULL;
+    }
+    s->loaded = loaded && !s->closed;
+    s->reason = MPV_VORTX_FRAME_NO_SOURCE;
+    pthread_mutex_unlock(&s->lock);
+    receiver_release(old);
+}
+
+void vortx_frame_set_foreground(mpv_vortx_apple_frame_session *s, bool foreground)
+{
+    if (!s)
+        return;
+    pthread_mutex_lock(&s->lock);
+    s->foreground = foreground && !s->closed;
+    pthread_mutex_unlock(&s->lock);
+}
+
+bool vortx_frame_gpu_allowed(mpv_vortx_apple_frame_session *s)
+{
+    /* Allocation failure disables the new feature, not ordinary MPV. */
+    if (!s)
+        return true;
+    pthread_mutex_lock(&s->lock);
+    bool allowed = s->foreground && !s->closed;
+    pthread_mutex_unlock(&s->lock);
+    return allowed;
+}
+
+void vortx_frame_report(mpv_vortx_apple_frame_session *s, int reason)
+{
+    if (!s)
+        return;
+    pthread_mutex_lock(&s->lock);
+    if (!s->closed)
+        s->reason = reason;
+    pthread_mutex_unlock(&s->lock);
+}
+
+int mpv_vortx_apple_frame_reason(mpv_vortx_apple_frame_session *s)
+{
+    if (!s)
+        return MPV_VORTX_FRAME_NO_SOURCE;
+    pthread_mutex_lock(&s->lock);
+    int reason = s->reason;
+    pthread_mutex_unlock(&s->lock);
+    return reason;
+}
+
+bool vortx_frame_host_deadline(uint64_t raw, int64_t local_now,
+    int64_t scheduled, bool paused, uint64_t *deadline)
+{
+    if (!deadline || !raw || local_now < 0 || (uint64_t)local_now > raw)
+        return false;
+    if (paused) {
+        *deadline = 0;
+        return true;
+    }
+    if (scheduled <= 0)
+        return false;
+    // local_now must be mp_time_ns_from_raw_time(raw): the SAME sample, not
+    // a second time read. This recovers the process offset without jitter.
+    uint64_t offset = raw - (uint64_t)local_now;
+    if ((uint64_t)scheduled > UINT64_MAX - offset)
+        return false;
+    *deadline = offset + (uint64_t)scheduled;
+    return true;
+}
+
+void vortx_frame_reset(mpv_vortx_apple_frame_session *s, uint64_t cutoff)
+{
+    if (!s)
+        return;
+    pthread_mutex_lock(&s->lock);
+    if (s->timeline_epoch == UINT64_MAX) {
+        s->closed = true;
+    } else {
+        s->timeline_epoch++;
+    }
+    s->cutoff = cutoff;
+    s->last_frame = 0;
+    pthread_mutex_unlock(&s->lock);
+}
+
+struct vortx_frame_stamp vortx_frame_stamp(mpv_vortx_apple_frame_session *s)
+{
+    if (!s)
+        return (struct vortx_frame_stamp){0};
+    pthread_mutex_lock(&s->lock);
+    struct vortx_frame_stamp stamp = {s->file_epoch, s->timeline_epoch};
+    pthread_mutex_unlock(&s->lock);
+    return stamp;
+}
+
+bool mpv_vortx_apple_frame_is_current(mpv_vortx_apple_frame_session *s, uint64_t lease)
+{
+    if (!s || !lease)
+        return false;
+    bool current = false;
+    pthread_mutex_lock(&s->lock);
+    for (int n = 0; n < 2; n++) {
+        const struct vortx_frame_slot *slot = &s->slots[n];
+        if (slot->lease == lease) {
+            current = !s->closed && s->loaded && s->receiver &&
+                slot->subscription == s->receiver->subscription &&
+                slot->file_epoch == s->file_epoch &&
+                slot->timeline_epoch == s->timeline_epoch;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&s->lock);
+    return current;
+}
+
+void mpv_vortx_apple_frame_release_frame(mpv_vortx_apple_frame_session *s, uint64_t lease)
+{
+    if (!s || !lease)
+        return;
+    struct vortx_frame_buffer buffer = {0};
+    pthread_mutex_lock(&s->lock);
+    for (int n = 0; n < 2; n++) {
+        if (s->slots[n].lease == lease) {
+            buffer = s->slots[n].buffer;
+            s->slots[n] = (struct vortx_frame_slot){0};
+            break;
+        }
+    }
+    pthread_mutex_unlock(&s->lock);
+    if (buffer.value) {
+        buffer.release(buffer.value);
+        mpv_vortx_apple_frame_release(s);
+    }
+}
+
+bool vortx_frame_publish(mpv_vortx_apple_frame_session *s,
+    struct vortx_frame_stamp stamp, uint64_t frame_id,
+    struct vortx_frame_buffer buffer, double pts, double duration, double rate,
+    uint64_t deadline, uint64_t observed, bool paused)
+{
+    if (!s || !buffer.value || !buffer.retain || !buffer.release ||
+        !isfinite(pts) || pts < 0 || !isfinite(duration) || duration < 0 ||
+        !isfinite(rate) || rate <= 0 ||
+        (!paused && (!deadline || !observed)))
+        return false;
+    pthread_mutex_lock(&s->lock);
+    int index = !s->slots[0].lease ? 0 : !s->slots[1].lease ? 1 : -1;
+    struct vortx_frame_receiver *r = s->receiver;
+    if (s->closed || !s->loaded || !r || index < 0 ||
+        s->next_lease == UINT64_MAX || stamp.file_epoch != s->file_epoch ||
+        stamp.timeline_epoch != s->timeline_epoch || frame_id <= s->cutoff ||
+        frame_id <= s->last_frame)
+    {
+        pthread_mutex_unlock(&s->lock);
+        return false;
+    }
+    uint64_t lease = ++s->next_lease;
+    s->reason = MPV_VORTX_FRAME_READY;
+    s->last_frame = frame_id;
+    atomic_fetch_add_explicit(&r->refs, 1, memory_order_relaxed);
+    /* One reference for the outstanding lease, another for this callback. */
+    mpv_vortx_apple_frame_retain(s);
+    mpv_vortx_apple_frame_retain(s);
+    s->slots[index] = (struct vortx_frame_slot){
+        lease, r->subscription, stamp.file_epoch, stamp.timeline_epoch, buffer,
+    };
+    struct mpv_vortx_apple_frame packet = {
+        .abi_version = MPV_VORTX_APPLE_FRAME_ABI,
+        .reason = MPV_VORTX_FRAME_READY, .subscription = r->subscription,
+        .owner = r->owner, .file_epoch = stamp.file_epoch,
+        .timeline_epoch = stamp.timeline_epoch, .frame_id = frame_id,
+        .lease = lease, .pixel_buffer = buffer.value,
+        .media_pts = pts, .media_duration = duration, .media_rate = rate,
+        .host_deadline_ns = deadline, .host_observed_ns = observed, .paused = paused,
+    };
+    pthread_mutex_unlock(&s->lock);
+    /* The VO still owns the input until publish returns. Retain and release
+     * callbacks, like receiver callbacks, must run outside transport locks. */
+    buffer.retain(buffer.value);
+    r->callback(r->context, s, &packet);
+    receiver_release(r);
+    mpv_vortx_apple_frame_release(s);
+    return true;
+}
+
+void vortx_gpu_gate_init(struct vortx_gpu_gate *g)
+{
+    *g = (struct vortx_gpu_gate){0};
+    pthread_mutex_init(&g->lock, NULL);
+    pthread_cond_init(&g->idle, NULL);
+}
+void vortx_gpu_gate_destroy(struct vortx_gpu_gate *g)
+{
+    assert(!g->in_flight);
+    pthread_cond_destroy(&g->idle);
+    pthread_mutex_destroy(&g->lock);
+}
+bool vortx_gpu_gate_enter(struct vortx_gpu_gate *g)
+{
+    pthread_mutex_lock(&g->lock);
+    bool allowed = !g->closed;
+    if (allowed)
+        g->in_flight++;
+    pthread_mutex_unlock(&g->lock);
+    return allowed;
+}
+void vortx_gpu_gate_leave(struct vortx_gpu_gate *g)
+{
+    pthread_mutex_lock(&g->lock);
+    assert(g->in_flight > 0);
+    if (!--g->in_flight)
+        pthread_cond_broadcast(&g->idle);
+    pthread_mutex_unlock(&g->lock);
+}
+bool vortx_gpu_gate_close(struct vortx_gpu_gate *g, const struct timespec *deadline)
+{
+    pthread_mutex_lock(&g->lock);
+    g->closed = true;
+    if (g->generation == UINT64_MAX) {
+        pthread_mutex_unlock(&g->lock);
+        return false;
+    }
+    uint64_t generation = ++g->generation;
+    pthread_cond_broadcast(&g->idle);
+    while (g->in_flight) {
+        if (!g->closed || g->generation != generation) {
+            pthread_mutex_unlock(&g->lock);
+            return false;
+        }
+        if (pthread_cond_timedwait(&g->idle, &g->lock, deadline) != 0) {
+            pthread_mutex_unlock(&g->lock);
+            return false;
+        }
+    }
+    bool drained = g->closed && g->generation == generation;
+    pthread_mutex_unlock(&g->lock);
+    return drained;
+}
+void vortx_gpu_gate_reopen(struct vortx_gpu_gate *g)
+{
+    pthread_mutex_lock(&g->lock);
+    if (g->generation != UINT64_MAX) {
+        g->generation++;
+        g->closed = false;
+    }
+    pthread_cond_broadcast(&g->idle);
+    pthread_mutex_unlock(&g->lock);
+}
