+static bool vortx_deliver_frame(struct vo *vo, struct vo_frame *frame)
+{
+    struct priv *p = vo->priv;
+    if (!vortx_frame_subscribed(p->vortx_frames)) {
+        mp_image_unrefp(&p->vortx_last_image);
