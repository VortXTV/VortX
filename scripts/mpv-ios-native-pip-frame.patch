+
+int mpv_vortx_apple_frame_subscribe(mpv_handle *ctx, uint64_t owner,
+    mpv_vortx_apple_frame_callback callback, mpv_vortx_apple_frame_destroy destroy,
+    void *context, mpv_vortx_apple_frame_session **session, uint64_t *subscription)
+{
+    if (!ctx || !session || !subscription)
+        return MPV_ERROR_INVALID_PARAMETER;
+    *session = NULL;
+    *subscription = 0;
+    mpv_vortx_apple_frame_session *s = ctx->clients->vortx_frames;
+    uint64_t cookie = vortx_frame_subscribe(s, owner, callback, destroy, context);
+    if (!cookie)
+        return MPV_ERROR_PROPERTY_UNAVAILABLE;
+    uint_fast64_t previous = atomic_load(&ctx->vortx_subscription);
+    while (previous < cookie && !atomic_compare_exchange_weak(
+        &ctx->vortx_subscription, &previous, cookie)) {}
+    mpv_vortx_apple_frame_retain(s);
+    *session = s;
+    *subscription = cookie;
+    lock_core(ctx);
+    if (ctx->mpctx->video_out)
+        vo_redraw(ctx->mpctx->video_out); // seed a paused source without playing
+    unlock_core(ctx);
+    return 0;
+}
+
+void mpv_vortx_apple_frame_set_foreground(mpv_handle *ctx, bool foreground)
+{
+    if (!ctx)
+        return;
+    // The same core barrier serializes video-chain initialization and mode
+    // transitions. Revocation cannot race a half-created GPU context.
+    lock_core(ctx);
+    vortx_frame_set_foreground(ctx->clients->vortx_frames, foreground);
+    unlock_core(ctx);
+}
+
+int mpv_vortx_apple_frame_set_headless(mpv_handle *ctx,
+    mpv_vortx_apple_frame_session *session, uint64_t subscription, bool headless)
+{
+    if (!ctx || !session || session != ctx->clients->vortx_frames ||
+        !vortx_frame_owner_current(session, subscription))
+        return MPV_VORTX_FRAME_STALE_OWNER;
+    lock_core(ctx);
+    struct vortx_frame_mode_request request = {
+        .session = session, .subscription = subscription, .headless = headless,
+        .captions_required = ctx->mpctx->current_track[0][STREAM_SUB] ||
+                             ctx->mpctx->current_track[1][STREAM_SUB],
+        .reason = MPV_VORTX_FRAME_NO_SOURCE,
+    };
+    if (ctx->mpctx->video_out && vortx_frame_owner_current(session, subscription))
+        vo_control(ctx->mpctx->video_out, VOCTRL_VORTX_NATIVE_FRAME_MODE, &request);
+    unlock_core(ctx);
+    return request.reason;
+}
