+// No demuxer/stream/AVIO/cancel pointer is retained here. Consumer and queued
+// owner each own one reference; the sole worker borrows the retained consumer
+// request only until its synchronous run returns and the caller joins it.
+struct demux_reference_request {
+    atomic_uint refs;                 // exactly one consumer + at most one queue
+    atomic_bool cancelled;            // independent request cancellation only
+    atomic_bool publication_validated; // release-publishes immutable reader job
+    int64_t deadline_ns;              // immutable finite monotonic deadline
+    mp_mutex lock;                   // state and move-only result lease
+    enum demux_reference_status state;
+    struct stream_reference_lease lease;
+    // Reader phases share the existing single queue/refcount/cancel mechanism,
+    // but NEVER the old INITIAL_REQUEST_ONLY output or authority enum.
+    bool is_reader;
+    enum demux_reference_reader_status reader_state;
+    bool reader_taken; // one timing copy; retained grant can revalidate again
+    int stream_index;
+    struct demux_reference_lifetime *owner;
+    unsigned owner_epoch;
+    struct mp_reference_reader_job *job;
+};
+
+#define REFERENCE_HANDOFF_MAX_NS MP_TIME_S_TO_NS(5)
+
+static void reference_lifetime_unref(struct demux_reference_lifetime *owner)
+{
+    if (owner && atomic_fetch_sub_explicit(&owner->refs, 1,
+                                           memory_order_acq_rel) == 1)
+        free(owner);
+}
+
+static bool reference_owner_current(const struct demux_reference_request *r)
+{
+    return r->owner && r->owner_epoch &&
+        !atomic_load_explicit(&r->owner->retired, memory_order_acquire) &&
+        atomic_load_explicit(&r->owner->epoch, memory_order_acquire) == r->owner_epoch;
+}
+
+static void reference_owner_retire(struct demux_internal *in)
+{
+    if (in->reference_lifetime)
+        atomic_store_explicit(&in->reference_lifetime->retired, true,
+                               memory_order_release);
+}
+
+// Called with in->lock BEFORE every timing/selection/seek/reset transition.
+static void reference_epoch_advance(struct demux_internal *in)
+{
+    struct demux_reference_lifetime *owner = in->reference_lifetime;
+    if (!owner)
+        return;
+    unsigned value = atomic_load_explicit(&owner->epoch, memory_order_relaxed);
+    if (value == UINT_MAX) {
+        reference_owner_retire(in);
+    } else {
+        atomic_store_explicit(&owner->epoch, value + 1, memory_order_release);
+    }
+}
+
+bool demux_reference_request_cancelled(struct demux_reference_request *r)
+{
+    return !r || atomic_load_explicit(&r->cancelled, memory_order_acquire) ||
+        mp_time_ns() >= r->deadline_ns || (r->is_reader && !reference_owner_current(r));
+}
+
+static void reference_request_unref(struct demux_reference_request *r)
+{
+    if (!r)
+        return;
+    unsigned previous = atomic_fetch_sub_explicit(&r->refs, 1,
+                                                   memory_order_acq_rel);
+    mp_assert(previous > 0 && previous <= 2);
+    if (previous == 1) {
+        stream_reference_lease_release(&r->lease);
+        mp_reference_reader_job_free(&r->job);
+        reference_lifetime_unref(r->owner);
+        mp_mutex_destroy(&r->lock);
+        free(r);
+    }
+}
+
+void demux_reference_request_cancel(struct demux_reference_request *r)
+{
+    if (r)
+        atomic_store_explicit(&r->cancelled, true, memory_order_release);
+}
+
+void demux_reference_request_release(struct demux_reference_request **handle)
+{
+    if (!handle)
+        return;
+    struct demux_reference_request *r = *handle;
+    *handle = NULL;
+    reference_request_unref(r);
+}
+
+enum demux_reference_status demux_reference_request_take(
+    struct demux_reference_request *r, struct stream_reference_lease *out)
+{
+    // Do not overwrite another owning result on caller misuse.
+    if (!r || r->is_reader || !out || out->source)
+        return DEMUX_REFERENCE_UNAVAILABLE;
+    mp_mutex_lock(&r->lock);
+    if (demux_reference_request_cancelled(r)) {
+        stream_reference_lease_release(&r->lease);
+        r->state = DEMUX_REFERENCE_CANCELLED;
+    }
+    enum demux_reference_status state = r->state;
+    if (state == DEMUX_REFERENCE_READY) {
+        if (stream_reference_lease_cancelled(&r->lease)) {
+            stream_reference_lease_release(&r->lease);
+            state = DEMUX_REFERENCE_UNAVAILABLE;
+        } else {
+            *out = r->lease;
+            r->lease = (struct stream_reference_lease){0};
+        }
+        // A ready lease can be moved out exactly once. Repeated take cannot
+        // issue another owning handle or revive an invalidated source epoch.
+        r->state = DEMUX_REFERENCE_UNAVAILABLE;
+    }
+    mp_mutex_unlock(&r->lock);
+    return state;
+}
+
+// Called with in->lock held. Only the demux owner may pass acquire=true;
+// abort-only calls may run while that owner is blocked in a read without the
+// lock, and must never touch its stream. This operation performs no source I/O.
+static bool finish_reference_request(struct demux_internal *in, bool acquire)
+{
+    struct demux_reference_request *r = in->reference_request;
+    if (!r)
+        return false;
+    in->reference_request = NULL;
+    if (r->is_reader) {
+        mp_mutex_lock(&r->lock);
+        bool current = acquire && !in->thread_terminate && !in->shutdown_async &&
+            in->reference_lifetime == r->owner &&
+            !demux_reference_request_cancelled(r) &&
+            !mp_cancel_test(in->d_thread->cancel) &&
+            (in->d_thread->desc == &demuxer_desc_lavf ||
+             in->d_thread->desc == &demuxer_desc_matroska) &&
+            !in->seeking && !in->tracks_switched && !in->back_demuxing;
+        struct sh_stream *reference = NULL;
+        unsigned references = 0;
+        for (int n = 0; current && n < in->num_streams; n++) {
+            struct sh_stream *s = in->streams[n];
+            if (s->type == STREAM_SUB && s->index == r->stream_index) {
+                references++;
+                reference = s;
+            }
+        }
+        current = current && references == 1 && reference;
+        if (current && r->reader_state == DEMUX_REFERENCE_READER_PENDING) {
+            if (in->d_thread->desc == &demuxer_desc_matroska) {
+                struct mkv_sparse_snapshot *snapshot = NULL;
+                if (demux_mkv_reference_sparse_capture(in->d_thread, reference,
+                        in->ts_offset, &snapshot)) {
+                    r->job = mp_reference_reader_job_create_mkv_sparse(
+                        in->d_thread->stream, snapshot, r->deadline_ns);
+                }
+                demux_mkv_reference_sparse_snapshot_free(&snapshot);
+            } else {
+                r->job = demux_lavf_reference_capture(in->d_thread, reference,
+                                                      in->ts_offset, r->deadline_ns);
+            }
+            current = r->job && !mp_reference_reader_job_cancelled(r->job);
+            r->reader_state = current ? DEMUX_REFERENCE_READER_CAPTURED :
+                                       DEMUX_REFERENCE_READER_UNAVAILABLE;
+        } else if (current && r->reader_state == DEMUX_REFERENCE_READER_REVALIDATING) {
+            if (in->d_thread->desc == &demuxer_desc_matroska) {
+                const struct mkv_sparse_snapshot *snapshot =
+                    mp_reference_reader_job_mkv_snapshot(r->job);
+                current = r->job && snapshot &&
+                    demux_mkv_reference_sparse_revalidate(in->d_thread, reference,
+                        in->ts_offset, snapshot) &&
+                    mp_reference_reader_job_revalidate(r->job, in->d_thread->stream) &&
+                    demux_mkv_reference_sparse_revalidate(in->d_thread, reference,
+                        in->ts_offset, snapshot);
+            } else {
+                current = r->job && demux_lavf_reference_revalidate(in->d_thread,
+                                                       reference, in->ts_offset, r->job);
+            }
+            r->reader_state = current ? DEMUX_REFERENCE_READER_READY :
+                                       DEMUX_REFERENCE_READER_UNAVAILABLE;
+        } else {
+            r->reader_state = DEMUX_REFERENCE_READER_UNAVAILABLE;
+        }
+        if (demux_reference_request_cancelled(r))
+            r->reader_state = DEMUX_REFERENCE_READER_CANCELLED;
+        atomic_store_explicit(&r->publication_validated,
+            r->reader_taken && r->reader_state == DEMUX_REFERENCE_READER_READY,
+            memory_order_release);
+        mp_mutex_unlock(&r->lock);
+        reference_request_unref(r);
+        return true;
+    }
+    struct stream_reference_lease lease = {0};
+    bool ready = acquire && !in->thread_terminate && !in->shutdown_async &&
+        !demux_reference_request_cancelled(r) &&
+        !mp_cancel_test(in->d_thread->cancel) &&
+        stream_reference_source_acquire_initial_request(in->d_thread->stream,
+                                                       &lease);
+    mp_mutex_lock(&r->lock);
+    if (demux_reference_request_cancelled(r)) {
+        r->state = DEMUX_REFERENCE_CANCELLED;
+    } else if (ready && !stream_reference_lease_cancelled(&lease)) {
+        r->lease = lease;
+        lease = (struct stream_reference_lease){0};
+        r->state = DEMUX_REFERENCE_READY;
+    } else {
+        r->state = DEMUX_REFERENCE_UNAVAILABLE;
+    }
+    mp_mutex_unlock(&r->lock);
+    stream_reference_lease_release(&lease);
+    reference_request_unref(r); // release the queue's reference only
+    return true;
+}
+
+struct demux_reference_request *demux_reference_source_request(
+    struct demuxer *demuxer, int64_t deadline_ns)
+{
+    if (!demuxer)
+        return NULL;
+    struct demux_internal *in = demuxer->in;
+    mp_assert(demuxer == in->d_user);
+    int64_t now = mp_time_ns();
+    // Both values are nonnegative and deadline>now, so subtraction cannot
+    // overflow. Do not clamp an unbounded caller deadline into an accepted one.
+    if (deadline_ns <= now || deadline_ns - now > REFERENCE_HANDOFF_MAX_NS)
+        return NULL;
+    struct demux_reference_request *r = calloc(1, sizeof(*r));
+    if (!r)
+        return NULL;
+    atomic_init(&r->refs, 1);
+    atomic_init(&r->cancelled, false);
+    atomic_init(&r->publication_validated, false);
+    r->deadline_ns = deadline_ns;
+    r->state = DEMUX_REFERENCE_PENDING;
+    if (mp_mutex_init(&r->lock)) {
+        free(r);
+        return NULL;
+    }
+
+    mp_mutex_lock(&in->lock);
+    // Expiry/cancellation can free the one queue slot without waiting for or
+    // interrupting a blocked playback read. No producer holds r outside lock.
+    if (in->reference_request &&
+        demux_reference_request_cancelled(in->reference_request))
+        finish_reference_request(in, false);
+    if (in->thread_terminate || in->shutdown_async || in->reference_request ||
+        demux_reference_request_cancelled(r)) {
+        mp_mutex_unlock(&in->lock);
+        reference_request_unref(r);
+        return NULL;
+    }
+    // There are no public retain/copy operations; these two fixed roles cannot
+    // overflow the private count or recycle a still-live request identity.
+    atomic_fetch_add_explicit(&r->refs, 1, memory_order_relaxed);
+    in->reference_request = r;
+    if (in->threading) {
+        mp_cond_signal(&in->wakeup);
+    } else {
+        // The consumer is also the demux owner in nonthreaded mode. Acquire
+        // directly, without calling thread_work or initiating reads/seeks.
+        finish_reference_request(in, true);
+    }
+    mp_mutex_unlock(&in->lock);
+    return r;
+}
+
+struct demux_reference_request *demux_reference_reader_request(
+    struct demuxer *demuxer, int stream_index, int64_t deadline_ns)
+{
+    if (!demuxer || stream_index < 0)
+        return NULL;
+    struct demux_internal *in = demuxer->in;
+    mp_assert(demuxer == in->d_user);
+    int64_t now = mp_time_ns();
+    if (deadline_ns <= now || deadline_ns - now > MP_TIME_S_TO_NS(30))
+        return NULL;
+    struct demux_reference_request *r = calloc(1, sizeof(*r));
+    if (!r)
+        return NULL;
+    atomic_init(&r->refs, 1);
+    atomic_init(&r->cancelled, false);
+    atomic_init(&r->publication_validated, false);
+    r->deadline_ns = deadline_ns;
+    r->is_reader = true;
+    r->reader_state = DEMUX_REFERENCE_READER_PENDING;
+    r->stream_index = stream_index;
+    if (mp_mutex_init(&r->lock)) {
+        free(r);
+        return NULL;
+    }
+    mp_mutex_lock(&in->lock);
+    if (in->reference_request && demux_reference_request_cancelled(in->reference_request))
+        finish_reference_request(in, false);
+    if (!in->reference_lifetime) {
+        in->reference_lifetime = calloc(1, sizeof(*in->reference_lifetime));
+        if (in->reference_lifetime) {
+            atomic_init(&in->reference_lifetime->refs, 1);
+            atomic_init(&in->reference_lifetime->epoch, 1);
+            atomic_init(&in->reference_lifetime->retired, false);
+        }
+    }
+    struct demux_reference_lifetime *owner = in->reference_lifetime;
+    // Only the live consumer creates a request, under in->lock. Releases may
+    // decrement concurrently, so reserve the extra retained lifetime by CAS.
+    unsigned count = owner ? atomic_load_explicit(&owner->refs, memory_order_relaxed) : 0;
+    bool retained = false;
+    while (count && count < UINT_MAX && !retained) {
+        retained = atomic_compare_exchange_weak_explicit(&owner->refs, &count, count + 1,
+            memory_order_relaxed, memory_order_relaxed);
+    }
+    if (retained) {
+        r->owner = owner;
+        r->owner_epoch = atomic_load_explicit(&owner->epoch, memory_order_acquire);
+    }
+    if (!retained || in->thread_terminate || in->shutdown_async ||
+        in->reference_request || stream_index >= in->num_streams ||
+        demux_reference_request_cancelled(r)) {
+        mp_mutex_unlock(&in->lock);
+        reference_request_unref(r);
+        return NULL;
+    }
+    atomic_fetch_add_explicit(&r->refs, 1, memory_order_relaxed);
+    in->reference_request = r;
+    if (in->threading)
+        mp_cond_signal(&in->wakeup);
+    else
+        finish_reference_request(in, true);
+    mp_mutex_unlock(&in->lock);
+    return r;
+}
+
+enum demux_reference_reader_status demux_reference_reader_status(
+    struct demux_reference_request *r)
+{
+    if (!r || !r->is_reader)
+        return DEMUX_REFERENCE_READER_UNAVAILABLE;
+    mp_mutex_lock(&r->lock);
+    if (demux_reference_request_cancelled(r) ||
+        (r->job && mp_reference_reader_job_cancelled(r->job)))
+        r->reader_state = DEMUX_REFERENCE_READER_CANCELLED;
+    enum demux_reference_reader_status result = r->reader_state;
+    mp_mutex_unlock(&r->lock);
+    return result;
+}
+
+static int reference_reader_interrupt(void *opaque)
+{
+    return demux_reference_request_cancelled(opaque);
+}
+
+bool demux_reference_reader_run(struct demux_reference_request *r)
+{
+    if (!r || !r->is_reader)
+        return false;
+    mp_mutex_lock(&r->lock);
+    bool allowed = r->reader_state == DEMUX_REFERENCE_READER_CAPTURED &&
+        !demux_reference_request_cancelled(r) && r->job;
+    if (allowed)
+        r->reader_state = DEMUX_REFERENCE_READER_RUNNING;
+    mp_mutex_unlock(&r->lock);
+    if (!allowed)
+        return false;
+    const AVIOInterruptCB cb = {.callback = reference_reader_interrupt, .opaque = r};
+    bool decoded = mp_reference_reader_job_run(r->job, &cb);
+    mp_mutex_lock(&r->lock);
+    bool cancelled = demux_reference_request_cancelled(r) ||
+        mp_reference_reader_job_cancelled(r->job);
+    r->reader_state = cancelled ? DEMUX_REFERENCE_READER_CANCELLED :
+        decoded ? DEMUX_REFERENCE_READER_DECODED : DEMUX_REFERENCE_READER_UNAVAILABLE;
+    mp_mutex_unlock(&r->lock);
+    return decoded && !cancelled;
+}
+
+bool demux_reference_reader_revalidate(struct demuxer *demuxer,
+                                      struct demux_reference_request *r)
+{
+    if (!demuxer || !r || !r->is_reader)
+        return false;
+    struct demux_internal *in = demuxer->in;
+    mp_assert(demuxer == in->d_user);
+    mp_mutex_lock(&in->lock);
+    if (in->reference_request && demux_reference_request_cancelled(in->reference_request))
+        finish_reference_request(in, false);
+    mp_mutex_lock(&r->lock);
+    bool ready = !in->thread_terminate && !in->shutdown_async &&
+        !in->reference_request && in->reference_lifetime == r->owner &&
+        !demux_reference_request_cancelled(r) &&
+        (r->reader_state == DEMUX_REFERENCE_READER_DECODED ||
+         (r->reader_taken && r->reader_state == DEMUX_REFERENCE_READER_READY)) &&
+        !mp_reference_reader_job_cancelled(r->job);
+    if (ready) {
+        // Consumer joined its sole worker: only consumer+one queue refs exist.
+        mp_assert(atomic_load_explicit(&r->refs, memory_order_relaxed) == 1);
+        atomic_fetch_add_explicit(&r->refs, 1, memory_order_relaxed);
+        atomic_store_explicit(&r->publication_validated, false, memory_order_release);
+        r->reader_state = DEMUX_REFERENCE_READER_REVALIDATING;
+        in->reference_request = r;
+    }
+    mp_mutex_unlock(&r->lock);
+    if (ready) {
+        if (in->threading)
+            mp_cond_signal(&in->wakeup);
+        else
+            finish_reference_request(in, true);
+    }
+    mp_mutex_unlock(&in->lock);
+    return ready;
+}
+
+bool demux_reference_reader_take(struct demux_reference_request *r,
+                                struct demux_reference_result *out)
+{
+    if (!r || !r->is_reader || !out || out->source_generation ||
+        out->complete || out->num_pairs)
+        return false;
+    mp_mutex_lock(&r->lock);
+    bool ready = !r->reader_taken && r->reader_state == DEMUX_REFERENCE_READER_READY &&
+        !demux_reference_request_cancelled(r) &&
+        mp_reference_reader_job_copy_result(r->job, out);
+    if (ready) {
+        out->demux_epoch = r->owner_epoch;
+        // Check after the copy too: a concurrent seek/track/close invalidates
+        // the whole value, never a truncated or partially admitted result.
+        if (demux_reference_request_cancelled(r) ||
+            mp_reference_reader_job_cancelled(r->job)) {
+            *out = (struct demux_reference_result){0};
+            ready = false;
+        }
+        r->reader_taken = true;
+        atomic_store_explicit(&r->publication_validated, ready, memory_order_release);
+        if (!ready)
+            r->reader_state = DEMUX_REFERENCE_READER_UNAVAILABLE;
+    }
+    mp_mutex_unlock(&r->lock);
+    return ready;
+}
+
+bool demux_reference_reader_publication_current(struct demux_reference_request *r)
+{
+    // Retained allocation required through OSD quiescence. The acquire pairs
+    // with successful take/final-owner validation and publishes immutable job
+    // fields. No mutable phase/result/decoded field or deadline is read here.
+    return r && r->is_reader &&
+        atomic_load_explicit(&r->publication_validated, memory_order_acquire) &&
+        !atomic_load_explicit(&r->cancelled, memory_order_acquire) &&
+        reference_owner_current(r) && mp_reference_reader_job_publication_current(r->job);
+}
