+struct stream;
+struct mp_reference_reader_job;
+struct stream_reference_reader_grant;
+
+#define DEMUX_MKV_REFERENCE_VERSION 1u
+struct demux_mkv_reference_spec {
+    unsigned version, num_tracks;
+    uint64_t track_number, track_uid, codec_delay_ns, default_duration_ns;
+    unsigned codec_delay_present, default_duration_present;
+    int64_t timecode_scale, segment_start, segment_end;
+    double demux_start_time, consumer_ts_offset;
+    int source_origin, owner_stream_index, owner_demuxer_id;
+    unsigned char segment_uid[16];
+};
+
+/* Actual original native-MKV owner only, excluded from seek/track/close.
+ * out must be zero initialized, and size is checked before any write. All
+ * output is owned scalar data. No emulated ff_index/title/language matching.
+ * Initial subset: UTF8 text, no private bytes/encodings/ordered timeline,
+ * known raw TrackNumber/UID/scale/delay and unmodified consumer timestamps. */
+bool demux_mkv_reference_capture_spec(struct demuxer *demuxer,
+    struct sh_stream *selected, double consumer_ts_offset,
+    struct demux_mkv_reference_spec *out, size_t out_size);
+bool demux_mkv_reference_revalidate_spec(struct demuxer *demuxer,
+    struct sh_stream *selected, double consumer_ts_offset,
+    const struct demux_mkv_reference_spec *expected, size_t expected_size);
+
+/* Only a new duplicate demuxer owned by this worker. Search by real raw
+ * TrackNumber+UID, then compare all admitted codec/timestamp facts. The
+ * returned pointer belongs to that duplicate and never leaves the worker.
+ * This comparison alone never proves that two resources are the same. */
+struct sh_stream *demux_mkv_reference_find_duplicate(struct demuxer *duplicate,
+    const struct demux_mkv_reference_spec *expected, size_t expected_size);
+
+/* One synchronous utility worker. Its existing owned grant must already carry
+ * current-response/entity/peer/TLS/budget authority; INITIAL_REQUEST_ONLY is
+ * not accepted here. Callback storage and grant outlive the entire call.
+ * Creates its own config/global/stream/demux/decoder and closes them all.
+ * out zero initialized; all partial pairs remain private and are cleared on
+ * failure. Caller still queues original-owner revalidation and core admission.
+ * The inherited native parser uses MPV mandatory-OOM allocation primitives;
+ * bounded worker allocation/error testing remains an explicit activation gate. */
+bool demux_mkv_reference_run(struct stream_reference_reader_grant *grant,
+    const struct demux_mkv_reference_spec *expected, size_t expected_size,
+    int64_t deadline_ns, const AVIOInterruptCB *interrupt,
+    struct demux_reference_result *out, size_t out_size);
+
+/* The concrete sparse owner snapshot/job/worker route is declared in
+ * reference_mkv_sparse_planner.h + reference_reader_internal.h. The old
+ * composition-prose-only constructor is deliberately not advertised here. */
diff --git a/demux/reference_mkv_reader.c b/demux/reference_mkv_reader.c
