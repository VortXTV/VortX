new file mode 100644
--- /dev/null
+++ b/demux/reference_mkv_sparse_planner.h
@@ -0,0 +1,86 @@
+/* Private source proposal. No network authority or public ABI. */
+#pragma once
+#include "reference_mkv.h"
+#include "reference_mkv_sparse.h"
+
+struct mkv_sparse_planner;
+#define MKV_SPARSE_MAX_CAPTURE_HINTS 8192u
+struct mkv_sparse_snapshot {
+    struct demux_mkv_reference_spec spec;
+    int64_t original_origin_ns;
+    size_t hint_count;
+    uint64_t hints[MKV_SPARSE_MAX_CAPTURE_HINTS];
+};
+/* Actual original native owner only, excluded from read/seek/close. Allocates
+ * an owned source-private scalar snapshot, never reads deferred Cues or I/O.
+ * Header/index positions are hints only. Failure leaves *out NULL. */
+bool demux_mkv_reference_sparse_capture(struct demuxer *d, struct sh_stream *selected,
+    double consumer_ts_offset, struct mkv_sparse_snapshot **out);
+bool demux_mkv_reference_sparse_revalidate(struct demuxer *d, struct sh_stream *selected,
+    double consumer_ts_offset, const struct mkv_sparse_snapshot *expected);
+void demux_mkv_reference_sparse_snapshot_free(struct mkv_sparse_snapshot **snapshot);
+struct mkv_sparse_bytes {
+    uint64_t start;
+    uint32_t bytes;
+    const unsigned char *data;
+};
+struct mkv_sparse_text {
+    uint64_t source_position;
+    int64_t pts_ns;
+    uint64_t duration_ns;
+    uint32_t bytes;
+    const unsigned char *data;
+};
+struct mkv_sparse_progress {
+    uint32_t batches, clusters, excluded_clusters;
+    uint64_t requested_payload_bytes, block_headers, selected_occurrences;
+    bool chain_complete, metadata_matched, complete, failed;
+};
+enum mkv_sparse_step { MKV_SPARSE_ERROR = -1, MKV_SPARSE_FINISHED = 0,
+                       MKV_SPARSE_FETCH = 1 };
+
+/* Owned scalar descriptor and hints only. Hints are untrusted acceleration
+ * offsets; a hint never creates a Cluster or absence witness. All allocations
+ * are fallible. Abort callback/storage outlive planner destruction. */
+struct mkv_sparse_planner *mkv_sparse_planner_create(
+    const struct demux_mkv_reference_spec *spec, size_t spec_size,
+    int64_t original_origin_ns, uint64_t known_entity_bytes,
+    const uint64_t *hints, size_t hint_count,
+    bool (*abort_requested)(void *), void *abort_opaque);
+
+/* One worker, one pending batch. The supplied spans are copied and immutable
+ * until accept. No I/O is hidden in next. No range end is media EOF. */
+enum mkv_sparse_step mkv_sparse_planner_next(struct mkv_sparse_planner *p,
+    struct mkv_sparse_span *out, size_t capacity, size_t *count,
+    uint64_t *batch_id);
+
+/* Caller supplies ONLY a fully framed/admitted FF sparse batch, in exactly the
+ * emitted span order. This parser primitive does not authenticate that caller.
+ * It copies bytes, so no response buffer or live transport is retained. False
+ * framing, a missing/extra/changed span or allocation failure is sticky failure. */
+bool mkv_sparse_planner_accept(struct mkv_sparse_planner *p, uint64_t batch_id,
+    const struct mkv_sparse_bytes *parts, size_t count, bool batch_validated);
+bool mkv_sparse_planner_progress(const struct mkv_sparse_planner *p,
+    struct mkv_sparse_progress *out, size_t out_size);
+/* Returned records are planner-owned, source-ordered, and available only after
+ * actual Segment-chain/metadata/every-relevant-child completion. */
+const struct mkv_sparse_text *mkv_sparse_planner_text(
+    const struct mkv_sparse_planner *p, size_t *count);
+void mkv_sparse_planner_destroy(struct mkv_sparse_planner **p);
+
+/* Decode completed owned records with the SAME genuine SUBRIP decoder and
+ * mkv_reference_decode helper as the sequential native worker. This fills only
+ * tentative pairs; it never marks complete or invents source/response witness. */
+bool demux_mkv_reference_sparse_decode(const struct mkv_sparse_planner *planner,
+    const struct demux_mkv_reference_spec *spec, size_t spec_size,
+    const AVIOInterruptCB *owned_interrupt,
+    struct demux_reference_result *out, size_t out_size);
+
+/* Actual synchronous utility worker, captured reader-grant only. It owns every
+ * copied batch/plan/decoder; grant and job callback survive join/last close.
+ * Final original-owner source/track/epoch/intent admission is still mandatory. */
+bool demux_mkv_reference_sparse_run(struct stream_reference_reader_grant *grant,
+    const struct demux_mkv_reference_spec *spec, size_t spec_size,
+    int64_t original_origin_ns, const uint64_t *owned_hints, size_t hint_count,
+    int64_t deadline_ns, const AVIOInterruptCB *owned_interrupt,
+    struct demux_reference_result *out, size_t out_size);
diff --git a/demux/reference_mkv_sparse_worker.c b/demux/reference_mkv_sparse_worker.c
new file mode 100644
--- /dev/null
+++ b/demux/reference_mkv_sparse_worker.c
@@ -0,0 +1,181 @@
+/* Private actual sparse utility worker. Source proposal, UNCOMPILED/UNRUN.
+ * Ordinary playback never uses this stream/parser or its optional restrictions. */
+#include <stdlib.h>
+#include <string.h>
+#include <libavcodec/codec_id.h>
+#include "common/common.h"
+#include "osdep/timer.h"
+#include "stream/reference_source.h"
+#include "stream/vortx_reference_sparse.h"
+#include "reference_mkv_sparse_planner.h"
+
+struct mkv_sparse_worker {
+    struct stream_reference_reader_grant *grant;
+    const AVIOInterruptCB *interrupt;
+    int64_t deadline;
+};
+static bool mkv_sparse_worker_abort(void *opaque)
+{
+    struct mkv_sparse_worker *w = opaque;
+    return mp_time_ns() >= w->deadline ||
+        stream_reference_reader_cancelled(w->grant) ||
+        !stream_reference_reader_current(w->grant) ||
+        w->interrupt->callback(w->interrupt->opaque);
+}
+static int mkv_sparse_worker_interrupt(void *opaque)
+{ return mkv_sparse_worker_abort(opaque); }
+static void mkv_sparse_free_parts(struct mkv_sparse_bytes *parts, size_t count)
+{
+    for (size_t i = 0; i < count; i++) {
+        free((void *)parts[i].data);
+        parts[i] = (struct mkv_sparse_bytes){0};
+    }
+}
+
+bool demux_mkv_reference_sparse_run(struct stream_reference_reader_grant *grant,
+    const struct demux_mkv_reference_spec *spec, size_t spec_size,
+    int64_t original_origin_ns, const uint64_t *hints, size_t hint_count,
+    int64_t deadline, const AVIOInterruptCB *interrupt,
+    struct demux_reference_result *out, size_t out_size)
+{
+    int64_t now = mp_time_ns();
+    if (!grant || !spec || spec_size != sizeof(*spec) || !interrupt ||
+        !interrupt->callback || !out || out_size != sizeof(*out) ||
+        out->complete || out->num_pairs || deadline <= now ||
+        deadline - now > 30000000000LL)
+        return false;
+    struct mkv_sparse_worker w = {grant, interrupt, deadline};
+    AVIOInterruptCB owned_cb = {mkv_sparse_worker_interrupt, &w};
+    struct avpriv_vortx_reference_sparse_budget *budget = NULL;
+    struct avpriv_vortx_reference_sparse_reader *reader = NULL;
+    struct mkv_sparse_planner *planner = NULL;
+    struct mkv_sparse_span *spans = calloc(MKV_SPARSE_MAX_SPANS, sizeof(*spans));
+    struct avpriv_vortx_reference_sparse_span *request = calloc(MKV_SPARSE_MAX_SPANS, sizeof(*request));
+    struct mkv_sparse_bytes *parts = calloc(MKV_SPARSE_MAX_SPANS, sizeof(*parts));
+    struct demux_reference_result value = {0};
+    struct avpriv_vortx_reference_sparse_info info = {0};
+    struct mkv_sparse_progress progress = {0};
+    size_t part_count = 0;
+    bool ok = false;
+    if (!spans || !request || !parts || mkv_sparse_worker_abort(&w) ||
+        !stream_reference_reader_witness(grant, &value.source_generation,
+            &value.source_epoch, &value.response_generation) ||
+        !stream_reference_reader_sparse_budget(grant, &owned_cb, &budget) ||
+        avpriv_vortx_reference_sparse_budget_info_v1(budget, &info, sizeof(info)) < 0 ||
+        info.terminal_error || info.active_handle || !info.entity_bytes)
+        goto done;
+    planner = mkv_sparse_planner_create(spec, spec_size, original_origin_ns,
+        info.entity_bytes, hints, hint_count, mkv_sparse_worker_abort, &w);
+    if (!planner)
+        goto done;
+    for (;;) {
+        size_t count = 0;
+        uint64_t id = 0;
+        enum mkv_sparse_step step = mkv_sparse_planner_next(planner, spans,
+            MKV_SPARSE_MAX_SPANS, &count, &id);
+        if (step == MKV_SPARSE_ERROR || mkv_sparse_worker_abort(&w))
+            goto done;
+        if (step == MKV_SPARSE_FINISHED)
+            break;
+        if (!count || count > MKV_SPARSE_MAX_SPANS)
+            goto done;
+        for (size_t i = 0; i < count; i++) {
+            if (spans[i].bytes > UINT32_MAX)
+                goto done;
+            request[i] = (struct avpriv_vortx_reference_sparse_span){spans[i].start, spans[i].bytes};
+        }
+        if (avpriv_vortx_reference_sparse_open_v1(budget, request,
+                count * sizeof(*request), count, &reader) < 0)
+            goto done;
+        part_count = 0;
+        for (;;) {
+            struct avpriv_vortx_reference_sparse_part part = {0};
+            int next = avpriv_vortx_reference_sparse_next_part_v1(reader, &part, sizeof(part));
+            if (next < 0 || mkv_sparse_worker_abort(&w))
+                goto done;
+            if (!next)
+                break; // only FF's COMPLETE BATCH, never entity EOF
+            if (part_count >= count || part.plan_index != part_count ||
+                part.start != spans[part_count].start ||
+                part.bytes != spans[part_count].bytes || part.entity_bytes != info.entity_bytes)
+                goto done;
+            unsigned char *buffer = malloc(part.bytes);
+            if (!buffer)
+                goto done;
+            parts[part_count] = (struct mkv_sparse_bytes){part.start, part.bytes, buffer};
+            part_count++;
+            uint32_t used = 0;
+            while (used < part.bytes) {
+                int n = avpriv_vortx_reference_sparse_read_part_v1(reader,
+                    buffer + used, part.bytes - used);
+                if (n <= 0 || (uint32_t)n > part.bytes - used || mkv_sparse_worker_abort(&w))
+                    goto done;
+                used += n;
+            }
+            unsigned char extra = 0;
+            if (avpriv_vortx_reference_sparse_read_part_v1(reader, &extra, 1) != 0)
+                goto done;
+        }
+        struct avpriv_vortx_reference_sparse_stats stats = {0};
+        if (part_count != count ||
+            avpriv_vortx_reference_sparse_stats_v1(reader, &stats, sizeof(stats)) < 0 ||
+            !stats.batch_validated || stats.terminal_error || stats.parts_complete != count)
+            goto done;
+        avpriv_vortx_reference_sparse_close_v1(&reader);
+        info = (struct avpriv_vortx_reference_sparse_info){0};
+        if (avpriv_vortx_reference_sparse_budget_info_v1(budget, &info, sizeof(info)) < 0 ||
+            info.terminal_error || info.active_handle || mkv_sparse_worker_abort(&w) ||
+            !mkv_sparse_planner_accept(planner, id, parts, part_count, true))
+            goto done;
+        mkv_sparse_free_parts(parts, part_count);
+        part_count = 0;
+    }
+    if (!mkv_sparse_planner_progress(planner, &progress, sizeof(progress)) ||
+        !progress.complete || !progress.chain_complete || !progress.metadata_matched ||
+        progress.failed || progress.selected_occurrences > UINT32_MAX ||
+        mkv_sparse_worker_abort(&w))
+        goto done;
+    struct demux_reference_result decoded = {0};
+    if (!demux_mkv_reference_sparse_decode(planner, spec, spec_size,
+            &owned_cb, &decoded, sizeof(decoded)) || mkv_sparse_worker_abort(&w))
+        goto done;
+    info = (struct avpriv_vortx_reference_sparse_info){0};
+    int64_t source_generation = 0, response_generation = 0;
+    uint64_t source_epoch = 0;
+    if (avpriv_vortx_reference_sparse_budget_info_v1(budget, &info, sizeof(info)) < 0 ||
+        info.terminal_error || info.active_handle ||
+        info.http_plaintext_bytes > VORTX_SPARSE_MAX_HTTP_BYTES ||
+        info.requests_started > VORTX_SPARSE_MAX_REQUESTS ||
+        !stream_reference_reader_witness(grant, &source_generation, &source_epoch, &response_generation) ||
+        source_generation != value.source_generation || source_epoch != value.source_epoch ||
+        response_generation != value.response_generation || mkv_sparse_worker_abort(&w))
+        goto done;
+    value.num_pairs = decoded.num_pairs;
+    memcpy(value.pairs, decoded.pairs, sizeof(value.pairs));
+    value.packets_seen = progress.selected_occurrences;
+    value.stream_index = spec->owner_stream_index;
+    value.demuxer_id = spec->owner_demuxer_id;
+    value.ff_index = value.av_stream_id = -1;
+    value.format_kind = 3;
+    value.codec_id = AV_CODEC_ID_SUBRIP;
+    value.time_base_num = 1;
+    value.time_base_den = 1000;
+    value.source_origin = spec->source_origin;
+    value.origin_seconds = spec->demux_start_time;
+    value.prefix_end_ms = 1080000;
+    value.input_bytes = info.http_plaintext_bytes;
+    value.complete = true;
+    // Final caller must still compare the ORIGINAL current demux/track/source
+    // epoch and intent, then use existing publication/reader-quiescence fences.
+    *out = value;
+    ok = true;
+done:
+    avpriv_vortx_reference_sparse_close_v1(&reader);
+    mkv_sparse_free_parts(parts, part_count);
+    mkv_sparse_planner_destroy(&planner);
+    avpriv_vortx_reference_sparse_budget_release_v1(&budget);
+    free(parts);
+    free(request);
+    free(spans);
+    return ok;
+}
diff --git a/stream/vortx_reference_sparse.h b/stream/vortx_reference_sparse.h
new file mode 100644
--- /dev/null
+++ b/stream/vortx_reference_sparse.h
@@ -0,0 +1,100 @@
+/* Source-private matched-component sparse HTTP API. SOURCE PROPOSAL ONLY;
+ * UNCOMPILED/UNRUN. This additive header preserves the adaeb9 prefix contract.
+ * Recipe remains opaque/native: no Swift/public option/serialized carrier. */
+#ifndef VORTX_PRIVATE_REFERENCE_SPARSE_H
+#define VORTX_PRIVATE_REFERENCE_SPARSE_H
+#include <stddef.h>
+#include <stdint.h>
+#include <libavformat/avio.h>
+
+#define VORTX_SPARSE_MAX_HTTP_BYTES (128u * 1024u * 1024u)
+#define VORTX_SPARSE_MAX_REQUESTS 256u
+#define VORTX_SPARSE_MAX_SPANS 1024u
+#define VORTX_SPARSE_MAX_SPAN_BYTES (1024u * 1024u)
+#define VORTX_SPARSE_MAX_BATCH_BYTES (4u * 1024u * 1024u)
+#define VORTX_SPARSE_MAX_RANGE_VALUE (32u * 1024u)
