+}
+
+bool stream_reference_reader_revalidate(
+    stream_t *s, const struct stream_reference_reader_grant *grant)
+{
+    if (stream_reference_reader_cancelled(grant) ||
+        !stream_reference_source_revalidate_sent_request(s, grant->sent))
+        return false;
+    struct lavf_priv *p = s->priv;
+    return p && p->avio && avpriv_vortx_reference_revalidate_v1(p->avio,
+        &grant->sent->sent, sizeof(grant->sent->sent), grant->recipe) == 0 &&
+        stream_reference_source_revalidate_sent_request(s, grant->sent) &&
+        !stream_reference_reader_cancelled(grant);
+}
+
+bool stream_reference_reader_witness(
+    const struct stream_reference_reader_grant *grant,
+    int64_t *source_generation, uint64_t *epoch, int64_t *response_generation)
+{
+    if (!source_generation || !epoch || !response_generation ||
+        stream_reference_reader_cancelled(grant))
+        return false;
+    const struct stream_reference_observation_values *v =
+        &grant->sent->observation->values;
+    *source_generation = v->source_generation;
