+/* Native-only bounded reference decoder with owned source authority.
+ * Source recipe captures no live owner pointers; reader owns small buffers.
+ * Same LGPL terms as demux_lavf.c. No raw subtitle text is retained in result. */
+#include <math.h>
+#include <errno.h>
+#include <string.h>
+#include <libavcodec/avcodec.h>
+#include <libavcodec/codec_desc.h>
+#include <libavutil/error.h>
+#include <libavutil/mem.h>
+#include <libavutil/mathematics.h>
+#include "osdep/timer.h"
+#include "stream/stream.h"
+#include "stream/vortx_reference_reader_stream.h"
+#include "reference_reader_internal.h"
+#include "reference_mkv_sparse_planner.h"
+
+#define REFERENCE_PACKET_LIMIT 100000u
+#define REFERENCE_PACKET_BYTES (64 * 1024)
+#define REFERENCE_WINDOW_MS 1080000LL
+#define REFERENCE_AVIO_BYTES 32768
+
+struct mp_reference_reader_job {
+    struct stream_reference_reader_grant *grant;
+    struct mp_reference_track_spec spec;
+    AVCodecParameters *codecpar;
+    struct mkv_sparse_snapshot *mkv; // owned immutable native-only descriptor
+    int64_t deadline_ns;
+    bool decoded;
+    // Worker-only evidence from this SAME finite duplicate, not a new origin.
+    // Consumer reads it only after the worker has joined and decode succeeded.
+    bool worker_stream_start_observed;
+    int64_t worker_stream_start_time;
+    struct demux_reference_result result;
+};
+
+static bool codec_equal(const AVCodecParameters *a, const AVCodecParameters *b)
+{
+    if (!a || !b || a->codec_type != AVMEDIA_TYPE_SUBTITLE ||
+        b->codec_type != a->codec_type || b->codec_id != a->codec_id ||
+        b->codec_tag != a->codec_tag || b->format != a->format ||
+        b->profile != a->profile || b->level != a->level ||
+        b->width != a->width || b->height != a->height ||
+        b->bit_rate != a->bit_rate ||
+        b->bits_per_coded_sample != a->bits_per_coded_sample ||
+        b->bits_per_raw_sample != a->bits_per_raw_sample ||
+        b->sample_aspect_ratio.num != a->sample_aspect_ratio.num ||
+        b->sample_aspect_ratio.den != a->sample_aspect_ratio.den ||
+        b->framerate.num != a->framerate.num || b->framerate.den != a->framerate.den ||
+        b->field_order != a->field_order || b->color_range != a->color_range ||
+        b->color_primaries != a->color_primaries || b->color_trc != a->color_trc ||
+        b->color_space != a->color_space || b->chroma_location != a->chroma_location ||
+        b->video_delay != a->video_delay || b->sample_rate != a->sample_rate ||
+        b->block_align != a->block_align || b->frame_size != a->frame_size ||
+        b->initial_padding != a->initial_padding || b->trailing_padding != a->trailing_padding ||
+        b->seek_preroll != a->seek_preroll || b->alpha_mode != a->alpha_mode ||
+        av_channel_layout_compare(&a->ch_layout, &b->ch_layout) != 0 ||
+        b->extradata_size != a->extradata_size || a->extradata_size < 0 ||
+        a->extradata_size > REFERENCE_PACKET_BYTES ||
+        a->nb_coded_side_data || b->nb_coded_side_data)
+        return false;
+    return !a->extradata_size || (a->extradata && b->extradata &&
+        !memcmp(a->extradata, b->extradata, a->extradata_size));
+}
+
+static bool text_codec(enum AVCodecID codec)
+{
+    // No teletext/CC state, bitmap, unknown end, charset guessing, or special
+    // mpv-mkv WebVTT framing. These are ordinary libavformat text packets.
+    switch (codec) {
+    case AV_CODEC_ID_ASS: case AV_CODEC_ID_SSA: case AV_CODEC_ID_SUBRIP:
+    case AV_CODEC_ID_TEXT: case AV_CODEC_ID_WEBVTT: case AV_CODEC_ID_MOV_TEXT: return true;
+    default: return false;
+    }
+}
+
+bool mp_reference_reader_job_cancelled(const struct mp_reference_reader_job *job)
+{
+    return !job || mp_time_ns() >= job->deadline_ns ||
+        stream_reference_reader_cancelled(job->grant);
+}
+
+bool mp_reference_reader_job_publication_current(const struct mp_reference_reader_job *job)
+{
+    // Job/grant pointer was release-published by the validated request. These
+    // immutable fields outlive all renderer calls; decoded/result/deadline are
+    // intentionally not read on this off-owner persistent-lifetime path.
+    return job && stream_reference_reader_current(job->grant);
+}
+
+void mp_reference_reader_job_free(struct mp_reference_reader_job **out)
+{
+    if (!out || !*out)
+        return;
+    struct mp_reference_reader_job *job = *out;
+    *out = NULL;
+    stream_reference_reader_release(&job->grant);
+    avcodec_parameters_free(&job->codecpar);
+    av_free(job->mkv);
+    av_free(job);
+}
+
+struct mp_reference_reader_job *mp_reference_reader_job_create_mkv_sparse(
+    struct stream *source, const struct mkv_sparse_snapshot *snapshot,
+    int64_t deadline_ns)
+{
+    if (!source || !snapshot || snapshot->spec.version != DEMUX_MKV_REFERENCE_VERSION ||
+        snapshot->hint_count > MKV_SPARSE_MAX_CAPTURE_HINTS)
+        return NULL;
+    struct mp_reference_reader_job *job = av_mallocz(sizeof(*job));
+    if (!job)
+        return NULL;
+    job->deadline_ns = deadline_ns;
+    job->mkv = av_memdup(snapshot, sizeof(*snapshot));
+    if (!job->mkv || !stream_reference_reader_capture(source, deadline_ns, &job->grant) ||
+        !stream_reference_reader_witness(job->grant, &job->result.source_generation,
+            &job->result.source_epoch, &job->result.response_generation)) {
+        mp_reference_reader_job_free(&job);
+        return NULL;
+    }
+    return job;
+}
+
+const struct mkv_sparse_snapshot *mp_reference_reader_job_mkv_snapshot(
+    const struct mp_reference_reader_job *job)
+{
+    return job ? job->mkv : NULL; // immutable job-owned scalars, no live source
+}
+
+struct mp_reference_reader_job *mp_reference_reader_job_create(
+    struct stream *source, const struct mp_reference_track_spec *spec,
+    int64_t deadline_ns)
+{
+    if (!source || !spec || !spec->format || !spec->codecpar ||
+        !text_codec(spec->codecpar->codec_id) ||
+        !codec_equal(spec->codecpar, spec->codecpar) ||
+        !isfinite(spec->demux_start_time) || !isfinite(spec->consumer_ts_offset) ||
+        !isfinite(spec->demux_start_time + spec->consumer_ts_offset) ||
+        (spec->format_start_time == AV_NOPTS_VALUE ? spec->demux_start_time != 0 :
+         spec->demux_start_time != spec->format_start_time / (double)AV_TIME_BASE) ||
+        spec->time_base.num <= 0 || spec->time_base.den <= 0)
+        return NULL;
+    struct mp_reference_reader_job *job = av_mallocz(sizeof(*job));
+    if (!job)
+        return NULL;
+    job->worker_stream_start_time = AV_NOPTS_VALUE;
+    job->deadline_ns = deadline_ns;
+    job->spec = *spec;
+    job->spec.codecpar = NULL; // never retain the borrowed original parameters
+    job->codecpar = avcodec_parameters_alloc();
+    if (!job->codecpar || avcodec_parameters_copy(job->codecpar, spec->codecpar) < 0 ||
+        !stream_reference_reader_capture(source, deadline_ns, &job->grant) ||
+        !stream_reference_reader_witness(job->grant,
+            &job->result.source_generation, &job->result.source_epoch,
+            &job->result.response_generation)) {
+        mp_reference_reader_job_free(&job);
+        return NULL;
+    }
+    job->result.stream_index = spec->stream_index;
+    job->result.demuxer_id = spec->demuxer_id;
+    job->result.ff_index = spec->ff_index;
+    job->result.av_stream_id = spec->av_stream_id;
+    job->result.format_kind = !strcmp(spec->format->name, "matroska,webm") ? 1 : 2;
+    job->result.codec_id = spec->codecpar->codec_id;
+    job->result.time_base_num = spec->time_base.num;
+    job->result.time_base_den = spec->time_base.den;
+    job->result.source_origin = spec->source_origin;
+    job->result.origin_seconds = spec->demux_start_time + spec->consumer_ts_offset;
+    job->result.prefix_end_ms = REFERENCE_WINDOW_MS;
+    return job;
+}
+
+static bool owner_stream_start_matches(const struct mp_reference_reader_job *job,
+                                        int64_t current_start)
+{
+    if (job->spec.stream_start_time != AV_NOPTS_VALUE)
+        return current_start == job->spec.stream_start_time;
+    // Unknown original metadata is not a wildcard. Only a successful joined
+    // worker can certify its actual selected stream's one observed value.
+    return job->decoded && job->worker_stream_start_observed &&
+        (current_start == AV_NOPTS_VALUE ||
+         current_start == job->worker_stream_start_time);
+}
+
+bool mp_reference_reader_job_matches(
+    const struct mp_reference_reader_job *job,
+    const struct mp_reference_track_spec *s)
+{
+    const struct mp_reference_track_spec *p = job && !job->mkv ? &job->spec : NULL;
+    return s && p && !mp_reference_reader_job_cancelled(job) &&
+        s->format == p->format && s->format_flags == p->format_flags &&
+        s->num_streams == p->num_streams &&
+        s->time_base.num == p->time_base.num && s->time_base.den == p->time_base.den &&
+        s->format_start_time == p->format_start_time &&
+        owner_stream_start_matches(job, s->stream_start_time) &&
+        s->stream_index == p->stream_index && s->demuxer_id == p->demuxer_id &&
+        s->ff_index == p->ff_index && s->av_stream_id == p->av_stream_id &&
+        s->source_origin == p->source_origin &&
+        s->demux_start_time == p->demux_start_time &&
+        s->consumer_ts_offset == p->consumer_ts_offset &&
+        codec_equal(job->codecpar, s->codecpar);
+}
+
+bool mp_reference_reader_job_revalidate(
+    const struct mp_reference_reader_job *job, struct stream *source)
+{
+    return !mp_reference_reader_job_cancelled(job) &&
+        stream_reference_reader_revalidate(source, job->grant);
+}
+
+struct reader_io {
+    struct mp_reference_reader_job *job;
+    struct avpriv_vortx_reference_reader *reader;
+    const AVIOInterruptCB *interrupt; // call-local owned request, alive until close
+    bool nested_attempt;
+};
+
+static int reader_interrupt(void *opaque)
+{
+    struct reader_io *io = opaque;
+    return mp_reference_reader_job_cancelled(io->job) ||
+        io->interrupt->callback(io->interrupt->opaque);
+}
+
+static int reader_read(void *opaque, uint8_t *buffer, int bytes)
+{
+    struct reader_io *io = opaque;
+    if (reader_interrupt(io))
+        return AVERROR_EXIT;
+    int rc = avpriv_vortx_reference_read_v1(io->reader, buffer, bytes);
+    return reader_interrupt(io) ? AVERROR_EXIT : rc;
+}
+
+static int deny_nested(AVFormatContext *ctx, AVIOContext **pb,
+                       const char *url, int flags, AVDictionary **options)
+{
+    struct reader_io *io = ctx->opaque;
+    io->nested_attempt = true;
+    return AVERROR(EPERM);
+}
+
+static bool worker_stream_start_matches(struct mp_reference_reader_job *job,
+                                         int64_t current_start, bool require_start)
+{
+    // Preserve the known-original exact rule, including the pre-packet unknown
+    // allowance. No timestamp in either original or duplicate is written.
+    if (job->spec.stream_start_time != AV_NOPTS_VALUE)
+        return current_start == job->spec.stream_start_time ||
+            (!require_start && current_start == AV_NOPTS_VALUE);
+    if (job->worker_stream_start_observed)
+        return current_start == job->worker_stream_start_time;
+    if (current_start == AV_NOPTS_VALUE)
+        return !require_start;
+    job->worker_stream_start_time = current_start;
+    job->worker_stream_start_observed = true;
+    return true;
+}
+
+static bool duplicate_matches(struct mp_reference_reader_job *job,
+                              const AVFormatContext *fmt, bool require_start)
+{
+    const struct mp_reference_track_spec *p = &job->spec;
+    if (fmt->iformat != p->format || fmt->flags != p->format_flags ||
+        fmt->nb_streams != p->num_streams ||
+        fmt->start_time != p->format_start_time || p->ff_index < 0 ||
+        p->ff_index >= fmt->nb_streams)
+        return false;
+    const AVStream *s = fmt->streams[p->ff_index];
+    return s->index == p->ff_index && s->id == p->av_stream_id &&
+        worker_stream_start_matches(job, s->start_time, require_start) &&
+        s->time_base.num == p->time_base.num &&
+        s->time_base.den == p->time_base.den && codec_equal(job->codecpar, s->codecpar);
+}
+
+static bool decode_pair(struct mp_reference_reader_job *job, AVCodecContext *ctx,
+                         AVPacket *packet, double relative_pts)
+{
+    double duration = packet->duration * av_q2d(job->spec.time_base);
+    bool ass = ctx->codec_id == AV_CODEC_ID_ASS || ctx->codec_id == AV_CODEC_ID_SSA;
+    double duration_ms = duration / 0.001;
+    double duration_end = relative_pts + duration;
+    // Exact rational guard covers the sentinel boundary even if the double
+    // conversion would round UINT32_MAX milliseconds down to MAX-1.
+    if (!ass && (packet->duration < 0 ||
+        av_compare_ts(packet->duration, job->spec.time_base, UINT32_MAX,
+                      (AVRational){1, 1000}) >= 0))
+        return false;
+    // lavc_conv passes packet PTS/duration in milliseconds, then interprets
+    // start/end_display_time in its explicitly forced 1/1000 timebase.
+    double presentation_pts = packet->pts * av_q2d(job->spec.time_base) +
+        job->spec.consumer_ts_offset;
+    double dts = packet->dts == AV_NOPTS_VALUE ? NAN :
+        packet->dts * av_q2d(job->spec.time_base) + job->spec.consumer_ts_offset;
+    // Exact binary double numerator preserves the old effective double bound,
+    // keeping about half the int64 range as margin for millisecond conversion.
+    const double max_decoder_seconds = 0x1p62 / 1000.0;
+    if (!isfinite(presentation_pts) || fabs(presentation_pts) > max_decoder_seconds ||
+        !isfinite(duration) || duration < 0 || duration > max_decoder_seconds ||
+        !isfinite(duration_end) ||
+        // libavcodec's non-ASS fallback assigns this rescaled duration to
+        // uint32_t end_display_time. Reject BEFORE decode, including its
+        // UINT32_MAX unknown-end sentinel, rather than admit a narrowed end.
+        (!ass && (!isfinite(duration_ms) || duration_ms >= UINT32_MAX)) ||
+        (isfinite(dts) && fabs(dts) > max_decoder_seconds))
+        return false;
+    packet->pts = llrint(presentation_pts / 0.001);
+    packet->dts = isfinite(dts) ? llrint(dts / 0.001) : AV_NOPTS_VALUE;
+    packet->duration = duration_ms; // mp_set_av_packet truncates duration
+    if (packet->pts < 0)
+        packet->pts = 0; // same decoder-input clamp as lavc_conv
+    AVSubtitle sub = {0};
+    int got = 0;
+    int decoded = avcodec_decode_subtitle2(ctx, &sub, &got, packet);
+    // movtextdec.c explicitly consumes the two-zero-byte end marker with
+    // ret=0, got=0: durations already define the prior cue's real end. Observe
+    // that decoder outcome, omit the marker, and never synthesize a cue.
+    if (ctx->codec_id == AV_CODEC_ID_MOV_TEXT && packet->size == 2 &&
+        packet->data[0] == 0 && packet->data[1] == 0 && decoded == 0 && !got &&
+        sub.num_rects == 0) {
+        avsubtitle_free(&sub);
+        return true;
+    }
+    bool good = decoded == packet->size && got && sub.num_rects > 0 &&
+        sub.start_display_time != UINT32_MAX;
+    for (unsigned n = 0; good && n < sub.num_rects; n++) {
+        AVSubtitleRect *rect = sub.rects[n];
+        good = rect && rect->type == SUBTITLE_ASS && rect->ass &&
+            rect->w == 0 && rect->h == 0;
+    }
+    double start = relative_pts + sub.start_display_time / 1000.0;
+    double end = relative_pts + sub.end_display_time / 1000.0;
+    // Native ASS playback uses its real packet duration. No unknown-duration
+    // heuristic or fabricated three-second end is allowed for any codec.
+    if (ass)
+        end = duration_end;
+    else {
+        good &= sub.end_display_time != UINT32_MAX;
+        // When decode.c filled end_display_time from packet duration, retain
+        // its original unwrapped finite end for the whole-cue window proof.
+        // A legitimate fractional native duration must not become an in-window
+        // cue merely because the decoder's millisecond field was truncated.
+        if (sub.end_display_time == packet->duration)
+            end = duration_end;
+    }
+    good &= isfinite(start) && isfinite(end) && end > start &&
+        (!ass || (isfinite(duration) && duration > 0));
+    // Match the existing reference path: omit a real cue crossing either
+    // boundary; never crop, rebase, or fabricate its duration to fit.
+    if (good && start >= 0 && end <= REFERENCE_WINDOW_MS / 1000.0) {
+        int64_t start_ms = llrint(start * 1000), end_ms = llrint(end * 1000);
+        unsigned n = job->result.num_pairs;
+        good = n < DEMUX_REFERENCE_MAX_PAIRS && end_ms > start_ms &&
+            (!n || start_ms >= job->result.pairs[n - 1].start_ms);
+        if (good) {
+            job->result.pairs[n] = (struct demux_reference_pair){start_ms, end_ms};
+            job->result.num_pairs++;
+        }
+    }
+    avsubtitle_free(&sub);
+    return good;
+}
+
+bool mp_reference_reader_job_run(struct mp_reference_reader_job *job,
+                               const AVIOInterruptCB *interrupt)
+{
+    if (!job || job->decoded || !interrupt || !interrupt->callback ||
+        mp_reference_reader_job_cancelled(job))
+        return false;
+    // A failed earlier attempt must not lend evidence to a different duplicate.
+    job->worker_stream_start_observed = false;
+    job->worker_stream_start_time = AV_NOPTS_VALUE;
+    if (job->mkv) {
+        struct demux_reference_result value = {0};
+        const struct mkv_sparse_snapshot *s = job->mkv;
+        bool ok = demux_mkv_reference_sparse_run(job->grant, &s->spec, sizeof(s->spec),
+            s->original_origin_ns, s->hints, s->hint_count, job->deadline_ns,
+            interrupt, &value, sizeof(value));
+        job->decoded = ok && value.complete && value.num_pairs &&
+            value.source_generation == job->result.source_generation &&
+            value.source_epoch == job->result.source_epoch &&
+            value.response_generation == job->result.response_generation &&
+            !mp_reference_reader_job_cancelled(job) && !interrupt->callback(interrupt->opaque);
+        if (job->decoded) {
+            job->result = value;
+        } else {
+            job->result.complete = false;
+            job->result.num_pairs = 0;
+            memset(job->result.pairs, 0, sizeof(job->result.pairs));
+        }
+        return job->decoded;
+    }
+    struct reader_io io = {.job = job, .interrupt = interrupt};
+    AVIOInterruptCB cb = {.callback = reader_interrupt, .opaque = &io};
+    AVFormatContext *fmt = NULL;
+    AVIOContext *pb = NULL;
+    AVCodecContext *decoder = NULL;
+    AVPacket *packet = NULL;
+    uint8_t *buffer = NULL;
+    AVDictionary *options = NULL;
+    bool complete = false, seen = false, ok = false;
+    double last_pts = -INFINITY;
+    if (!stream_reference_reader_open(job->grant, &cb, &io.reader))
+        goto done;
+    buffer = av_malloc(REFERENCE_AVIO_BYTES);
+    fmt = avformat_alloc_context();
+    if (!buffer || !fmt)
+        goto done;
+    pb = avio_alloc_context(buffer, REFERENCE_AVIO_BYTES, 0, &io,
+                            reader_read, NULL, NULL);
+    if (!pb)
+        goto done;
+    buffer = NULL; // pb owns; no seek callback, no second request or filename
+    pb->seekable = 0;
+    fmt->pb = pb;
+    fmt->flags = job->spec.format_flags;
+    fmt->interrupt_callback = cb;
+    fmt->opaque = &io;
+    fmt->io_open = deny_nested;
+    fmt->probesize = REFERENCE_AVIO_BYTES;
+    fmt->max_analyze_duration = 0;
+    fmt->max_streams = 1024;
+    // Admitted formats parse track headers at open; no find_stream_info
+    // scan is needed. Force the EXACT original static format, never autodetect.
+    if (reader_interrupt(&io) ||
+        avformat_open_input(&fmt, NULL, job->spec.format, NULL) < 0 ||
+        io.nested_attempt || !duplicate_matches(job, fmt, false))
+        goto done;
+    const AVCodec *codec = avcodec_find_decoder(job->codecpar->codec_id);
+    if (!codec || (codec->capabilities & AV_CODEC_CAP_DELAY))
+        goto done; // no delayed/reordered text decoder may certify the prefix
+    decoder = codec ? avcodec_alloc_context3(codec) : NULL;
+    if (decoder)
+        decoder->thread_count = 1;
+    packet = av_packet_alloc();
+    if (!decoder || !packet ||
+        avcodec_parameters_to_context(decoder, job->codecpar) < 0 ||
+        av_dict_set(&options, "sub_text_format", "ass", 0) < 0 ||
+        av_dict_set(&options, "flags2", "+ass_ro_flush_noop", 0) < 0 ||
+        avcodec_open2(decoder, codec, &options) < 0)
+        goto done;
+    av_dict_free(&options);
+    decoder->time_base = decoder->pkt_timebase = (AVRational){1, 1000};
+    decoder->sub_charenc_mode = FF_SUB_CHARENC_MODE_IGNORE;
+    for (;;) {
+        if (reader_interrupt(&io) || io.nested_attempt ||
+            job->result.packets_seen >= REFERENCE_PACKET_LIMIT)
+            goto done;
+        int rc = av_read_frame(fmt, packet);
+        if (reader_interrupt(&io) || io.nested_attempt ||
+            !duplicate_matches(job, fmt, seen ||
+                (rc >= 0 && packet->stream_index == job->spec.ff_index)))
+            goto done;
+        if (rc == AVERROR_EOF) {
+            struct avpriv_vortx_reference_stats stats = {0};
+            complete = avpriv_vortx_reference_stats_v1(io.reader,
+                &stats, sizeof(stats)) == 0 && !stats.terminal_error &&
+                stats.complete_entity && stats.reached_entity_eof && seen;
+            break;
+        }
+        if (rc < 0)
+            goto done;
+        job->result.packets_seen++;
+        if (packet->stream_index == job->spec.ff_index) {
+            double pts = packet->pts == AV_NOPTS_VALUE ? NAN :
+                packet->pts * av_q2d(job->spec.time_base) - job->spec.demux_start_time;
+            if (!isfinite(pts) || pts < 0 || pts < last_pts ||
+                packet->size <= 0 ||
+                packet->size > REFERENCE_PACKET_BYTES ||
+                (packet->flags & (AV_PKT_FLAG_CORRUPT | AV_PKT_FLAG_DISCARD)))
+                goto done;
+            seen = true;
+            last_pts = pts;
+            if (pts >= REFERENCE_WINDOW_MS / 1000.0) {
+                complete = true; // no more I/O once selected prefix spans window
+                break;
+            }
+            if (!decode_pair(job, decoder, packet, pts) || reader_interrupt(&io))
+                goto done;
+        }
+        av_packet_unref(packet);
+    }
+    // Even the out-of-window early stop must prove no decoder output is
+    // pending. All admitted codecs lack DELAY; empty input therefore must
+    // produce exactly no subtitle through the real libavcodec API.
+    AVSubtitle flushed = {0};
+    AVPacket empty = {0};
+    int got_flushed = 0;
+    int flush_rc = avcodec_decode_subtitle2(decoder, &flushed, &got_flushed, &empty);
+    bool drained = flush_rc == 0 && !got_flushed && !flushed.num_rects;
+    avsubtitle_free(&flushed);
+    struct avpriv_vortx_reference_stats stats = {0};
+    if (!complete || !drained || !job->result.num_pairs || reader_interrupt(&io) ||
+        (job->spec.stream_start_time == AV_NOPTS_VALUE &&
+         !job->worker_stream_start_observed) ||
+        avpriv_vortx_reference_stats_v1(io.reader, &stats, sizeof(stats)) < 0 ||
+        stats.terminal_error || stats.body_bytes > VORTX_REFERENCE_READER_MAX_BYTES ||
+        (pb && pb->error && pb->error != AVERROR_EOF))
+        goto done;
+    job->result.input_bytes = stats.body_bytes;
+    job->result.complete = true;
+    ok = true;
+done:
+    av_dict_free(&options);
+    av_packet_free(&packet);
+    avcodec_free_context(&decoder);
+    avformat_close_input(&fmt);
+    if (pb) {
+        av_freep(&pb->buffer);
+        avio_context_free(&pb);
+    }
+    av_free(buffer);
+    avpriv_vortx_reference_reader_close_v1(&io.reader);
+    job->decoded = ok && !mp_reference_reader_job_cancelled(job) &&
+        !interrupt->callback(interrupt->opaque);
+    if (!job->decoded) {
+        job->result.complete = false;
+        job->result.num_pairs = 0;
+        memset(job->result.pairs, 0, sizeof(job->result.pairs));
+    }
+    return job->decoded;
+}
+
+bool mp_reference_reader_job_copy_result(
+    const struct mp_reference_reader_job *job, struct demux_reference_result *out)
+{
+    if (!out || !job || !job->decoded || !job->result.complete ||
+        mp_reference_reader_job_cancelled(job))
+        return false;
+    *out = job->result;
+    return true;
+}
+
+#if defined(VORTX_REFERENCE_READER_SOURCE_FIXTURE)
+#include "reference_reader_fixture.inc"
+#endif
