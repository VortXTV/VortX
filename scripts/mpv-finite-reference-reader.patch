+// Owned grant, separate from INITIAL_REQUEST_ONLY and sent evidence. Only
+// capture/revalidate touch live p->avio, on the actual demux/stream owner.
+struct stream_reference_reader_grant {
+    struct stream_reference_sent_request *sent;
+    struct avpriv_vortx_reference_recipe *recipe;
+};
+
+bool stream_reference_reader_cancelled(
+    const struct stream_reference_reader_grant *grant)
+{
+    return !grant || stream_reference_sent_request_cancelled(grant->sent);
+}
+
+bool stream_reference_reader_current(const struct stream_reference_reader_grant *grant)
+{
+    // The observation's deadline belongs to preparation. A validated active
+    // subtitle publication instead observes its retained real source lifetime
+    // and FF completed-response token. Never read the original AVIO off-owner.
+    return grant && grant->sent && grant->sent->observation &&
+        !stream_reference_lease_cancelled(&grant->sent->observation->initial) &&
+        avpriv_vortx_reference_recipe_current(grant->recipe);
+}
+
+void stream_reference_reader_release(struct stream_reference_reader_grant **out)
+{
+    if (!out || !*out)
+        return;
+    struct stream_reference_reader_grant *grant = *out;
+    *out = NULL;
+    avpriv_vortx_reference_recipe_release_v1(&grant->recipe);
+    stream_reference_sent_request_release(&grant->sent);
+    av_free(grant);
+}
+
+bool stream_reference_reader_capture(
+    stream_t *s, int64_t deadline_ns, struct stream_reference_reader_grant **out)
+{
+    if (!out || *out || !reference_observation_deadline_valid(deadline_ns))
+        return false;
+    struct stream_reference_reader_grant *grant = av_mallocz(sizeof(*grant));
+    char *url = NULL;
+    AVDictionary *options = NULL;
+    if (!grant || !stream_reference_source_observe_sent_request(
+                      s, deadline_ns, &grant->sent) ||
+        !stream_reference_source_prepare_prefix_request(s, grant->sent,
+            STREAM_REFERENCE_PREFIX_MAX_BYTES, &url, &options))
+        goto fail;
+    struct lavf_priv *p = s->priv;
+    int64_t remaining_us = (deadline_ns - mp_time_ns()) / 1000;
+    if (remaining_us <= 0 || stream_reference_reader_cancelled(grant) ||
+        !p || !p->avio || avpriv_vortx_reference_capture_v1(p->avio,
+            &grant->sent->sent, sizeof(grant->sent->sent),
+            grant->sent->observation->values.etag, url, options,
+            STREAM_REFERENCE_PREFIX_MAX_BYTES, remaining_us, &grant->recipe) < 0 ||
+        !stream_reference_source_revalidate_sent_request(s, grant->sent) ||
+        stream_reference_reader_cancelled(grant))
+        goto fail;
+    av_free(url);
+    av_dict_free(&options);
+    *out = grant;
