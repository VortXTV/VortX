+struct avpriv_vortx_reference_recipe;
+struct avpriv_vortx_reference_sparse_budget;
+struct avpriv_vortx_reference_sparse_reader;
+struct avpriv_vortx_reference_sparse_span {
+    uint64_t start; /* absolute entity offset */
+    uint32_t bytes; /* 1..1MiB, end=start+bytes-1 checked before addition */
+};
+struct avpriv_vortx_reference_sparse_info {
+    uint64_t entity_bytes; /* known original total; never inferred from prefix */
+    uint64_t http_plaintext_bytes; /* outgoing request + ALL incoming HTTP */
+    uint32_t requests_started;
+    int active_handle;
+    int terminal_error;
+};
+struct avpriv_vortx_reference_sparse_part {
+    uint32_t plan_index;
+    uint64_t start;
+    uint32_t bytes;
+    uint64_t entity_bytes;
+};
+struct avpriv_vortx_reference_sparse_stats {
+    uint64_t payload_bytes;
+    uint32_t parts_complete;
+    int batch_validated; /* all parts, final delimiter, exact outer body length */
+    int terminal_error;
+};
+
+/* One worker owns budget and every handle, no concurrent budget operations.
+ * Create owns a complete immutable native recipe copy plus retained response
+ * lifetime token. Caller owns the input recipe throughout create; the budget
+ * retains no original owner/FD and thereafter owns its copy until release.
+ * Job owns callback storage until last close/budget release. Native publication
+ * ownership of the original recipe remains separate. Require known nonzero
+ * original total and current response lifetime. No network here. Inherit exact
+ * captured deadline, never renew30s or bytes/attempts on another open/close. */
+int avpriv_vortx_reference_sparse_budget_create_v1(
+    const struct avpriv_vortx_reference_recipe *recipe,
+    const AVIOInterruptCB *owned_interrupt,
+    struct avpriv_vortx_reference_sparse_budget **out);
+int avpriv_vortx_reference_sparse_budget_info_v1(
+    const struct avpriv_vortx_reference_sparse_budget *budget,
+    struct avpriv_vortx_reference_sparse_info *out, size_t out_size);
+
+/* Validate count<=1024 BEFORE multiplication/access; spans_size must exactly
+ * match. Copy ascending nonoverlapping spans, every end below original total.
+ * Each<=1MiB, sum<=4MiB; Range value<=32KiB and whole request still bounded.
+ * One active handle. Charge attempt before connection, request bytes before
+ * write and every received HTTP byte before read. 256attempts/128MiB shared.
+ * One span requires exact single206. Multiple require strict multipart206.
+ * Original URL/Host/SNI, credentials, strongETag, knownTOTAL, pinned endpoints
+ * and supported verified TLS remain exact. No redirect/retry/reconnect/seek. */
+int avpriv_vortx_reference_sparse_open_v1(
+    struct avpriv_vortx_reference_sparse_budget *budget,
+    const struct avpriv_vortx_reference_sparse_span *spans,
+    size_t spans_size, uint32_t span_count,
+    struct avpriv_vortx_reference_sparse_reader **out);
+
+/* All output structures must be cleared; exact out_size checked before access.
+ * 1=next strict admitted part header; 0=ENTIRE batch framing validated;
+ * negative=sticky operation failure. Prior part must be fully drained.
+ * A zero result is NEVER media EOF. No unrequested/coalesced/reordered parts. */
+int avpriv_vortx_reference_sparse_next_part_v1(
+    struct avpriv_vortx_reference_sparse_reader *reader,
+    struct avpriv_vortx_reference_sparse_part *out, size_t out_size);
+/* Positive current-part payload bytes; zero=current exact part drained;
+ * negative=sticky failure. Payload stays tentative until entire batch validates.
+ * Every operation checks current token, original deadline and owned callback.
+ * No binary boundary search, body-sized eager allocation, or synthetic holes. */
+int avpriv_vortx_reference_sparse_read_part_v1(
+    struct avpriv_vortx_reference_sparse_reader *reader,
+    unsigned char *buffer, int buffer_size);
+int avpriv_vortx_reference_sparse_stats_v1(
+    const struct avpriv_vortx_reference_sparse_reader *reader,
+    struct avpriv_vortx_reference_sparse_stats *out, size_t out_size);
+
+/* Close ALL duplicate contexts before recipe/callback release. An incomplete
+ * close invalidates the operation; bytes/attempts are never replenished.
+ * Budget release requires no active handle; misuse leaves budget owned and
+ * terminal rather than freeing storage underneath a live handle. */
+void avpriv_vortx_reference_sparse_close_v1(
+    struct avpriv_vortx_reference_sparse_reader **reader);
+void avpriv_vortx_reference_sparse_budget_release_v1(
+    struct avpriv_vortx_reference_sparse_budget **budget);
