+/* Proposed private native-MKV worker; source only, UNCOMPILED/UNRUN.
+ * Uses the actual MPV MKV parser, fresh config/global and one bounded stream.
+ * No original owner/global/stream/AVIO/options or packet is borrowed. */
+#include <errno.h>
+#include <math.h>
+#include <string.h>
+#include <libavcodec/avcodec.h>
+#include <libavutil/error.h>
+#include "mpv_talloc.h"
+#include "common/global.h"
+#include "common/msg.h"
+#include "common/stats.h"
+#include "misc/thread_tools.h"
+#include "options/m_config_core.h"
+#include "options/options.h"
+#include "osdep/timer.h"
+#include "stream/stream.h"
+#include "stream/vortx_reference_reader_stream.h"
+#include "demux.h"
+#include "packet_pool.h"
+#include "reference_mkv.h"
+#include "reference_mkv_sparse_planner.h"
+
+#define MKV_REFERENCE_WINDOW_MS 1080000LL
+#define MKV_REFERENCE_PACKET_LIMIT 100000u
+#define MKV_REFERENCE_PACKET_BYTES 65536u
+
+struct mkv_reference_io {
+    struct stream_reference_reader_grant *grant;
+    struct avpriv_vortx_reference_reader *reader;
+    const AVIOInterruptCB *interrupt;
+    int64_t deadline_ns;
+    bool failed;
+};
+
+static int mkv_reference_interrupt(void *opaque)
+{
+    struct mkv_reference_io *io = opaque;
+    return mp_time_ns() >= io->deadline_ns ||
+        stream_reference_reader_cancelled(io->grant) ||
+        io->interrupt->callback(io->interrupt->opaque);
+}
+
+static int mkv_reference_fill(struct stream *s, void *buffer, int bytes)
+{
+    struct mkv_reference_io *io = s->priv;
+    if (mkv_reference_interrupt(io)) {
+        io->failed = true;
+        return 0;
+    }
+    int rc = avpriv_vortx_reference_read_v1(io->reader, buffer, bytes);
+    if (mkv_reference_interrupt(io) || (rc < 0 && rc != AVERROR_EOF)) {
+        io->failed = true;
+        return 0;
+    }
+    return rc == AVERROR_EOF ? 0 : rc;
+}
+
+static int mkv_reference_stream_open(struct stream *s,
+                                   const struct stream_open_args *args)
+{
+    if (!args->special_arg)
+        return STREAM_ERROR;
+    s->priv = args->special_arg; // worker stack, alive through free_stream
+    s->fill_buffer = mkv_reference_fill;
+    s->requested_buffer_size = 32768;
+    s->seekable = false;
+    s->streaming = s->is_network = true;
+    s->access_references = false;
+    return STREAM_OK; // no seek/size/URL callback, no nested source/open
+}
+
+static const stream_info_t mkv_reference_stream_info = {
+    .name = "reference-mkv-owned",
+    .open2 = mkv_reference_stream_open,
+};
+
+static struct mpv_global *mkv_reference_global(void)
+{
+    // Isolated defaults, not a copy or borrow of the player's mutable global.
+    // These are real MPV constructors, including their mandatory-OOM policy.
+    struct mpv_global *g = talloc_zero(NULL, struct mpv_global);
+    g->log = mp_null_log;
+    g->config = m_config_shadow_new(&mp_opt_root);
+    talloc_steal(g, g->config);
+    demux_packet_pool_init(g);
+    stats_global_init(g);
+    struct m_config_cache *cache = m_config_cache_alloc(NULL, g, &demux_conf);
+    struct demux_opts *o = cache->opts;
+    o->enable_cache = 0;
+    m_config_cache_write_opt(cache, &o->enable_cache);
+    o->disk_cache = false;
+    m_config_cache_write_opt(cache, &o->disk_cache);
+    o->access_references = false;
+    m_config_cache_write_opt(cache, &o->access_references);
+    o->create_ccs = false;
+    m_config_cache_write_opt(cache, &o->create_ccs);
+    o->force_seekable = false;
+    m_config_cache_write_opt(cache, &o->force_seekable);
+    o->max_bytes = 1024 * 1024;
+    m_config_cache_write_opt(cache, &o->max_bytes);
+    o->max_bytes_bw = 0;
+    m_config_cache_write_opt(cache, &o->max_bytes_bw);
+    talloc_free(cache);
+    return g;
+}
+
+static bool mkv_reference_decode(struct demux_reference_result *result,
+    AVCodecContext *decoder, AVPacket *packet, const struct demux_packet *dp,
+    double relative)
+{
+    if (av_new_packet(packet, (int)dp->len) < 0)
+        return false;
+    memcpy(packet->data, dp->buffer, dp->len);
+    packet->pts = llrint(dp->pts * 1000.0);
+    packet->dts = AV_NOPTS_VALUE;
+    packet->duration = dp->duration * 1000.0; // same lavc_conv truncation
+    if (packet->pts < 0)
+        packet->pts = 0;
+    AVSubtitle sub = {0};
+    int got = 0;
+    int consumed = avcodec_decode_subtitle2(decoder, &sub, &got, packet);
+    bool good = consumed == packet->size && got && sub.num_rects > 0 &&
+        sub.start_display_time != UINT32_MAX && sub.end_display_time != UINT32_MAX;
+    for (unsigned i = 0; good && i < sub.num_rects; i++) {
+        const AVSubtitleRect *r = sub.rects[i];
+        good = r && r->type == SUBTITLE_ASS && r->ass && !r->w && !r->h;
+    }
+    double start = relative + sub.start_display_time / 1000.0;
+    double end = relative + sub.end_display_time / 1000.0;
+    if (sub.end_display_time == packet->duration)
+        end = relative + dp->duration; // never narrow a boundary-crossing cue
+    good &= isfinite(start) && isfinite(end) && end > start;
+    if (good && start >= 0 && end <= MKV_REFERENCE_WINDOW_MS / 1000.0) {
+        int64_t a = llrint(start * 1000), b = llrint(end * 1000);
+        unsigned n = result->num_pairs;
+        good = n < DEMUX_REFERENCE_MAX_PAIRS && b > a &&
+            (!n || a >= result->pairs[n - 1].start_ms);
+        if (good)
+            result->pairs[result->num_pairs++] = (struct demux_reference_pair){a, b};
+    }
+    avsubtitle_free(&sub);
+    av_packet_unref(packet);
+    return good;
+}
+
+bool demux_mkv_reference_sparse_decode(const struct mkv_sparse_planner *planner,
+    const struct demux_mkv_reference_spec *spec, size_t spec_size,
+    const AVIOInterruptCB *interrupt,
+    struct demux_reference_result *out, size_t out_size)
+{
+    if (!spec || spec_size != sizeof(*spec) || spec->version != DEMUX_MKV_REFERENCE_VERSION ||
+        !interrupt || !interrupt->callback || !out || out_size != sizeof(*out) ||
+        out->complete || out->num_pairs || interrupt->callback(interrupt->opaque))
+        return false;
+    size_t count = 0;
+    const struct mkv_sparse_text *text = mkv_sparse_planner_text(planner, &count);
+    if (!text || !count || count > 10000)
+        return false;
+    AVCodecContext *decoder = NULL;
+    AVPacket *packet = NULL;
+    AVDictionary *options = NULL;
+    struct demux_reference_result value = {0};
+    const AVCodec *codec = avcodec_find_decoder(AV_CODEC_ID_SUBRIP);
+    bool ok = false;
+    if (!codec || (codec->capabilities & AV_CODEC_CAP_DELAY))
+        goto done;
+    decoder = avcodec_alloc_context3(codec);
+    packet = av_packet_alloc();
+    if (!decoder || !packet || av_dict_set(&options, "sub_text_format", "ass", 0) < 0 ||
+        av_dict_set(&options, "flags2", "+ass_ro_flush_noop", 0) < 0)
+        goto done;
+    decoder->thread_count = 1;
+    if (avcodec_open2(decoder, codec, &options) < 0)
+        goto done;
+    av_dict_free(&options);
+    decoder->time_base = decoder->pkt_timebase = (AVRational){1, 1000};
+    decoder->sub_charenc_mode = FF_SUB_CHARENC_MODE_IGNORE;
+    for (size_t i = 0; i < count; i++) {
+        if (interrupt->callback(interrupt->opaque) || !text[i].data || !text[i].bytes || text[i].bytes > 65536 ||
+            text[i].pts_ns < 0 || !text[i].duration_ns)
+            goto done;
+        // Same original native conversion order: block_ns/1e9 - codec_delay.
+        double pts = (text[i].pts_ns + spec->codec_delay_ns) / 1e9 -
+            spec->codec_delay_ns / 1e9;
+        struct demux_packet dp = {.buffer = (unsigned char *)text[i].data,
+            .len = text[i].bytes, .pts = pts, .duration = text[i].duration_ns / 1e9};
+        double relative = pts - spec->demux_start_time;
+        if (!isfinite(relative) || relative < 0 ||
+            !mkv_reference_decode(&value, decoder, packet, &dp, relative))
+            goto done;
+    }
+    AVSubtitle flushed = {0};
+    AVPacket empty = {0};
+    int got = 0;
+    int rc = avcodec_decode_subtitle2(decoder, &flushed, &got, &empty);
+    bool drained = rc == 0 && !got && !flushed.num_rects;
+    avsubtitle_free(&flushed);
+    if (!drained || !value.num_pairs || interrupt->callback(interrupt->opaque))
+        goto done;
+    // Deliberately tentative: this helper grants no source witness/completion.
+    *out = value;
+    ok = true;
+done:
+    av_dict_free(&options);
+    av_packet_free(&packet);
+    avcodec_free_context(&decoder);
+    return ok;
+}
+
+bool demux_mkv_reference_run(struct stream_reference_reader_grant *grant,
+    const struct demux_mkv_reference_spec *spec, size_t spec_size,
+    int64_t deadline, const AVIOInterruptCB *interrupt,
+    struct demux_reference_result *out, size_t out_size)
+{
+    int64_t now = mp_time_ns();
+    if (!grant || !spec || spec_size != sizeof(*spec) ||
+        spec->version != DEMUX_MKV_REFERENCE_VERSION || !interrupt ||
+        !interrupt->callback || !out || out_size != sizeof(*out) ||
+        out->complete || out->num_pairs || deadline <= now ||
+        deadline - now > 30000000000LL)
+        return false;
+    struct demux_reference_result value = {0};
+    struct mkv_reference_io io = {.grant = grant, .interrupt = interrupt,
+                                  .deadline_ns = deadline};
+    AVIOInterruptCB cb = {.callback = mkv_reference_interrupt, .opaque = &io};
+    struct mpv_global *g = NULL;
+    struct stream *s = NULL;
+    struct demuxer *d = NULL;
+    struct mp_cancel *cancel = NULL;
+    AVCodecContext *decoder = NULL;
+    AVPacket *packet = NULL;
+    AVDictionary *options = NULL;
+    struct demux_packet *dp = NULL;
+    bool ok = false, complete = false, seen = false;
+    double previous = -INFINITY;
+    if (mkv_reference_interrupt(&io) ||
+        !stream_reference_reader_witness(grant, &value.source_generation,
+            &value.source_epoch, &value.response_generation) ||
+        !stream_reference_reader_open(grant, &cb, &io.reader))
+        goto done;
+    g = mkv_reference_global();
+    cancel = mp_cancel_new(NULL);
+    struct stream_open_args args = {.global = g, .cancel = cancel,
+        .url = "reference-mkv-owned://", .flags = STREAM_READ | STREAM_SILENT |
+        spec->source_origin, .sinfo = &mkv_reference_stream_info, .special_arg = &io};
+    if (stream_create_with_args(&args, &s) != STREAM_OK)
+        goto done;
+    char format[] = "mkv";
+    struct demuxer_params params = {.force_format = format, .external_stream = s,
+        .disable_timeline = true, .allow_playlist_create = false};
+    d = demux_open_url(NULL, &params, cancel, g);
+    struct sh_stream *selected = d ? demux_mkv_reference_find_duplicate(d, spec, spec_size) : NULL;
+    if (!selected || io.failed || mkv_reference_interrupt(&io))
+        goto done;
+    demuxer_select_track(d, selected, MP_NOPTS_VALUE, true);
+    const AVCodec *codec = avcodec_find_decoder(AV_CODEC_ID_SUBRIP);
+    if (!codec || (codec->capabilities & AV_CODEC_CAP_DELAY))
+        goto done;
+    decoder = avcodec_alloc_context3(codec);
+    packet = av_packet_alloc();
+    if (!decoder || !packet || av_dict_set(&options, "sub_text_format", "ass", 0) < 0 ||
+        av_dict_set(&options, "flags2", "+ass_ro_flush_noop", 0) < 0)
+        goto done;
+    decoder->thread_count = 1;
+    if (avcodec_open2(decoder, codec, &options) < 0)
+        goto done;
+    av_dict_free(&options);
+    decoder->time_base = decoder->pkt_timebase = (AVRational){1, 1000};
+    decoder->sub_charenc_mode = FF_SUB_CHARENC_MODE_IGNORE;
+    for (;;) {
+        if (io.failed || mkv_reference_interrupt(&io) ||
+            value.packets_seen >= MKV_REFERENCE_PACKET_LIMIT)
+            goto done;
+        dp = demux_read_any_packet(d); // real non-threaded native demux/cache
+        if (io.failed || mkv_reference_interrupt(&io) ||
+            demux_mkv_reference_find_duplicate(d, spec, spec_size) != selected)
+            goto done;
+        if (!dp) {
+            struct avpriv_vortx_reference_stats stats = {0};
+            complete = avpriv_vortx_reference_stats_v1(io.reader, &stats, sizeof(stats)) == 0 &&
+                !stats.terminal_error && stats.complete_entity && stats.reached_entity_eof && seen;
+            break;
+        }
+        value.packets_seen++;
+        double relative = dp->pts - spec->demux_start_time;
+        if (dp->stream != selected->index || dp->segmented || dp->is_wrapped_avframe ||
+            dp->is_cached || !dp->buffer || !dp->len || dp->len > MKV_REFERENCE_PACKET_BYTES ||
+            !isfinite(dp->pts) || fabs(dp->pts) > (double)INT64_MAX / 2000.0 ||
+            !isfinite(dp->duration) || dp->duration <= 0 ||
+            dp->duration * 1000.0 >= UINT32_MAX || !isfinite(relative) ||
+            relative < 0 || relative < previous || (!seen && relative > 30) ||
+            (dp->avpacket && (dp->avpacket->flags & (AV_PKT_FLAG_CORRUPT | AV_PKT_FLAG_DISCARD))))
+            goto done;
+        seen = true;
+        previous = relative;
+        if (relative >= MKV_REFERENCE_WINDOW_MS / 1000.0) {
+            complete = true;
+            break;
+        }
+        if (!mkv_reference_decode(&value, decoder, packet, dp, relative))
+            goto done;
+        free_demux_packet(dp);
+        dp = NULL;
+    }
+    AVSubtitle flushed = {0};
+    AVPacket empty = {0};
+    int got = 0;
+    int rc = avcodec_decode_subtitle2(decoder, &flushed, &got, &empty);
+    bool drained = rc == 0 && !got && !flushed.num_rects;
+    avsubtitle_free(&flushed);
+    struct avpriv_vortx_reference_stats stats = {0};
+    if (!complete || !drained || !value.num_pairs || io.failed || mkv_reference_interrupt(&io) ||
+        avpriv_vortx_reference_stats_v1(io.reader, &stats, sizeof(stats)) < 0 ||
+        stats.terminal_error || stats.body_bytes > VORTX_REFERENCE_READER_MAX_BYTES)
+        goto done;
+    value.stream_index = spec->owner_stream_index;
+    value.demuxer_id = spec->owner_demuxer_id;
+    value.ff_index = value.av_stream_id = -1; // native TrackNumber is not an AVStream index
+    value.format_kind = 3; // native same-parser Matroska, never lavf Matroska
+    value.codec_id = AV_CODEC_ID_SUBRIP;
+    value.time_base_num = 1;
+    value.time_base_den = 1000;
+    value.source_origin = spec->source_origin;
+    value.origin_seconds = spec->demux_start_time;
+    value.prefix_end_ms = MKV_REFERENCE_WINDOW_MS;
+    value.input_bytes = stats.body_bytes;
+    value.complete = true;
+    ok = true;
+done:
+    free_demux_packet(dp);
+    av_dict_free(&options);
+    av_packet_free(&packet);
+    avcodec_free_context(&decoder);
+    demux_free(d);
+    free_stream(s); // external stream: demux_free deliberately does not own it
+    talloc_free(cancel);
+    talloc_free(g);
+    avpriv_vortx_reference_reader_close_v1(&io.reader);
+    if (ok && !io.failed && !mkv_reference_interrupt(&io))
+        *out = value;
+    else
+        ok = false;
+    // A failed call never writes partial cue values into caller storage.
+    return ok;
+}
diff --git a/demux/reference_mkv_sparse.h b/demux/reference_mkv_sparse.h
new file mode 100644
--- /dev/null
+++ b/demux/reference_mkv_sparse.h
@@ -0,0 +1,94 @@
+/* Proposed sparse primitives and original-owner integer-origin API.
+ * SOURCE ONLY, UNCOMPILED/UNRUN; no sparse network reader is activated. */
+#pragma once
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <limits.h>
+
+#define MKV_SPARSE_MAX_REQUESTS 256u
+#define MKV_SPARSE_MAX_SPANS 1024u
+#define MKV_SPARSE_MAX_HTTP_BYTES (128u * 1024u * 1024u)
+#define MKV_SPARSE_MAX_BATCH_PAYLOAD (4u * 1024u * 1024u)
+#define MKV_SPARSE_MAX_SPAN_BYTES (1024u * 1024u)
+#define MKV_SPARSE_HEADER_WINDOW 512u
+#define MKV_SPARSE_MAX_CLUSTER_HINTS 8192u
+#define MKV_SPARSE_MAX_ACTIVE_CLUSTERS 1024u
+#define MKV_SPARSE_MAX_EXACT_NS (UINT64_C(1) << 53)
+
+struct demuxer;
+struct sh_stream;
+/* Same original native owner exclusion as capture_spec. No I/O. Size checked
+ * before write; failure leaves caller scalar unchanged. This is the ACTUAL
+ * probe-first-timestamp cluster integer used by the original parser, not a
+ * reconstructed double or an indexed time. No authority follows from it. */
+bool demux_mkv_reference_sparse_origin(struct demuxer *demuxer,
+    struct sh_stream *selected, double consumer_ts_offset,
+    int64_t *origin_ns, size_t origin_size);
+
+struct mkv_sparse_span { uint64_t start, bytes; };
+struct mkv_sparse_origin {
+    int64_t first_cluster_ns; /* real original native integer before /1e9 */
+    int64_t timecode_scale;
+    uint64_t codec_delay_ns;
+    uint64_t entity_total; /* supplied only by the immutable FF recipe */
+    uint64_t segment_start, segment_end;
+    uint64_t track_number, track_uid;
+    int64_t window_end_ms;
+};
+enum mkv_sparse_phase {
+    MKV_SPARSE_DISCOVER_HEADERS,
+    MKV_SPARSE_VERIFY_SEGMENT_CHAIN,
+    MKV_SPARSE_WALK_CHILDREN,
+    MKV_SPARSE_NEED_BATCH,
+    MKV_SPARSE_NEED_SELECTED_PAYLOAD,
+    MKV_SPARSE_COMPLETE,
+    MKV_SPARSE_UNAVAILABLE,
+};
+
+/* A scalar prerequisite only. It NEVER proves hierarchy, resource identity,
+ * source authority, response completeness or that a Cluster header was real.
+ * Caller must separately prove actual Timestamp before Blocks and known-size
+ * strict hierarchy. Refusal means WALK, not absence. No floating conversion. */
+static inline bool mkv_sparse_time_excludes_window(
+    const struct mkv_sparse_origin *o, uint64_t cluster_ticks)
+{
+    if (!o || o->first_cluster_ns < 0 ||
+        (uint64_t)o->first_cluster_ns > MKV_SPARSE_MAX_EXACT_NS ||
+        o->timecode_scale < 1 || o->timecode_scale > 1000000000LL ||
+        o->codec_delay_ns > 60000000000ULL ||
+        o->window_end_ms < 1 || o->window_end_ms > 1080000 ||
+        cluster_ticks > MKV_SPARSE_MAX_EXACT_NS / (uint64_t)o->timecode_scale)
+        return false;
+    uint64_t cluster_ns = cluster_ticks * (uint64_t)o->timecode_scale;
+    uint64_t negative_relative = UINT64_C(32768) * (uint64_t)o->timecode_scale;
+    uint64_t correction = negative_relative + o->codec_delay_ns;
+    if (cluster_ns < correction)
+        return false;
+    uint64_t boundary = (uint64_t)o->first_cluster_ns +
+        (uint64_t)o->window_end_ms * 1000000u + 1000000u;
+    return cluster_ns - correction > boundary;
+}
+
+/* Only request shape/bounds, never a transport authority check. Native planner
+ * sorts and merges overlap/adjacency first; a proposed batch must fit atomically.
+ * A root integration must bind this shape to the actual FF budget transaction. */
+static inline bool mkv_sparse_spans_valid(const struct mkv_sparse_span *spans,
+    size_t count, uint64_t known_total)
+{
+    if (!spans || !count || count > MKV_SPARSE_MAX_SPANS ||
+        !known_total || known_total > INT64_MAX)
+        return false;
+    uint64_t sum = 0, previous_end = 0;
+    for (size_t i = 0; i < count; i++) {
+        uint64_t start = spans[i].start, bytes = spans[i].bytes;
+        if (!bytes || bytes > MKV_SPARSE_MAX_SPAN_BYTES || start >= known_total ||
+            bytes > known_total - start || (i && start <= previous_end))
+            return false;
+        sum += bytes;
+        if (sum > MKV_SPARSE_MAX_BATCH_PAYLOAD)
+            return false;
+        previous_end = start + bytes; /* exclusive, also refuses unmerged adjacency */
+    }
+    return true;
+}
diff --git a/demux/reference_mkv_sparse_planner.c b/demux/reference_mkv_sparse_planner.c
new file mode 100644
--- /dev/null
+++ b/demux/reference_mkv_sparse_planner.c
@@ -0,0 +1,671 @@
+/* Actual resumable sparse EBML planner. Source proposal, UNCOMPILED/UNRUN.
+ * No socket, URL, AVIO, owner, global config or cancel pointer is borrowed. */
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include "reference_mkv_sparse_planner.h"
+
+#define SP_MAX_CLUSTERS 8192u
+#define SP_MAX_TEXT 10000u
+#define SP_MAX_TEXT_BYTES (8u * 1024u * 1024u)
+#define SP_MAX_METADATA (1024u * 1024u)
+#define SP_MAX_STEPS 4000000u
+#define SP_SEGMENT 0x18538067u
+#define SP_CLUSTER 0x1f43b675u
+#define SP_INFO 0x1549a966u
+#define SP_TRACKS 0x1654ae6bu
+#define SP_CUES 0x1c53bb6bu
+#define SP_SEEKHEAD 0x114d9b74u
+
+struct sp_element { uint32_t id; uint64_t start, body, end; bool unknown; };
+struct sp_cache { struct mkv_sparse_bytes bytes; unsigned char *owned; };
+struct sp_cluster {
+    uint64_t start, body, end, cursor, ticks;
+    uint64_t group_end, block_position, payload_start, duration;
+    uint32_t payload_bytes;
+    int16_t relative;
+    bool header, accepted, timestamp, done, excluded, invalid_hint, first_known_block;
+    bool group, block, selected, duration_seen, forbidden;
+};
+struct mkv_sparse_planner {
+    struct demux_mkv_reference_spec spec;
+    struct mkv_sparse_origin origin;
+    bool (*abort_requested)(void *); void *abort_opaque;
+    struct mkv_sparse_progress progress;
+    struct sp_cluster *clusters; size_t cluster_count;
+    struct mkv_sparse_text *text; size_t text_count; uint64_t text_bytes;
+    struct sp_cache cache[MKV_SPARSE_MAX_SPANS]; size_t cache_count;
+    struct mkv_sparse_span need[MKV_SPARSE_MAX_SPANS], pending[MKV_SPARSE_MAX_SPANS];
+    size_t need_count, pending_count; uint64_t batch_id;
+    uint64_t boot_pos, chain_pos, segment_end, cues_pos;
+    uint64_t origin_frontier, track_numbers[1024]; size_t track_count;
+    unsigned boot, metadata_seen, steps;
+    bool cues_done, pending_active, origin_verified;
+};
+static bool sp_fail(struct mkv_sparse_planner *p)
+{ p->progress.failed = true; return false; }
+static bool sp_live(struct mkv_sparse_planner *p)
+{
+    return !p->progress.failed &&
+        (!p->abort_requested || !p->abort_requested(p->abort_opaque)) &&
+        p->steps++ < SP_MAX_STEPS ? true : sp_fail(p);
+}
+static void sp_clear_cache(struct mkv_sparse_planner *p)
+{
+    for (size_t i = 0; i < p->cache_count; i++) free(p->cache[i].owned);
+    p->cache_count = 0;
+}
+static const unsigned char *sp_data(struct mkv_sparse_planner *p,
+    uint64_t at, uint64_t bytes)
+{
+    if (!bytes || at >= p->origin.entity_total || bytes > p->origin.entity_total - at)
+        return NULL;
+    for (size_t i = 0; i < p->cache_count; i++) {
+        struct mkv_sparse_bytes *c = &p->cache[i].bytes;
+        if (at >= c->start && at - c->start <= c->bytes &&
+            bytes <= c->bytes - (at - c->start))
+            return c->data + (at - c->start);
+    }
+    return NULL;
+}
+static void sp_need(struct mkv_sparse_planner *p, uint64_t at,
+                    uint64_t bytes, uint64_t parent_end)
+{
+    if (at >= parent_end || parent_end > p->origin.entity_total ||
+        !bytes || bytes > MKV_SPARSE_MAX_SPAN_BYTES) { sp_fail(p); return; }
+    uint64_t n = bytes < 512 ? 512 : bytes;
+    if (n > parent_end - at) n = parent_end - at;
+    if (n < bytes) { sp_fail(p); return; }
+    for (size_t i = 0; i < p->need_count; i++)
+        if (p->need[i].start == at && p->need[i].bytes >= n) return;
+    if (p->need_count < MKV_SPARSE_MAX_SPANS)
+        p->need[p->need_count++] = (struct mkv_sparse_span){at, n};
+}
+static unsigned sp_width(unsigned char first, unsigned maximum)
+{
+    if (!first) return 0;
+    unsigned n = 1;
+    for (unsigned mask = 0x80; !(first & mask); mask >>= 1) n++;
+    return n <= maximum ? n : 0;
+}
+/* 1 parsed, 0 missing admitted bytes, -1 invalid. Parent bounds are checked
+ * before every ID/size access and before converting a length into an offset. */
+static int sp_element(struct mkv_sparse_planner *p, uint64_t at,
+    uint64_t parent_end, struct sp_element *out)
+{
+    if (at >= parent_end || parent_end > p->origin.entity_total) return -1;
+    const unsigned char *b = sp_data(p, at, 1);
+    if (!b) { sp_need(p, at, 1, parent_end); return 0; }
+    unsigned idn = sp_width(b[0], 4);
+    if (!idn || idn > parent_end - at) return -1;
+    b = sp_data(p, at, idn + 1);
+    if (!b) { sp_need(p, at, idn + 1, parent_end); return 0; }
+    unsigned sn = sp_width(b[idn], 8);
+    if (!sn || idn + sn > parent_end - at) return -1;
+    b = sp_data(p, at, idn + sn);
+    if (!b) { sp_need(p, at, idn + sn, parent_end); return 0; }
+    uint32_t id = 0; uint64_t size = b[idn] & (0xffu >> sn);
+    for (unsigned i = 0; i < idn; i++) id = (id << 8) | b[i];
+    for (unsigned i = 1; i < sn; i++) size = (size << 8) | b[idn + i];
+    uint64_t body = at + idn + sn;
+    bool unknown = size == (UINT64_C(1) << (7 * sn)) - 1;
+    if (!unknown && size > parent_end - body) return -1;
+    *out = (struct sp_element){id, at, body, unknown ? parent_end : body + size, unknown};
+    return 1;
+}
+/* Strict memory EBML used only on a completely copied bounded metadata body. */
+static bool sp_memory_element(const unsigned char *b, size_t size, size_t *at,
+    uint32_t *id, const unsigned char **value, size_t *bytes)
+{
+    if (*at >= size) return false;
+    unsigned a = sp_width(b[*at], 4);
+    if (!a || a >= size - *at) return false;
+    unsigned n = sp_width(b[*at + a], 8);
+    if (!n || a + n > size - *at) return false;
+    uint64_t z = b[*at + a] & (0xffu >> n); *id = 0;
+    for (unsigned i = 0; i < a; i++) *id = (*id << 8) | b[*at + i];
+    for (unsigned i = 1; i < n; i++) z = (z << 8) | b[*at + a + i];
+    if (z == (UINT64_C(1) << (7 * n)) - 1 || z > size - *at - a - n) return false;
+    *at += a + n; *value = b + *at; *bytes = z; *at += z; return true;
+}
+static bool sp_uint(const unsigned char *b, size_t n, uint64_t *v)
+{
+    if (n > 8) return false;
+    *v = 0; for (size_t i = 0; i < n; i++) *v = (*v << 8) | b[i];
+    return true;
+}
+static bool sp_info(struct mkv_sparse_planner *p, const unsigned char *b, size_t n)
+{
+    size_t at = 0; unsigned scale_seen = 0, uid_seen = 0;
+    uint64_t scale = 1000000; unsigned char uid[16] = {0};
+    while (at < n) {
+        if(!sp_live(p))return false;
+        uint32_t id; const unsigned char *v; size_t z;
+        if (!sp_memory_element(b, n, &at, &id, &v, &z)) return false;
+        if (id == 0x2ad7b1) { if (scale_seen++ || !sp_uint(v, z, &scale)) return false; }
+        if (id == 0x73a4) { if (uid_seen++ || z != 16) return false; memcpy(uid, v, 16); }
+        if (id == 0x3cb923 || id == 0x3eb923) return false; // linked Segments
+    }
+    return scale == (uint64_t)p->spec.timecode_scale &&
+        !memcmp(uid, p->spec.segment_uid, 16);
+}
+static bool sp_track(struct mkv_sparse_planner *p, const unsigned char *b, size_t n,
+                     uint64_t *number, uint64_t *uid, bool *selected)
+{
+    size_t at = 0; unsigned ns = 0, us = 0, ts = 0, cs = 0, ds = 0, fs = 0, ss = 0;
+    uint64_t type = 0, delay = 0, duration = 0; bool utf8 = false, prohibited = false;
+    *number = *uid = 0;
+    while (at < n) {
+        if(!sp_live(p))return false;
+        uint32_t id; const unsigned char *v; size_t z; uint64_t u;
+        if (!sp_memory_element(b, n, &at, &id, &v, &z)) return false;
+        switch (id) {
+        case 0xd7: if (ns++ || !sp_uint(v,z,number)) return false; break;
+        case 0x73c5: if (us++ || !sp_uint(v,z,uid)) return false; break;
+        case 0x83: if (ts++ || !sp_uint(v,z,&type)) return false; break;
+        case 0x86: if (cs++) return false; utf8 = z == 11 && !memcmp(v,"S_TEXT/UTF8",11); break;
+        case 0x56aa: if (ds++ || !sp_uint(v,z,&delay)) return false; break;
+        case 0x23e383: if (fs++ || !sp_uint(v,z,&duration)) return false; break;
+        case 0x63a2: case 0x6d80: case 0x537f: prohibited = true; break;
+        case 0x23314f:
+            u = 0;
+            if (ss++ || !sp_uint(v,z,&u) || !((z == 4 && u == 0x3f800000u) ||
+                (z == 8 && u == UINT64_C(0x3ff0000000000000)))) prohibited = true;
+            break;
+        default: break;
+        }
+    }
+    if (ns != 1 || !*number || *number > INT_MAX) return false;
+    *selected = *number == p->spec.track_number;
+    if (!*selected) return true;
+    return us == 1 && *uid == p->spec.track_uid && ts == 1 && type == 17 &&
+        cs == 1 && utf8 && !prohibited && delay == p->spec.codec_delay_ns &&
+        duration == p->spec.default_duration_ns && ds == p->spec.codec_delay_present &&
+        fs == p->spec.default_duration_present;
+}
+static bool sp_tracks(struct mkv_sparse_planner *p, const unsigned char *b, size_t n)
+{
+    uint64_t numbers[1024], uids[1024]; size_t at = 0, count = 0; unsigned selected = 0;
+    while (at < n) {
+        if(!sp_live(p))return false;
+        uint32_t id; const unsigned char *v; size_t z; bool match;
+        if (!sp_memory_element(b,n,&at,&id,&v,&z)) return false;
+        if (id == 0xbf || id == 0xec) continue;
+        if (id != 0xae || count == 1024 || !sp_track(p,v,z,&numbers[count],&uids[count],&match)) return false;
+        for (size_t i = 0; i < count; i++) if (numbers[i] == numbers[count]) return false;
+        selected += match; count++;
+    }
+    unsigned same_uid = 0;
+    for (size_t i = 0; i < count; i++) same_uid += uids[i] == p->spec.track_uid;
+    if(count != p->spec.num_tracks || selected != 1 || same_uid != 1)return false;
+    memcpy(p->track_numbers,numbers,count*sizeof(*numbers));p->track_count=count;
+    return true;
+}
+static struct sp_cluster *sp_cluster(struct mkv_sparse_planner *p, uint64_t at)
+{
+    if (at < (uint64_t)p->spec.segment_start || at >= p->segment_end) return NULL;
+    for (size_t i = 0; i < p->cluster_count; i++) if (p->clusters[i].start == at) return &p->clusters[i];
+    if (p->cluster_count == SP_MAX_CLUSTERS) { sp_fail(p); return NULL; }
+    struct sp_cluster *c = &p->clusters[p->cluster_count++]; *c = (struct sp_cluster){.start=at}; return c;
+}
+static bool sp_cue_positions(struct mkv_sparse_planner *p, const unsigned char *b,
+                            size_t n, unsigned depth)
+{
+    if (depth > 4) return false;
+    size_t at = 0;
+    while (at < n) {
+        if(!sp_live(p))return false;
+        uint32_t id; const unsigned char *v; size_t z; uint64_t pos;
+        if (!sp_memory_element(b,n,&at,&id,&v,&z)) return false;
+        if (id == 0xbb || id == 0xb7) {
+            if (!sp_cue_positions(p,v,z,depth+1)) return false;
+        } else if (id == 0xf1) {
+            if (!sp_uint(v,z,&pos) || pos > p->segment_end - p->spec.segment_start) return false;
+            if (!sp_cluster(p, p->spec.segment_start + pos)) return false;
+        }
+    }
+    return true;
+}
+static bool sp_seekhead(struct mkv_sparse_planner *p, const unsigned char *b, size_t n)
+{
+    size_t at = 0;
+    while (at < n) {
+        if(!sp_live(p))return false;
+        uint32_t id; const unsigned char *v; size_t z;
+        if (!sp_memory_element(b,n,&at,&id,&v,&z)) return false;
+        if (id != 0x4dbb) continue;
+        size_t a = 0; uint64_t which = 0, position = UINT64_MAX; unsigned is = 0, ps = 0;
+        while (a < z) {
+            if(!sp_live(p))return false;
+            uint32_t child; const unsigned char *cv; size_t cz;
+            if (!sp_memory_element(v,z,&a,&child,&cv,&cz)) return false;
+            if (child == 0x53ab && (is++ || !sp_uint(cv,cz,&which))) return false;
+            if (child == 0x53ac && (ps++ || !sp_uint(cv,cz,&position))) return false;
+        }
+        if (which == SP_CUES && is == 1 && ps == 1) {
+            if (position >= p->segment_end - p->spec.segment_start) return false;
+            uint64_t absolute = p->spec.segment_start + position;
+            if (p->cues_pos && p->cues_pos != absolute) return false;
+            p->cues_pos = absolute;
+        }
+    }
+    return true;
+}
+static int sp_metadata(struct mkv_sparse_planner *p, struct sp_element e, bool speculative)
+{
+    uint64_t n = e.end - e.body;
+    if (e.unknown || e.end-e.start > SP_MAX_METADATA || !n) return -1;
+    const unsigned char *b = sp_data(p,e.body,n);
+    // Retry must retain the element header together with its body. Asking for
+    // body-only bytes would evict that header and alternate NEED forever.
+    if (!b) { sp_need(p,e.start,e.end-e.start,e.end); return 0; }
+    if (e.id == SP_CUES) {
+        if (!sp_cue_positions(p,b,n,0)) return -1;
+        p->cues_done = true; return 1;
+    }
+    if (speculative) return -1;
+    unsigned bit = e.id == SP_INFO ? 1 : e.id == SP_TRACKS ? 2 : 0;
+    if (bit && (p->metadata_seen & bit)) return -1;
+    bool ok = e.id == SP_INFO ? sp_info(p,b,n) : e.id == SP_TRACKS ? sp_tracks(p,b,n) :
+        e.id == SP_SEEKHEAD ? sp_seekhead(p,b,n) : true;
+    if (ok) p->metadata_seen |= bit;
+    return ok ? 1 : -1;
+}
+static bool sp_boot(struct mkv_sparse_planner *p)
+{
+    struct sp_element e; int r;
+    if (!p->boot) {
+        r = sp_element(p,0,p->origin.entity_total,&e);
+        if (r <= 0) return r < 0 ? sp_fail(p) : false;
+        if (e.id != 0x1a45dfa3 || e.unknown || e.end - e.body > 65536) return sp_fail(p);
+        const unsigned char *b = sp_data(p,e.body,e.end-e.body);
+        if (!b) { sp_need(p,e.start,e.end-e.start,e.end); return false; }
+        size_t at=0; unsigned docs=0; bool valid=false;
+        while(at < e.end-e.body) {
+            if(!sp_live(p))return sp_fail(p);
+            uint32_t id; const unsigned char *v; size_t z; uint64_t u;
+            if (!sp_memory_element(b,e.end-e.body,&at,&id,&v,&z)) return sp_fail(p);
+            if (id == 0x4282) { docs++; valid=(z==8&&!memcmp(v,"matroska",8))||(z==4&&!memcmp(v,"webm",4)); }
+            if ((id==0x42f7||id==0x4285) && (!sp_uint(v,z,&u)||u>2)) return sp_fail(p);
+        }
+        if (docs != 1 || !valid) return sp_fail(p);
+        p->boot_pos=e.end; p->boot=1;
+    }
+    if (p->boot==1) {
+        r=sp_element(p,p->boot_pos,p->origin.entity_total,&e);
+        if (r<=0) return r<0?sp_fail(p):false;
+        if(e.id!=SP_SEGMENT||e.body!=(uint64_t)p->spec.segment_start||
+           (!e.unknown&&e.end!=(uint64_t)p->spec.segment_end)) return sp_fail(p);
+        p->segment_end=e.end; p->origin.segment_end=e.end; p->chain_pos=e.body; p->boot=2;
+    }
+    return true;
+}
+static bool sp_chain(struct mkv_sparse_planner *p)
+{
+    bool moved=false;
+    while (p->chain_pos < p->segment_end && sp_live(p)) {
+        struct sp_element e; int r=0;
+        /* A once-admitted speculative header is immutable same-entity data.
+         * It becomes a real Cluster ONLY when the contiguous chain reaches
+         * its exact start; this avoids refetching each Cue-seeded header. */
+        for(size_t i=0;i<p->cluster_count;i++) {
+            struct sp_cluster *c=&p->clusters[i];
+            if(c->start==p->chain_pos&&c->header&&!c->invalid_hint) {
+                e=(struct sp_element){SP_CLUSTER,c->start,c->body,c->end,false};r=1;break;
+            }
+        }
+        if(!r)r=sp_element(p,p->chain_pos,p->segment_end,&e);
+        if(r==0) return moved;
+        if(r<0||e.unknown) return sp_fail(p);
+        if(e.id==SP_CLUSTER) {
+            struct sp_cluster *c=sp_cluster(p,e.start); if(!c) return sp_fail(p);
+            if(c->header&&(c->body!=e.body||c->end!=e.end)) return sp_fail(p);
+            c->header=true;c->accepted=true;c->body=e.body;c->end=e.end;
+            if(!c->cursor)c->cursor=e.body;
+            if(!p->origin_frontier)p->origin_frontier=e.start;
+        } else if(e.id==SP_INFO||e.id==SP_TRACKS||e.id==SP_SEEKHEAD||e.id==SP_CUES) {
+            r=sp_metadata(p,e,false); if(!r)return moved;if(r<0)return sp_fail(p);
+        } else if(e.id!=0x1254c367&&e.id!=0x1043a770&&e.id!=0x1941a469&&e.id!=0xec&&e.id!=0xbf)
+            return sp_fail(p); // known level1 only; no resync into unknown payload
+        p->chain_pos=e.end;moved=true;
+    }
+    if(p->chain_pos==p->segment_end)p->progress.chain_complete=true;
+    return moved;
+}
+static int sp_scalar(struct mkv_sparse_planner *p,struct sp_element e,uint64_t *v)
+{
+    if(e.unknown||e.end-e.body>8)return -1;
+    const unsigned char *b=sp_data(p,e.body,e.end-e.body);
+    if(!b&&e.end!=e.body){sp_need(p,e.start,e.end-e.start,e.end);return 0;}
+    return sp_uint(b,e.end-e.body,v)&&*v!=UINT64_MAX?1:-1;
+}
+static int sp_reference_block(struct mkv_sparse_planner *p,struct sp_element e)
+{
+    uint64_t n=e.end-e.body,value=0;
+    if(e.unknown||n>8)return -1;
+    const unsigned char *b=sp_data(p,e.body,n);
+    if(!b&&n){sp_need(p,e.start,e.end-e.start,e.end);return 0;}
+    if(!sp_uint(b,n,&value))return -1;
+    // ebml_read_int sign-extends shorter encodings. Only this eight-byte
+    // value equals its EBML_INT_INVALID sentinel; -1 remains a valid reference.
+    return n==8&&value==INT64_MAX?-1:1;
+}
+static int sp_lace_byte(struct mkv_sparse_planner *p,uint64_t request_start,
+    uint64_t begin,uint64_t at,uint64_t end,unsigned char *out)
+{
+    if(at>=end||at-begin>=65536)return -1;
+    const unsigned char *b=sp_data(p,at,1);
+    if(!b){
+        uint64_t want=at-request_start+512;
+        if(want>end-request_start)want=end-request_start;
+        uint64_t limit=begin-request_start+65536;
+        if(want>limit)want=limit;
+        sp_need(p,request_start,want,end);return 0;
+    }
+    *out=*b;return 1;
+}
+static int sp_lace_vint(struct mkv_sparse_planner *p,uint64_t request_start,
+    uint64_t begin,uint64_t *at,uint64_t end,uint64_t *out,unsigned *width)
+{
+    unsigned char first;int r=sp_lace_byte(p,request_start,begin,*at,end,&first);if(r<=0)return r;
+    unsigned n=sp_width(first,8);if(!n||n>end-*at)return -1;
+    uint64_t value=first&(0xffu>>n);
+    for(unsigned i=1;i<n;i++){
+        unsigned char b;r=sp_lace_byte(p,request_start,begin,*at+i,end,&b);if(r<=0)return r;
+        value=(value<<8)|b;
+    }
+    *at+=n;*out=value;*width=n;return 1;
+}
+/* Native read_block parses lacing BEFORE track selection. Validate that same
+ * geometry even for skipped audio/video, so malformed unselected data cannot
+ * conceal a real native Cluster rejection before a later selected occurrence.
+ * Only the small lace table is fetched, never the media frames. */
+static int sp_lacing(struct mkv_sparse_planner *p,uint64_t request_start,
+                     uint64_t begin,uint64_t end,unsigned type)
+{
+    if(type==0)return end-begin<=(1u<<30)?1:-1;
+    unsigned char count;int r=sp_lace_byte(p,request_start,begin,begin,end,&count);if(r<=0)return r;
+    unsigned laces=(unsigned)count+1;uint64_t at=begin+1,total=0,sizes[256]={0};
+    if(type==2){
+        uint64_t rest=end-at;
+        return rest%laces==0&&rest/laces<=(1u<<30)?1:-1;
+    }
+    if(type==1){
+        for(unsigned i=0;i+1<laces;i++){
+            unsigned char b;
+            do{
+                r=sp_lace_byte(p,request_start,begin,at,end,&b);if(r<=0)return r;at++;
+                if(at>=end||sizes[i]>UINT32_MAX-b)return -1;
+                sizes[i]+=b;
+            }while(b==255);
+            total+=sizes[i];
+        }
+    }else if(type==3){
+        uint64_t value;unsigned width;
+        r=sp_lace_vint(p,request_start,begin,&at,end,&value,&width);if(r<=0)return r;
+        if(at>=end||value>UINT32_MAX)return -1;
+        sizes[0]=value;total=value;
+        for(unsigned i=1;i+1<laces;i++){
+            r=sp_lace_vint(p,request_start,begin,&at,end,&value,&width);if(r<=0)return r;
+            if(at>=end)return -1;
+            int64_t delta=(int64_t)value-((INT64_C(1)<<(7*width-1))-1);
+            int64_t size=(int64_t)sizes[i-1]+delta;
+            if(size<0||size>UINT32_MAX)return -1;
+            sizes[i]=size;total+=sizes[i];
+        }
+        // With a single lace the native loop overwrites size[0] with the
+        // remaining-minus-initial value, then requires exact end consumption.
+        if(laces==1&&value!=0)return -1;
+    }else return -1;
+    if(total>end-at)return -1;
+    sizes[laces-1]=end-at-total;
+    for(unsigned i=0;i<laces;i++)if(sizes[i]>(1u<<30))return -1;
+    return 1;
+}
+static int sp_block_header(struct mkv_sparse_planner *p,struct sp_cluster *c,struct sp_element e)
+{
+    uint64_t z=e.end-e.body;if(e.unknown||z<4||z>500000000)return -1;
+    const unsigned char *b=sp_data(p,e.body,1);
+    if(!b){sp_need(p,e.start,e.body-e.start+(z<11?z:11),e.end);return 0;}
+    unsigned w=sp_width(b[0],8);if(!w||w+3>z)return -1;
+    b=sp_data(p,e.body,w+3);if(!b){sp_need(p,e.start,e.body-e.start+w+3,e.end);return 0;}
+    uint64_t track=b[0]&(0xffu>>w);for(unsigned i=1;i<w;i++)track=(track<<8)|b[i];
+    if(!track||track==(UINT64_C(1)<<(7*w))-1)return -1;
+    int lace=sp_lacing(p,e.start,e.body+w+3,e.end,(b[w+2]>>1)&3);
+    if(lace<=0)return lace;
+    p->progress.block_headers++;
+    for(size_t i=0;i<p->track_count;i++)
+        if(track==p->track_numbers[i])c->first_known_block=true;
+    if(c->block)return -1;
+    c->block=true;c->selected=track==p->spec.track_number;c->block_position=e.start;
+    if(c->selected){
+        if(b[w+2]!=0||z-w-3==0||z-w-3>65536)return -1;
+        c->relative=(int16_t)((unsigned)b[w]<<8|b[w+1]);
+        c->payload_start=e.body+w+3;c->payload_bytes=z-w-3;
+    }
+    return 1;
+}
+static int sp_record(struct mkv_sparse_planner *p,struct sp_cluster *c)
+{
+    if(!c->selected)return 1;
+    if(!c->duration_seen||!c->duration||c->forbidden||c->duration>=UINT32_MAX*1000000ULL)return -1;
+    p->progress.selected_occurrences++;
+    int64_t cluster_ns=c->ticks*p->spec.timecode_scale;
+    int64_t offset=(int64_t)c->relative*p->spec.timecode_scale;
+    if((offset>0&&cluster_ns>INT64_MAX-offset)||(offset<0&&cluster_ns<INT64_MIN-offset))return -1;
+    int64_t pts=cluster_ns+offset;
+    if(pts<0||(uint64_t)pts<p->spec.codec_delay_ns)return -1;
+    pts-=p->spec.codec_delay_ns;
+    if(pts<p->origin.first_cluster_ns)return -1;
+    if(pts-p->origin.first_cluster_ns>=p->origin.window_end_ms*1000000LL)return 1;
+    const unsigned char *b=sp_data(p,c->payload_start,c->payload_bytes);
+    if(!b){p->progress.selected_occurrences--;sp_need(p,c->payload_start,c->payload_bytes,c->group_end);return 0;}
+    if(p->text_count==SP_MAX_TEXT||c->payload_bytes>SP_MAX_TEXT_BYTES-p->text_bytes)return -1;
+    unsigned char *copy=malloc(c->payload_bytes);if(!copy)return -1;memcpy(copy,b,c->payload_bytes);
+    p->text[p->text_count++]=(struct mkv_sparse_text){c->block_position,pts,c->duration,c->payload_bytes,copy};
+    p->text_bytes+=c->payload_bytes;return 1;
+}
+static bool sp_walk(struct mkv_sparse_planner *p,struct sp_cluster *c)
+{
+    bool moved=false;
+    if(c->done||c->invalid_hint)return false;
+    if(!c->header){
+        struct sp_element e;int r=sp_element(p,c->start,p->segment_end,&e);
+        if(!r)return false;
+        if(r>0&&e.id==SP_CUES&&!e.unknown){
+            r=sp_metadata(p,e,true);
+            if(!r)return false;
+            c->invalid_hint=true;return true;
+        }
+        if(r<0||e.id!=SP_CLUSTER||e.unknown){if(c->accepted)return sp_fail(p);c->invalid_hint=true;return true;}
+        c->header=true;c->body=e.body;c->end=e.end;c->cursor=e.body;moved=true;
+    }
+    /* Speculative hints only parse their headers; no child/result authority. */
+    if(!c->accepted||!(p->metadata_seen&2))return moved;
+    // Establish the genuine source-order probe origin first. Later cursors may
+    // seed immutable headers, but must not count/consume Blocks before that
+    // frontier is known; this also keeps excluded-Cluster receipts exact.
+    if(!p->origin_verified&&c->start!=p->origin_frontier)return moved;
+    if(c->timestamp&&p->origin_verified&&
+       mkv_sparse_time_excludes_window(&p->origin,c->ticks)){
+        c->done=c->excluded=true;p->progress.excluded_clusters++;return true;
+    }
+    while(!c->done&&sp_live(p)){
+        if(c->group&&c->cursor==c->group_end){
+            int r=sp_record(p,c);if(!r)return moved;if(r<0)return sp_fail(p);
+            c->group=false;c->block=false;c->selected=false;c->duration_seen=false;c->forbidden=false;
+            moved=true;continue;
+        }
+        uint64_t end=c->group?c->group_end:c->end;
+        if(c->cursor==end){
+            if(c->group||!c->timestamp)return sp_fail(p);
+            c->done=true;return true;
+        }
+        struct sp_element e;int r=sp_element(p,c->cursor,end,&e);
+        if(!r)return moved;if(r<0||e.unknown)return sp_fail(p);
+        if(!c->group&&e.id==0xe7){
+            uint64_t ticks=0;if(c->timestamp)return sp_fail(p);
+            r=sp_scalar(p,e,&ticks);if(!r)return moved;
+            if(r<0||ticks>MKV_SPARSE_MAX_EXACT_NS/(uint64_t)p->spec.timecode_scale)return sp_fail(p);
+            c->ticks=ticks;c->timestamp=true;c->cursor=e.end;moved=true;
+            if(p->origin_verified&&mkv_sparse_time_excludes_window(&p->origin,ticks)){
+                c->done=c->excluded=true;p->progress.excluded_clusters++;return true;
+            }
+            continue;
+        }
+        if(!c->timestamp&&(e.id==0xa0||e.id==0xa3))return sp_fail(p);
+        if(!c->group&&e.id==0xa0){
+            c->group=true;c->group_end=e.end;c->cursor=e.body;c->block=false;c->selected=false;
+            c->duration_seen=false;c->duration=0;c->forbidden=false;moved=true;continue;
+        }
+        if((c->group&&e.id==0xa1)||(!c->group&&e.id==0xa3)){
+            r=sp_block_header(p,c,e);if(!r)return moved;if(r<0)return sp_fail(p);
+            if(!c->group){if(c->selected)return sp_fail(p);c->block=false;}
+        }else if(c->group&&e.id==0x9b){
+            uint64_t ticks;r=sp_scalar(p,e,&ticks);if(!r)return moved;
+            if(r<0||c->duration_seen||ticks>INT64_MAX/(uint64_t)p->spec.timecode_scale)return sp_fail(p);
+            c->duration_seen=true;c->duration=ticks*p->spec.timecode_scale;
+        }else if(c->group&&e.id==0xfb){
+            r=sp_reference_block(p,e);if(!r)return moved;if(r<0)return sp_fail(p);
+        }else if(c->group&&e.id==0x75a2){
+            uint64_t padding;r=sp_scalar(p,e,&padding);if(!r)return moved;
+            if(r<0)return sp_fail(p);c->forbidden=true;
+        }else if(c->group&&(e.id==0x75a1||e.id==SP_CLUSTER)){
+            return sp_fail(p); // unsupported BlockAdditions, or native group error
+        }else if(c->group&&e.id!=0xfb&&e.id!=0xbf&&e.id!=0xec){
+            c->forbidden=true; // may precede a selected Block; never forget it
+        }else if(!c->group&&e.id==SP_CLUSTER)return sp_fail(p);
+        c->cursor=e.end;moved=true;
+    }
+    return moved;
+}
+/* The original probe uses the Cluster clock of the first known-track Block,
+ * not necessarily the first Timestamp of an empty Cluster. Verify that same
+ * source-order fact before allowing any whole-Cluster exclusion. */
+static bool sp_origin_update(struct mkv_sparse_planner *p)
+{
+    while(!p->origin_verified&&p->origin_frontier&&sp_live(p)){
+        struct sp_cluster *c=NULL;
+        for(size_t i=0;i<p->cluster_count;i++)
+            if(p->clusters[i].accepted&&p->clusters[i].start==p->origin_frontier)c=&p->clusters[i];
+        if(!c)return false;
+        if(c->first_known_block){
+            if(!c->timestamp||c->ticks*(uint64_t)p->spec.timecode_scale!=(uint64_t)p->origin.first_cluster_ns)
+                return sp_fail(p);
+            p->origin_verified=true;return true;
+        }
+        if(!c->done)return false;
+        uint64_t next=UINT64_MAX;
+        for(size_t i=0;i<p->cluster_count;i++)
+            if(p->clusters[i].accepted&&p->clusters[i].start>c->start&&p->clusters[i].start<next)
+                next=p->clusters[i].start;
+        if(next==UINT64_MAX)return false;
+        p->origin_frontier=next;
+    }
+    return false;
+}
+static int sp_span_compare(const void *a,const void *b)
+{
+    const struct mkv_sparse_span *x=a,*y=b;return x->start<y->start?-1:x->start>y->start;
+}
+static int sp_text_compare(const void *a,const void *b)
+{
+    const struct mkv_sparse_text *x=a,*y=b;return x->source_position<y->source_position?-1:x->source_position>y->source_position;
+}
+struct mkv_sparse_planner *mkv_sparse_planner_create(
+    const struct demux_mkv_reference_spec *s,size_t z,int64_t origin,uint64_t total,
+    const uint64_t *hints,size_t count,bool(*abort_requested)(void*),void *opaque)
+{
+    if(!s||z!=sizeof(*s)||s->version!=1||!total||total>INT64_MAX||origin<0||
+       (uint64_t)origin>MKV_SPARSE_MAX_EXACT_NS||s->segment_start<=0||
+       (uint64_t)s->segment_start>=total||s->timecode_scale<1||s->timecode_scale>1000000000LL||
+       !s->track_number||s->track_number>INT_MAX||!s->track_uid||s->codec_delay_ns>60000000000ULL||
+       !s->num_tracks||s->num_tracks>1024||s->codec_delay_present>1||s->default_duration_present>1||
+       s->default_duration_ns>3600000000000ULL||s->demux_start_time!=origin/1e9||
+       s->consumer_ts_offset!=0||!isfinite(s->demux_start_time)||count>SP_MAX_CLUSTERS||
+       (count&&!hints)||!abort_requested)return NULL;
+    struct mkv_sparse_planner *p=calloc(1,sizeof(*p));if(!p)return NULL;
+    p->clusters=calloc(SP_MAX_CLUSTERS,sizeof(*p->clusters));p->text=calloc(SP_MAX_TEXT,sizeof(*p->text));
+    if(!p->clusters||!p->text){mkv_sparse_planner_destroy(&p);return NULL;}
+    p->spec=*s;p->abort_requested=abort_requested;p->abort_opaque=opaque;
+    p->origin=(struct mkv_sparse_origin){.first_cluster_ns=origin,.timecode_scale=s->timecode_scale,
+        .codec_delay_ns=s->codec_delay_ns,.entity_total=total,.segment_start=s->segment_start,
+        .segment_end=total,.track_number=s->track_number,.track_uid=s->track_uid,.window_end_ms=1080000};
+    p->segment_end=total;
+    for(size_t i=0;i<count;i++)if(!sp_cluster(p,hints[i])){mkv_sparse_planner_destroy(&p);return NULL;}
+    return p;
+}
+enum mkv_sparse_step mkv_sparse_planner_next(struct mkv_sparse_planner *p,
+    struct mkv_sparse_span *out,size_t capacity,size_t *count,uint64_t *id)
+{
+    if(!p||!out||capacity<MKV_SPARSE_MAX_SPANS||!count||!id||p->pending_active||!sp_live(p))return MKV_SPARSE_ERROR;
+    *count=0;*id=0;if(p->progress.complete)return MKV_SPARSE_FINISHED;
+    p->need_count=0;
+    if(sp_boot(p)){
+        bool moved;
+        do{
+            moved=sp_chain(p);
+            if(p->cues_pos&&!p->cues_done){
+                struct sp_element e;int r=sp_element(p,p->cues_pos,p->segment_end,&e);
+                if(r<0||(r>0&&(e.id!=SP_CUES||sp_metadata(p,e,true)<0)))sp_fail(p);
+            }
+            for(size_t i=0;i<p->cluster_count&&!p->progress.failed;i++)moved|=sp_walk(p,&p->clusters[i]);
+            moved|=sp_origin_update(p);
+        }while(moved&&!p->progress.failed&&sp_live(p));
+    }
+    if(p->progress.failed)return MKV_SPARSE_ERROR;
+    bool done=p->progress.chain_complete&&p->metadata_seen==3&&p->origin_verified;
+    unsigned accepted=0;
+    for(size_t i=0;i<p->cluster_count;i++)if(p->clusters[i].accepted){accepted++;done&=p->clusters[i].done;}
+    if(done&&accepted){
+        qsort(p->text,p->text_count,sizeof(*p->text),sp_text_compare);
+        for(size_t i=1;i<p->text_count;i++)if(p->text[i].source_position==p->text[i-1].source_position||
+            p->text[i].pts_ns<p->text[i-1].pts_ns){sp_fail(p);return MKV_SPARSE_ERROR;}
+        p->progress.metadata_matched=true;p->progress.clusters=accepted;p->progress.complete=true;
+        return MKV_SPARSE_FINISHED;
+    }
+    if(!p->need_count||p->progress.batches>=MKV_SPARSE_MAX_REQUESTS){sp_fail(p);return MKV_SPARSE_ERROR;}
+    qsort(p->need,p->need_count,sizeof(*p->need),sp_span_compare);
+    size_t n=0;uint64_t sum=0;
+    for(size_t i=0;i<p->need_count;i++){
+        struct mkv_sparse_span s=p->need[i];
+        if(n&&s.start<=out[n-1].start+out[n-1].bytes){
+            uint64_t end=s.start+s.bytes,old=out[n-1].start+out[n-1].bytes;
+            if(end<=old)continue;
+            if(end-out[n-1].start>MKV_SPARSE_MAX_SPAN_BYTES)continue;
+            if(sum+end-old>MKV_SPARSE_MAX_BATCH_PAYLOAD)continue;
+            out[n-1].bytes+=end-old;sum+=end-old;continue;
+        }
+        if(sum+s.bytes>MKV_SPARSE_MAX_BATCH_PAYLOAD)continue;
+        out[n++]=s;sum+=s.bytes;
+    }
+    if(!mkv_sparse_spans_valid(out,n,p->origin.entity_total)||
+       sum>MKV_SPARSE_MAX_HTTP_BYTES-p->progress.requested_payload_bytes){sp_fail(p);return MKV_SPARSE_ERROR;}
+    memcpy(p->pending,out,n*sizeof(*out));p->pending_count=n;p->pending_active=true;
+    p->progress.batches++;p->progress.requested_payload_bytes+=sum;
+    *id=++p->batch_id;*count=n;sp_clear_cache(p);return MKV_SPARSE_FETCH;
+}
+bool mkv_sparse_planner_accept(struct mkv_sparse_planner *p,uint64_t id,
+    const struct mkv_sparse_bytes *parts,size_t count,bool framed)
+{
+    if(!p||!sp_live(p)||!p->pending_active||id!=p->batch_id||!framed||!parts||
+       count!=p->pending_count)return p?sp_fail(p):false;
+    for(size_t i=0;i<count;i++){
+        if(parts[i].start!=p->pending[i].start||parts[i].bytes!=p->pending[i].bytes||!parts[i].data){sp_clear_cache(p);return sp_fail(p);}
+        unsigned char *copy=malloc(parts[i].bytes);if(!copy){sp_clear_cache(p);return sp_fail(p);}
+        memcpy(copy,parts[i].data,parts[i].bytes);
+        p->cache[p->cache_count++]=(struct sp_cache){{parts[i].start,parts[i].bytes,copy},copy};
+    }
+    p->pending_active=false;p->pending_count=0;return true;
+}
+bool mkv_sparse_planner_progress(const struct mkv_sparse_planner *p,
+    struct mkv_sparse_progress *out,size_t z)
+{if(!p||!out||z!=sizeof(*out))return false;*out=p->progress;return true;}
+const struct mkv_sparse_text *mkv_sparse_planner_text(const struct mkv_sparse_planner *p,size_t *count)
+{if(!p||!count||!p->progress.complete||p->progress.failed)return NULL;*count=p->text_count;return p->text;}
+void mkv_sparse_planner_destroy(struct mkv_sparse_planner **pp)
+{
+    if(!pp||!*pp)return;struct mkv_sparse_planner *p=*pp;*pp=NULL;sp_clear_cache(p);
+    for(size_t i=0;i<p->text_count;i++)free((void*)p->text[i].data);
+    free(p->text);free(p->clusters);free(p);
+}
