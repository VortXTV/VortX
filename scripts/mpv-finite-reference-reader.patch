+int avpriv_vortx_reference_revalidate_v1(
+    struct AVIOContext *owner,
+    const struct avpriv_vortx_http_sent_request *expected, size_t expected_size,
+    const struct avpriv_vortx_reference_recipe *recipe);
+
+/* Persistent publication-current check. Caller owns recipe throughout this
+ * call (publication/request lease remains retained until renderer quiescence).
+ * Read only the recipe's retained response-lifetime token; never borrow AVIO,
+ * socket, mutable options/job/result or an original owner pointer. Retirement
+ * is sticky and precedes original response/transport replacement or teardown.
+ * This has NO work-deadline expiry: the 30-second read limit is separate from
+ * how long a published timing map may remain valid. Returns 1 only while this
+ * exact original completed response is current, 0 after retirement/unavailable.
+ * Supported implementation requires compile-time always-lock-free atomic_uint
+ * and atomic_bool, bounded references, and matched target/build verification.
+ * Unsupported atomic policy or allocation/ref saturation disables optional
+ * capture only; it never alters normal HTTP playback. */
+int avpriv_vortx_reference_recipe_current(
+    const struct avpriv_vortx_reference_recipe *recipe);
+
+/* One utility worker only. The owned job keeps recipe and the callback's owned
+ * cancellation state alive until close. No borrowed original source pointer.
+ * Allocate a SMALL reader, never a max_bytes body buffer. Keep original URL,
+ * Host and SNI; enforce the captured numeric peer BEFORE connect/credentials.
+ * No DNS broadening, redirects, reconnects or nested requests. Validate exact
+ * conditional response/range/identity encoding and TLS before open succeeds.
+ * No request/URL/header/auth value may appear in new logs. */
+int avpriv_vortx_reference_open_prefix_v1(
+    const struct avpriv_vortx_reference_recipe *recipe,
+    const AVIOInterruptCB *interrupt,
+    struct avpriv_vortx_reference_reader **out);
+
+/* Incremental body reads only. Count actual returned bytes against max_bytes,
+ * enforce the same deadline/callback each time, and do not retry/reopen/seek.
+ * Return AVERROR_EOF only after an admitted COMPLETE ENTITY actually ends.
+ * EOF of a partial range or exhausted byte cap is an error, never media EOF.
+ * A failure invalidates every partial timing result. Caller must stop reading
+ * as soon as a useful complete timing prefix is obtained, then close. */
+int avpriv_vortx_reference_read_v1(
+    struct avpriv_vortx_reference_reader *reader,
+    unsigned char *buffer, int buffer_size);
+
+/* Worker-owned scalars only; out zeroed and exact size checked before access.
+ * Must be called before close. No readiness/permission is inferred from stats. */
+int avpriv_vortx_reference_stats_v1(
+    const struct avpriv_vortx_reference_reader *reader,
+    struct avpriv_vortx_reference_stats *out, size_t out_size);
+
+/* Close ALL new contexts before recipe/callback storage may be released.
+ * Never closes or interrupts the original playback AVIO/socket. */
+void avpriv_vortx_reference_reader_close_v1(
+    struct avpriv_vortx_reference_reader **reader);
+void avpriv_vortx_reference_recipe_release_v1(
+    struct avpriv_vortx_reference_recipe **recipe);
