+static bool mkv_reference_make_spec(struct demuxer *d, struct sh_stream *sh,
+    double offset, struct demux_mkv_reference_spec *out)
+{
+    if (!d || d->desc != &demuxer_desc_matroska || !d->priv || !d->stream ||
+        !sh || sh->type != STREAM_SUB || !sh->codec || !sh->codec->codec ||
+        strcmp(sh->codec->codec, "subrip") || sh->codec->extradata_size ||
+        sh->codec->lav_codecpar || sh->missing_timestamps || sh->group ||
+        !isfinite(offset) || offset != 0 || !isfinite(d->start_time) ||
+        d->start_time < 0 || d->matroska_data.ordered_chapters ||
+        d->matroska_data.num_ordered_chapters ||
+        d->matroska_data.uid.edition || d->edition_is_track_mapping)
+        return false;
+    struct mkv_demuxer *p = d->priv;
+    if (!p->reference_simple_open || p->reference_timing_invalid ||
+        !p->opts || !p->opts->probe_start_time ||
+        p->edition_id != -1 || p->num_tracks < 1 || p->num_tracks > 1024 ||
+        p->tc_scale <= 0 || p->tc_scale > 1000000000LL ||
+        !d->stream_origin || (d->stream_origin & ~STREAM_ORIGIN_MASK))
+        return false;
+    struct mkv_track *selected = NULL;
+    unsigned same_uid = 0;
+    for (int i = 0; i < p->num_tracks; i++) {
+        struct mkv_track *t = p->tracks[i];
+        if (!t || !t->reference_number_valid)
+            return false; // even an unselected narrowed alias could steal blocks
+        for (int j = 0; j < i; j++) {
+            if (p->tracks[j]->reference_track_number == t->reference_track_number)
+                return false;
+        }
+        if (t->stream == sh) {
+            if (selected)
+                return false;
+            selected = t;
+        }
+    }
+    if (!selected || !selected->reference_utf8_eligible ||
+        selected->type != MATROSKA_TRACK_SUBTITLE ||
+        selected->tnum != selected->reference_track_number ||
+        selected->uid == 0 || selected->private_size || selected->num_encodings ||
+        !selected->codec_id || strcmp(selected->codec_id, "S_TEXT/UTF8") ||
+        selected->codec_delay != selected->reference_codec_delay_ns / 1e9 ||
+        selected->default_duration != selected->reference_default_duration_ns / 1e9 ||
+        sh->demuxer_id != selected->tnum)
+        return false;
+    for (int i = 0; i < p->num_tracks; i++)
+        same_uid += p->tracks[i]->uid == selected->uid;
+    if (same_uid != 1)
+        return false;
+    *out = (struct demux_mkv_reference_spec){
+        .version = DEMUX_MKV_REFERENCE_VERSION,
+        .num_tracks = p->num_tracks,
+        .track_number = selected->reference_track_number, .track_uid = selected->uid,
+        .codec_delay_ns = selected->reference_codec_delay_ns,
+        .default_duration_ns = selected->reference_default_duration_ns,
+        .codec_delay_present = selected->reference_codec_delay_present,
+        .default_duration_present = selected->reference_default_duration_present,
+        .timecode_scale = p->tc_scale, .segment_start = p->segment_start,
+        .segment_end = p->segment_end, .demux_start_time = d->start_time,
+        .consumer_ts_offset = offset, .source_origin = d->stream_origin,
+        .owner_stream_index = sh->index, .owner_demuxer_id = sh->demuxer_id,
+    };
+    memcpy(out->segment_uid, d->matroska_data.uid.segment, sizeof(out->segment_uid));
+    return true;
+}
+
+static bool mkv_reference_equal(const struct demux_mkv_reference_spec *a,
+    const struct demux_mkv_reference_spec *b, bool same_owner)
+{
+    return a && b && a->version == DEMUX_MKV_REFERENCE_VERSION &&
+        b->version == a->version && a->num_tracks == b->num_tracks &&
+        a->track_number == b->track_number && a->track_uid == b->track_uid &&
+        a->codec_delay_ns == b->codec_delay_ns &&
+        a->default_duration_ns == b->default_duration_ns &&
+        a->codec_delay_present == b->codec_delay_present &&
+        a->default_duration_present == b->default_duration_present &&
+        a->timecode_scale == b->timecode_scale &&
+        a->segment_start == b->segment_start && a->segment_end == b->segment_end &&
+        a->demux_start_time == b->demux_start_time &&
+        a->consumer_ts_offset == b->consumer_ts_offset &&
+        a->source_origin == b->source_origin &&
+        !memcmp(a->segment_uid, b->segment_uid, sizeof(a->segment_uid)) &&
+        (!same_owner || (a->owner_stream_index == b->owner_stream_index &&
+                        a->owner_demuxer_id == b->owner_demuxer_id));
+}
+
+bool demux_mkv_reference_capture_spec(struct demuxer *d, struct sh_stream *sh,
+    double offset, struct demux_mkv_reference_spec *out, size_t out_size)
+{
+    if (!out || out_size != sizeof(*out) || out->version)
+        return false;
+    struct demux_mkv_reference_spec value = {0};
+    if (!mkv_reference_make_spec(d, sh, offset, &value))
+        return false;
+    *out = value;
+    return true;
+}
+
+bool demux_mkv_reference_revalidate_spec(struct demuxer *d, struct sh_stream *sh,
+    double offset, const struct demux_mkv_reference_spec *expected, size_t size)
+{
+    struct demux_mkv_reference_spec current = {0};
+    return expected && size == sizeof(*expected) &&
+        mkv_reference_make_spec(d, sh, offset, &current) &&
+        mkv_reference_equal(expected, &current, true);
+}
+
+struct sh_stream *demux_mkv_reference_find_duplicate(struct demuxer *d,
+    const struct demux_mkv_reference_spec *expected, size_t size)
+{
+    if (!d || d->desc != &demuxer_desc_matroska || !d->priv || !expected ||
+        size != sizeof(*expected) || expected->version != DEMUX_MKV_REFERENCE_VERSION)
+        return NULL;
+    struct mkv_demuxer *p = d->priv;
+    struct sh_stream *found = NULL;
+    for (int i = 0; i < p->num_tracks; i++) {
+        struct mkv_track *t = p->tracks[i];
+        if (!t || t->reference_track_number != expected->track_number ||
+            t->uid != expected->track_uid)
+            continue;
+        struct demux_mkv_reference_spec current = {0};
+        if (found || !mkv_reference_make_spec(d, t->stream, 0, &current) ||
+            !mkv_reference_equal(expected, &current, false))
+            return NULL;
+        found = t->stream;
+    }
+    return found;
+}
+
+bool demux_mkv_reference_sparse_origin(struct demuxer *d, struct sh_stream *sh,
+    double offset, int64_t *origin_ns, size_t size)
+{
+    if (!origin_ns || size != sizeof(*origin_ns))
+        return false;
+    struct demux_mkv_reference_spec current = {0};
+    if (!mkv_reference_make_spec(d, sh, offset, &current))
+        return false;
+    struct mkv_demuxer *p = d->priv;
+    if (!p->reference_origin_valid || p->reference_origin_ns < 0 ||
+        (uint64_t)p->reference_origin_ns > MKV_SPARSE_MAX_EXACT_NS ||
+        d->start_time != p->reference_origin_ns / 1e9)
+        return false;
+    *origin_ns = p->reference_origin_ns;
+    return true;
+}
+
+static bool mkv_sparse_add_hint(struct mkv_sparse_snapshot *value,
+    uint64_t *set, uint64_t at, uint64_t segment_start)
+{
+    if (at < segment_start || at > INT64_MAX)
+        return false;
+    uint64_t hash = (at ^ (at >> 33)) * UINT64_C(0xff51afd7ed558ccd);
+    size_t slot = hash & 16383u;
+    // Bounded collisions refuse optional capture; no adversarial unbounded
+    // work on the original owner and no duplicate per-track Cue exhaustion.
+    for (unsigned probe = 0; probe < 64; probe++, slot = (slot + 1) & 16383u) {
+        if (set[slot] == at)
+            return true;
+        if (!set[slot]) {
+            if (value->hint_count == MKV_SPARSE_MAX_CAPTURE_HINTS)
+                return false;
+            set[slot] = at;
+            value->hints[value->hint_count++] = at;
+            return true;
+        }
+    }
+    return false;
+}
+
+bool demux_mkv_reference_sparse_capture(struct demuxer *d, struct sh_stream *sh,
+    double offset, struct mkv_sparse_snapshot **out)
+{
+    if (!out || *out)
+        return false;
+    struct demux_mkv_reference_spec spec = {0};
+    int64_t origin = 0;
+    if (!demux_mkv_reference_capture_spec(d, sh, offset, &spec, sizeof(spec)) ||
+        !demux_mkv_reference_sparse_origin(d, sh, offset, &origin, sizeof(origin)))
+        return false;
+    struct mkv_demuxer *p = d->priv;
+    if (p->num_headers < 0 || p->num_headers > 1024 || p->num_indexes > 65536)
+        return false;
+    struct mkv_sparse_snapshot *value = calloc(1, sizeof(*value));
+    uint64_t *set = calloc(16384, sizeof(*set));
+    if (!value || !set) {
+        free(set);
+        free(value);
+        return false;
+    }
+    value->spec = spec;
+    value->original_origin_ns = origin;
+    for (size_t i = 0; i < p->num_indexes; i++) {
+        uint64_t at = p->indexes[i].filepos;
+        if (!mkv_sparse_add_hint(value, set, at, p->segment_start)) {
+            free(set);
+            free(value);
+            return false;
+        }
+    }
+    for (int i = 0; i < p->num_headers; i++) {
+        const struct header_elem *h = &p->headers[i];
+        if (h->id == MATROSKA_ID_CUES &&
+            !mkv_sparse_add_hint(value, set, h->pos, p->segment_start)) {
+            free(set);
+            free(value);
+            return false;
+        }
+    }
+    // No seek, deferred parsing, raw pointer or new source authority. The
+    // existing original-owner source epoch and grant are captured separately.
+    free(set);
+    *out = value;
+    return true;
+}
+
+bool demux_mkv_reference_sparse_revalidate(struct demuxer *d, struct sh_stream *sh,
+    double offset, const struct mkv_sparse_snapshot *expected)
+{
+    int64_t origin = 0;
+    return expected && expected->hint_count <= MKV_SPARSE_MAX_CAPTURE_HINTS &&
+        demux_mkv_reference_revalidate_spec(d, sh, offset,
+            &expected->spec, sizeof(expected->spec)) &&
+        demux_mkv_reference_sparse_origin(d, sh, offset, &origin, sizeof(origin)) &&
+        origin == expected->original_origin_ns;
+}
+
+void demux_mkv_reference_sparse_snapshot_free(struct mkv_sparse_snapshot **out)
+{
+    if (out && *out) {
+        free(*out);
+        *out = NULL;
+    }
+}
