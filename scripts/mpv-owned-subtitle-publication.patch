--- /dev/null
+++ b/sub/owned_text_slot.h
@@ -0,0 +1,35 @@
+/* Native core is the sole writer. Only the existing serialized OSD renderer
+ * may borrow. This is NOT an account/profile/source admission capability.
+ */
+#ifndef MP_VORTX_OWNED_TEXT_SLOT_H
+#define MP_VORTX_OWNED_TEXT_SLOT_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdatomic.h>
+#include "osdep/threads.h"
+
+struct dec_sub;
+
+// Created only after sub_create_owned_text returned the complete corpus.
+// Immutable until removal, reader quiescence and off-core destruction.
+struct vortx_owned_text {
+    int64_t ticket;
+    struct dec_sub *decoder;
+};
+
+struct vortx_owned_text_slot {
+    _Atomic(struct vortx_owned_text *) active;
+    atomic_uint readers;
+    atomic_bool waiting;
+    atomic_bool dirty;
+    atomic_int_fast64_t failed_ticket;
+    bool available; // initialized before any render thread starts
+    mp_mutex wait_lock;
+    mp_cond idle;
+    // Set before video outputs start, cleared only after outputs join.
+    void (*wakeup)(void *ctx);
+    void *wakeup_ctx;
+};
+
+#endif
