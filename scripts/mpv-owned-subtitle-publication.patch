+/* Owned, whole-corpus subtitle publication through the real primary OSD slot.
+ * This file is linked inside libmpv. Only existing node commands/properties
+ * cross into Swift; no internal pointer or borrowed packet crosses that ABI.
+ */
+#include <assert.h>
+#include <limits.h>
+#include <math.h>
+#include <string.h>
+
+#include "config.h"
+#include "mpv_talloc.h"
+#include "mpv/client.h"
+#include "common/common.h"
+#include "common/playlist.h"
+#include "demux/demux.h"
+#include "demux/stheader.h"
+#include "input/cmd.h"
+#include "misc/json.h"
+#include "misc/node.h"
+#include "misc/thread_pool.h"
+#include "misc/thread_tools.h"
+#include "options/m_config_frontend.h"
+#include "options/m_option.h"
+#include "options/m_property.h"
+#include "options/options.h"
+#include "osdep/timer.h"
+#include "player/client.h"
+#include "player/command.h"
+#include "player/core.h"
+#include "sub/dec_sub.h"
+#include "sub/osd.h"
+#include "sub/owned_text_slot.h"
+#include "owned_subtitle.h"
+
+#define OWNED_JSON_LIMIT (9 * 1024 * 1024)
+
+struct owned_witness {
+    int64_t intent, entry, source;
+    int sid, ff_index, play_dir;
+    double origin, video_fps;
+    bool visible;
+};
+
+struct vortx_owned_subtitle {
+    int64_t intent, sequence;
+    bool preparing, closing;
+    struct vortx_owned_text *ready;
+    struct owned_witness ready_witness, active_witness;
+    struct vortx_owned_text *retired[2];
+    int retired_count;
+    int64_t reaping_tickets[2];
+    int reaping_count;
+};
+
+struct owned_reap {
+    struct MPContext *mpctx;
+    struct osd_state *osd;
+    struct vortx_owned_text *objects[2];
+    int64_t tickets[2];
+    int count;
+};
+
+static void kick_reaper(struct MPContext *mpctx);
+
+static void retire_object(struct vortx_owned_subtitle *s,
+                          struct vortx_owned_text *object)
+{
+    if (!object)
+        return;
+    // No prepare/publish is admitted with a retirement/reaper backlog. A
+    // replacement then mandatory revoke therefore needs at most two slots.
+    mp_assert(s->retired_count < MP_ARRAY_SIZE(s->retired));
+    s->retired[s->retired_count++] = object;
+}
+
+void mp_vortx_owned_subtitle_retire(struct MPContext *mpctx)
+{
+    struct vortx_owned_subtitle *s = mpctx->vortx_owned_subtitle;
+    if (!s)
+        return;
+    if (mpctx->osd)
+        retire_object(s, osd_vortx_owned_text_exchange(mpctx->osd, NULL));
+    retire_object(s, s->ready);
+    s->ready = NULL;
+    if (s->intent < INT64_MAX)
+        s->intent++;
+    // Notification wakes a deferred poll/reaper without acquiring an OSD or
+    // decoder lock. No destructor runs in an option or source admission body.
+    if (mpctx->clients && mpctx->osd) {
+        mp_notify_property(mpctx, "vortx-owned-subtitle-state");
+        mp_wakeup_core(mpctx);
+    }
+}
+
+void mp_vortx_owned_subtitle_option_attempt(void *p, struct m_config_option *co)
+{
+    static const char *const names[] = {
+        "sid", "secondary-sid", "sub-delay", "sub-speed", "sub-fps",
+        "sub-visibility", "secondary-sub-visibility", "rebase-start-time",
+        "input-terminal", "input-default-bindings", "input-vo-keyboard", "osc",
+        "config", "scripts", "load-scripts", "vf", "lavfi-complex",
+        "play-dir", "video-fps-override", NULL,
+    };
+    for (int n = 0; co && names[n]; n++) {
+        if (!strcmp(co->name, names[n])) {
+            mp_vortx_owned_subtitle_retire(p);
+            break;
+        }
+    }
+}
+
+static bool false_option(struct MPContext *mpctx, const char *name)
+{
+    struct m_config_option *co = m_config_get_co(mpctx->mconfig, bstr0(name));
+    return co && co->data && co->opt->type == CONF_TYPE_BOOL && !*(bool *)co->data;
+}
+
+static bool capture(struct MPContext *mpctx, struct owned_witness *out)
+{
+    struct vortx_owned_subtitle *s = mpctx->vortx_owned_subtitle;
+    struct MPOpts *o = mpctx->opts;
+    struct demuxer *d = mpctx->demuxer;
+    if (!s || s->closing || !mpctx->osd ||
+        !osd_vortx_owned_text_available(mpctx->osd) ||
+        s->intent <= 0 || s->intent == INT64_MAX || mpctx->stop_play ||
+        !mpctx->playback_initialized || !mpctx->playing || mpctx->playing->id <= 0 ||
+        !d || !d->original_local_file_identity || d->original_local_file_generation <= 0 ||
+        d->is_network || d->is_streaming || strcmp(d->desc->name, "lavf") ||
+        !isfinite(d->start_time) || fabs(d->start_time) > 86400 ||
+        mpctx->num_option_callbacks || mpctx->num_tracks < 1 || mpctx->num_tracks > 128 ||
+        !o->rebase_start_time || o->subs_shared->sub_delay[0] != 0 ||
+        o->subs_rend->sub_speed != 1 || o->subs_rend->sub_fps != 0 ||
+        (mpctx->play_dir != 1 && mpctx->play_dir != -1) ||
+        o->consolecontrols || o->load_config || o->auto_load_scripts ||
+        (o->script_files && o->script_files[0]) ||
+        (o->vf_settings && o->vf_settings[0].name) ||
+        (o->lavfi_complex && o->lavfi_complex[0]) ||
+        !false_option(mpctx, "input-default-bindings") ||
+        !false_option(mpctx, "input-vo-keyboard") ||
+        mpctx->mconfig->option_set_attempt_callback != mp_vortx_owned_subtitle_option_attempt ||
+        mpctx->mconfig->option_set_attempt_callback_ctx != mpctx)
+        return false;
+#if HAVE_LUA
+    if (o->lua_load_osc)
+        return false;
+#endif
+    struct track *primary = mpctx->current_track[0][STREAM_SUB];
+    if (!primary || primary->type != STREAM_SUB || !primary->selected ||
+        primary->is_external || primary->demuxer != d || !primary->stream ||
+        primary->user_tid <= 0 || primary->ff_index < 0 || primary->ff_index >= 128 ||
+        mpctx->current_track[1][STREAM_SUB] == primary)
+        return false;
+    int matches = 0;
+    for (int n = 0; n < mpctx->num_tracks; n++) {
+        struct track *t = mpctx->tracks[n];
+        if (t->type == STREAM_SUB && t->user_tid == primary->user_tid)
+            matches++;
+    }
+    if (matches != 1)
+        return false;
+    struct track *video = mpctx->current_track[0][STREAM_VIDEO];
+    double fps = video && video->stream && video->stream->codec ?
+                     video->stream->codec->fps : 25;
+    if (!isfinite(fps) || fps < 0)
+        return false;
+    *out = (struct owned_witness){
+        .intent = s->intent, .entry = mpctx->playing->id,
+        .source = d->original_local_file_generation,
+        .sid = primary->user_tid, .ff_index = primary->ff_index,
+        .origin = d->start_time, .visible = o->subs_shared->sub_visibility[0],
+        .play_dir = mpctx->play_dir, .video_fps = fps,
+    };
+    return true;
+}
+
+static bool same(const struct owned_witness *a, const struct owned_witness *b)
+{
+    return a->intent == b->intent && a->entry == b->entry &&
+        a->source == b->source && a->sid == b->sid && a->ff_index == b->ff_index &&
+        a->origin == b->origin && a->visible == b->visible &&
+        a->play_dir == b->play_dir && a->video_fps == b->video_fps;
+}
+
+static bool args_match(struct mp_cmd_ctx *cmd, int offset,
+                       const struct owned_witness *s)
+{
+    return cmd->args[offset].v.i64 == s->intent &&
+        cmd->args[offset + 1].v.i64 == s->entry &&
+        cmd->args[offset + 2].v.i64 == s->source &&
+        cmd->args[offset + 3].v.i64 == s->sid &&
+        cmd->args[offset + 4].v.i64 == s->ff_index &&
+        cmd->args[offset + 5].v.d == s->origin;
+}
+
+int mp_property_vortx_owned_subtitle(void *p, struct m_property *prop,
+                                    int action, void *arg)
+{
+    struct MPContext *mpctx = p;
+    struct owned_witness s;
+    if (!capture(mpctx, &s))
+        return M_PROPERTY_UNAVAILABLE;
+    if (action == M_PROPERTY_GET_TYPE) {
+        *(struct m_option *)arg = (struct m_option){.type = CONF_TYPE_NODE};
+        return M_PROPERTY_OK;
+    }
+    if (action != M_PROPERTY_GET)
+        return M_PROPERTY_NOT_IMPLEMENTED;
+    struct mpv_node *r = arg;
+    node_init(r, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(r, "version", 1);
+    node_map_add_int64(r, "intent-generation", s.intent);
+    node_map_add_int64(r, "entry-id", s.entry);
+    node_map_add_int64(r, "source-generation", s.source);
+    node_map_add_int64(r, "sid", s.sid);
+    node_map_add_int64(r, "ff-index", s.ff_index);
+    node_map_add_double(r, "origin", s.origin);
+    node_map_add_flag(r, "primary-visible", s.visible);
+    struct vortx_owned_text *active = osd_vortx_owned_text_current(mpctx->osd);
+    node_map_add_int64(r, "active-ticket", active ? active->ticket : 0);
+    return M_PROPERTY_OK;
+}
+
+static struct attachment_list *copy_attachments(struct demuxer *d)
+{
+    // Snapshot ONLY the original primary media demuxer. Reject over-budget
+    // inputs before copying any font; silently dropping fonts changes layout.
+    if (d->num_attachments < 0 || d->num_attachments > SUB_OWNED_TEXT_MAX_ATTACHMENTS ||
+        (d->num_attachments && !d->attachments))
+        return NULL;
+    size_t total = 0;
+    for (int n = 0; n < d->num_attachments; n++) {
+        struct demux_attachment *a = &d->attachments[n];
+        if (!a->name || !a->type || (a->data_size && !a->data) ||
+            strnlen(a->name, SUB_OWNED_TEXT_MAX_ATTACHMENT_NAME + 1) > SUB_OWNED_TEXT_MAX_ATTACHMENT_NAME ||
+            strnlen(a->type, SUB_OWNED_TEXT_MAX_ATTACHMENT_NAME + 1) > SUB_OWNED_TEXT_MAX_ATTACHMENT_NAME ||
+            a->data_size > SUB_OWNED_TEXT_MAX_ATTACHMENT_BYTES ||
+            a->data_size > SUB_OWNED_TEXT_MAX_ATTACHMENT_TOTAL - total)
+            return NULL;
+        total += a->data_size;
+    }
+    struct attachment_list *copy = talloc_zero(NULL, struct attachment_list);
+    copy->entries = talloc_zero_array(copy, struct demux_attachment, d->num_attachments);
+    copy->num_entries = d->num_attachments;
+    for (int n = 0; n < d->num_attachments; n++) {
+        struct demux_attachment *a = &d->attachments[n];
+        copy->entries[n] = (struct demux_attachment){
+            .name = talloc_strdup(copy, a->name), .type = talloc_strdup(copy, a->type),
+            .data = talloc_memdup(copy, a->data, a->data_size), .data_size = a->data_size,
+        };
+    }
+    return copy;
+}
+
+static bool exact_keys(struct mpv_node *node, const char *const *keys, int count)
+{
+    if (node->format != MPV_FORMAT_NODE_MAP || !node->u.list ||
+        node->u.list->num != count || !node->u.list->keys || !node->u.list->values)
+        return false;
+    unsigned seen = 0;
+    for (int n = 0; n < count; n++) {
+        const char *key = node->u.list->keys[n];
+        int found = -1;
+        for (int k = 0; key && k < count; k++)
+            if (!strcmp(key, keys[k]))
+                found = k;
+        if (found < 0 || (seen & (1u << found)))
+            return false;
+        seen |= 1u << found;
+    }
+    return true;
+}
+
+static int hex(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static bool lossless_json_escapes(const char *json)
+{
+    // mpv's generic parser accepts C escapes and returns NUL-terminated strings.
+    // Refuse byte escapes and escaped NUL BEFORE parsing so strlen cannot hide
+    // a truncated cue or key. Escaped literal backslashes remain ordinary text.
+    for (size_t n = 0; json[n]; n++) {
+        if (json[n] != '\\')
+            continue;
+        char c = json[++n];
+        if (!c || !strchr("\"\\/bfnrtu", c))
+            return false;
+        if (c != 'u')
+            continue;
+        unsigned value = 0;
+        for (int k = 0; k < 4; k++) {
+            int digit = hex(json[++n]);
+            if (digit < 0)
+                return false;
+            value = value * 16 + digit;
+        }
+        if (!value)
+            return false;
+    }
+    return true;
+}
+
+static struct dec_sub *decode_payload(struct mpv_global *global,
+                                      struct attachment_list *attachments,
+                                      const char *payload, int direction, double fps,
+                                      struct mp_cancel *cancel, int64_t deadline)
+{
+    void *tmp = talloc_new(NULL);
+    struct dec_sub *decoder = NULL;
+    if (!payload || strnlen(payload, OWNED_JSON_LIMIT + 1) > OWNED_JSON_LIMIT ||
+        !lossless_json_escapes(payload) || mp_cancel_test(cancel))
+        goto done;
+    char *cursor = talloc_strdup(tmp, payload);
+    struct mpv_node root = {0};
+    if (json_parse(tmp, &root, &cursor, 5) < 0)
+        goto done;
+    json_skip_whitespace(&cursor);
+    if (*cursor)
+        goto done;
+    const char *const root_keys[] = {"version", "language", "cues"};
+    if (!exact_keys(&root, root_keys, 3))
+        goto done;
+    struct mpv_node *version = node_map_get(&root, "version");
+    struct mpv_node *language = node_map_get(&root, "language");
+    struct mpv_node *cues = node_map_get(&root, "cues");
+    if (version->format != MPV_FORMAT_INT64 || version->u.int64 != 1 ||
+        language->format != MPV_FORMAT_STRING || !language->u.string ||
+        cues->format != MPV_FORMAT_NODE_ARRAY || !cues->u.list ||
+        cues->u.list->num < 1 || cues->u.list->num > SUB_OWNED_TEXT_MAX_CUES ||
+        !cues->u.list->values)
+        goto done;
+    int count = cues->u.list->num;
+    struct sub_owned_text_cue *owned = talloc_zero_array(tmp, struct sub_owned_text_cue, count);
+    const char *const cue_keys[] = {"startMs", "endMs", "text"};
+    for (int n = 0; n < count; n++) {
+        struct mpv_node *cue = &cues->u.list->values[n];
+        if (!exact_keys(cue, cue_keys, 3))
+            goto done;
+        struct mpv_node *start = node_map_get(cue, "startMs");
+        struct mpv_node *end = node_map_get(cue, "endMs");
+        struct mpv_node *text = node_map_get(cue, "text");
+        if (start->format != MPV_FORMAT_INT64 || start->u.int64 < 0 ||
+            end->format != MPV_FORMAT_INT64 || end->u.int64 <= start->u.int64 ||
+            end->u.int64 > SUB_OWNED_TEXT_MAX_END_MS ||
+            text->format != MPV_FORMAT_STRING || !text->u.string)
+            goto done;
+        owned[n] = (struct sub_owned_text_cue){
+            .start_ms = start->u.int64, .end_ms = end->u.int64,
+            .utf8 = text->u.string,
+            .length = strnlen(text->u.string, SUB_OWNED_TEXT_MAX_CUE_BYTES + 1),
+        };
+    }
+    // All decoding/filtering completes on this worker. The constructor owns
+    // attachments on entry and never borrows a live track, stream or demuxer.
+    decoder = sub_create_owned_text(global, attachments, language->u.string,
+        owned, count, direction, fps, cancel, deadline, NULL);
+    attachments = NULL;
+done:
+    talloc_free(attachments);
+    talloc_free(tmp);
+    return decoder;
+}
+
+void cmd_vortx_owned_subtitle_prepare(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct MPContext *mpctx = cmd->mpctx;
+    struct vortx_owned_subtitle *s = mpctx->vortx_owned_subtitle;
+    struct owned_witness original, current;
+    cmd->success = false;
+    if (!s || mp_cancel_test(cmd->abort->cancel) ||
+        s->preparing || s->ready || s->retired_count || s->reaping_count ||
+        s->sequence == INT64_MAX || !capture(mpctx, &original) ||
+        !args_match(cmd, 0, &original))
+        return;
+    struct attachment_list *attachments = copy_attachments(mpctx->demuxer);
+    if (!attachments)
+        return;
+    int64_t ticket = ++s->sequence; // consume even on cancellation/failure
+    s->preparing = true;
+    struct mpv_global *global = mpctx->global;
+    int64_t deadline = mp_time_ns() + SUB_OWNED_TEXT_MAX_WORK_NS;
+    // spawn_thread's outstanding_async hold keeps mpctx/global/config/log alive.
+    // No core/admission/OSD/decoder lock remains held while fonts and cues decode.
+    mp_core_unlock(mpctx);
+    struct dec_sub *decoder = decode_payload(global, attachments, cmd->args[6].v.s,
+        original.play_dir, original.video_fps, cmd->abort->cancel, deadline);
+    struct vortx_owned_text *ready = NULL;
+    if (decoder) {
+        ready = talloc(NULL, struct vortx_owned_text);
+        *ready = (struct vortx_owned_text){.ticket = ticket, .decoder = decoder};
+    }
+    mp_core_lock(mpctx);
+    s->preparing = false;
+    if (!ready || mp_cancel_test(cmd->abort->cancel) ||
+        !capture(mpctx, &current) || !same(&original, &current) || s->ready) {
+        mp_core_unlock(mpctx);
+        if (ready) {
+            sub_destroy_owned_text(ready->decoder);
+            talloc_free(ready);
+        }
+        mp_core_lock(mpctx);
+        return;
+    }
+    s->ready = ready;
+    s->ready_witness = original;
+    node_init(&cmd->result, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(&cmd->result, "version", 1);
+    node_map_add_int64(&cmd->result, "ticket", ticket);
+    cmd->success = true;
+}
+
+void cmd_vortx_owned_subtitle_commit(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct MPContext *mpctx = cmd->mpctx;
+    struct vortx_owned_subtitle *s = mpctx->vortx_owned_subtitle;
+    struct owned_witness current;
+    cmd->success = false;
+    if (!s || !s->ready || s->retired_count || s->reaping_count ||
+        cmd->args[0].v.i64 <= 0 || s->ready->ticket != cmd->args[0].v.i64 ||
+        !capture(mpctx, &current) || !same(&s->ready_witness, &current) ||
+        !args_match(cmd, 1, &current))
+        return;
+    // Final native admission contains scalar checks and a lock-free exchange.
+    // The ORIGINAL host effect lease remains retained outside its scalar lock.
+    struct vortx_owned_text *ready = s->ready;
+    retire_object(s, osd_vortx_owned_text_exchange(mpctx->osd, ready));
+    s->ready = NULL;
+    s->active_witness = current;
+    node_init(&cmd->result, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(&cmd->result, "version", 1);
+    node_map_add_int64(&cmd->result, "ticket", ready->ticket);
+    node_map_add_flag(&cmd->result, "committed", true);
+    cmd->success = true;
+    mp_notify_property(mpctx, "vortx-owned-subtitle-state");
+    mp_wakeup_core(mpctx);
+}
+
+void cmd_vortx_owned_subtitle_revoke(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct MPContext *mpctx = cmd->mpctx;
+    struct vortx_owned_subtitle *s = mpctx->vortx_owned_subtitle;
+    int64_t ticket = cmd->args[0].v.i64;
+    bool released = false;
+    if (s && ticket > 0) {
+        if (s->ready && s->ready->ticket == ticket) {
+            retire_object(s, s->ready);
+            s->ready = NULL;
+            released = true;
+        }
+        struct vortx_owned_text *active = mpctx->osd ?
+            osd_vortx_owned_text_current(mpctx->osd) : NULL;
+        if (active && active->ticket == ticket) {
+            retire_object(s, osd_vortx_owned_text_exchange(mpctx->osd, NULL));
+            released = true;
+        }
+    }
+    node_init(&cmd->result, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(&cmd->result, "version", 1);
+    node_map_add_flag(&cmd->result, "released", released);
+    if (released) {
+        mp_notify_property(mpctx, "vortx-owned-subtitle-state");
+        mp_wakeup_core(mpctx);
+    }
+}
+
+static void reap_worker(void *p)
+{
+    struct owned_reap *work = p;
+    // Removal happened under core before this work was queued. New publication
+    // refuses until exact reap acknowledgement. This join holds neither core
+    // nor OSD; old render readers finish their complete bitmap copies first.
+    osd_vortx_owned_text_wait_quiescent(work->osd);
+    for (int n = 0; n < work->count; n++) {
+        sub_destroy_owned_text(work->objects[n]->decoder);
+        talloc_free(work->objects[n]);
+    }
+    struct MPContext *mpctx = work->mpctx;
+    mp_core_lock(mpctx);
+    struct vortx_owned_subtitle *s = mpctx->vortx_owned_subtitle;
+    mp_assert(s->reaping_count == work->count);
+    for (int n = 0; n < work->count; n++)
+        mp_assert(s->reaping_tickets[n] == work->tickets[n]);
+    s->reaping_count = 0;
+    kick_reaper(mpctx);
+    mpctx->outstanding_async--;
+    mp_wakeup_core(mpctx);
+    talloc_free(work);
+    mp_core_unlock(mpctx);
+}
+
+static void kick_reaper(struct MPContext *mpctx)
+{
+    struct vortx_owned_subtitle *s = mpctx->vortx_owned_subtitle;
+    if (!s || !s->retired_count || s->reaping_count)
+        return;
+    struct owned_reap *work = talloc_zero(NULL, struct owned_reap);
+    work->mpctx = mpctx;
+    work->osd = mpctx->osd;
+    work->count = s->retired_count;
+    for (int n = 0; n < work->count; n++) {
+        work->objects[n] = s->retired[n];
+        work->tickets[n] = s->reaping_tickets[n] = s->retired[n]->ticket;
+        s->retired[n] = NULL;
+    }
+    s->retired_count = 0;
+    s->reaping_count = work->count;
+    mpctx->outstanding_async++;
+    // A decoder exists only after prepare ran on this same thread pool. Its
+    // min_threads=1 keeps a worker thereafter; queue() can always queue onto
+    // that worker even if a new thread cannot be created. Shutdown joins these
+    // outstanding leases before command/OSD/config/log/libav destruction.
+    bool queued = mp_thread_pool_queue(mpctx->thread_pool, reap_worker, work);
+    mp_assert(queued);
+}
+
+void mp_vortx_owned_subtitle_updates(struct MPContext *mpctx)
+{
+    struct vortx_owned_subtitle *s = mpctx->vortx_owned_subtitle;
+    if (!s)
+        return;
+    struct vortx_owned_text *active = mpctx->osd ?
+        osd_vortx_owned_text_current(mpctx->osd) : NULL;
+    if (!active && !s->ready) {
+        kick_reaper(mpctx);
+        return;
+    }
+    struct owned_witness current;
+    bool valid = capture(mpctx, &current);
+    if ((active && (!valid || !same(&s->active_witness, &current) ||
+                    osd_vortx_owned_text_failed(mpctx->osd) == active->ticket)) ||
+        (s->ready && (!valid || !same(&s->ready_witness, &current))))
+        mp_vortx_owned_subtitle_retire(mpctx);
+    kick_reaper(mpctx);
+}
+
+void mp_vortx_owned_subtitle_init(struct MPContext *mpctx)
+{
+    struct vortx_owned_subtitle *s = talloc_zero(NULL, struct vortx_owned_subtitle);
+    s->intent = 1;
+    mpctx->vortx_owned_subtitle = s;
+    // Never steal another extension's callback. Capability refuses if ours is
+    // missing, replaced or paired with another owner context.
+    if (!mpctx->mconfig->option_set_attempt_callback) {
+        mpctx->mconfig->option_set_attempt_callback = mp_vortx_owned_subtitle_option_attempt;
+        mpctx->mconfig->option_set_attempt_callback_ctx = mpctx;
+    }
+}
+
+void mp_vortx_owned_subtitle_bind_osd(struct MPContext *mpctx)
+{
+    osd_vortx_owned_text_bind_wakeup(mpctx->osd, mp_wakeup_core_cb, mpctx);
+}
+
+void mp_vortx_owned_subtitle_shutdown(struct MPContext *mpctx)
+{
+    struct vortx_owned_subtitle *s = mpctx->vortx_owned_subtitle;
+    // First call runs in mp_shutdown_clients on the still-live core owner,
+    // BEFORE its async-drain loop. mp_destroy may run after libmpv joined that
+    // thread: the second call must never create new work needing dead dispatch.
+    // CLI/init-failure mp_destroy remains a safe first-call fallback.
+    if (!s || s->closing)
+        return;
+    s->closing = true;
+    mp_vortx_owned_subtitle_retire(mpctx);
+    kick_reaper(mpctx);
+}
+
+void mp_vortx_owned_subtitle_uninit(struct MPContext *mpctx)
+{
+    struct vortx_owned_subtitle *s = mpctx->vortx_owned_subtitle;
+    if (!s)
+        return;
+    // mp_shutdown_clients joined outstanding preparation/reaper leases; outputs
+    // have joined before command_uninit. Nothing owned may survive into osd_free.
+    mp_assert(!s->preparing && !s->ready && !s->retired_count && !s->reaping_count);
+    mp_assert(!mpctx->osd || !osd_vortx_owned_text_current(mpctx->osd));
+    if (mpctx->osd)
+        osd_vortx_owned_text_bind_wakeup(mpctx->osd, NULL, NULL);
+    if (mpctx->mconfig->option_set_attempt_callback == mp_vortx_owned_subtitle_option_attempt &&
+        mpctx->mconfig->option_set_attempt_callback_ctx == mpctx) {
+        mpctx->mconfig->option_set_attempt_callback = NULL;
+        mpctx->mconfig->option_set_attempt_callback_ctx = NULL;
+    }
+    talloc_free(s);
+    mpctx->vortx_owned_subtitle = NULL;
+}
