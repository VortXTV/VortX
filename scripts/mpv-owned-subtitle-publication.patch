+bool osd_vortx_owned_text_available(struct osd_state *osd)
+{
+    return osd && osd->vortx_owned_text.available;
+}
+
+void osd_vortx_owned_text_bind_wakeup(struct osd_state *osd,
+                                      void (*wakeup)(void *ctx), void *ctx)
+{
+    // Before outputs start / after outputs join only. Never changed concurrently
+    // with a renderer borrow. The core/global outlives every outstanding reaper.
+    osd->vortx_owned_text.wakeup = wakeup;
+    osd->vortx_owned_text.wakeup_ctx = ctx;
+}
+
+struct vortx_owned_text *osd_vortx_owned_text_current(struct osd_state *osd)
+{
+    return atomic_load_explicit(&osd->vortx_owned_text.active, memory_order_seq_cst);
+}
+
+struct vortx_owned_text *osd_vortx_owned_text_exchange(
+    struct osd_state *osd, struct vortx_owned_text *ready)
+{
+    // Native core only after original source/manual/host-effect admission.
+    // Never acquires an OSD/decoder mutex or destroys the returned object.
+    struct vortx_owned_text *old = atomic_exchange_explicit(
+        &osd->vortx_owned_text.active, ready, memory_order_seq_cst);
+    if (old != ready)
+        atomic_store_explicit(&osd->vortx_owned_text.dirty, true, memory_order_release);
+    return old;
+}
+
+int64_t osd_vortx_owned_text_failed(struct osd_state *osd)
+{
+    return atomic_load_explicit(&osd->vortx_owned_text.failed_ticket,
+                                memory_order_acquire);
+}
+
+void osd_vortx_owned_text_wait_quiescent(struct osd_state *osd)
+{
+    // Reaper worker only, with no core/OSD/admission/decoder lock. Removal was
+    // already SC-published, so a reader that can still hold the retired pointer
+    // increments before the zero observation. A later reader sees its successor.
+    struct vortx_owned_text_slot *slot = &osd->vortx_owned_text;
+    mp_mutex_lock(&slot->wait_lock);
+    // waiting and readers share the SC order: a reader cannot skip signaling
+    // after this store while this waiter still observes its positive count.
+    atomic_store_explicit(&slot->waiting, true, memory_order_seq_cst);
+    while (atomic_load_explicit(&slot->readers, memory_order_seq_cst))
+        mp_cond_wait(&slot->idle, &slot->wait_lock);
+    atomic_store_explicit(&slot->waiting, false, memory_order_seq_cst);
+    mp_mutex_unlock(&slot->wait_lock);
+}
+
+static struct sub_bitmaps *vortx_render_primary(struct osd_state *osd,
+                                                struct osd_object *obj,
+                                                int format, double video_pts)
+{
+    struct vortx_owned_text_slot *slot = &osd->vortx_owned_text;
+    // Ordinary primary rendering retains its existing owner and does not need
+    // an owned decoder lease. No per-frame condition mutex on an idle feature.
+    if (!osd_vortx_owned_text_current(osd)) {
+        if (obj->vortx_seen_ticket) {
+            obj->vortx_seen_ticket = 0;
+            obj->vo_change_id++;
+        }
+        struct sub_bitmaps *ordinary = NULL;
+        if (obj->sub && sub_is_primary_visible(obj->sub))
+            ordinary = sub_get_bitmaps(obj->sub, obj->vo_res, format, video_pts);
+        if (osd_vortx_owned_text_current(osd)) {
+            talloc_free(ordinary);
+            ordinary = NULL;
+        }
+        return ordinary;
+    }
+    // The surrounding osd->lock serializes the sole actual reader. Increment
+    // MUST precede loading active; the core exchanges without taking that lock.
+    unsigned previous = atomic_fetch_add_explicit(&slot->readers, 1,
+                                                  memory_order_seq_cst);
+    mp_assert(previous == 0);
+    struct vortx_owned_text *owned = osd_vortx_owned_text_current(osd);
+    struct dec_sub *selected = owned ? owned->decoder : obj->sub;
+    int64_t ticket = owned ? owned->ticket : 0;
+    if (obj->vortx_seen_ticket != ticket) {
+        obj->vortx_seen_ticket = ticket;
+        obj->vo_change_id++;
+    }
+    bool valid = true;
+    if (owned) {
+        valid = osd_vortx_owned_text_failed(osd) != ticket &&
+            sub_refresh_owned_text(selected, NULL,
+                mp_time_ns() + SUB_OWNED_TEXT_MAX_WORK_NS, NULL);
+        if (!valid) {
+            // Refresh's checked path is all-corpus or nonrenderable. Never show
+            // its earlier successful cues, and never destroy on this OSD owner.
+            atomic_store_explicit(&slot->failed_ticket, ticket, memory_order_release);
+            if (slot->wakeup)
+                slot->wakeup(slot->wakeup_ctx);
+        }
+    }
+    struct sub_bitmaps *res = NULL;
+    if (valid && selected && sub_is_primary_visible(selected))
+        res = sub_get_bitmaps(selected, obj->vo_res, format, video_pts);
+    // A concurrent source/manual retirement or replacement must not return an
+    // old bitmap just because rendering/font work started before admission.
+    // This does not withdraw a frame already handed to the VO/presentation.
+    if (osd_vortx_owned_text_current(osd) != owned) {
+        talloc_free(res);
+        res = NULL;
+    }
+    // sub_get_bitmaps' real ASS path completed sub_bitmaps_copy and retained
+    // packed mp_image refs before returning. VO no longer borrows this decoder.
+    previous = atomic_fetch_sub_explicit(&slot->readers, 1, memory_order_seq_cst);
+    mp_assert(previous == 1);
+    if (atomic_load_explicit(&slot->waiting, memory_order_seq_cst)) {
+        mp_mutex_lock(&slot->wait_lock);
+        mp_cond_broadcast(&slot->idle);
+        mp_mutex_unlock(&slot->wait_lock);
+    }
+    return res;
+}
