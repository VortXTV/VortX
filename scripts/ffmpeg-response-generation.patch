+/* A token is unique across HTTP contexts in this producer instance. Use the
+ * existing thread abstraction, not a 64-bit atomic that can add libatomic on
+ * Android32. A build with no real mutex backend has no optional observation.
+ * The lock protects only this scalar counter, never allocation or source I/O.
+ */
+#if HAVE_PTHREADS || HAVE_W32THREADS || HAVE_OS2THREADS
+static AVMutex response_generation_lock = AV_MUTEX_INITIALIZER;
+static int64_t last_response_generation;
+#endif
+
+static int64_t http_response_generation_new(void)
+{
+#if HAVE_PTHREADS || HAVE_W32THREADS || HAVE_OS2THREADS
+    int64_t result = 0;
+    if (ff_mutex_lock(&response_generation_lock))
+        return 0;
+    if (last_response_generation < INT64_MAX)
+        result = ++last_response_generation;
+    if (ff_mutex_unlock(&response_generation_lock))
+        return 0;
+    return result;
+#else
+    return 0;
+#endif
+}
