+// A read-only scalar snapshot, not an fd grant or a late filesystem lookup.
+// Reading all fields in one property binds the source to the actual playing
+// entry under mpv's own core owner, rather than to mutable playlist position 0.
+static int mp_property_original_local_file(void *ctx, struct m_property *prop,
+                                          int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    struct demuxer *d = mpctx->demuxer;
+    if (mpctx->stop_play || !mpctx->playback_initialized ||
+        !mpctx->playing || mpctx->playing->id <= 0 ||
+        !d || !d->original_local_file_identity || d->original_local_file_generation <= 0 ||
+        d->is_network || d->is_streaming)
+        return M_PROPERTY_UNAVAILABLE;
+    if (action == M_PROPERTY_GET_TYPE) {
+        *(struct m_option *)arg = (struct m_option){.type = CONF_TYPE_NODE};
+        return M_PROPERTY_OK;
+    }
+    if (action != M_PROPERTY_GET)
+        return M_PROPERTY_NOT_IMPLEMENTED;
+    struct mpv_node *r = arg;
+    node_init(r, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(r, "version", 1);
+    node_map_add_int64(r, "entry-id", mpctx->playing->id);
+    node_map_add_int64(r, "source-generation", d->original_local_file_generation);
+    node_map_add_string(r, "identity", d->original_local_file_identity);
+    // Builtin OSC is not compiled on no-Lua targets. Certify that explicitly;
+    // clients must never reinterpret an arbitrary missing option as disabled.
+#if HAVE_LUA
+    node_map_add_flag(r, "osc-disabled", !mpctx->opts->lua_load_osc);
+#else
+    node_map_add_flag(r, "osc-disabled", true);
+#endif
+    return M_PROPERTY_OK;
+}
