 // Total timeout = RETRY_TIMEOUT * MAX_RETRIES
+// Unique for this process, never reused after exhaustion. A demux reopen of the
+// same pathname/inode is a new source, not renewed authority for an old job.
+#if defined(__APPLE__) || defined(__linux__)
+static atomic_int_fast64_t local_file_generation;
+
+static int64_t next_local_file_generation(void)
+{
+    int_fast64_t old = atomic_load_explicit(&local_file_generation, memory_order_relaxed);
+    while (old < INT64_MAX) {
+        if (atomic_compare_exchange_weak_explicit(&local_file_generation, &old, old + 1,
+                                                memory_order_relaxed, memory_order_relaxed))
+            return old + 1;
+    }
+    return 0;
+}
+#endif
+
 #define RETRY_TIMEOUT 0.2
 #define MAX_RETRIES 10

