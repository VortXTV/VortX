+// Optional consumers must not add an abort-on-allocation-failure path to playback.
+// Keep the established mp_cancel_new() contract and callers unchanged.
+struct mp_cancel *mp_cancel_try_new(void *talloc_ctx)
+{
+    struct mp_cancel *c = ta_new(talloc_ctx, struct mp_cancel);
+    if (!c)
+        return NULL;
+    *c = (struct mp_cancel){
+        .triggered = false,
+        .wakeup_pipe = {-1, -1},
+    };
+    if (mp_mutex_init(&c->lock)) {
+        talloc_free(c);
+        return NULL;
+    }
+    if (mp_cond_init(&c->wakeup)) {
+        mp_mutex_destroy(&c->lock);
+        talloc_free(c);
+        return NULL;
+    }
+    // No destructor runs on partially initialized synchronization objects.
+    talloc_set_destructor(c, cancel_destroy);
+    return c;
+}
+
 static void trigger_locked(struct mp_cancel *c)
 {
     atomic_store(&c->triggered, true);
