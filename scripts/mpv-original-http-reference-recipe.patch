--- /dev/null
+++ b/stream/reference_source.h
@@ -0,0 +1,66 @@
+/* Internal native source authority. Not part of libmpv's public client ABI. */
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct stream;
+struct AVDictionary;
+struct stream_reference_source;
+
+enum stream_reference_backend {
+    STREAM_REFERENCE_UNAVAILABLE = 0,
+    STREAM_REFERENCE_LAVF_HTTP_GET_INITIAL = 1,
+};
+
+enum stream_reference_authority {
+    // Exact initial request only: no learned-cookie, current-response, resource
+    // entity, format/track or timing-prefix equivalence is certified.
+    STREAM_REFERENCE_INITIAL_REQUEST_ONLY = 1,
+};
+
+// An owning, move-only-by-convention native lease. Initialize to {0}, acquire
+// once and release once. Do not memcpy/copy this into a second owning lease.
+// No stream, AVIOContext, borrowed cancel, URL or option pointer is present.
+struct stream_reference_lease {
+    struct stream_reference_source *source;
+    enum stream_reference_authority authority;
+    int64_t source_generation;
+    uint64_t epoch;
+};
+
+// The successful stream-open owner calls this exactly once, before publishing
+// the stream to any other thread. Zero/exhausted generation drops only the new
+// optional recipe; ordinary playback remains available.
+void stream_reference_source_finish_open(struct stream *s, int64_t generation);
+
+// ONLY the original stream/demux owner may call acquire while s is alive. It
+// checks only the actual safe backend and exact ORIGINAL request recipe. It
+// never inspects current AVIO/cookie state. Learned-cookie/current-response and
+// resource equivalence remain uncertified; this is not a reader capability.
+// A core/utility caller must not borrow s. Future admission needs a real bridge.
+bool stream_reference_source_acquire_initial_request(
+    struct stream *s, struct stream_reference_lease *out);
+
+// Transport seek interruption invalidates all previous epochs. Close retires
+// the source permanently before the backend or its borrowed cancel is freed.
+// These functions require the existing stream lifetime/owner discipline.
+void stream_reference_source_invalidate(struct stream *s);
+void stream_reference_source_close(struct stream *s);
+
+// These operate only on a retained lease and are safe off the stream owner.
+// The cancellation query covers close/retirement and transport-epoch changes.
+// It does NOT retain or poll the old stream's cancel. A future reader must also
+// combine its independently owned request/source cancellation and deadline.
+bool stream_reference_lease_cancelled(const struct stream_reference_lease *lease);
+void stream_reference_lease_release(struct stream_reference_lease *lease);
+
+// Internal utility-worker prerequisite only: make private owned copies of the
+// ORIGINAL URL/options, never reread globals or live AVIO state. No I/O occurs.
+// The caller must free *url with av_free() and *options with av_dict_free().
+// Both outputs are NULL on failure. The copies contain credentials and must
+// never cross the public mpv/Swift ABI, be logged or be persisted. Cancellation
+// must still be checked during any later open/read and at final admission.
+bool stream_reference_lease_copy_initial_request(
+    const struct stream_reference_lease *lease,
+    char **url, struct AVDictionary **options);
