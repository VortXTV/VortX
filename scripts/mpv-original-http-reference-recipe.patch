+// This is native-only source authority, not an alignment capability. A later
+// reader still needs format/track/entity/prefix validation and final admission.
+// The source owns one reference; workers own leases and never borrow stream_t,
+// AVIOContext or the original cancellation object's lifetime.
+struct stream_reference_source {
+    atomic_uint refs;
+    atomic_bool retired;
+    atomic_uint_fast64_t epoch;
+    int64_t generation; // assigned once, before the stream is published
+    char *url;
+    AVDictionary *options; // immutable ORIGINAL pre-open options
+};
+
+#define REFERENCE_URL_LIMIT (16 * 1024)
+#define REFERENCE_OPTION_LIMIT 64
+#define REFERENCE_KEY_LIMIT 128
+#define REFERENCE_VALUE_LIMIT (32 * 1024)
+#define REFERENCE_OPTIONS_BYTES (128 * 1024)
+
+extern const stream_info_t stream_info_ffmpeg;
+
+static void reference_source_unref(struct stream_reference_source *source)
+{
+    if (!source)
+        return;
+    unsigned previous = atomic_fetch_sub_explicit(&source->refs, 1,
+                                                  memory_order_acq_rel);
+    mp_assert(previous > 0);
+    if (previous == 1) {
+        av_dict_free(&source->options);
+        av_free(source->url);
+        av_free(source);
+    }
+}
+
+static struct stream_reference_source *reference_source_ref(
+    struct stream_reference_source *source)
+{
+    if (!source)
+        return NULL;
+    unsigned count = atomic_load_explicit(&source->refs, memory_order_relaxed);
+    while (count && count < UINT_MAX) {
+        if (atomic_compare_exchange_weak_explicit(&source->refs, &count, count + 1,
+                memory_order_relaxed, memory_order_relaxed))
+            return source;
+    }
+    return NULL;
+}
+
+static bool reference_options_valid(const AVDictionary *options)
+{
+    // Explicitly unsupported: file-backed CA/client keys, POST/listen modes,
+    // offsets and unknown custom protocol options. This narrows only the new
+    // recipe; original playback and its exact configured options are untouched.
+    static const char *const allowed[] = {
+        "reconnect", "reconnect_delay_max", "user_agent", "cookies", "tls_verify",
+        "headers", "icy", "timeout", "rw_timeout", "http_proxy", "method",
+        "referer", "auth_type", "protocol_whitelist", "protocol_blacklist", NULL,
+    };
+    if (!options || av_dict_count(options) > REFERENCE_OPTION_LIMIT)
+        return false;
+    size_t bytes = 0;
+    unsigned seen = 0;
+    AVDictionaryEntry *entry = NULL;
+    while ((entry = av_dict_get(options, "", entry, AV_DICT_IGNORE_SUFFIX))) {
+        if (!entry->key || !entry->value)
+            return false;
+        size_t key = strnlen(entry->key, REFERENCE_KEY_LIMIT + 1);
+        size_t value = strnlen(entry->value, REFERENCE_VALUE_LIMIT + 1);
+        if (!key || key > REFERENCE_KEY_LIMIT || value > REFERENCE_VALUE_LIMIT ||
+            key + value + 2 > REFERENCE_OPTIONS_BYTES - bytes)
+            return false;
+        bytes += key + value + 2;
+        int known = -1;
+        for (int n = 0; allowed[n]; n++) {
+            if (!strcmp(entry->key, allowed[n])) {
+                known = n;
+                break;
+            }
+        }
+        // AVDictionary can represent duplicate keys with AV_DICT_MULTIKEY.
+        // Refuse even identical duplicates; first/last option semantics must
+        // never make TLS or method certification ambiguous.
+        if (known < 0 || known >= (int)(sizeof(seen) * CHAR_BIT) ||
+            (seen & (1u << known)))
+            return false;
+        seen |= 1u << known;
+    }
+    AVDictionaryEntry *tls = av_dict_get(options, "tls_verify", NULL,
+                                       AV_DICT_MATCH_CASE);
+    AVDictionaryEntry *method = av_dict_get(options, "method", NULL,
+                                          AV_DICT_MATCH_CASE);
+    return tls && !strcmp(tls->value, "1") &&
+        (!method || !strcmp(method->value, "GET"));
+}
+
+static struct stream_reference_source *reference_source_new(
+    stream_t *s, const char *url, const AVDictionary *options)
+{
+    // Pointer identity matters: the unsafe descriptor has the same name and
+    // open function. Curl, wrappers and every other backend remain unsupported.
+    if (s->info != &stream_info_ffmpeg || s->mode != STREAM_READ ||
+        s->stream_origin != STREAM_ORIGIN_NET || !url ||
+        (strncmp(url, "http://", 7) && strncmp(url, "https://", 8)) ||
+        strnlen(url, REFERENCE_URL_LIMIT + 1) > REFERENCE_URL_LIMIT ||
+        !reference_options_valid(options))
+        return NULL;
+    struct stream_reference_source *source = av_mallocz(sizeof(*source));
+    if (!source)
+        return NULL;
+    atomic_init(&source->refs, 1);
+    atomic_init(&source->retired, false);
+    atomic_init(&source->epoch, 1);
+    source->url = av_strdup(url);
+    if (!source->url || av_dict_copy(&source->options, options, 0) < 0) {
+        reference_source_unref(source);
+        return NULL;
+    }
+    return source;
+}
+
+static void reference_source_retire(struct stream_reference_source *source)
+{
+    if (source)
+        atomic_store_explicit(&source->retired, true, memory_order_release);
+}
+
+void stream_reference_source_close(stream_t *s)
+{
+    if (!s)
+        return;
+    struct stream_reference_source *source = s->reference_source;
+    s->reference_source = NULL;
+    s->original_source_backend = STREAM_REFERENCE_UNAVAILABLE;
+    reference_source_retire(source);
+    reference_source_unref(source);
+}
+
+void stream_reference_source_finish_open(stream_t *s, int64_t generation)
+{
+    struct stream_reference_source *source = s->reference_source;
+    if (!source)
+        return;
+    if (s->info != &stream_info_ffmpeg || s->mode != STREAM_READ ||
+        !s->seekable || !s->seek_interruptible || generation <= 0 ||
+        source->generation || atomic_load(&source->refs) != 1) {
+        stream_reference_source_close(s);
+        return;
+    }
+    source->generation = generation;
+    s->original_source_backend = STREAM_REFERENCE_LAVF_HTTP_GET_INITIAL;
+}
+
+void stream_reference_source_invalidate(stream_t *s)
+{
+    struct stream_reference_source *source = s ? s->reference_source : NULL;
+    if (!source)
+        return;
+    uint_fast64_t value = atomic_load_explicit(&source->epoch, memory_order_relaxed);
+    while (value < UINT64_MAX) {
+        if (atomic_compare_exchange_weak_explicit(&source->epoch, &value, value + 1,
+                memory_order_release, memory_order_relaxed))
+            return;
+    }
+    // Never wrap back to an earlier lease, including on narrower platforms.
+    reference_source_retire(source);
+}
+
+bool stream_reference_lease_cancelled(const struct stream_reference_lease *lease)
+{
+    const struct stream_reference_source *source = lease ? lease->source : NULL;
+    return !source || lease->authority != STREAM_REFERENCE_INITIAL_REQUEST_ONLY ||
+        lease->source_generation <= 0 || !lease->epoch ||
+        source->generation != lease->source_generation ||
+        atomic_load_explicit(&source->retired, memory_order_acquire) ||
+        atomic_load_explicit(&source->epoch, memory_order_acquire) != lease->epoch;
+}
+
+void stream_reference_lease_release(struct stream_reference_lease *lease)
+{
+    if (!lease)
+        return;
+    struct stream_reference_source *source = lease->source;
+    *lease = (struct stream_reference_lease){0};
+    reference_source_unref(source);
+}
+
+bool stream_reference_source_acquire_initial_request(
+    stream_t *s, struct stream_reference_lease *out)
+{
+    // Owner-thread-only. This is INITIAL request authority, never a claim about
+    // current learned cookies, response identity, format or a complete prefix.
+    // No AVIO/cookie getter or private protocol layout is inspected here.
+    if (!s || !out || out->source || s->info != &stream_info_ffmpeg ||
+        s->mode != STREAM_READ || !s->seekable || !s->seek_interruptible ||
+        s->original_source_backend != STREAM_REFERENCE_LAVF_HTTP_GET_INITIAL ||
+        s->original_source_generation <= 0 || !s->reference_source ||
+        mp_cancel_test(s->cancel) || stream_io_interrupted(s))
+        return false;
+    struct stream_reference_source *source = s->reference_source;
+    if (source->generation != s->original_source_generation ||
+        !reference_source_ref(source))
+        return false;
+    struct stream_reference_lease lease = {
+        .source = source,
+        .authority = STREAM_REFERENCE_INITIAL_REQUEST_ONLY,
+        .source_generation = source->generation,
+        .epoch = atomic_load_explicit(&source->epoch, memory_order_acquire),
+    };
+    if (mp_cancel_test(s->cancel) || stream_io_interrupted(s) ||
+        stream_reference_lease_cancelled(&lease)) {
+        stream_reference_lease_release(&lease);
+        return false;
+    }
+    *out = lease;
+    return true;
+}
+
+bool stream_reference_lease_copy_initial_request(
+    const struct stream_reference_lease *lease, char **url, AVDictionary **options)
+{
+    if (url)
+        *url = NULL;
+    if (options)
+        *options = NULL;
+    if (!url || !options)
+        return false;
+    if (stream_reference_lease_cancelled(lease))
+        return false;
+    const struct stream_reference_source *source = lease->source;
+    char *copy_url = av_strdup(source->url);
+    AVDictionary *copy_options = NULL;
+    if (!copy_url || av_dict_copy(&copy_options, source->options, 0) < 0 ||
+        stream_reference_lease_cancelled(lease)) {
+        av_free(copy_url);
+        av_dict_free(&copy_options);
+        return false;
+    }
+    *url = copy_url;
+    *options = copy_options;
+    return true;
+}
