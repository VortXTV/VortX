+void avpriv_vortx_http_sent_request_clear(
+    struct avpriv_vortx_http_sent_request *value)
+{
+    if (!value)
+        return;
+    av_free(value->location);
+    av_free(value->request);
+    *value = (struct avpriv_vortx_http_sent_request){0};
+}
+
+int avpriv_vortx_http_copy_sent_request(
+    AVIOContext *owner, int64_t expected_generation,
+    struct avpriv_vortx_http_sent_request *out)
+{
+    URLContext *h;
+    HTTPContext *s;
+    int recognized = 0;
+    struct avpriv_vortx_http_sent_request copy = {0};
+    if (!out || out->location || out->request || out->request_bytes ||
+        out->response_generation || out->version || expected_generation <= 0 ||
+        !owner || owner->av_class != &ff_avio_class ||
+        !(h = ffio_geturlcontext(owner)) || !h->priv_data)
+        return AVERROR(EINVAL);
+#if CONFIG_HTTP_PROTOCOL
+    recognized |= h->prot == &ff_http_protocol &&
+                  h->prot->priv_data_class == &http_context_class &&
+                  h->prot->priv_data_size == sizeof(HTTPContext);
+#endif
+#if CONFIG_HTTPS_PROTOCOL
+    recognized |= h->prot == &ff_https_protocol &&
+                  h->prot->priv_data_class == &https_context_class &&
+                  h->prot->priv_data_size == sizeof(HTTPContext);
+#endif
+    if (!recognized)
+        return AVERROR(ENOSYS);
+    s = h->priv_data; // private typed access only after exact protocol/class/size
+    if (s->class != h->prot->priv_data_class ||
+        s->response_generation != expected_generation ||
+        s->sent_request_generation != expected_generation ||
+        !s->sent_request || !s->sent_location || !s->response_location ||
+        strcmp(s->sent_location, s->response_location) ||
+        !http_sent_request_wire_valid(s->sent_request, s->sent_request_bytes))
+        return AVERROR(EAGAIN);
+    copy.location = av_strdup(s->sent_location);
+    copy.request = av_strndup(s->sent_request, s->sent_request_bytes);
+    if (!copy.location || !copy.request) {
+        avpriv_vortx_http_sent_request_clear(&copy);
+        return AVERROR(ENOMEM);
+    }
+    copy.request_bytes = s->sent_request_bytes;
+    copy.response_generation = expected_generation;
+    copy.version = VORTX_HTTP_SENT_REQUEST_VERSION;
+    if (s->response_generation != expected_generation ||
+        s->sent_request_generation != expected_generation) {
+        avpriv_vortx_http_sent_request_clear(&copy);
+        return AVERROR(EAGAIN);
+    }
+    *out = copy;
+    return 0;
+}
