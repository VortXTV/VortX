+static void http_sent_request_capture(URLContext *h, const char *wire, size_t bytes,
+                                      const char *path, const char *local_path,
+                                      const char *method, const char *auth,
+                                      const char *proxyauth, const char *authstr,
+                                      const char *proxyauthstr)
+{
+    HTTPContext *s = h->priv_data;
+    char *copy = NULL, *location = NULL;
+    int64_t tls_verify = 0;
+    if ((h->flags & AVIO_FLAG_WRITE) || !(h->flags & AVIO_FLAG_READ) ||
+        s->post_data || s->listen || s->is_connected_server || strcmp(method, "GET") ||
+        !path || path != local_path || path[0] != '/' ||
+        (auth && *auth) || (proxyauth && *proxyauth) || authstr || proxyauthstr ||
+        s->auth_state.auth_type != HTTP_AUTH_NONE ||
+        s->proxy_auth_state.auth_type != HTTP_AUTH_NONE ||
+        (s->http_proxy && *s->http_proxy) ||
+        has_header(s->headers, "\r\nHost: ") ||
+        !http_response_location_valid(s->location) ||
+        !http_sent_request_wire_valid(wire, bytes))
+        return;
+    if (!strncmp(s->location, "https://", 8)) {
+        const AVOption *verify = av_opt_find(s->hd, "tls_verify", NULL, 0,
+                                            AV_OPT_SEARCH_CHILDREN);
+        if (!verify || verify->type != AV_OPT_TYPE_BOOL ||
+            av_opt_get_int(s->hd, "tls_verify", AV_OPT_SEARCH_CHILDREN, &tls_verify) < 0 ||
+            tls_verify != 1)
+            return;
+    }
+    copy = av_strndup(wire, bytes);
+    location = av_strdup(s->location);
+    if (!copy || !location) {
+        av_free(copy);
+        av_free(location);
+        return;
+    }
+    s->sent_request_pending = copy;
+    s->sent_location_pending = location;
+    s->sent_request_pending_bytes = bytes;
+}
+
+static void http_sent_request_complete(HTTPContext *s)
+{
+    if (s->http_code >= 100 && s->http_code < 200)
+        return;
+    if (s->response_generation > 0 && s->sent_request_pending &&
+        s->sent_location_pending && s->response_location &&
+        !strcmp(s->sent_location_pending, s->response_location)) {
+        // The token is minted for the response read AFTER these actual bytes.
+        // Equal URL/ETag does not manufacture this causal request association.
+        s->sent_request = s->sent_request_pending;
+        s->sent_location = s->sent_location_pending;
+        s->sent_request_bytes = s->sent_request_pending_bytes;
+        s->sent_request_generation = s->response_generation;
+        s->sent_request_pending = s->sent_location_pending = NULL;
+    }
+    http_sent_request_pending_clear(s);
 }
 
