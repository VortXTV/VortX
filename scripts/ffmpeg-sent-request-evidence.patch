+/* Validate the actual serialized bytes, not user-supplied option spellings.
+ * Refuse ambiguous header shapes for this optional snapshot only. */
+static int http_sent_request_wire_valid(const char *wire, size_t bytes)
+{
+    const char *names[64];
+    size_t lengths[64];
+    unsigned fields = 0, hosts = 0;
+    if (!wire || bytes < 18 || bytes > VORTX_HTTP_SENT_REQUEST_MAX_BYTES ||
+        strnlen(wire, bytes + 1) != bytes || memcmp(wire, "GET /", 5) ||
+        memcmp(wire + bytes - 4, "\r\n\r\n", 4))
+        return 0;
+    const char *end = wire + bytes;
+    const char *line = strstr(wire, "\r\n");
+    if (!line || line - wire < 14 || memcmp(line - 9, " HTTP/1.1", 9))
+        return 0;
+    for (const unsigned char *c = (const unsigned char *)wire + 4;
+         c < (const unsigned char *)line - 9; c++) {
+        if (*c <= 0x20 || *c >= 0x7f)
+            return 0;
+    }
+    line += 2;
+    while (line < end - 2) {
+        const char *next = strstr(line, "\r\n");
+        const char *colon = next ? memchr(line, ':', next - line) : NULL;
+        if (!next || next >= end - 2 || !colon || colon == line || fields == 64)
+            return 0;
+        for (const unsigned char *c = (const unsigned char *)line;
+             c < (const unsigned char *)colon; c++) {
+            if (!((*c >= 'A' && *c <= 'Z') || (*c >= 'a' && *c <= 'z') ||
+                  (*c >= '0' && *c <= '9')) && !strchr("!#$%&'*+-.^_`|~", *c))
+                return 0;
+        }
+        for (const unsigned char *c = (const unsigned char *)colon + 1;
+             c < (const unsigned char *)next; c++) {
+            if ((*c < 0x20 && *c != '\t') || *c == 0x7f)
+                return 0;
+        }
+        size_t length = colon - line;
+        for (unsigned n = 0; n < fields; n++) {
+            if (lengths[n] == length && !av_strncasecmp(names[n], line, length))
+                return 0;
+        }
+        if (length == 19 && !av_strncasecmp(line, "Proxy-Authorization", length))
+            return 0;
+        if (length == 4 && !av_strncasecmp(line, "Host", length))
+            hosts++;
+        names[fields] = line;
+        lengths[fields++] = length;
+        line = next + 2;
+    }
+    return line == end - 2 && hosts == 1;
+}
