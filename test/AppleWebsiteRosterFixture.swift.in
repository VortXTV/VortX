// BEGIN EXECUTABLE
@main @MainActor enum AppleWebsiteRosterFixture {
    struct Command: Decodable {
        let mode: String
        let directory: String
        let baseURL: String
        let websiteWitness: String?
    }
    struct Instruction: Decodable {
        let action: String
    }

    nonisolated static func nextLine() async -> String? {
        await withCheckedContinuation { continuation in
            DispatchQueue.global().async { continuation.resume(returning: readLine()) }
        }
    }

    static func run() async throws {
        guard CommandLine.arguments.count == 2 else { throw VortxNativeError.invalidResponse }
        let command = try JSONDecoder().decode(Command.self,
            from: Data(contentsOf: URL(fileURLWithPath: CommandLine.arguments[1])))
        guard ["website-cold", "website-restart", "website-peer"].contains(command.mode),
              let base = URL(string: command.baseURL),
              base.scheme == "http", base.host == "127.0.0.1", base.port != nil,
              base.user == nil, base.password == nil, base.query == nil, base.fragment == nil,
              base.path.isEmpty || base.path == "/" else { throw VortxNativeError.invalidResponse }

        let witness: Data?
        if let hex = command.websiteWitness {
            guard hex.utf8.count == 64, hex.utf8.allSatisfy({ (48...57).contains($0) || (97...102).contains($0) })
            else { throw VortxNativeError.invalidResponse }
            let bytes = Array(hex.utf8)
            witness = Data(stride(from: 0, to: bytes.count, by: 2).map { index in
                func digit(_ byte: UInt8) -> UInt8 { byte < 58 ? byte - 48 : byte - 87 }
                return 16 * digit(bytes[index]) + digit(bytes[index + 1])
            })
        } else { witness = nil }

        let directory = try VortxNativeStorage.root()
        let manager = VortXSyncManager(directory: directory, baseURL: base)
        ProfileStore.shared.activeID = UserProfile.ownerID
        manager.fixtureBaseline()
        do {
            try AppleSyncReceivePublicationPeer.emit(["ready": true, "actor": WebsiteFixtureDisk.actor,
                "role": command.mode, "owner": UserProfile.ownerID.uuidString])
            while let line = await nextLine() {
                let instruction = try JSONDecoder().decode(Instruction.self, from: Data(line.utf8))
                if instruction.action == "close" { break }
                var extra: [String: Any] = [:]
                switch instruction.action {
                case "pull":
                    var outcome = VortXSyncManager.ConflictResolutionOutcome.failed
                    extra["restored"] = await manager.syncDown(reportOutcome: { outcome = $0 })
                    extra["outcome"] = outcome.rawValue
                case "push":
                    extra["accepted"] = await manager.syncUp()
                case "offline":
                    let reopened = await manager.websiteFixtureOfflineOpen()
                    extra["restored"] = reopened
                    extra["outcome"] = reopened ? "completed" : "failed"
                case "snapshot": break
                default: throw VortxNativeError.invalidResponse
                }
                await manager.parkWebsiteFixtureTimer()
                var snapshot = try await manager.websiteFixtureState(witness: witness)
                extra.forEach { snapshot[$0.key] = $0.value }
                try AppleSyncReceivePublicationPeer.emit(snapshot)
            }
        } catch {
            await manager.websiteFixtureStop()
            throw error
        }
        await manager.websiteFixtureStop()
    }

    static func main() async {
        do { try await run() }
        catch {
            let code = VortxNativeError.diagnosticCode(error)
            FileHandle.standardError.write(Data("Website roster fixture failed: \(code)\n".utf8))
            exit(1)
        }
    }
}
// END EXECUTABLE
