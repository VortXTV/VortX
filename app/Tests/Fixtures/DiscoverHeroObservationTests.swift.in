import Foundation
import Combine

// Generated by prepare-discover-hero-observation.cjs from captured production source.
// Explicit seams: this deterministic published-output model never starts real hero work.
// The ownership probe replaces StateObject with a retained field; it is NOT a SwiftUI
// identity, body-count, mount, scheduling, rendering, or device-performance test.
@MainActor
private final class FeaturedHeroModel: ObservableObject {
    @Published private(set) var hero: Int?
    @Published private(set) var pageCount = 0
    @Published private(set) var page = 0

    enum Channel: String, CaseIterable { case hero, pageCount, page }

    func publish(_ value: Int, on channel: Channel) {
        switch channel {
        case .hero: hero = value
        case .pageCount: pageCount = value
        case .page: page = value
        }
    }

    func value(on channel: Channel) -> Int? {
        switch channel {
        case .hero: return hero
        case .pageCount: return pageCount
        case .page: return page
        }
    }
}

/* PRODUCTION_DISCOVER_OWNER */

@MainActor
private final class DiscoverHeroOwnershipProbe {
/* PRODUCTION_DISCOVER_BINDING */
/* PRODUCTION_DISCOVER_ALIAS */

    // These two bridges expose the source-selected model and observation subject to tests.
    var model: FeaturedHeroModel { hero }
    var parentPublisher: ObservableObjectPublisher { /* PRODUCTION_DISCOVER_SUBJECT */.objectWillChange }
}

// Intentional negative control. This is fixture-only and must report every model event;
// it proves the zero-parent-events assertion can detect a forwarding owner.
@MainActor
private final class ForwardingControl {
    let objectWillChange = ObservableObjectPublisher()
    private var subscription: AnyCancellable?

    init(model: FeaturedHeroModel) {
        subscription = model.objectWillChange.sink { [weak self] _ in
            self?.objectWillChange.send()
        }
    }
}

// A weak property observes release without a never-mutated weak local binding.
@MainActor
private final class WeakModelReference {
    weak var value: FeaturedHeroModel?
    init(_ value: FeaturedHeroModel?) { self.value = value }
}

@MainActor
private final class Counter {
    var value = 0
}

private enum ObservationFailure: Error {
    case fixture(String)
    case ownershipLeak(String)
}

@main
@MainActor
private enum DiscoverHeroObservationTests {
    static func require(_ condition: Bool, _ message: String) throws {
        if !condition { throw ObservationFailure.fixture(message) }
    }

    static func checkOwnershipLifetime() throws {
        var owner: DiscoverHeroOwnershipProbe? = DiscoverHeroOwnershipProbe()
        let weakModel = WeakModelReference(owner?.model)
        var external = owner?.model
        try require(external != nil && external === weakModel.value, "external reference sees the owned model")
        let identity = ObjectIdentifier(owner!.model)
        for _ in 0..<8 {
            try require(ObjectIdentifier(owner!.model) == identity, "repeated accessor returns the same model")
        }
        external = nil
        try withExtendedLifetime(owner) {
            try require(weakModel.value != nil, "owner retains model after the external reference is released")

            var other: DiscoverHeroOwnershipProbe? = DiscoverHeroOwnershipProbe()
            let otherModel = WeakModelReference(other?.model)
            try require(owner!.model !== other!.model, "separate owners have separate models")
            other = nil
            try require(otherModel.value == nil, "releasing another owner releases only its model")
            try require(weakModel.value != nil, "first owner's model remains alive")
        }
        owner = nil
        try require(weakModel.value == nil, "model is released after owner and external references are released")
    }

    static func checkPublications() throws -> Int {
        let owner = DiscoverHeroOwnershipProbe()
        let model = owner.model
        let parent = Counter(), leaf = Counter(), direct = Counter(), forwarded = Counter()
        let forwardingControl = ForwardingControl(model: model)
        let subscriptions = [
            owner.parentPublisher.sink { _ in parent.value += 1 },
            model.objectWillChange.sink { _ in leaf.value += 1 },
            model.objectWillChange.sink { _ in direct.value += 1 },
            forwardingControl.objectWillChange.sink { _ in forwarded.value += 1 },
        ]
        defer {
            for subscription in subscriptions { subscription.cancel() }
            withExtendedLifetime(owner) {}
            withExtendedLifetime(forwardingControl) {}
        }
        var assignments = 0
        for channel in FeaturedHeroModel.Channel.allCases {
            for value in [1, 1, 2] { // The repeated equal assignment must publish too.
                let beforeParent = parent.value
                let beforeLeaf = leaf.value
                let beforeDirect = direct.value
                let beforeForwarded = forwarded.value
                model.publish(value, on: channel)
                assignments += 1
                // Check all controls FIRST, so no silent/broken observer can masquerade as RED.
                try require(model.value(on: channel) == value, "published collaborator installs its assigned value")
                try require(leaf.value == beforeLeaf + 1, "leaf publisher receives exactly one event")
                try require(direct.value == beforeDirect + 1, "direct positive control receives exactly one event")
                try require(forwarded.value == beforeForwarded + 1,
                            "intentional forwarding control receives exactly one event")
                if parent.value != beforeParent {
                    throw ObservationFailure.ownershipLeak(
                        "channel=\(channel.rawValue) assignment=\(assignments); leaf/direct/forward controls passed")
                }
            }
        }
        try require(assignments == 9 && leaf.value == 9 && direct.value == 9 && forwarded.value == 9,
                    "all three outputs and equal assignments exercised")
        try require(parent.value == 0, "actual ownership subject remains silent for hero outputs")
        return assignments
    }

    static func main() {
        do {
            try checkOwnershipLifetime()
            let assignments = try checkPublications()
            print("PASS: Discover publisher graph; \(assignments) assignments, positive/forwarding controls and ARC checks")
            print("SOURCE-UNIT ONLY: no SwiftUI StateObject scheduling, body-count or device-performance claim")
        } catch ObservationFailure.ownershipLeak(let detail) {
            print("FAIL_OWNERSHIP_ISOLATION: \(detail)")
            exit(1)
        } catch {
            print("FAIL_FIXTURE: \(error)")
            exit(2)
        }
    }
}
