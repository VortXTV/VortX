        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mō ngā kaiwhakamahi matatau; kotahi kōwhiringa=uara ia rārangi. Ka whakamahia ki runga i ngā taunoa o VortX ā te wā ka tīmata ake he ataata."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Мэргэжлийн хэрэглэгчдэд зориулав; мөр бүрт нэг option=value. Дараагийн видео эхлэх үед VortX-ийн үндсэн тохиргооны дээр нэмж хэрэглэгдэнэ."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għall-utenti avvanzati; option=value waħda għal kull linja. Applikata fuq id-defaults ta' VortX id-darba li jmiss li jibda vidjo."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ကျွမ်းကျင်သုံးစွဲသူများအတွက်၊ တစ်ကြောင်းလျှင် option=value တစ်ခု။ ဗီဒီယိုတစ်ခု နောက်တစ်ကြိမ် စတင်သည့်အခါ VortX ၏ မူလတန်ဖိုးများအပေါ်တွင် ထပ်ဆင့်အသုံးပြုသည်။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwa ogwiritsa ntchito aluso; option=value imodzi pa mzere uliwonse. Zimagwiritsidwa ntchito pamwamba pa zoyambirira za VortX nthawi yotsatira vidiyo ikayamba."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Pels utilizaires avançats ; una opcion=valor per linha. Aplicat en dessús dels reglatges per defaut de VortX al lançament venent d'una vidèo."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପାୱାର ୟୁଜରଙ୍କ ପାଇଁ; ପ୍ରତି ଧାଡ଼ିରେ ଗୋଟିଏ option=value। ପରବର୍ତ୍ତୀ ଥର ଏକ ଭିଡିଓ ଆରମ୍ଭ ହେବା ସମୟରେ VortX‌ର ଡିଫଲ୍ଟ ଉପରେ ପ୍ରୟୋଗ ହୁଏ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "د ماهرو کاروونکو لپاره؛ هرې کرښې کې یو option=value. د VortX له تلواليو پورته د بل ځل ویډیو پیلولو پر مهال پلي کیږي."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ku bakoresha bahanitse; ihitamo=agaciro rimwe kuri buri murongo. Bishyirwaho hejuru y'ibisanzwe bya VortX ubutaha video izatangira."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "پاور صارفين لاءِ؛ هر سٽ تي هڪ option=value. ايندڙ ڀيري جڏهن ويڊيو شروع ٿيندي ته VortX جي ڊفالٽ مٿان لاڳو ٿيندو."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "බලවත් පරිශීලකයන් සඳහා; පේළියකට එක් option=value බැගින්. වීඩියෝවක් ඊළඟ වර ආරම්භ වන විට VortX හි පෙරනිමි මත යෙදේ."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "Mo tagata faaaoga poto; tasi le filifiliga=aoga i le laina. E faaaoga i luga o filifiliga faalemasani a VortX i le isi taimi e amata ai se vitio."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kune vashandisi vane hunyanzvi; option=value imwe pamutsara. Inoshandiswa pamusoro pezvakamiswa zveVortX panguva inotevera inotanga vhidhiyo."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Isticmaalayaasha khibradda leh; hal option=value sadar kasta. Waxaa lagu dabaqaa dusha sixireyaasha caadiga ah ee VortX marka xigta ee muuqaal bilowdo."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakeng sa basebelisi ba matla; option=value e le 'ngoe ka mola. E sebetsoa holim'a di-default tsa VortX nakong e latelang eo video e qalang ka eona."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikeun pangguna mahér; hiji pilihan=niléy per baris. Diterapkeun di luhureun bawaan VortX iraha waé pidéo mimiti dijalankeun."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои корбарони пешрафта; як option=value дар ҳар сатр. Дар болои пешфарзҳои VortX ҳангоми оғози навбатии видео татбиқ мешавад."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Тәҗрибәле кулланучылар өчен; һәр юлга бер option=value. Киләсе тапкыр видео башлангач VortX'ның стандарт көйләүләре өстенә кулланыла."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ماھىر ئىشلەتكۈچىلەر ئۈچۈن؛ ھەر قۇرغا بىر option=value. كېيىنكى قېتىم سىن باشلانغاندا VortX نىڭ سۈكۈتتىكى تەڭشەكلىرى ئۈستىگە قوللىنىلىدۇ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajribali foydalanuvchilar uchun; har bir qatorda bitta parametr=qiymat. Keyingi safar video boshlanganda VortX standart sozlamalari ustiga qo'llaniladi."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kubasebenzisi abanamandla; enye ukhetho=ixabiso ngomgca ngamnye. Ifakwe phezu kweenketho ezimiselweyo zeVortX ngexesha elilandelayo ividiyo iqala."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Fún àwọn olùmúlò onígbọ̀nràrà; àṣàyàn=iye kan fún ìlà kọ̀ọ̀kan. A ó lò ó lórí àwọn àbọ̀-ọ̀nà VortX ní àkókò tó kàn tí fídíò bá bẹ̀rẹ̀."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kubasebenzisi abakhaliphile; i-option=value eyodwa kumugqa ngamunye. Kufakwa phezu kwezimiselo ze-VortX ngesikhathi esilandelayo ividiyo iqala."
          }
        }
      }
    },
