        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajiye wannan fayil lafiya. Maido da shi a VortX don kawo saitunanka."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenbe fichye sa a an sekirite. Restore l nan VortX pou pote paramèt ou yo."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Debe faịlụ a n'udo. Weghachi ya na VortX iji weta ntọala gị."
          }
        },
        "jv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga file iki aman. Pulihaké ing VortX kanggo nggawa setelan sampeyan."
          }
        },
        "ku": {
          "stringUnit": {
            "state": "translated",
            "value": "Vî pelî ewle biparêze. Wê di VortX de vegerîne da ku mîhengên xwe biînî."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул файлды коопсуз сактаңыз. Жөндөөлөрүңүздү алып өтүү үчүн аны VortX'те калыбына келтириңиз."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt dës Datei sécher. Restauréier se a VortX fir deng Astellungen eriwwerzebréngen."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເກັບໄຟລ໌ນີ້ໄວ້ໃຫ້ປອດໄພ. ກູ້ຄືນມັນໃນ VortX ເພື່ອນຳການຕັ້ງຄ່າຂອງທ່ານກັບມາ."
          }
        },
        "mg": {
          "stringUnit": {
            "state": "translated",
            "value": "Tazomy azo antoka ity rakitra ity. Avereno ao amin'ny VortX mba hitondrana ny fandrindranao."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pupuri i tēnei kōnae kia haumaru. Whakaorangia i VortX kia kawea mai ō tautuhinga."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ файлыг аюулгүй хадгалаарай. Тохиргоогоо шилжүүлэхийн тулд VortX дээр сэргээнэ үү."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Żomm dan il-fajl sigur. Irrestawrah f'VortX biex iġġib is-settings tiegħek."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤဖိုင်ကို လုံခြုံစွာ ထားပါ။ သင့်ဆက်တင်များ ကူးယူရန် VortX တွင် ၎င်းကို ပြန်လည်ရယူပါ။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "Sungani fayilo ili motetezeka. Libwezeretseni mu VortX kuti mubweretse zokonda zanu."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardatz aqueste fichièr en seguretat. Restauratz-lo dins VortX per recuperar vòstres reglatges."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଫାଇଲକୁ ସୁରକ୍ଷିତ ରଖନ୍ତୁ। ଆପଣଙ୍କ ସେଟିଂ ଆଣିବାକୁ VortX‌ରେ ଏହାକୁ ପୁନରୁଦ୍ଧାର କରନ୍ତୁ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "دا فایل خوندي وساتئ. د خپلو ترتیباتو د راوړلو لپاره یې په VortX کې بیا راوباسئ."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bika iyi dosiye mu mutekano. Yigarurire muri VortX kugira ngo uzane imiterere yawe."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "هيءَ فائل محفوظ رکو. اوهان جون سيٽنگون آڻڻ لاءِ ان کي VortX ۾ بحال ڪريو."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙම ගොනුව ආරක්ෂිතව තබා ගන්න. ඔබේ සැකසුම් රැගෙන ඒමට VortX හි එය ප්‍රතිසාධනය කරන්න."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "Teu saogalemu lenei faila. Toe faaleleia i VortX e aumai ai au faatulagaga."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "Chengeta faira iri rakachengeteka. Ridzoreredze muVortX kuti uunze zvirongwa zvako."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Faylkan ammaan u hay. Ku soo celi VortX si aad dejintaada u keento."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "Boloka faele ena e sireletsehile. E tsosolose ho VortX ho tlisa litlhophiso tsa hau."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga file ieu aman. Pulihkeun dina VortX pikeun mawa setélan anjeun."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин файлро бехатар нигоҳ доред. Онро дар VortX барқарор кунед, то танзимоти худро интиқол диҳед."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Бу файлны куркынычсыз сакла. Көйләүләреңне күчерү өчен аны VortX'та торгыз."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بۇ ھۆججەتنى بىخەتەر ساقلاڭ. تەڭشەكلىرىڭىزنى ئېلىپ كېلىش ئۈچۈن ئۇنى VortX دا ئەسلىگە كەلتۈرۈڭ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu faylni xavfsiz saqlang. Sozlamalaringizni o'tkazish uchun uni VortX'da tiklang."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "Gcina le fayile ikhuselekile. Yibuyisele kwiVortX ukuze uzise iisetingi zakho."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Pa fáìlì yìí mọ́ láàbò. Mú un padà nínú VortX láti mú àwọn ètò rẹ wọlé."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gcina leli fayela liphephile. Libuyisele ku-VortX ukuze ulethe izilungiselelo zakho."
          }
        }
      }
    },
