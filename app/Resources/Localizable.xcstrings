        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasifu huu hauna vichwa vya habari vilivyohifadhiwa au historia ya kutazama bado."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சுயவிவரத்தில் இதுவரை சேமிக்கப்பட்ட தலைப்புகள் அல்லது பார்த்த வரலாறு எதுவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ప్రొఫైల్‌లో ఇంకా సేవ్ చేసిన టైటిల్‌లు లేదా చూసిన చరిత్ర లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรไฟล์นี้ยังไม่มีเรื่องที่บันทึกไว้หรือประวัติการดู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profilde henüz kaydedilmiş içerik veya izleme geçmişi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому профілі ще немає збережених фільмів, серіалів чи історії перегляду."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اِس پروفائل میں ابھی تک کوئی محفوظ عنوانات یا دیکھنے کی تاریخ نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ này chưa có tựa phim hoặc lịch sử xem nào được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此用户暂无已保存的影片或观看记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此設定檔尚未儲存任何影片或觀看記錄。"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এই প্ৰ'ফাইলৰ এতিয়ালৈকে কোনো সাঁচি থোৱা শিৰোনাম বা চোৱাৰ ইতিহাস নাই।"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэтага профілю пакуль няма захаваных тайтлаў ці гісторыі прагляду."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "N'en deus an aelad-mañ titl enrollet nag istor sellet ebet c'hoazh."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj profil još nema sačuvanih naslova ni historije gledanja."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kini nga profile wala pa'y na-save nga titulo o watch history."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Nid oes gan y proffil hwn unrhyw deitlau wedi'u cadw na hanes gwylio eto."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Henda vangamynd hevur ongar goymdar titlar ella hyggisøgu enn."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit profyl hat noch gjin bewarre titels of sjochskiednis."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl aon teideal sábháilte ná stair féachana ag an bpróifíl seo fós."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Chan eil tiotalan sàbhailte no eachdraidh coimhid aig a' phròifil seo fhathast."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan bayanin martaba ba shi da taken da aka adana ko tarihin kallo tukuna."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Pwofil sa a poko gen tit ki sove oswa istorik gade."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Profaịlụ a enwebeghị aha echekwara ma ọ bụ akụkọ nlele."
          }
        },
        "jv": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil iki durung duwé judhul kasimpen utawa riwayat tonton."
          }
        },
        "ku": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê profîlê hê tu sernavên tomarkirî an dîroka temaşekirinê tune."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул профилде азырынча сакталган аталыштар же көрүү тарыхы жок."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dëse Profil huet nach keng gespäichert Titelen oder keng Kucks-Historik."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂປຣໄຟລ໌ນີ້ຍັງບໍ່ມີລາຍການ ຫຼື ປະຫວັດການເບິ່ງທີ່ບັນທຶກໄວ້."
          }
        },
        "mg": {
          "stringUnit": {
            "state": "translated",
            "value": "Mbola tsy manana lohateny voatahiry na tantaram-pijerena ity profil ity."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kāore anō he taitara kua tiakina, he hītori mātakitaki rānei o tēnei kōtaha."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ профайлд одоогоор хадгалсан контент эсвэл үзсэн түүх алга."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan il-profil għadu m'għandux titli mħażna jew storja tal-wiri."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤပရိုဖိုင်တွင် သိမ်းထားသော ခေါင်းစဉ်များ သို့မဟုတ် ကြည့်ရှုမှုမှတ်တမ်း မရှိသေးပါ။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile iyi ilibe mitu yosungidwa kapena mbiri ya kuwonera panobe."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqueste perfil a pas encara cap de títol enregistrat nimai d'istoric de visionatge."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ପ୍ରୋଫାଇଲରେ ଏ ଯାଏ କୌଣସି ସାଇତ ହୋଇଥିବା ଟାଇଟଲ କିମ୍ବା ୱାଚ୍ ଇତିହାସ ନାହିଁ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "دا پروفایل لا تر اوسه هیڅ ساتل شوي سرلیکونه یا د کتلو تاریخچه نه لري."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyu mwirondoro nta nsanganyamatsiko zabitswe cyangwa amateka yo kureba uracyafite."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "هن پروفائل ۾ اڃا ڪوبه محفوظ ٿيل عنوان يا ڏسڻ جي تاريخ ناهي."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙම පැතිකඩට තවම සුරැකි මාතෘකා හෝ නැරඹීම් ඉතිහාසයක් නැත."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "E leai ni ulutala ua sefe pe tala faasolopito o le matamata a lenei tala faasino patino."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "Purofaira iyi haisati iine zvinyorwa zvakachengetwa kana nhoroondo yokuona."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile-kani weli ma laha cinwaanno la kaydiyay ama taariikh daawasho."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "Profaele ena ha e e-s'o be le lihlooho tse bolokiloeng kapa nalane ea ho shebella."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil ieu can boga judul disimpen atawa riwayat lalajo."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин профил ҳанӯз унвонҳои нигоҳдошташуда ё таърихи тамошо надорад."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Бу профильдә әле сакланган исемнәр яки карау тарихы юк."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بۇ سەپلىمىدە تېخى ساقلانغان ماۋزۇ ياكى كۆرۈش تارىخى يوق."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profilda hozircha saqlangan sarlavhalar yoki ko'rish tarixi yo'q."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profayile ayikabi nayo imixholo egciniweyo okanye imbali yokubukela okwangoku."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Profaìlì yìí kò ní àkọ́lé tí a tọ́jú tàbí ìtàn ìwò kankan síbẹ̀."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Le phrofayela ayikabi nazihloko ezilondoloziwe noma umlando wokubuka okwamanje."
          }
        }
      }
