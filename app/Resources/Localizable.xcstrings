        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թաքցնում է սահմանաչափից մեծ աղբյուրները (օրինակ՝ 1080p, բայց ոչ 20 ԳԲ ֆայլ)։ Անհայտ չափի աղբյուրները պահվում են։"
