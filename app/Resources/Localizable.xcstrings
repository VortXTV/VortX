    "Sideload the new IPA from the GitHub releases page, your sign-in and settings carry over.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa tramite sideload il nuovo IPA dalla pagina delle release di GitHub; il tuo accesso e le impostazioni vengono mantenuti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala mediante sideload el nuevo IPA desde la página de releases de GitHub; tu inicio de sesión y ajustes se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargez le nouveau IPA en sideload depuis la page des releases GitHub, votre connexion et vos réglages sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade die neue IPA von der GitHub-Releases-Seite per Sideload; deine Anmeldung und Einstellungen werden übernommen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça o sideload do novo IPA pela página de releases do GitHub; seu login e configurações são mantidos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub のリリースページから新しい IPA をサイドロードしてください。サインインと設定は引き継がれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 릴리스 페이지에서 새 IPA를 사이드로드하세요. 로그인과 설정은 그대로 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 GitHub 发布页旁加载新的 IPA，你的登录和设置会随之保留。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузите новый IPA со страницы релизов GitHub, ваш вход и настройки сохранятся."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub रिलीज़ पेज से नया IPA साइडलोड करें, आपका साइन-इन और सेटिंग्स साथ चली आती हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حمّل ملف IPA الجديد جانبيًا من صفحة الإصدارات على GitHub، تنتقل معك بيانات تسجيل دخولك وإعداداتك."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni IPA'yı GitHub sürümler sayfasından yandan yükleyin, oturumunuz ve ayarlarınız aktarılır."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça sideload do novo IPA a partir da página de lançamentos do GitHub; a sua sessão e definições transitam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sideload de nieuwe IPA vanaf de GitHub-releasepagina, je aanmelding en instellingen blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Załaduj nowy plik IPA ze strony wydań GitHub; Twoje logowanie i ustawienia zostaną zachowane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidladda den nya IPA:n från GitHub-utgivningssidan, din inloggning och dina inställningar följer med."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請從 GitHub releases 頁面側載新的 IPA，你的登入與設定都會保留。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sideload IPA baru dari halaman rilis GitHub, info masuk dan pengaturan Anda ikut terbawa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไซด์โหลด IPA ใหม่จากหน้า GitHub releases การลงชื่อเข้าใช้และการตั้งค่าของคุณจะถูกนำมาด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sideload bản IPA mới từ trang releases trên GitHub, thông tin đăng nhập và cài đặt của bạn sẽ được giữ lại."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажте новий IPA зі сторінки релізів GitHub методом sideload, ваш вхід і налаштування переносяться."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načtěte (sideload) novou IPA ze stránky vydání na GitHubu, vaše přihlášení a nastavení se přenesou."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φορτώστε με sideload το νέο IPA από τη σελίδα εκδόσεων του GitHub· η σύνδεση και οι ρυθμίσεις σας μεταφέρονται."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טען בצד את ה-IPA החדש מדף ההפצות ב-GitHub, ההתחברות וההגדרות שלך עוברות יחד."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sideload den nye IPA fra GitHub-udgivelsessiden, din login og dine indstillinger følger med."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sivulataa uusi IPA GitHubin julkaisusivulta, kirjautumisesi ja asetuksesi siirtyvät mukana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidelast den nye IPA-en fra utgivelsessiden på GitHub, innloggingen og innstillingene dine følger med."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încarcă manual noul IPA din pagina de lansări GitHub, autentificarea și setările tale se păstrează."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telepítsd oldalról (sideload) az új IPA-t a GitHub kiadások oldaláról, a bejelentkezésed és a beállításaid átkerülnek."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat sisi IPA baharu daripada halaman keluaran GitHub, log masuk dan tetapan anda dibawa bersama."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-sideload ang bagong IPA mula sa pahina ng mga release sa GitHub, sumasama ang iyong sign-in at mga setting."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخه جدید IPA را از صفحه انتشارها در GitHub بارگذاری جانبی کنید، ورود و تنظیمات شما منتقل می‌شوند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub রিলিজ পৃষ্ঠা থেকে নতুন IPA সাইডলোড করুন, আপনার সাইন-ইন এবং সেটিংস বহাল থাকবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub வெளியீடுகள் பக்கத்திலிருந்து புதிய IPA-ஐ சைட்லோடு செய்யவும், உங்கள் உள்நுழைவும் அமைப்புகளும் தொடரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub releases పేజీ నుండి కొత్త IPAను సైడ్‌లోడ్ చేయండి, మీ సైన్-ఇన్ మరియు సెట్టింగ్‌లు కొనసాగుతాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub रिलीज पृष्ठावरून नवीन IPA साइडलोड करा, तुमचे साइन-इन आणि सेटिंग्ज तशीच राहतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub releases પૃષ્ઠ પરથી નવો IPA સાઇડલોડ કરો, તમારું સાઇન-ઇન અને સેટિંગ સાથે આવી જાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ರಿಲೀಸ್ ಪುಟದಿಂದ ಹೊಸ IPA ಅನ್ನು ಸೈಡ್‌ಲೋಡ್ ಮಾಡಿ, ನಿಮ್ಮ ಸೈನ್-ಇನ್ ಮತ್ತು ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಮುಂದುವರಿಯುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub റിലീസ് പേജിൽ നിന്ന് പുതിയ IPA സൈഡ്‌ലോഡ് ചെയ്യുക, നിങ്ങളുടെ സൈൻ-ഇന്നും ക്രമീകരണങ്ങളും കൊണ്ടുപോകുന്നു."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ریلیزز صفحے سے نیا IPA سائیڈ لوڈ کریں، آپ کا سائن-اِن اور سیٹنگز ساتھ منتقل ہو جاتی ہیں۔"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bočne načítajte nový IPA zo stránky vydaní na GitHube, vaše prihlásenie a nastavenia sa prenesú."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Заредете страничен новия IPA от страницата с издания в GitHub, вашето влизане и настройки се пренасят."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sideloadajte novi IPA sa stranice GitHub izdanja, vaša prijava i postavke prenose se."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитајте нови IPA са странице GitHub издања, ваша пријава и подешавања се преносе."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stransko naložite novo datoteko IPA s strani z izdajami na GitHubu, vaša prijava in nastavitve se prenesejo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šoniniu būdu įdiekite naują IPA iš GitHub leidimų puslapio, jūsų prisijungimas ir nuostatos perkeliami automatiškai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sānielādējiet jauno IPA no GitHub laidienu lapas, jūsu pierakstīšanās un iestatījumi tiek pārnesti."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lae uus IPA GitHubi väljalasete lehelt külgkaudu; su sisselogimine ja seaded kanduvad üle."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal·la la nova IPA des de la pàgina de llançaments de GitHub; el teu inici de sessió i la configuració es conserven."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala o novo IPA desde a páxina de versións de GitHub; o teu inicio de sesión e os axustes consérvanse."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalatu IPA berria GitHub argitalpen-orritik, zure saioa eta ezarpenak mantentzen dira."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidelaai die nuwe IPA van die GitHub-vrystellingsblad; jou aanmelding en instellings word oorgedra."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni IPA-nı GitHub relizlər səhifəsindən yan yüklə, girişin və parametrlərin köçürülür."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Sideload-ni IPA-n e re nga faqja e lëshimeve GitHub, hyrja dhe cilësimet tuaja ruhen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hliðhlaðaðu nýja IPA frá GitHub-útgáfusíðunni, innskráning og stillingar flytjast yfir."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сидолоадирајте го новото IPA од страницата со изданија на GitHub, вашата најава и поставки се пренесуваат."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakinisha IPA mpya kutoka ukurasa wa matoleo ya GitHub, kuingia kwako na mipangilio inabaki."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub шығарылымдар бетінен жаңа IPA файлын бүйірден жүктеңіз, кіру деректеріңіз бен параметрлеріңіз сақталады."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տեղադրեք նոր IPA-ն GitHub-ի թողարկումների էջից կողային բեռնումով, ձեր մուտքն ու կարգավորումները կպահվեն։"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩატვირთეთ ახალი IPA GitHub releases გვერდიდან, თქვენი შესვლა და პარამეტრები გადადის."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ਰਿਲੀਜ਼ ਪੇਜ ਤੋਂ ਨਵਾਂ IPA ਸਾਈਡਲੋਡ ਕਰੋ, ਤੁਹਾਡੇ ਸਾਈਨ-ਇਨ ਅਤੇ ਸੈਟਿੰਗਾਂ ਮੌਜੂਦ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub रिलिज पृष्ठबाट नयाँ IPA साइडलोड गर्नुहोस्, तपाईंको साइन-इन र सेटिङहरू सुरक्षित रहन्छन्।"
