    "Makes every screen's text larger or smaller. Changes apply instantly.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rende il testo di ogni schermata più grande o più piccolo. Le modifiche si applicano subito."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace el texto de cada pantalla más grande o más pequeño. Los cambios se aplican al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrandit ou réduit le texte de tous les écrans. Les changements s'appliquent immédiatement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht den Text auf jedem Bildschirm größer oder kleiner. Änderungen werden sofort übernommen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa o texto de cada tela maior ou menor. As alterações são aplicadas instantaneamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての画面の文字を大きくまたは小さくします。変更はすぐに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 화면의 텍스트를 더 크거나 작게 만듭니다. 변경 사항은 즉시 적용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让每个屏幕的文字变大或变小。更改即时生效。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делает текст на всех экранах крупнее или мельче. Изменения применяются мгновенно."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर स्क्रीन का टेक्स्ट बड़ा या छोटा करता है। बदलाव तुरंत लागू होते हैं।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكبّر نص كل شاشة أو يصغّره. تُطبَّق التغييرات فورًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ekranın metnini büyütür veya küçültür. Değişiklikler anında uygulanır."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna o texto de todos os ecrãs maior ou menor. As alterações aplicam-se de imediato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt de tekst op elk scherm groter of kleiner. Wijzigingen worden meteen toegepast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiększa lub pomniejsza tekst na każdym ekranie. Zmiany są stosowane natychmiast."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör texten på varje skärm större eller mindre. Ändringar tillämpas direkt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓每個畫面的文字變大或變小。變更會立即套用。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuat teks setiap layar lebih besar atau lebih kecil. Perubahan berlaku seketika."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำให้ข้อความทุกหน้าจอใหญ่ขึ้นหรือเล็กลง การเปลี่ยนแปลงจะมีผลทันที"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm cho chữ trên mọi màn hình to hơn hoặc nhỏ hơn. Thay đổi được áp dụng ngay lập tức."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Робить текст на кожному екрані більшим або меншим. Зміни застосовуються миттєво."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvětší nebo zmenší text na všech obrazovkách. Změny se projeví okamžitě."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάνει το κείμενο κάθε οθόνης μεγαλύτερο ή μικρότερο. Οι αλλαγές εφαρμόζονται άμεσα."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מגדיל או מקטין את הטקסט בכל מסך. השינויים חלים מיד."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør teksten på alle skærme større eller mindre. Ændringer træder i kraft med det samme."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suurentaa tai pienentää jokaisen näytön tekstiä. Muutokset tulevat voimaan välittömästi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør teksten på alle skjermer større eller mindre. Endringer trer i kraft umiddelbart."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mărește sau micșorează textul din fiecare ecran. Modificările se aplică instant."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden képernyőn nagyobbá vagy kisebbé teszi a szöveget. A változtatások azonnal érvénybe lépnek."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjadikan teks setiap skrin lebih besar atau lebih kecil. Perubahan digunakan serta-merta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinalalaki o pinaliliit ang teksto sa bawat screen. Agad inilalapat ang mga pagbabago."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "متن هر صفحه را بزرگ‌تر یا کوچک‌تر می‌کند. تغییرات بلافاصله اعمال می‌شوند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি স্ক্রিনের লেখা বড় বা ছোট করে। পরিবর্তন তাৎক্ষণিকভাবে প্রয়োগ হয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு திரையின் உரையையும் பெரிதாகவோ சிறிதாகவோ ஆக்குகிறது. மாற்றங்கள் உடனடியாகப் பயன்படுத்தப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి స్క్రీన్ టెక్స్ట్‌ను పెద్దదిగా లేదా చిన్నదిగా చేస్తుంది. మార్పులు తక్షణం వర్తిస్తాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक स्क्रीनवरील मजकूर मोठा किंवा लहान करते. बदल त्वरित लागू होतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક સ્ક્રીનનો ટેક્સ્ટ મોટો કે નાનો બનાવે છે. ફેરફારો તરત લાગુ થાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಸ್ಕ್ರೀನ್‌ನ ಪಠ್ಯವನ್ನು ದೊಡ್ಡದಾಗಿ ಅಥವಾ ಚಿಕ್ಕದಾಗಿ ಮಾಡುತ್ತದೆ. ಬದಲಾವಣೆಗಳು ತಕ್ಷಣ ಅನ್ವಯವಾಗುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ സ്ക്രീനിന്റെയും ടെക്സ്റ്റ് വലുതോ ചെറുതോ ആക്കുന്നു. മാറ്റങ്ങൾ ഉടനടി പ്രയോഗിക്കും."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر اسکرین کے متن کو بڑا یا چھوٹا بناتا ہے۔ تبدیلیاں فوری لاگو ہوتی ہیں۔"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zväčší alebo zmenší text na každej obrazovke. Zmeny sa prejavia okamžite."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прави текста на всеки екран по-голям или по-малък. Промените се прилагат незабавно."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povećava ili smanjuje tekst na svim zaslonima. Promjene se primjenjuju odmah."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Чини текст на сваком екрану већим или мањим. Промене се примењују одмах."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poveča ali pomanjša besedilo na vseh zaslonih. Spremembe se uveljavijo takoj."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Padaro viso ekrano tekstą didesnį ar mažesnį. Pakeitimai pritaikomi akimirksniu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Padara katra ekrāna tekstu lielāku vai mazāku. Izmaiņas tiek lietotas nekavējoties."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muudab iga ekraani teksti suuremaks või väiksemaks. Muudatused rakenduvad kohe."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa el text de totes les pantalles més gran o més petit. Els canvis s'apliquen immediatament."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai o texto de cada pantalla máis grande ou máis pequeno. Os cambios aplícanse de inmediato."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantaila guztietako testua handiago edo txikiago egiten du. Aldaketak berehala aplikatzen dira."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak elke skerm se teks groter of kleiner. Veranderings geld onmiddellik."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün ekranların mətnini böyüdür və ya kiçildir. Dəyişikliklər dərhal tətbiq olunur."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Bën tekstin e çdo ekrani më të madh ose më të vogël. Ndryshimet aplikohen menjëherë."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerir texta allra skjáa stærri eða minni. Breytingar taka gildi strax."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Го прави текстот на секој екран поголем или помал. Промените се применуваат веднаш."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hufanya maandishi ya kila skrini kuwa makubwa zaidi au madogo. Mabadiliko yanatekelezwa papo hapo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық экрандардың мәтінін үлкейтеді немесе кішірейтеді. Өзгерістер бірден қолданылады."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բոլոր էկրաններում տեքստը մեծացնում կամ փոքրացնում է։ Փոփոխությունները կիրառվում են ակնթարթորեն։"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყველა ეკრანის ტექსტს ადიდებს ან ამცირებს. ცვლილებები დაუყოვნებლივ ვრცელდება."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਸਕਰੀਨ ਦਾ ਟੈਕਸਟ ਵੱਡਾ ਜਾਂ ਛੋਟਾ ਕਰਦਾ ਹੈ। ਬਦਲਾਅ ਤੁਰੰਤ ਲਾਗੂ ਹੁੰਦੇ ਹਨ।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक स्क्रिनको पाठ ठूलो वा सानो बनाउँछ। परिवर्तनहरू तुरुन्तै लागू हुन्छन्।"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሁሉም ስክሪኖች ጽሑፍ ሊበልጥ ወይም ሊቀንስ ያደርጋሉ። ለውጦቹ ወዲያው ተፈጻሚ ይሆናሉ።"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ធ្វើឱ្យអត្ថបទរបស់រាល់អេក្រង់ធំឡើង ឬតូចចុះ។ ការផ្លាស់ប្តូរត្រូវបានអនុវត្តភ្លាមៗ។"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "প্ৰতিটো স্ক্ৰীনৰ লিখনি ডাঙৰ বা সৰু কৰে। সালসলনিবোৰ তৎক্ষণাৎ প্ৰয়োগ হয়।"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Робіць тэкст на кожным экране большым ці меншым. Змены ўжываюцца імгненна."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Brasaat pe vihanaat a ra testenn pep skramm. An daskemmadurioù a arlo raktal."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čini tekst na svakom ekranu većim ili manjim. Promjene se primjenjuju odmah."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagpadako o nagpagamay sa teksto sa matag screen. Ang mga kausaban molihok dayon."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn gwneud testun pob sgrin yn fwy neu'n llai. Mae newidiadau'n cael eu gweithredu ar unwaith."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ger tekstin á hvørjum skíggja størri ella minni. Broytingar virka beinanvegin."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "Makket de tekst op elk skerm grutter of lytser. Wizigingen wurde daliks tapast."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Déanann sé téacs gach scáileáin níos mó nó níos lú. Cuirtear athruithe i bhfeidhm láithreach."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Nì seo teacsa gach sgrìn nas motha no nas lugha. Bidh atharraichean an sàs sa bhad."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana sa rubutun kowane allo ya fi girma ko ƙanƙanta. Canje-canje suna aiki nan take."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Fè tèks chak ekran pi gwo oswa pi piti. Chanjman yo aplike enstantaneman."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-eme ederede ihuenyo ọ bụla buru ibu ma ọ bụ pere mpe. Mgbanwe na-arụ ọrụ ozugbo."
          }
        },
        "jv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nggawé teks saben layar luwih gedhé utawa cilik. Owahan ditrapaké sanalika."
          }
        },
        "ku": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivîsa her dîmenerê mezintir an biçûktir dike. Guhertin di cih de têne sepandin."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ар бир экрандагы текстти чоңойтот же кичирейтет. Өзгөртүүлөр заматта колдонулат."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mécht den Text op all Écran méi grouss oder méi kleng. D'Ännerunge gi sofort ugewannt."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຮັດໃຫ້ຂໍ້ຄວາມທຸກໜ້າຈໍໃຫຍ່ຂຶ້ນ ຫຼື ນ້ອຍລົງ. ການປ່ຽນແປງມີຜົນທັນທີ."
          }
        },
        "mg": {
          "stringUnit": {
            "state": "translated",
            "value": "Manalehibe na manakely ny soratra amin'ny efijery rehetra. Mihatra avy hatrany ny fanovana."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka whakanui, ka whakaiti rānei i te kuputuhi o ia mata. Ka whai mana tere ngā panonitanga."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дэлгэц бүрийн текстийг том эсвэл жижиг болгоно. Өөрчлөлт тэр даруй хэрэгжинэ."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jagħmel it-test ta' kull skrin akbar jew iżgħar. Il-bidliet japplikaw immedjatament."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဖန်သားပြင်တိုင်း၏ စာသားကို ပိုကြီး သို့မဟုတ် ပိုသေးအောင် ပြုလုပ်သည်။ ပြောင်းလဲမှုများ ချက်ချင်း အသက်ဝင်သည်။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "Imasandutsa mawu a skrini iliyonse kukhala akulu kapena aang'ono. Zosintha zimagwira ntchito nthawi yomweyo."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend lo tèxte de cada ecran mai grand o mai pichon. Los cambiaments s'aplican sul pic."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ ସ୍କ୍ରିନର ଟେକ୍ସଟକୁ ବଡ଼ କିମ୍ବା ଛୋଟ କରେ। ପରିବର୍ତ୍ତନ ତତକ୍ଷଣାତ ପ୍ରୟୋଗ ହୁଏ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "د هرې پردې متن لوی یا کوچنی کوي. بدلونونه سملاسي پلي کیږي."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bituma inyandiko ya buri ecran iba nini cyangwa nto. Impinduka zishyirwaho ako kanya."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "هر اسڪرين جي متن کي وڏو يا ننڍو بڻائي ٿو. تبديليون فوري لاڳو ٿين ٿيون."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සෑම තිරයකම පෙළ විශාල හෝ කුඩා කරයි. වෙනස්කම් ක්ෂණිකව යෙදේ."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "E faalapopoa pe faaitiitia tusitusiga o mata uma. E faaaoga vave suiga."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "Inoita mavara epachiratidziro chega chega kukura kana kudukupa. Shanduko dzinoshanda pakarepo."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu qoraalka shaashad kasta ka dhigaa mid weyn ama yar. Isbeddelladu isla markiiba way dhaqan galaan."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "E etsa hore mongolo oa skrine e 'ngoe le e 'ngoe o be moholo kapa o monyenyane. Liphetoho li sebetsa hang-hang."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngajadikeun téks unggal layar leuwih badag atawa leuwih leutik. Parobahan diterapkeun sakedapan."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Матни ҳар экранро калонтар ё хурдтар мекунад. Тағйирот фавран татбиқ мешаванд."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Һәр экрандагы текстны зуррак яки кечерәк итә. Үзгәрешләр шунда ук кулланыла."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ھەر بىر ئېكراندىكى خەتنى چوڭ ياكى كىچىك قىلىدۇ. ئۆزگەرتىش دەرھال كۈچكە ئىگە بولىدۇ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir ekrandagi matnni kattaroq yoki kichikroq qiladi. O'zgarishlar bir zumda qo'llaniladi."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenza umbhalo weskrini ngasinye ube mkhulu okanye mncinci. Utshintsho lusebenza ngoko nangoko."
          }
        },
