    "Delete %@? Its settings and sign-in are removed.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrap %@? Sy instellings en aanmelding word verwyder."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ይሰረዝ? ቅንብሮቹና መግቢያው ይወገዳሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف %@؟ ستُحذف إعداداته وتسجيل دخوله."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ silinsin? Onun ayarları və girişi silinir."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Да се изтрие ли %@? Настройките и влизането му се премахват."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ মুছবেন? এর সেটিংস ও সাইন-ইন সরিয়ে ফেলা হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vols eliminar %@? S'eliminaran la seva configuració i l'inici de sessió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazat %@? Jeho nastavení a přihlášení budou odstraněny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet %@? Dens indstillinger og login fjernes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ löschen? Die Einstellungen und Anmeldung werden entfernt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγραφή %@; Οι ρυθμίσεις και η σύνδεσή του θα αφαιρεθούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@? Se borrarán sus ajustes y su sesión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas kustutada %@? Selle seaded ja sisselogimine eemaldatakse."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ezabatu? Bere ezarpenak eta saio-hasiera kendu egingo dira."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ حذف شود؟ تنظیمات و ورود آن پاک می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaanko %@? Sen asetukset ja kirjautuminen poistetaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggalin ang %@? Tatanggalin ang mga setting at sign-in nito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %@ ? Ses réglages et sa connexion seront supprimés."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar %@? Elimínanse a súa configuración e o inicio de sesión."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ કાઢી નાખવું છે? તેની સેટિંગ અને સાઇન-ઇન દૂર થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למחוק את %@? ההגדרות והכניסה שלו יוסרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ हटाएँ? इसकी सेटिंग्स और साइन-इन हटा दिए जाएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrisati %@? Njegove postavke i prijava bit će uklonjeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törlöd ezt: %@? A beállításai és a bejelentkezése törlődik."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ջնջե՞լ %@-ը։ Դրա կարգավորումներն ու մուտքը կհեռացվեն։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus %@? Pengaturan dan info masuknya akan dihapus."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyða %@? Stillingar þess og innskráning verða fjarlægðar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare %@? Le sue impostazioni e l'accesso verranno rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を削除しますか？設定とサインイン情報が削除されます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წაიშალოს %@? მისი პარამეტრები და ანგარიში წაიშლება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ жойылсын ба? Оның баптаулары мен кіру деректері жойылады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លុប %@? ការកំណត់ និងការចូលគណនីរបស់វានឹងត្រូវលុបចេញ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಅಳಿಸುವುದೇ? ಅದರ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಮತ್ತು ಸೈನ್ ಇನ್ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ."
