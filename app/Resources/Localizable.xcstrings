            "value": "magnet នេះមានវីដេអូ %@។ ជ្រើសសើចំណងជើងណាមួយដើម្បីចាក់។"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মেগনেটত %@টা ভিডিঅ' আছে। কোনটো চলাব বাছক।"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У гэтага magnet %@ відэа. Выберыце, якое прайграць."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Ur %@ video zo el liamm magnet-mañ. Dibabit pehini c'hoari."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj magnet ima %@ videa. Odaberite koji pustiti."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kini nga magnet adunay %@ ka video. Pilia kung hain ang i-play."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae gan y magnet hwn %@ fideo. Dewiswch pa un i'w chwarae."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesin magnet hevur %@ sjónbond. Vel hvørt tú vilt spæla."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizze magnet hat %@ fideo's. Kies hokker jo ôfspylje wolle."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá %@ físeán ag an maighnéad seo. Roghnaigh cé acu ceann le seinnt."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Tha %@ bhidiothan aig a' mhagnad seo. Tagh cò am fear a chluicheas tu."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan maganti yana da bidiyo %@. Zaɓi wanne za a kunna."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnet sa a gen %@ videyo. Chwazi kilès pou jwe."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnet a nwere vidiyo %@. Họrọ nke ị ga-akpọ."
          }
        },
        "jv": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnet iki duwé %@ vidhéo. Pilih sing endi arep dimainaké."
          }
        },
        "ku": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê magnetê %@ vîdyo hene. Hilbijêre ka kîjan bilîze."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул магнитте %@ видео бар. Кайсынысын ойнотууну тандаңыз."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dëse Magnet huet %@ Videoen. Wiel wéi een ofgespillt gëtt."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "magnet ນີ້ມີວິດີໂອ %@ ອັນ. ເລືອກອັນທີ່ຈະຫຼິ້ນ."
          }
        },
        "mg": {
          "stringUnit": {
            "state": "translated",
            "value": "Manana video %@ ity magnet ity. Fidio izay hilalao."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "He %@ ataata tā tēnei aukume. Kōwhiria ko tēhea hei pāho."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ магнет %@ видеотой. Аль нь тоглуулахыг сонгоно уу."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan il-magnet għandu %@ vidjos. Agħżel liema wieħed iddoqq."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤ magnet တွင် ဗီဒီယို %@ ခု ရှိသည်။ မည်သည့်ခုကို ဖွင့်မည်ဆိုသည်ကို ရွေးပါ။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnet iyi ili ndi ma vidiyo %@. Sankhani liti loti museweretse."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqueste magnet a %@ vidèos. Causissètz quina legir."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ମ୍ୟାଗନେଟରେ %@ ଭିଡିଓ ଅଛି। କେଉଁଟି ଚଲାଇବେ ବାଛନ୍ତୁ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "دا مقناطیس %@ ویډیوګانې لري. وټاکئ چې کومه یې وغږوئ."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Iyi magnet ifite videwo %@. Hitamo iyo ukina."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "هن ميگنيٽ ۾ %@ ويڊيوز آهن. چونڊيو ته ڪھڙو هلائجي."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙම magnet හි වීඩියෝ %@ක් ඇත. වාදනය කළ යුත්තේ කුමක්දැයි තෝරන්න."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "E iai vitio e %@ i lenei maneta. Filifili po o le fea e taalo."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnet iyi ine mavhidhiyo %@. Sarudza rekutamba."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnet-kan wuxuu leeyahay %@ muuqaal. Dooro midka aad ciyaarayso."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnet ena e na le divideo tse %@. Khetha hore na u bapala efe."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnet ieu boga %@ pidéo. Pilih mana nu rék diputer."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин магнит %@ видео дорад. Интихоб кунед, ки кадомаш пахш шавад."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Бу магнитта %@ видео бар. Кайсын уйнатасын сайла."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بۇ magnet دا %@ سىن بار. قايسىنى قويۇشنى تاللاڭ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu magnitda %@ ta video bor. Qaysi birini ijro etishni tanlang."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "Le magnet ineevidiyo ezingu-%@. Khetha ukuba yeyiphi oza kuyidlala."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Magnet yìí ní fídíò %@. Yan èyí tí o fẹ́ tú."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Le magnet inamavidiyo angu-%@. Khetha ukuthi yiliphi ozolidlala."
          }
