          "stringUnit": {
            "state": "translated",
            "value": "%@ shtesë%@ tjetër nuk ktheu burime për këtë titull."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ annað viðbót%@ skilaði engum streymum fyrir þessa titil."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ друг додаток%@ не врати извори за овој наслов."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiongezi kingine %@ cha%@ hakijarudisha vyanzo vya kichwa hiki."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ басқа қондырма%@ осы тақырып үшін ешқандай дерек көз қайтармады."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ այլ հավելանյութ%@ այս վերնագրի համար աղբյուրներ չի գտել։"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ სხვა დამატება%@ ამ სათაურისთვის წყაროები ვერ მოიძია."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਹੋਰ ਐਡ-ਆਨ%@ ਨੇ ਇਸ ਸਿਰਲੇਖ ਲਈ ਕੋਈ ਸਰੋਤ ਨਹੀਂ ਦਿੱਤਾ।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अन्य add-on%@ ले यो शीर्षकका लागि कुनै स्रोत फेला पारेन।"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ሌላ ተጨማሪ%@ ለዚህ ርዕስ ምንጮችን አልመለሰም።"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ កម្មវិធីបន្ថែម%@ ផ្សេងទៀតមិនបានត្រឡប់ប្រភពសម្រាប់ចំណងជើងនេះទេ។"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ অন্য এড-অন%2$@-এ এই শিৰোনামৰ বাবে কোনো উৎস ঘূৰাই নিদিলে।"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ іншых дадаткаў%2$@ не вярнулі крыніц для гэтага тайтла."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ enlugellad all%2$@ n'o deus roet mammenn ebet evit an titl-mañ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ drugih dodataka%2$@ nije vratilo izvore za ovaj naslov."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ka lain nga add-on%2$@ walay gibalik nga tinubdan para niini nga titulo."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni ddychwelodd %1$@ ychwanegyn%2$@ arall unrhyw ffynonellau ar gyfer y teitl hwn."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ onnur eyking%2$@ skiluðu ongar keldur fyri hendan titul."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ oare add-on%2$@ joech gjin boarnen foar dizze titel."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níor sheol %1$@ breiseán%2$@ eile aon fhoinse don teideal seo."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Cha do thill %1$@ tuilleadan%2$@ eile tùs sam bith airson an tiotail seo."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauran ƙarin abubuwa %1$@%2$@ ba su dawo da wani tushe ba don wannan taken."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lòt add-on%2$@ pa retounen okenn sous pou tit sa a."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ngwakọ ọzọ%2$@ weghachiteghị isi mmalite ọ bụla maka aha a."
          }
        },
        "jv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ add-on liyané%2$@ ora ngasilaké sumber kanggo judhul iki."
          }
        },
        "ku": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pêvekên din%2$@ ji bo vê sernavê tu çavkanî nedan."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ башка кошумча%2$@ бул аталышка эч кандай булак кайтарган жок."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ aner Add-on%2$@ hunn keng Quelle fir dësen Titel zréckginn."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສ່ວນເສີມອື່ນ %1$@ ຢ່າງ%2$@ ບໍ່ໄດ້ໃຫ້ແຫຼ່ງໃດສຳລັບເລື່ອງນີ້."
          }
        },
        "mg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ add-on hafa%2$@ tsy namerina loharano ho an'ity lohateny ity."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kāore he pūtake i whakahokia mai e %1$@ atu apataki%2$@ mō tēnei taitara."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ өөр нэмэлт%2$@ энэ контентод эх сурвалж буцаасангүй."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ add-on%2$@ oħra ma rritornaw ebda sors għal dan it-titlu."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အခြား add-on %1$@ ခု%2$@ သည် ဤခေါင်းစဉ်အတွက် အရင်းအမြစ်များ မပြန်ပေးပါ။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ add-on%2$@ zina sizinapereke gwero lililonse la mutu uwu."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ autre%2$@ modul renviguèt pas cap de font per aqueste títol."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ଅନ୍ୟ ଆଡ୍-ଅନ%2$@ ଏହି ଟାଇଟଲ ପାଇଁ କୌଣସି ଉତ୍ସ ଫେରାଇ ନାହିଁ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ نور اضافه‌ونه%2$@ د دې سرلیک لپاره هیڅ سرچینه رانه‌ولوله."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ibindi byongera%2$@ ntibyagaragaje inkomoko z'iyi nsanganyamatsiko."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ٻئي ايڊ-آن%2$@ هن عنوان لاءِ ڪوبه ذريعو نه موٽايو."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "වෙනත් %1$@ ඇඩෝන%2$@ මෙම මාතෘකාව සඳහා මූලාශ්‍ර කිසිවක් ලබා දුන්නේ නැත."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "E leai ni puna na toe tuuina mai e le isi %1$@ add-on%2$@ mo lenei ulutala."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zvimwe zvinowedzera%2$@ hazvina kudzosa nzvimbo dzemvura yechinyorwa ichi."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ add-on%2$@ oo kale ma ay soo celin ilo cinwaankan."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tlatelano%2$@ tse ling ha lia ka tsa fana ka mehloli bakeng sa sehlooho sena."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ add-on séjén%2$@ teu méré sumber pikeun judul ieu."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ иловаи дигар%2$@ барои ин унвон ягон манбаъ барнагардонд."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ башка өстәмә%2$@ бу исем өчен чыганак бирмәде."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "باشقا %1$@ قوشۇلما%2$@ بۇ ماۋزۇغا ھېچقانداق مەنبە قايتۇرمىدى."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana %1$@ ta qo'shimcha%2$@ bu sarlavha uchun manba qaytarmadi."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ezinye ii-add-on%2$@ azikhuphanga mithombo yalo mxholo."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ add-on mìíràn%2$@ kò dá orísun kankan padà fún àkọ́lé yìí."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ezinye izengezo%2$@ azibuyisanga imithombo yalesi sihloko."
          }
