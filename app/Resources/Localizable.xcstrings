        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন ভাষাত এপ্‌টো দেখুৱাবলৈ VortX বন্ধ কৰি পুনৰ খোলিব লাগিব। ইয়াক বন্ধ হোৱাৰ পিছত পুনৰ খোলক।"
