        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neprivaloma. Nemokama, ištisai užšifruota paskyra apsaugo jūsų profilius, nuostatas ir biblioteką visuose įrenginiuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobligāti. Bezmaksas, pilnībā šifrēts konts uztur jūsu profilus, iestatījumus un bibliotēku drošībā visās ierīcēs."
