        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ਰਿਲੀਜ਼ ਪੇਜ ਤੋਂ ਨਵਾਂ ਬਿਲਡ ਇੰਸਟਾਲ ਕਰੋ; ਤੁਹਾਡੇ ਸਾਈਨ-ਇਨ ਅਤੇ ਸੈਟਿੰਗਾਂ ਮੌਜੂਦ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub रिलिज पृष्ठबाट नयाँ बिल्ड स्थापना गर्नुहोस्; तपाईंको साइन-इन र सेटिङहरू सुरक्षित रहन्छन्।"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "አዲሱን ግንባታ ከ GitHub releases ገፅ ይጫኑ፤ ምዝገባዎ እና ቅንብሮቹ ይሸጋገራሉ።"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដំឡើង build ថ្មីពីទំព័រចេញផ្សាយ GitHub; ការចូល និងការកំណត់របស់អ្នករក្សាទុក។"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ৰিলিজ পৃষ্ঠাৰ পৰা নতুন বিল্ডটো ইনষ্টল কৰক; আপোনাৰ ছাইন-ইন আৰু ছেটিংছবোৰ থাকি যায়।"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Усталюйце новую зборку са старонкі рэлізаў GitHub; ваш уваход і налады перанясуцца."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Staliit ar sevel nevez adalek pajenn ar bermadennoù GitHub; ho kennaskañ hag ho arventennoù a dremen ganeoc'h."
