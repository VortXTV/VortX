        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksan an rekolore seleksyon ak pwogrè nan tout aplikasyon an. OLED Black sèvi ak nwa reyèl, pi bon sou ekran AMOLED yo."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Ụcha isi na-agbanwe ụcha nhọrọ na ọganihu n'ime ngwa niile. OLED Ojii na-eji ojii n'ezie, kacha mma na mbadamba AMOLED."
