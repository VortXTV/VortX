        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସେହି ସବଟାଇଟଲ ଉତ୍ସ ସମୟରେ ପ୍ରତିକ୍ରିୟା କଲା ନାହିଁ। ଅନ୍ୟଟି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "دا د زیرنوشت سرچینه په وخت ځواب ونه‌ورکړ. بله یې هڅه کړئ."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Iyo nkomoko y'amagambo agaragara ntiyatanze igisubizo ku gihe. Gerageza indi."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "ان سب ٽائيٽل ذريعي وقت تي جواب نه ڏنو. ٻيو آزمايو."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "එම උපසිරැසි මූලාශ්‍රය කාලයට ප්‍රතිචාර දැක්වූයේ නැත. තවත් එකක් උත්සාහ කරන්න."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "E leʻi tali mai le puna ulutala pito i lalo i le taimi. Taumafai i se isi."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nzvimbo iyoyo ye subtitle haina kupindura nenguva. Edza imwe."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Isha qoraal-hoosaadkaasi waqtigii kuma jawaabin. Isku day mid kale."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "Mohloli oo oa litlaleho ha oa ka oa araba ka nako. Leka o mong."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumber subjudul éta teu ngaréspon dina waktuna. Cobian nu séjén."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Он манбаи зерунвон дар вақташ ҷавоб надод. Дигарашро санҷед."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Бу субтитр чыганагы вакытында җавап бирмәде. Башкасын сынап кара."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بۇ خەتكۈش مەنبەسى ۋاقتىدا جاۋاب بەرمىدى. باشقىسىنى سىناڭ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu subtitr manbasi o'z vaqtida javob bermadi. Boshqasini sinab ko'ring."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "Loo mthombo wesihloko awuphendulanga ngexesha. Zama omnye."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Orísun àkọlé-abẹ́ yẹn kò dáhùn ní àkókò. Gbìyànjú mìíràn."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lowo mthombo wengcaphuno awuphendulanga ngesikhathi. Zama omunye."
          }
        }
      }
    },
    "The app quits immediately. Open it again from the Home Screen; the streaming server restarts with it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app si chiude immediatamente. Riaprila dalla schermata Home; il server di streaming si riavvia con essa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se cierra de inmediato. Vuelve a abrirla desde la pantalla de inicio; el servidor de streaming se reinicia con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app se ferme immédiatement. Rouvrez-la depuis l'écran d'accueil ; le serveur de streaming redémarre avec elle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wird sofort beendet. Öffne sie erneut über den Home-Bildschirm; der Streaming-Server startet mit ihr neu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app fecha imediatamente. Abra-o novamente pela Tela de Início; o servidor de streaming reinicia junto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはすぐに終了します。ホーム画面から再度開いてください。ストリーミングサーバーも一緒に再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 즉시 종료됩니다. 홈 화면에서 다시 여세요. 스트리밍 서버도 함께 다시 시작됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用会立即退出。请从主屏幕再次打开它；流媒体服务器会随之重启。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение немедленно закрывается. Откройте его снова с главного экрана; сервер потоковой передачи запустится вместе с ним."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप तुरंत बंद हो जाता है। उसे Home Screen से फिर से खोलें; स्ट्रीमिंग सर्वर उसके साथ पुनः आरंभ होता है।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُغلَق التطبيق فورًا. افتحه مجددًا من الشاشة الرئيسية؛ يُعاد تشغيل خادم البث معه."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama hemen kapanır. Ana Ekran'dan tekrar açın; akış sunucusu onunla birlikte yeniden başlar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A app encerra de imediato. Abra-a novamente a partir do ecrã principal; o servidor de streaming reinicia com ela."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app sluit meteen af. Open hem opnieuw vanaf het beginscherm; de streamingserver start mee opnieuw op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja natychmiast się zamknie. Otwórz ją ponownie z ekranu głównego; serwer strumieniowania uruchomi się razem z nią."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen avslutas omedelbart. Öppna den igen från hemskärmen; strömningsservern startas om med den."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 會立即結束。請從主畫面再次開啟它；串流伺服器會隨之重新啟動。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi langsung keluar. Buka lagi dari Layar Beranda; server streaming dimulai ulang bersamanya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปจะปิดทันที เปิดใหม่จากหน้าจอโฮม เซิร์ฟเวอร์สตรีมมิงจะรีสตาร์ทไปพร้อมกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng sẽ thoát ngay lập tức. Hãy mở lại từ Màn hình chính; máy chủ phát sẽ khởi động lại cùng với nó."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок негайно закривається. Відкрийте його знову з Домашнього екрана; сервер потокового відтворення перезапуститься разом із ним."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace se okamžitě ukončí. Otevřete ji znovu z Domovské obrazovky; streamovací server se s ní spustí znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή κλείνει αμέσως. Ανοίξτε την ξανά από την Αρχική οθόνη· ο διακομιστής ροής επανεκκινείται μαζί της."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה נסגרת מיד. פתח אותה שוב ממסך הבית; שרת ההזרמה מופעל מחדש יחד איתה."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen lukker med det samme. Åbn den igen fra hjemmeskærmen; streaming-serveren genstarter sammen med den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus sulkeutuu välittömästi. Avaa se uudelleen Koti-näytöltä; suoratoistopalvelin käynnistyy sen mukana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen avsluttes umiddelbart. Åpne den igjen fra Hjem-skjermen; strømmeserveren starter på nytt sammen med den."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația se închide imediat. Deschide-o din nou din ecranul principal; serverul de streaming repornește odată cu ea."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az app azonnal kilép. Nyisd meg újra a Kezdőképernyőről; a streaming szerver vele együtt újraindul."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi keluar serta-merta. Buka semula daripada Skrin Utama; pelayan penstriman dimulakan semula dengannya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Agad na nagsasara ang app. Buksan itong muli mula sa Home Screen; muling magsi-start ang streaming server kasabay nito."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه بلافاصله بسته می‌شود. آن را دوباره از صفحه خانه باز کنید؛ سرور پخش جریانی همراه آن دوباره راه‌اندازی می‌شود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপটি সঙ্গে সঙ্গে বন্ধ হয়ে যায়। হোম স্ক্রিন থেকে এটি আবার খুলুন; স্ট্রিমিং সার্ভার এর সঙ্গে পুনরায় চালু হয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப் உடனடியாக வெளியேறும். அதை முகப்புத் திரையிலிருந்து மீண்டும் திறக்கவும்; ஸ்ட்ரீமிங் சர்வர் அதனுடன் மறுதொடக்கம் செய்யும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్ వెంటనే మూసివేయబడుతుంది. హోమ్ స్క్రీన్ నుండి దాన్ని మళ్లీ తెరవండి; దానితో పాటు స్ట్రీమింగ్ సర్వర్ రీస్టార్ట్ అవుతుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अॅप लगेच बंद होते. ते Home Screen वरून पुन्हा उघडा; streaming सर्व्हर त्यासोबत पुन्हा सुरू होतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એપ તરત જ બંધ થાય છે. તેને Home Screen પરથી ફરી ખોલો; સ્ટ્રીમિંગ સર્વર તેની સાથે ફરી શરૂ થાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್ ತಕ್ಷಣ ಮುಚ್ಚುತ್ತದೆ. ಅದನ್ನು ಹೋಮ್ ಸ್ಕ್ರೀನ್‌ನಿಂದ ಮತ್ತೆ ತೆರೆಯಿರಿ; ಸ್ಟ್ರೀಮಿಂಗ್ ಸರ್ವರ್ ಅದರೊಂದಿಗೆ ಮರುಪ್ರಾರಂಭವಾಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പ് ഉടനടി അടയ്ക്കുന്നു. ഹോം സ്ക്രീനിൽ നിന്ന് അത് വീണ്ടും തുറക്കുക; സ്ട്രീമിംഗ് സെർവർ അതോടൊപ്പം റീസ്റ്റാർട്ട് ചെയ്യുന്നു."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ فوراً بند ہو جاتی ہے۔ اسے ہوم اسکرین سے دوبارہ کھولیں؛ اسٹریمنگ سرور اس کے ساتھ دوبارہ شروع ہو جاتا ہے۔"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácia sa okamžite ukončí. Otvorte ju znova z plochy; streamovací server sa s ňou reštartuje."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложението се затваря веднага. Отворете го отново от началния екран; стрийминг сървърът се рестартира с него."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija se odmah zatvara. Otvorite je ponovno s početnog zaslona; poslužitelj za streaming pokreće se s njom."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Апликација се одмах затвара. Отворите је поново са почетног екрана; сервер за стримовање се поново покреће с њом."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija se takoj zapre. Znova jo odprite z začetnega zaslona; pretočni strežnik se zažene z njo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Programa iškart išsijungia. Atverkite ją iš naujo pradžios ekrane; srautinio perdavimo serveris paleidžiamas kartu su ja."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietotne tūlīt aizveras. Atveriet to vēlreiz no sākuma ekrāna; straumēšanas serveris restartējas kopā ar to."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakendus sulgub kohe. Ava see uuesti Avakuvalt; voogedastusserver taaskäivitub koos sellega."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app es tanca immediatament. Torna a obrir-la des de la pantalla d'inici; el servidor de streaming es reinicia amb ella."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "A app péchase de inmediato. Ábrena de novo desde a pantalla de inicio; o servidor de transmisión reiníciase con ela."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikazioa berehala irteten da. Ireki berriz Hasierako Pantailatik; streaming zerbitzaria berrekin egiten da."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die app sluit onmiddellik. Maak dit weer oop vanaf die tuisskerm; die stromingbediener herbegin saam daarmee."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiq dərhal çıxır. Ana ekrandan yenidən açın; axın serveri onunla birlikdə yenidən başlayır."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacioni mbyllet menjëherë. Hapeni sërish nga Ekrani Kryesor; serveri i transmetimit riniset me të."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Forritið hættir strax. Opnaðu það aftur frá heimaskjánum; streymisþjónninn endurræsist með því."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Апликацијата веднаш се затвора. Повторно отворете ја од почетниот екран; серверот за стримување повторно се стартува со неа."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Programu inafunga mara moja. Ifungue tena kutoka kwenye Skrini ya Nyumbani; seva ya mtiririko inaanza upya nayo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қосымша бірден жабылады. Оны басты экраннан қайта ашыңыз; ағын серверы онымен бірге қайта іске қосылады."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ծրագիրն անմիջապես կփակվի։ Բացեք այն կրկին Գլխավոր էկրանից. հոսման սերվերն ու ծրագիրը կվերագործարկվի։"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აპლიკაცია დაუყოვნებლივ იხურება. გახსენით ხელახლა მთავარი ეკრანიდან; სტრიმინგ სერვერი ერთად გადაიტვირთება."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਤੁਰੰਤ ਬੰਦ ਹੋ ਜਾਂਦੀ ਹੈ। ਹੋਮ ਸਕਰੀਨ ਤੋਂ ਇਸਨੂੰ ਦੁਬਾਰਾ ਖੋਲ੍ਹੋ; ਸਟ੍ਰੀਮਿੰਗ ਸਰਵਰ ਇਸਦੇ ਨਾਲ ਮੁੜ ਸ਼ੁਰੂ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "एप तुरुन्तै बन्द हुन्छ। होम स्क्रिनबाट फेरि खोल्नुहोस्; स्ट्रिमिङ सर्भर यससँगै पुनः सुरु हुन्छ।"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መተግበሪያው ወዲያው ይዘጋሉ። ከቤት ስክሪን ዳግም ይክፈቱ፤ ዥረቱ አገልጋይ ከእሱ ጋር ዳግም ይጀምራሉ።"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កម្មវិធីបិទភ្លាម។ បើកវាឡើងវិញពី Home Screen; streaming server ចាប់ផ្តើមឡើងវិញជាមួយវា។"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এপ্‌টো লগে লগে বন্ধ হয়। Home Screen-ৰ পৰা ইয়াক পুনৰ খোলক; ষ্ট্ৰীমিং ছাৰ্ভাৰ ইয়াৰ সৈতে পুনৰ আৰম্ভ হয়।"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дадатак закрываецца адразу. Адкрыйце яго зноў з галоўнага экрана; сервер стрымінгу перазапускаецца разам з ім."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "An arload a serr raktal. Digorit anezhañ en-dro adalek ar Skramm Degemer; ar servijer lanviñ a adloc'h gantañ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija se odmah zatvara. Otvorite je ponovo sa početnog ekrana; server za streamovanje se ponovo pokreće s njom."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang app moundang dayon. Ablihi kini pag-usab gikan sa Home Screen; ang streaming server mo-restart uban niini."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae'r ap yn cau ar unwaith. Agorwch ef eto o'r Sgrin Cartref; bydd y gweinydd ffrydio'n ailgychwyn gydag ef."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Appið letur aftur beinanvegin. Lat tað upp aftur frá Heimaskíggjanum; streymingarambætarin byrjar av nýggjum við tí."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "De app slút daliks ôf. Iepenje him op 'e nij fanút it Thússkerm; de streaming-server start dêrmei op 'e nij."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Scoireann an aip láithreach. Oscail arís í ón Scáileán Baile; atosaíonn an freastalaí sruthaithe léi."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùinidh an aplacaid sa bhad. Fosgail a-rithist i on Sgrìn Dachaigh; ath-thòisichidh am frithealaiche sruthaidh còmhla rithe."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Manhajar tana rufewa nan take. Buɗe ta kuma daga Allon Gida; sabar streaming tana sake farawa tare da ita."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasyon an fèmen imedyatman. Louvri l ankò soti nan Ekran Akèy la; sèvè streaming lan rilanse avè l."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngwa na-akwụsị ozugbo. Meghee ya ọzọ site na Ihuenyo Ụlọ; sava nkesa na-amaliteghachi ya na ya."
          }
        },
        "jv": {
          "stringUnit": {
            "state": "translated",
            "value": "App langsung metu. Bukak manèh saka Layar Ngarep; server streaming miwiti manèh bareng."
          }
        },
        "ku": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepan di cih de tê girtin. Ji Dîmenerê Malê wê ji nû ve veke; servera streamkirinê pê re ji nû ve dest pê dike."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонмо дароо жабылат. Аны Башкы экрандан кайра ачыңыз; стриминг сервери аны менен кошо кайра иштейт."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "D'App mécht direkt zou. Maach se erëm op vum Startbildschierm; de Streaming-Server start domat nei."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ແອັບຈະປິດທັນທີ. ເປີດມັນອີກຄັ້ງຈາກໜ້າຈໍຫຼັກ; ເຊີບເວີສະຕຣີມມິງຈະຣີສະຕາດພ້ອມກັບມັນ."
          }
        },
        "mg": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijanona avy hatrany ny app. Sokafy indray avy amin'ny Efijery Fandraisana; miverina miaraka aminy ny server streaming."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka whakamutu tere te taupānga. Whakatuwherahia anō mai i te Mata Kāinga; ka whakaara anō te tūmau awa i tōna taha."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Апп тэр даруй хаагдана. Нүүр дэлгэцээс дахин нээнэ үү; урсгалын сервер түүнтэй хамт дахин эхэлнэ."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-app tagħlaq immedjatament. Iftaħha mill-ġdid mill-Home Screen; is-server tal-istreaming jerġa' jibda magħha."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "app သည် ချက်ချင်း ပိတ်သွားသည်။ Home Screen မှ ၎င်းကို ပြန်ဖွင့်ပါ၊ streaming server သည် ၎င်းနှင့်အတူ ပြန်စတင်သည်။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "App imatseka nthawi yomweyo. Itsekulireni kuchokera ku Home Screen; seva ya streaming imayambanso nayo."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aplicacion se tampa sul pic. Tornatz-la dobrir dempuèi l'ecran d'acuèlh ; lo servidor de difusion se reavia amb ela."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପ୍ ତତକ୍ଷଣାତ ବନ୍ଦ ହୋଇଯାଏ। ଏହାକୁ Home ସ୍କ୍ରିନରୁ ପୁନଃ ଖୋଲନ୍ତୁ; ଷ୍ଟ୍ରିମିଂ ସର୍ଭର ଏହା ସହିତ ପୁନଃ ଆରମ୍ଭ ହୁଏ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "اپ سملاسي وتړل کیږي. له کور پردې نه یې بیا خلاص کړئ؛ د سټریمینګ سرور ورسره بیا پیل کیږي."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Porogaramu ihagarara ako kanya. Ongera uyifungure uhereye ku Ntangiriro; seriveri ya streaming yongera gutangira nayo."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "ايپ فوري بند ٿي وڃي ٿي. ان کي ٻيهر گھر اسڪرين مان کوليو؛ اسٽريمنگ سرور ان سان گڏ ٻيهر شروع ٿي وڃي ٿو."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "යෙදුම වහාම ඉවත් වේ. එය මුල් තිරයෙන් නැවත විවෘත කරන්න; ප්‍රවාහ සේවාදායකය එය සමඟ නැවත ආරම්භ වේ."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "E vave tapunia le app. Toe tatala mai le Mata Home; e toe amata faatasi ai le server streaming."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "App inobva yamira pakarepo. Ivhurezve kubva paHome Screen; sevha ye streaming inotangazve pamwe nayo."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "App-ku isla markiiba wuu xirmayaa. Dib uga fur Shaashadda Home; server-ka stream-ku wuu la dib u bilaabmayaa."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "App e koala hang-hang. E bule hape ho tsoa Home Screen; seva sa streaming se qala hape le eona."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi langsung nutup. Buka deui tina Layar Utama; sérver streaming ngamimitian deui bareng jeung éta."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барнома фавран баста мешавад. Онро аз экрани асосӣ аз нав кушоед; сервери ҷараён ҳамроҳи он аз нав оғоз меёбад."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Кушымта шунда ук ябыла. Аны Баш экраннан кабат ач; агым сервере аның белән бергә кабат кабына."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "دېتال دەرھال چېكىنىدۇ. ئۇنى باش ئېكراندىن قايتا ئېچىڭ؛ ئېقىن مۇلازىمېتىرى ئۇنىڭ بىلەن بىللە قايتا قوزغىلىدۇ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilova darhol yopiladi. Uni Bosh ekrandan qayta oching; oqim serveri u bilan birga qayta ishga tushadi."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "I-app iyavala ngoko nangoko. Yivule kwakhona kwiskrini seKhaya; iseva yestream iqalisa kwakhona kunye nayo."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "App náà máa ń jáde lẹ́sẹ̀kẹsẹ̀. Ṣí i padà láti Home Screen; sáfà streaming máa ń tún bẹ̀rẹ̀ pẹ̀lú rẹ̀."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "I-app iyaphuma ngokushesha. Yivule futhi kusukela kuSikrini Sasekhaya; iseva ye-streaming iqala kabusha kanye nayo."
          }
        }
      }
    },
    "The main profile. It uses your Stremio account's own watch history, like before profiles existed.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo principale. Usa la cronologia di visione del tuo account Stremio, come prima che esistessero i profili."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil principal. Usa el propio historial de visualización de tu cuenta Stremio, como antes de que existieran los perfiles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil principal. Il utilise l'historique de visionnage propre à votre compte Stremio, comme avant l'existence des profils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hauptprofil. Es verwendet den eigenen Wiedergabeverlauf deines Stremio-Kontos, wie vor der Einführung von Profilen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil principal. Ele usa o histórico de exibição da sua própria conta Stremio, como antes de os perfis existirem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインのプロファイルです。プロファイルが存在する前と同じように、Stremio アカウント独自の視聴履歴を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 프로필입니다. 프로필이 존재하기 전과 마찬가지로 Stremio 계정 자체의 시청 기록을 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主配置文件。它使用你的 Stremio 账户自己的观看历史，就像配置文件出现之前那样。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной профиль. Он использует собственную историю просмотра вашего аккаунта Stremio, как было до появления профилей."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुख्य प्रोफ़ाइल। यह आपके Stremio खाते का अपना देखने का इतिहास उपयोग करती है, जैसे प्रोफ़ाइलें होने से पहले होता था।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف الشخصي الرئيسي. يستخدم سجل المشاهدة الخاص بحساب Stremio الخاص بك، كما كان قبل وجود الملفات الشخصية."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana profil. Profiller var olmadan önceki gibi, Stremio hesabınızın kendi izleme geçmişini kullanır."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil principal. Usa o histórico de visualização da sua própria conta Stremio, como antes de existirem perfis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het hoofdprofiel. Het gebruikt de eigen kijkgeschiedenis van je Stremio-account, net zoals voordat er profielen bestonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Główny profil. Korzysta z własnej historii oglądania Twojego konta Stremio, jak przed pojawieniem się profili."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Huvudprofilen. Den använder ditt Stremio-kontos egna tittarhistorik, som innan profiler fanns."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主要設定檔。它使用你 Stremio 帳號本身的觀看記錄，就像還沒有設定檔之前一樣。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil utama. Ini menggunakan riwayat tonton milik akun Stremio Anda sendiri, seperti sebelum profil ada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรไฟล์หลัก ใช้ประวัติการดูของบัญชี Stremio ของคุณเอง เหมือนตอนที่ยังไม่มีโปรไฟล์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ chính. Nó dùng lịch sử xem riêng của tài khoản Stremio của bạn, như trước khi có hồ sơ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основний профіль. Він використовує власну історію перегляду вашого акаунта Stremio, як було до появи профілів."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlavní profil. Používá vlastní historii sledování vašeho účtu Stremio, jako předtím, než profily existovaly."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κύριο προφίλ. Χρησιμοποιεί το ιστορικό παρακολούθησης του ίδιου του λογαριασμού Stremio σας, όπως πριν υπάρξουν τα προφίλ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרופיל הראשי. הוא משתמש בהיסטוריית הצפייה של חשבון Stremio שלך, כמו לפני שהיו פרופילים."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovedprofilen. Den bruger din Stremio-kontos egen seehistorik, ligesom før profiler fandtes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pääprofiili. Se käyttää Stremio-tilisi omaa katseluhistoriaa, kuten ennen profiilien olemassaoloa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovedprofilen. Den bruker Stremio-kontoens egen avspillingshistorikk, slik det var før profiler fantes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilul principal. Folosește propriul istoric de vizionare al contului tău Stremio, ca înainte de a exista profilurile."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fő profil. A Stremio-fiókod saját megtekintési előzményeit használja, ahogyan a profilok létezése előtt."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil utama. Ia menggunakan sejarah tontonan akaun Stremio anda sendiri, seperti sebelum profil wujud."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pangunahing profile. Ginagamit nito ang sariling watch history ng iyong Stremio account, gaya noong wala pang profile."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایه اصلی. از تاریخچه تماشای خودِ حساب Stremio شما استفاده می‌کند، مانند زمانی که نمایه‌ها وجود نداشتند."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রধান প্রোফাইল। প্রোফাইল থাকার আগের মতোই, এটি আপনার Stremio অ্যাকাউন্টের নিজের দেখার ইতিহাস ব্যবহার করে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதன்மைச் சுயவிவரம். சுயவிவரங்கள் இருந்த முன்பு போலவே, இது உங்கள் Stremio கணக்கின் சொந்த பார்வை வரலாற்றைப் பயன்படுத்துகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రధాన ప్రొఫైల్. ఇది మీ Stremio ఖాతా స్వంత చూసిన చరిత్రను వాడుతుంది, ప్రొఫైల్‌లు ఉనికిలోకి రాకముందటిలా."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मुख्य प्रोफाइल. प्रोफाइल अस्तित्वात येण्यापूर्वी जसे होते तसे, हे तुमच्या Stremio खात्याचा स्वतःचा पाहण्याचा इतिहास वापरते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મુખ્ય પ્રોફાઇલ. તે તમારા Stremio account નો પોતાનો જોવાનો ઇતિહાસ વાપરે છે, જેમ પ્રોફાઇલ અસ્તિત્વમાં આવ્યા પહેલાં હતું."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಖ್ಯ ಪ್ರೊಫೈಲ್. ಪ್ರೊಫೈಲ್‌ಗಳು ಇರುವ ಮೊದಲಿನಂತೆ, ಇದು ನಿಮ್ಮ Stremio ಖಾತೆಯ ಸ್ವಂತ ವೀಕ್ಷಣಾ ಇತಿಹಾಸವನ್ನು ಬಳಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രധാന പ്രൊഫൈൽ. പ്രൊഫൈലുകൾ നിലവിലുണ്ടാകുന്നതിന് മുമ്പുള്ളതുപോലെ, ഇത് നിങ്ങളുടെ Stremio അക്കൗണ്ടിന്റെ സ്വന്തം കാഴ്ച ചരിത്രം ഉപയോഗിക്കുന്നു."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مرکزی پروفائل۔ یہ آپ کے Stremio اکاؤنٹ کی اپنی دیکھنے کی تاریخ استعمال کرتا ہے، جیسے پروفائلز کے وجود میں آنے سے پہلے تھا۔"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlavný profil. Používa vlastnú históriu sledovania vášho účtu Stremio, ako pred existenciou profilov."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Основният профил. Той използва собствената история на гледане на вашия Stremio акаунт, както преди да съществуват профили."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glavni profil. Koristi vlastitu povijest gledanja vašeg Stremio računa, kao prije postojanja profila."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Главни профил. Користи сопствену историју гледања вашег Stremio налога, као пре него што су профили постојали."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glavni profil. Uporablja zgodovino gledanja vašega računa Stremio, kot je bilo pred obstojem profilov."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagrindinis profilis. Jis naudoja jūsų Stremio paskyros žiūrėjimo istoriją, kaip prieš atsirandant profiliams."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Galvenais profils. Tas izmanto jūsu Stremio konta paša skatīšanās vēsturi, tāpat kā pirms profilu pastāvēšanas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Põhiprofiil. See kasutab su Stremio konto enda vaatamisajalugu, nagu enne profiilide olemasolu."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil principal. Utilitza l'historial de visualització propi del teu compte de Stremio, com abans d'existir els perfils."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil principal. Usa o historial de visualización da túa conta de Stremio, como antes de que existisen os perfís."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil nagusia. Stremio kontuaren ikusteko historia propioa erabiltzen du, profilak existitu baino lehen bezala."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die hoofprofiel. Dit gebruik jou Stremio-rekening se eie kykvorderings, soos voor profiele bestaan het."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əsas profil. Profillər mövcud olmadan əvvəlki kimi öz Stremio hesabınızın izlənmə tarixçəsindən istifadə edir."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Profili kryesor. Përdor historinë e shikimit të llogarisë suaj Stremio, si para se profilet të ekzistonin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðalprófíllinn. Hann notar eigin horfuferil Stremio-reikningsins þíns, eins og áður en prófílar voru."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Главниот профил. Ја користи сопствената историја на гледање на вашата Stremio сметка, како пред да постоеле профили."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasifu mkuu. Unatumia historia ya kutazama ya akaunti yako ya Stremio yenyewe, kama ilivyokuwa kabla ya wasifu kuwepo."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Негізгі профиль. Бұл профильдер пайда болғанға дейінгідей Stremio тіркелгіңіздің жеке қараушы тарихын пайдаланады."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հիմնական պրոֆիլ։ Այն օգտագործում է ձեր Stremio հաշվի սեփական դիտման պատմությունը, ինչպես մինչ պրոֆիլների ստեղծումը։"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მთავარი პროფილი. ის იყენებს Stremio ანგარიშის საკუთარ ყურების ისტორიას, ისევე, როგორც პროფილების არსებობამდე."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੁੱਖ ਪ੍ਰੋਫ਼ਾਈਲ। ਇਹ ਤੁਹਾਡੇ Stremio ਖਾਤੇ ਦਾ ਆਪਣਾ ਵੇਖਣ ਇਤਿਹਾਸ ਵਰਤਦੀ ਹੈ, ਜਿਵੇਂ ਪ੍ਰੋਫ਼ਾਈਲਾਂ ਤੋਂ ਪਹਿਲਾਂ ਸੀ।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "मुख्य प्रोफाइल। यसले तपाईंको Stremio खाताको आफ्नै हेर्ने इतिहास प्रयोग गर्छ, जसरी प्रोफाइल अस्तित्वमा आउनु अगाडि थियो।"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ዋናው መገለጫ። ከ Stremio መለያ የራሱ የሰዓት ታሪክ ይጠቀማሉ፣ ከቀደም እንደነበሩ።"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រវត្តិរូបចម្បង។ វាប្រើប្រវត្តិមើលផ្ទាល់ខ្លួនរបស់គណនី Stremio របស់អ្នក ដូចមុនពេលប្រវត្តិរូបមានសារ៍ស្ទូ។"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "মুখ্য প্ৰ'ফাইল। ই আপোনাৰ Stremio একাউণ্টৰ নিজৰ চোৱাৰ ইতিহাস ব্যৱহাৰ কৰে, প্ৰ'ফাইল থকাৰ আগৰ দৰে।"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Асноўны профіль. Ён выкарыстоўвае ўласную гісторыю прагляду вашага акаўнта Stremio, як да з'яўлення профіляў."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "An aelad pennañ. Implijout a ra istor sellet ho kont Stremio ho-unan, evel a-raok ma oa aeladoù."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Glavni profil. Koristi vlastitu historiju gledanja vašeg Stremio računa, kao prije nego što su profili postojali."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang panguna nga profile. Naggamit kini sa kaugalingong watch history sa imong Stremio account, sama sa una nga wala pa ang mga profile."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Y prif broffil. Mae'n defnyddio hanes gwylio eich cyfrif Stremio ei hun, fel cyn i broffiliau fodoli."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Høvuðsvangamyndin. Hon brúkar egnu hyggisøguna hjá Stremio-kontu tíni, líkasum áðrenn vangamyndir vóru til."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "It haadprofyl. It brûkt de eigen sjochskiednis fan jo Stremio-akkount, sa as foardat profilen bestiene."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "An phríomhphróifíl. Úsáideann sé stair féachana do chuntais Stremio féin, cosúil le sula raibh próifílí ann."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "A' phrìomh phròifil. Cleachdaidh i eachdraidh coimhid a' chunntais Stremio agad fhèin, mar a bha e mus robh pròifilean ann."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babban bayanin martaba. Yana amfani da tarihin kallo na asusunka na Stremio, kamar kafin bayanan martaba su kasance."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Pwofil prensipal la. Li sèvi ak istorik gade pwòp kont Stremio ou an, tankou anvan pwofil yo te egziste."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Profaịlụ isi. Ọ na-eji akụkọ nlele nke akaụntụ Stremio gị, dị ka tupu profaịlụ adịrị."
          }
        },
        "jv": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil utama. Nggunakké riwayat tonton akun Stremio sampeyan dhéwé, kaya sadurungé ana profil."
          }
        },
        "ku": {
          "stringUnit": {
            "state": "translated",
            "value": "Profîla sereke. Ew dîroka temaşekirina hesabê te yê Stremio bikar tîne, wek berî ku profîl hebûn."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Негизги профиль. Ал профилдер пайда болгонго чейинки сыяктуу, Stremio аккаунтуңуздун өз көрүү тарыхын колдонот."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Haaptprofil. Hie benotzt déi eege Kucks-Historik vun dengem Stremio-Kont, wéi virun der Zäit vun de Profiler."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂປຣໄຟລ໌ຫຼັກ. ມັນໃຊ້ປະຫວັດການເບິ່ງຂອງບັນຊີ Stremio ຂອງທ່ານເອງ, ຄືກັບກ່ອນທີ່ຈະມີໂປຣໄຟລ໌."
          }
        },
        "mg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ny profil fototra. Mampiasa ny tantaram-pijerena manokan'ny kaonty Stremio-nao izy, toy ny talohan'ny nisian'ny profil."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Te kōtaha matua. Ka whakamahi i te hītori mātakitaki ake o tō pūkete Stremio, pēnei i mua i te oranga o ngā kōtaha."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үндсэн профайл. Профайл гарахаас өмнөх шиг таны Stremio дансны өөрийн үзсэн түүхийг ашигладаг."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-profil prinċipali. Juża l-istorja tal-wiri tal-kont Stremio tiegħek stess, bħal qabel ma kien hemm il-profili."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အဓိကပရိုဖိုင်။ ၎င်းသည် ပရိုဖိုင်များ မတည်ရှိမီကဲ့သို့ သင့် Stremio အကောင့်၏ ကိုယ်ပိုင် ကြည့်ရှုမှုမှတ်တမ်းကို သုံးသည်။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile yaikulu. Imagwiritsa ntchito mbiri ya kuwonera ya akaunti yanu ya Stremio, monga ma profile asanakhalepo."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo perfil principal. Utiliza l'istoric de visionatge pròpri de vòstre compte Stremio, coma abans qu'existiguèsson los perfils."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମୁଖ୍ୟ ପ୍ରୋଫାଇଲ। ପ୍ରୋଫାଇଲ ଥିବା ପୂର୍ବ ପରି, ଏହା ଆପଣଙ୍କ Stremio ଆକାଉଣ୍ଟର ନିଜର ୱାଚ୍ ଇତିହାସ ବ୍ୟବହାର କରେ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "اصلي پروفایل. دا ستاسو د Stremio حساب خپله د کتلو تاریخچه کاروي، لکه د پروفایلونو له شتون مخکې."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Umwirondoro w'ingenzi. Ukoresha amateka bwite yo kureba ya konti yawe ya Stremio, nk'uko byari mbere y'uko imyirondoro ibaho."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "مکيه پروفائل. اهو اوهان جي Stremio اڪائونٽ جي پنھنجي ڏسڻ جي تاريخ استعمال ڪري ٿو، جيئن پروفائل هئڻ کان اڳ هوندو هو."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ප්‍රධාන පැතිකඩ. පැතිකඩ පැවතීමට පෙර මෙන්, එය ඔබේ Stremio ගිණුමේම නැරඹීම් ඉතිහාසය භාවිත කරයි."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "O le tala faasino patino autu. E faaaoga ai lava tala faasolopito o le matamata a lau tala Stremio, e pei ona i ai muamua ao lei iai tala faasino patino."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "Purofaira huru. Inoshandisa nhoroondo yokuona yega ye account yako yeStremio, sezvazvakanga zvakaita maprofaira asati avapo."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile-ka weyn. Wuxuu isticmaalaa taariikhda daawashada u gaarka ah ee akoonkaaga Stremio, sidii ka hor inta profile-yadu jireen."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "Profaele e ka sehloohong. E sebelisa nalane ea akhaonto ea hau ea Stremio ea ho shebella, joalo ka pele liprofaele li e-ba teng."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil utama. Éta maké riwayat lalajo akun Stremio anjeun sorangan, saperti saméméh aya profil."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Профили асосӣ. Он таърихи тамошои худи ҳисоби Stremio-и шуморо истифода мебарад, мисли пеш аз он ки профилҳо вуҷуд дошта бошанд."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Төп профиль. Ул Stremio хисабыңның үз карау тарихын куллана, профильләр барлыкка килгәнче булган кебек."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ئاساسىي سەپلىمە. ئۇ سەپلىمىلەر پەيدا بولۇشتىن بۇرۇنقىغا ئوخشاش، Stremio ھېساباتىڭىزنىڭ ئۆز كۆرۈش تارىخىنى ئىشلىتىدۇ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Asosiy profil. U profillar paydo bo'lishidan oldingidek, Stremio hisobingizning o'z ko'rish tarixidan foydalanadi."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "Iprofayile eyintloko. Isebenzisa imbali yokubukela yeakhawunti yakho yeStremio, njengaphambi kokuba iiprofayile zibekho."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Profaìlì àkọ́kọ́. Ó máa ń lo ìtàn ìwò tí àkàwé Stremio rẹ ní, bíi kí àwọn profaìlì tó wà."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Iphrofayela eyinhloko. Isebenzisa umlando wokubuka we-akhawunti yakho ye-Stremio, njengangaphambi kokuthi kube khona amaphrofayela."
          }
        }
      }
    },
    "The player auto-picks these when a title starts. Forced shows only foreign-dialogue captions; Always shows full subtitles in your language. Foreign-language titles always get full subtitles so you can follow.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il lettore li seleziona automaticamente all'avvio di un titolo. Forzati mostra solo i sottotitoli dei dialoghi in lingua straniera; Sempre mostra i sottotitoli completi nella tua lingua. I titoli in lingua straniera ricevono sempre i sottotitoli completi così puoi seguirli."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reproductor los selecciona automáticamente al empezar un título. Forzados muestra solo los subtítulos de diálogos en idioma extranjero; Siempre muestra los subtítulos completos en tu idioma. Los títulos en idioma extranjero siempre reciben subtítulos completos para que puedas seguirlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lecteur les sélectionne automatiquement au démarrage d'un titre. Forcés affiche uniquement les sous-titres des dialogues en langue étrangère ; Toujours affiche les sous-titres complets dans votre langue. Les titres en langue étrangère reçoivent toujours des sous-titres complets pour que vous puissiez suivre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Player wählt diese automatisch aus, wenn ein Titel startet. „Erzwungen“ zeigt nur Untertitel für fremdsprachige Dialoge; „Immer“ zeigt vollständige Untertitel in deiner Sprache. Fremdsprachige Titel erhalten immer vollständige Untertitel, damit du folgen kannst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O player escolhe estas automaticamente quando um título inicia. Forçadas mostra apenas as legendas de diálogos em outros idiomas; Sempre mostra legendas completas no seu idioma. Títulos em idioma estrangeiro sempre recebem legendas completas para você acompanhar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトル開始時にプレーヤーがこれらを自動選択します。「強制」は外国語のセリフのキャプションのみを表示し、「常に」は使用言語のフル字幕を表示します。外国語のタイトルには、内容を追えるよう常にフル字幕が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이어는 작품이 시작될 때 이를 자동으로 선택합니다. 강제는 외국어 대사 자막만 표시하고, 항상은 사용 언어로 전체 자막을 표시합니다. 외국어 작품은 따라갈 수 있도록 항상 전체 자막이 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放器在影片开始时会自动选择这些。强制只显示外语对白字幕；始终会以你的语言显示完整字幕。外语影片始终会获得完整字幕，以便你跟上剧情。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плеер автоматически выбирает их при запуске тайтла. «Форсированные» показывают только субтитры для иностранной речи; «Всегда» показывает полные субтитры на вашем языке. Иноязычные тайтлы всегда получают полные субтитры, чтобы вы могли следить за сюжетом."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइटल शुरू होने पर प्लेयर इन्हें स्वतः चुन लेता है। बाध्य केवल विदेशी-संवाद के कैप्शन दिखाता है; हमेशा आपकी भाषा में पूरे सबटाइटल दिखाता है। विदेशी-भाषा वाले टाइटल को हमेशा पूरे सबटाइटल मिलते हैं ताकि आप समझ सकें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يختار المشغّل هذه تلقائيًا عند بدء عنوان. يعرض الوضع المفروض تعليقات الحوار الأجنبي فقط؛ ويعرض الوضع الدائم الترجمة الكاملة بلغتك. تحصل العناوين الأجنبية اللغة دائمًا على ترجمة كاملة لتتمكن من المتابعة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir başlık başladığında oynatıcı bunları otomatik seçer. Zorunlu yalnızca yabancı diyalog altyazılarını gösterir; Her Zaman ise kendi dilinizde tam altyazıları gösterir. Yabancı dildeki başlıklar takip edebilmeniz için her zaman tam altyazı alır."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O leitor escolhe estas automaticamente quando um título começa. Forçadas mostra apenas as legendas de diálogos em língua estrangeira; Sempre mostra legendas completas no seu idioma. Os títulos em língua estrangeira recebem sempre legendas completas para que possa acompanhar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De speler kiest deze automatisch wanneer een titel start. Geforceerd toont alleen ondertitels voor vreemdtalige dialogen; Altijd toont volledige ondertiteling in jouw taal. Vreemdtalige titels krijgen altijd volledige ondertiteling zodat je het kunt volgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzacz dobiera je automatycznie po uruchomieniu tytułu. Wymuszone pokazuje tylko napisy do obcojęzycznych dialogów; Zawsze pokazuje pełne napisy w Twoim języku. Tytuły obcojęzyczne zawsze otrzymują pełne napisy, abyś mógł śledzić akcję."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelaren väljer dessa automatiskt när en titel startar. Forcerade visar bara undertexter för främmande dialog; Alltid visar fullständiga undertexter på ditt språk. Titlar på främmande språk får alltid fullständiga undertexter så att du kan följa med."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放器會在片名開始時自動挑選這些。「強制」只顯示外語對白的字幕；「一律」則顯示你語言的完整字幕。外語片名一律會取得完整字幕，讓你能跟上劇情。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemutar memilih ini secara otomatis saat judul dimulai. Forced hanya menampilkan teks dialog bahasa asing; Selalu menampilkan subtitle penuh dalam bahasa Anda. Judul berbahasa asing selalu mendapat subtitle penuh agar Anda dapat mengikutinya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเล่นจะเลือกสิ่งเหล่านี้โดยอัตโนมัติเมื่อเรื่องเริ่มเล่น บังคับจะแสดงเฉพาะคำบรรยายบทสนทนาภาษาต่างประเทศ เสมอจะแสดงคำบรรยายเต็มในภาษาของคุณ เรื่องภาษาต่างประเทศจะได้คำบรรยายเต็มเสมอเพื่อให้คุณติดตามได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình phát tự động chọn các mục này khi một tựa đề bắt đầu. Bắt buộc chỉ hiển thị phụ đề cho lời thoại tiếng nước ngoài; Luôn hiển thị phụ đề đầy đủ bằng ngôn ngữ của bạn. Các tựa đề tiếng nước ngoài luôn được hiển thị phụ đề đầy đủ để bạn theo dõi được."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плеєр автоматично вибирає їх на старті тайтлу. Примусові показують лише підписи до іншомовних діалогів; Завжди показують повні субтитри вашою мовою. Іншомовні тайтли завжди отримують повні субтитри, щоб ви могли стежити."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehrávač je při spuštění titulu vybere automaticky. Vynucené zobrazí jen titulky cizojazyčných dialogů; Vždy zobrazí plné titulky ve vašem jazyce. Cizojazyčné tituly vždy dostanou plné titulky, abyste je mohli sledovat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναπαραγωγή τα επιλέγει αυτόματα όταν ξεκινά ένας τίτλος. Το Εξαναγκασμένο εμφανίζει μόνο λεζάντες ξενόγλωσσων διαλόγων· το Πάντα εμφανίζει πλήρεις υπότιτλους στη γλώσσα σας. Οι ξενόγλωσσοι τίτλοι λαμβάνουν πάντα πλήρεις υπότιτλους ώστε να μπορείτε να παρακολουθήσετε."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנגן בוחר אותם אוטומטית כשכותר מתחיל. כפוי מציג רק כתוביות לדיאלוג בשפה זרה; תמיד מציג כתוביות מלאות בשפה שלך. כותרים בשפה זרה תמיד מקבלים כתוביות מלאות כדי שתוכל לעקוב."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspilleren vælger automatisk disse, når en titel starter. Tvungen viser kun undertekster til fremmedsproget dialog; Altid viser fulde undertekster på dit sprog. Fremmedsprogede titler får altid fulde undertekster, så du kan følge med."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soitin valitsee nämä automaattisesti, kun nimike käynnistyy. Pakotettu näyttää vain vieraskielisen dialogin tekstitykset; Aina näyttää täydet tekstitykset kielelläsi. Vieraskieliset nimikkeet saavat aina täydet tekstitykset, jotta pysyt mukana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilleren velger disse automatisk når en tittel starter. Tvungen viser bare undertekster for fremmedspråklig dialog; Alltid viser fulle undertekster på ditt språk. Fremmedspråklige titler får alltid fulle undertekster så du kan følge med."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Playerul le alege automat când pornește un titlu. Forțate afișează doar subtitrările pentru dialogul străin; Întotdeauna afișează subtitrări complete în limba ta. Titlurile în limbi străine primesc întotdeauna subtitrări complete ca să le poți urmări."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lejátszó automatikusan ezeket választja egy cím indításakor. A Kényszerített csak az idegen nyelvű párbeszédek feliratait mutatja; a Mindig a teljes feliratot a nyelveden. Az idegen nyelvű címek mindig teljes feliratot kapnak, hogy követhesd."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemain memilih ini secara automatik apabila tajuk bermula. Dipaksa menunjukkan hanya kapsyen dialog asing; Sentiasa menunjukkan sari kata penuh dalam bahasa anda. Tajuk bahasa asing sentiasa mendapat sari kata penuh supaya anda boleh mengikuti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Awtomatikong pinipili ng player ang mga ito kapag nagsimula ang isang titulo. Ipinapakita ng Forced ang mga caption para lamang sa banyagang dialogo; Ipinapakita ng Always ang buong subtitle sa iyong wika. Ang mga titulong banyaga ang wika ay palaging may buong subtitle para makasunod ka."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پخش‌کننده هنگام شروع یک عنوان، این‌ها را به‌طور خودکار انتخاب می‌کند. اجباری فقط زیرنویس گفت‌وگوهای خارجی را نشان می‌دهد؛ همیشه زیرنویس کامل را به زبان شما نشان می‌دهد. عنوان‌های با زبان خارجی همیشه زیرنویس کامل دریافت می‌کنند تا بتوانید دنبال کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো শিরোনাম শুরু হলে প্লেয়ার এগুলো স্বয়ংক্রিয়ভাবে বেছে নেয়। Forced শুধু বিদেশি-সংলাপের ক্যাপশন দেখায়; Always আপনার ভাষায় সম্পূর্ণ সাবটাইটেল দেখায়। বিদেশি-ভাষার শিরোনাম সবসময় সম্পূর্ণ সাবটাইটেল পায় যাতে আপনি অনুসরণ করতে পারেন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தலைப்பு தொடங்கும்போது பிளேயர் இவற்றைத் தானாகத் தேர்ந்தெடுக்கும். கட்டாயம் வெளிநாட்டு-உரையாடல் வசன வரிகளை மட்டும் காட்டும்; எப்போதும் உங்கள் மொழியில் முழு வசன வரிகளைக் காட்டும். வெளிமொழித் தலைப்புகளுக்கு நீங்கள் பின்தொடரும்படி எப்போதும் முழு வசன வரிகள் கிடைக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టైటిల్ ప్రారంభమైనప్పుడు ప్లేయర్ వీటిని స్వయంచాలకంగా ఎంచుకుంటుంది. Forced విదేశీ-సంభాషణ క్యాప్షన్‌లను మాత్రమే చూపుతుంది; Always మీ భాషలో పూర్తి సబ్‌టైటిల్‌లను చూపుతుంది. విదేశీ-భాషా టైటిల్‌లకు మీరు అనుసరించగలిగేలా ఎల్లప్పుడూ పూర్తి సబ్‌టైటిల్‌లు వస్తాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षक सुरू होताना प्लेअर हे आपोआप निवडतो. Forced फक्त परदेशी-संवादाची कॅप्शन दाखवते; Always तुमच्या भाषेतील संपूर्ण उपशीर्षके दाखवते. परदेशी-भाषेतील शीर्षकांना नेहमी संपूर्ण उपशीर्षके मिळतात जेणेकरून तुम्ही समजू शकाल."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શીર્ષક શરૂ થાય ત્યારે પ્લેયર આ આપમેળે પસંદ કરે છે. Forced ફક્ત વિદેશી-સંવાદના કૅપ્શન બતાવે છે; Always તમારી ભાષામાં સંપૂર્ણ સબટાઇટલ બતાવે છે. વિદેશી-ભાષાના શીર્ષકોને હંમેશા સંપૂર્ણ સબટાઇટલ મળે છે જેથી તમે સમજી શકો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಶೀರ್ಷಿಕೆ ಪ್ರಾರಂಭವಾದಾಗ ಪ್ಲೇಯರ್ ಇವುಗಳನ್ನು ಸ್ವಯಂ-ಆಯ್ಕೆ ಮಾಡುತ್ತದೆ. ಫೋರ್ಸ್ಡ್ ವಿದೇಶಿ-ಸಂಭಾಷಣೆಯ ಕ್ಯಾಪ್ಶನ್‌ಗಳನ್ನು ಮಾತ್ರ ತೋರಿಸುತ್ತದೆ; ಯಾವಾಗಲೂ ನಿಮ್ಮ ಭಾಷೆಯಲ್ಲಿ ಪೂರ್ಣ ಸಬ್‌ಟೈಟಲ್‌ಗಳನ್ನು ತೋರಿಸುತ್ತದೆ. ವಿದೇಶಿ-ಭಾಷೆಯ ಶೀರ್ಷಿಕೆಗಳಿಗೆ ಯಾವಾಗಲೂ ಪೂರ್ಣ ಸಬ್‌ಟೈಟಲ್‌ಗಳು ಸಿಗುತ್ತವೆ ಇದರಿಂದ ನೀವು ಅನುಸರಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ടൈറ്റിൽ ആരംഭിക്കുമ്പോൾ പ്ലെയർ ഇവ സ്വയമേവ തിരഞ്ഞെടുക്കുന്നു. Forced വിദേശ-സംഭാഷണ ക്യാപ്ഷനുകൾ മാത്രം കാണിക്കുന്നു; Always നിങ്ങളുടെ ഭാഷയിലെ പൂർണ്ണ സബ്ടൈറ്റിലുകൾ കാണിക്കുന്നു. വിദേശ-ഭാഷാ ടൈറ്റിലുകൾക്ക് നിങ്ങൾക്ക് പിന്തുടരാൻ കഴിയുന്ന വിധം എപ്പോഴും പൂർണ്ണ സബ്ടൈറ്റിലുകൾ ലഭിക്കും."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان شروع ہونے پر پلیئر انہیں خود بخود منتخب کرتا ہے۔ مجبوری صرف غیر ملکی-مکالمے کے کیپشنز دکھاتی ہے؛ ہمیشہ آپ کی زبان میں مکمل سب ٹائٹلز دکھاتی ہے۔ غیر ملکی زبان کے عنوانات کو ہمیشہ مکمل سب ٹائٹلز ملتے ہیں تاکہ آپ سمجھ سکیں۔"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prehrávač ich automaticky vyberie pri spustení titulu. Vynútené zobrazuje len titulky cudzojazyčných dialógov; Vždy zobrazuje plné titulky vo vašom jazyku. Cudzojazyčné tituly vždy dostanú plné titulky, aby ste ich mohli sledovať."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Плейърът избира автоматично тези при стартиране на заглавие. Принудителни показва само надписи за чуждоезични диалози; Винаги показва пълни субтитри на вашия език. Чуждоезичните заглавия винаги получават пълни субтитри, за да можете да следите."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Player ih automatski odabire kad naslov krene. Prisilno prikazuje samo titlove dijaloga na stranom jeziku; Uvijek prikazuje pune titlove na vašem jeziku. Naslovi na stranom jeziku uvijek dobivaju pune titlove kako biste mogli pratiti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Плејер их аутоматски бира када наслов почне. Принудни приказује само титлове за дијалоге на страном језику; Увек приказује пуне титлове на вашем језику. Наслови на страном језику увек добијају пуне титлове како бисте могли да пратите."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predvajalnik te samodejno izbere ob zagonu naslova. Vsiljeno prikaže samo napise tujih dialogov; Vedno prikaže polne podnapise v vašem jeziku. Tujejezični naslovi vedno dobijo polne podnapise, da lahko sledite."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grotuvas automatiškai juos parenka paleidus kūrinį. Priverstiniai rodo tik užsienio kalbos dialogų subtitrus; Visada rodo pilnus subtitrus jūsų kalba. Užsienio kalbos kūriniai visada gauna pilnus subtitrus, kad galėtumėte sekti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atskaņotājs tos automātiski izvēlas, kad sākas nosaukums. Piespiestie rāda tikai svešvalodas dialogu parakstus; Vienmēr rāda pilnus subtitrus jūsu valodā. Svešvalodu nosaukumi vienmēr saņem pilnus subtitrus, lai jūs varētu sekot līdzi."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mängija valib need automaatselt, kui pealkiri käivitub. Sundtud kuvab ainult võõrkeelse dialoogi subtiitrid; Alati kuvab täissubtiitrid su keeles. Võõrkeelsed pealkirjad saavad alati täissubtiitrid, et saaksid järge pidada."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El reproductor selecciona automàticament aquests quan s'inicia un títol. Forçat mostra només els subtítols de diàleg en llengua estrangera; Sempre mostra els subtítols complets en el teu idioma. Els títols en llengua estrangera sempre reben subtítols complets perquè puguis seguir-los."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O reprodutor escolle automaticamente estas opcións cando comeza un título. Forzado mostra só os subtítulos de diálogos estranxeiros; Sempre mostra subtítulos completos no teu idioma. Os títulos en idioma estranxeiro sempre teñen subtítulos completos para que os poidas seguir."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreproduzitzaileak automatikoki hautatzen ditu hauek titulu bat hasten denean. Behartuak atzerriko elkarrizketaren azpitituluak soilik erakusten ditu; Beti zure hizkuntzan azpitituluak erakusten ditu. Atzerriko hizkuntzetako tituluek beti azpititulu osoak jasotzen dituzte jarraitu ahal izateko."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die speler kies hierdie outomaties wanneer 'n titel begin. Forseer wys slegs byskrifte vir buitelandse dialoog; Altyd wys volledige onderskrifte in jou taal. Buitelanders-taal titels kry altyd volledige onderskrifte sodat jy kan volg."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynatıcı, bir başlıq başladığında bunları avtomatik seçir. Məcburi yalnız xarici dialoqun altyazılarını göstərir; Həmişə dilinizde tam altyazılar göstərir. Xarici dilli başlıqlarda izləyə biləsiniz deyə həmişə tam altyazılar olur."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Luajtësi i zgjedh automatikisht këto kur fillon një titull. E Detyruar tregon vetëm titrat e dialogut të huaj; Gjithmonë tregon titrat e plota në gjuhën tuaj. Titujt në gjuhë të huaj marrin gjithmonë titrat e plota që ta ndiqni."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilarinn velur þessa sjálfkrafa þegar titill byrjar. Þvingað sýnir aðeins texta fyrir erlend samræður; Alltaf sýnir fulla skjátexta á tungumálinu þínu. Titlar á erlendum tungumálum fá alltaf fulla skjátexta svo þú getir fylgst með."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плеерот автоматски ги избира овие кога започнува наслов. Принудно прикажува само титлови за странски дијалог; Секогаш прикажува целосни титлови на вашиот јазик. Насловите на странски јазик секогаш добиваат целосни титлови за да можете да следите."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mchezaji huchagua hizi otomatiki wakati kichwa kinapoanza. Iliyolazimishwa inaonyesha manukuu ya mazungumzo ya kigeni peke yake; Daima inaonyesha manukuu kamili katika lugha yako. Vichwa vya lugha ya kigeni daima huwa na manukuu kamili ili uweze kufuatilia."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ойнатқыш атау басталғанда осыларды автоматты таңдайды. Мәжбүрлі тек шетел диалог субтитрлерін көрсетеді; Әрдайым тіліңіздегі толық субтитрлерді көрсетеді. Шет тіліндегі атаулар барлық уақытта толық субтитрлер алады."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նվագարկիչն ավտոմատ ընտրում է սրանք, երբ վերնագիրը սկսվում է։ «Հարկադիր»-ը ցուցադրում է միայն արտաքին երկխոսության ենթագրեր. «Միշտ»-ը ձեր լեզվով ամբողջ ենթագրեր է ցուցադրում։ Արտասահմանյան լեզվի վերնագրերն ամբողջ ենթագրեր են ստանում, որ կարողանաք հետևել։"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პლეერი ავტომატურად ირჩევს მათ სათაურის დაწყებისას. იძულებითი აჩვენებს მხოლოდ უცხოური დიალოგის წარწერებს; ყოველთვის აჩვენებს სრულ სუბტიტრებს თქვენ ენაზე. უცხოური ენის სათაურები ყოველთვის ღებულობს სრულ სუბტიტრებს გასაგებად."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਲੇਅਰ ਇਹਨਾਂ ਨੂੰ ਆਪਣੇ ਆਪ ਚੁਣਦਾ ਹੈ ਜਦੋਂ ਕੋਈ ਸਿਰਲੇਖ ਸ਼ੁਰੂ ਹੁੰਦਾ ਹੈ। ਲਾਜ਼ਮੀ ਸਿਰਫ਼ ਵਿਦੇਸ਼ੀ-ਸੰਵਾਦ ਕੈਪਸ਼ਨ ਦਿਖਾਉਂਦਾ ਹੈ; ਹਮੇਸ਼ਾ ਤੁਹਾਡੀ ਭਾਸ਼ਾ ਵਿੱਚ ਪੂਰੇ ਸਬਟਾਈਟਲ ਦਿਖਾਉਂਦਾ ਹੈ। ਵਿਦੇਸ਼ੀ ਭਾਸ਼ਾ ਦੇ ਸਿਰਲੇਖਾਂ ਨੂੰ ਹਮੇਸ਼ਾ ਪੂਰੇ ਸਬਟਾਈਟਲ ਮਿਲਦੇ ਹਨ ਤਾਂ ਜੋ ਤੁਸੀਂ ਸਮਝ ਸਕੋ।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षक सुरु हुँदा प्लेयरले यीहरू स्वचालित रूपमा छनोट गर्छ। Forced ले केवल विदेशी-संवाद क्याप्शन देखाउँछ; Always ले तपाईंको भाषामा पूर्ण उपशीर्षक देखाउँछ। विदेशी-भाषाका शीर्षकहरूले सधैं पूर्ण उपशीर्षक पाउँछन् ताकि तपाईं अनुसरण गर्न सक्नुहोस्।"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ርዕሱ ሲጀምር ተጫዋቹ ራስ ሰር ይምረጣቸዋሉ። «ያስፈለገ» ብቻ የውጭ-ቋንቋ ምልክቶችን ያሳያሉ፤ «ሁልጊዜ» ሙሉ ርዕሶቹ በቋንቋዎ ያሳያሉ። የውጭ ቋንቋ ርዕሶች ሁልጊዜ ሙሉ ርዕሶቹ ያገኛሉ ልትከተሉ ትችሉ ዘንድ።"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "player ជ្រើសរើសដោយស្វ័យប្រវត្តិទាំងនេះពេលចំណងជើងចាប់ផ្តើម។ Forced បង្ហាញតែចំណងក្រោមការសន្ទនាបរទេស; Always បង្ហាញចំណងក្រោមពេញលេញជាភាសារបស់អ្នក។ ចំណងជើងភាសាបរទេសតែងតែទទួលបានចំណងក្រោមពេញលេញ ដើម្បីឱ្យអ្នកអាចដើរតាម។"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এটা শিৰোনাম আৰম্ভ হ'লে প্লেয়াৰে এইবোৰ স্বয়ংক্ৰিয়ভাৱে বাছে। Forced-এ কেৱল বিদেশী-সংলাপৰ কেপচন দেখুৱায়; Always-এ আপোনাৰ ভাষাত সম্পূৰ্ণ চাবটাইটেল দেখুৱায়। বিদেশী-ভাষাৰ শিৰোনামবোৰে সদায় সম্পূৰ্ণ চাবটাইটেল পায় যাতে আপুনি বুজিব পাৰে।"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прайгравальнік аўтаматычна выбірае іх пры запуску тайтла. Прымусовыя паказваюць толькі субтытры замежнага дыялогу; Заўсёды паказвае поўныя субтытры на вашай мове. Тайтлы на замежнай мове заўсёды атрымліваюць поўныя субтытры, каб вы маглі сачыць."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar c'hoarier a zibab ar re-mañ emgefreek pa grog un titl. Rediet a ziskouez hepken istitloù an divizoù estren; Bepred a ziskouez an istitloù klok en ho yezh. An titloù e yezh estren o deus atav istitloù klok evit ma c'hallit heuliañ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plejer ih automatski bira kada naslov počne. Prisilni prikazuje samo titlove za strane dijaloge; Uvijek prikazuje potpune titlove na vašem jeziku. Naslovi na stranom jeziku uvijek dobijaju potpune titlove da možete pratiti."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang player awtomatik nga mopili niini kung magsugod ang titulo. Ang Forced mopakita lang sa mga caption sa langyaw nga dayalogo; ang Always mopakita og bug-os nga subtitle sa imong pinulongan. Ang langyaw-og-pinulongan nga mga titulo kanunay makakuha og bug-os nga subtitle aron makasabot ka."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae'r chwaraewr yn dewis y rhain yn awtomatig pan fydd teitl yn dechrau. Mae Gorfodol yn dangos capsiynau deialog estron yn unig; mae Bob amser yn dangos isdeitlau llawn yn eich iaith. Mae teitlau iaith estron bob amser yn cael isdeitlau llawn fel y gallwch ddilyn."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Spælarin veljur hesar sjálvvirkið, tá ein titul byrjar. Noydd vísir bara undirtekstir fyri fremmandan samrøðupart; Altíð vísir fullar undirtekstir á máli tínum. Fremmandmæltir titlar fáa altíð fullar undirtekstir, so tú kanst fylgja við."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "De spiler kiest dizze automatysk as in titel begjint. Forsearre toant allinne ûndertiteling foar frjemdtalige dialooch; Altyd toant folsleine ûndertiteling yn jo taal. Frjemdtalige titels krije altyd folsleine ûndertiteling sadat jo it folgje kinne."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaíonn an seinnteoir iad seo go huathoibríoch nuair a thosaíonn teideal. Ní thaispeánann Éigeanta ach fotheidil don chomhrá iasachta; taispeánann I gcónaí fotheidil iomlána i do theanga. Faigheann teidil i dteanga iasachta fotheidil iomlána i gcónaí ionas gur féidir leat leanúint."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Taghaidh an cluicheadair iad seo gu fèin-obrachail nuair a thòisicheas tiotal. Seallaidh Sparraichte fo-thiotalan còmhraidh chèin a-mhàin; seallaidh An-còmhnaidh làn fho-thiotalan sa chànan agad. Gheibh tiotalan cànain chèin làn fho-thiotalan an-còmhnaidh gus an urrainn dhut leantainn."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai kunnawa yana zaɓen waɗannan kai tsaye lokacin da take ya fara. Tilastawa yana nuna fassarar tattaunawar baƙi kawai; Koyaushe yana nuna cikakkun fassarar rubutu a cikin harshenka. Taken harshen baƙi koyaushe suna samun cikakkun fassarar rubutu don ka iya biyewa."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Lektè a chwazi otomatikman sa yo lè yon tit kòmanse. Forse montre sèlman soutit dyalòg etranje; Toujou montre soutit konplè nan lang ou. Tit an lang etranje toujou jwenn soutit konplè pou ou ka swiv."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Onye ọkpụ na-ahọrọ ndị a na-akpaghị aka mgbe aha malitere. Manyere na-egosi naanị ederede mkparịta ụka mba ọzọ; Mgbe Niile na-egosi ndepụta okwu zuru ezu n'asụsụ gị. Aha asụsụ mba ọzọ na-enweta ndepụta okwu zuru ezu mgbe niile ka ị nwee ike ịgbaso."
          }
        },
        "jv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemuter milih iki kanthi otomatis nalika judhul diwiwiti. Forced mung nampilaké teks dialog basa manca; Tansah nampilaké subtitel lengkap ing basa sampeyan. Judhul basa manca tansah entuk subtitel lengkap supaya sampeyan bisa ngetutaké."
          }
        },
        "ku": {
          "stringUnit": {
            "state": "translated",
            "value": "Lîstikvan dema sernavek dest pê dike van otomatîk hildibijêre. Bi zorê tenê jêrnivîsên diyaloga biyanî nîşan dide; Herdem jêrnivîsên tijî bi zimanê te nîşan dide. Sernavên bi zimanê biyanî herdem jêrnivîsên tijî distînin da ku tu bişopînî."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Аталыш башталганда ойноткуч муларды автоматтык тандайт. Мажбурлоо чет тилдеги диалогдордун субтитрлерин гана көрсөтөт; Дайыма тилиңизде толук субтитрлерди көрсөтөт. Чет тилдеги аталыштар кароого мүмкүн болушу үчүн дайыма толук субтитрлерди алат."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "De Player wielt dës automatesch aus, wann en Titel ufänkt. Erzwongen weist nëmmen Ënnertitele fir friem Dialog; Ëmmer weist voll Ënnertitelen an denger Sprooch. Titelen a frieme Sproochen kréien ëmmer voll Ënnertitelen, sou datt s du matverfolge kanns."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຕົວຫຼິ້ນຈະເລືອກສິ່ງເຫຼົ່ານີ້ໂດຍອັດຕະໂນມັດເມື່ອເລື່ອງເລີ່ມ. Forced ຈະສະແດງແຕ່ຄຳບັນຍາຍບົດສົນທະນາພາສາຕ່າງປະເທດ; Always ຈະສະແດງຄຳບັນຍາຍເຕັມໃນພາສາຂອງທ່ານ. ເລື່ອງພາສາຕ່າງປະເທດຈະໄດ້ຄຳບັນຍາຍເຕັມສະເໝີ ເພື່ອໃຫ້ທ່ານຕິດຕາມໄດ້."
          }
        },
        "mg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ny player dia misafidy ireto ho azy rehefa manomboka ny lohateny iray. Ny Forced dia maneho ny soratra ho an'ny resaka vahiny ihany; ny Always dia maneho dikanteny feno amin'ny teninao. Ny lohateny amin'ny teny vahiny dia mahazo dikanteny feno foana mba hahafahanao manaraka."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka kōwhiri aunoa te pūtangi i ēnei ina tīmata he taitara. Ka whakaatu te Kōkuku i ngā tapanga kōrero-tāwāhi anake; ka whakaatu te I ngā wā katoa i ngā hauraro katoa i tō reo. Ka whiwhi tonu ngā taitara reo-tāwāhi i ngā hauraro katoa kia taea ai e koe te whai."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Контент эхлэх үед тоглуулагч эдгээрийг автоматаар сонгоно. Албадсан нь зөвхөн гадаад хэлний ярианы хадмалыг харуулна; Үргэлж нь таны хэл дээр бүрэн хадмалыг харуулна. Гадаад хэлний контентууд таныг дагахад бүрэн хадмал үргэлж авдаг."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-player jagħżel dawn awtomatikament meta jibda titlu. Forced juri biss il-captions tad-djalogu barrani; Always juri sottotitli sħaħ fil-lingwa tiegħek. Titli b'lingwa barranija dejjem jieħdu sottotitli sħaħ biex tkun tista' ssegwi."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ခေါင်းစဉ်တစ်ခု စတင်သည့်အခါ player သည် ၎င်းတို့ကို အလိုအလျောက် ရွေးသည်။ Forced သည် နိုင်ငံခြားစကားပြော စာတန်းများကိုသာ ပြသည်၊ Always သည် သင့်ဘာသာစကားဖြင့် စာတန်းထိုးအပြည့်အစုံ ပြသည်။ နိုင်ငံခြားဘာသာစကား ခေါင်းစဉ်များသည် သင်နားလည်နိုင်ရန် အမြဲ စာတန်းထိုးအပြည့်အစုံ ရရှိသည်။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "Player imasankha izi zokha mutu ukayamba. Forced imawonetsa zolembedwa za zokambirana za chilankhulo china zokha; Always imawonetsa zolembedwa zonse mu chilankhulo chanu. Mitu ya zilankhulo zina nthawi zonse imapeza zolembedwa zonse kuti muzitha kutsatira."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo lector los causís automaticament quand un títol comença. Forçats aficha pas que los sostítols dels dialògs en lenga estrangièra ; Totjorn aficha los sostítols complets dins vòstra lenga. Los títols en lenga estrangièra recebon totjorn de sostítols complets per que pòscatz seguir."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ଟାଇଟଲ ଆରମ୍ଭ ହେଲେ ପ୍ଲେୟାର ଏଗୁଡ଼ିକୁ ସ୍ୱୟଂଚାଳିତ ଭାବେ ବାଛେ। Forced କେବଳ ବିଦେଶୀ-ସଂଳାପ କ୍ୟାପସନ ଦେଖାଏ; Always ଆପଣଙ୍କ ଭାଷାରେ ପୂର୍ଣ୍ଣ ସବଟାଇଟଲ ଦେଖାଏ। ବିଦେଶୀ-ଭାଷା ଟାଇଟଲ ସର୍ବଦା ପୂର୍ଣ୍ଣ ସବଟାଇଟଲ ପାଏ ଯାହା ଫଳରେ ଆପଣ ଅନୁସରଣ କରିପାରିବେ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "غږوونکی د سرلیک په پیلولو سره دا په اتومات ډول ټاکي. اجباري یوازې د بهرنۍ خبرو زیرنوشتونه ښیي؛ تل ستاسو په ژبه بشپړ زیرنوشتونه ښیي. بهرنۍ-ژبه سرلیکونه تل بشپړ زیرنوشتونه ترلاسه کوي چې تاسو یې تعقیبولی شئ."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Player ihitamo ibi mu buryo bwikora igihe insanganyamatsiko itangiye. Forced yerekana gusa amagambo agaragara y'ibiganiro by'amahanga; Buri gihe yerekana amagambo agaragara yuzuye mu rurimi rwawe. Insanganyamatsiko z'ururimi rw'amahanga buri gihe zibona amagambo agaragara yuzuye kugira ngo ukurikire."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "جڏهن ڪو عنوان شروع ٿئي ٿو ته پليئر اهي خودڪار چونڊي ٿو. زوري رڳو پرڏيھي-گفتگو جا ڪيپشن ڏيکاري ٿو؛ هميشه اوهان جي ٻوليءَ ۾ مڪمل سب ٽائيٽل ڏيکاري ٿو. پرڏيھي-ٻوليءَ وارن عنوانن کي هميشه مڪمل سب ٽائيٽل ملن ٿا ته جيئن اوهان سمجھي سگھو."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මාතෘකාවක් ආරම්භ වන විට ප්ලේයරය මේවා ස්වයංක්‍රීයව තෝරයි. බලෙන් යෙදූ විදේශීය-සංවාද සිරස්තල පමණක් පෙන්වයි; සැම විටම ඔබේ භාෂාවෙන් සම්පූර්ණ උපසිරැසි පෙන්වයි. ඔබට අනුගමනය කළ හැකි ලෙස විදේශ-භාෂා මාතෘකා සැම විටම සම්පූර්ණ උපසිරැසි ලබා ගනී."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "E filifili otometi e le taialo nei mea pe a amata se ulutala. E faaali e le Faamalosi na o ulutala tautala i gagana ese; E faaali e le Taimi Uma ulutala atoa i lau gagana. E maua e ulutala gagana ese i taimi uma ulutala atoatoa ina ia mafai ona e mulimuli."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutambi unosarudza izvi wega kana chinyorwa chichitanga. Forced inoratidza chete ma caption ehurukuro dzemumwe mutauro; Always inoratidza ma subtitle azere mumutauro wako. Zvinyorwa zvemitauro yekunze zvinogara zvichiwana ma subtitle azere kuti utevedzere."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciyaaryahanku si toos ah ayuu kuwan u doortaa marka cinwaan bilowdo. Forced wuxuu tusaa oo keliya qoraallada wada-hadalka luqadaha ajnabiga ah; Always wuxuu ku tusaa qoraal-hoosaad buuxa luqaddaada. Cinwaannada luqadaha ajnabiga ah had iyo jeer waxay helaan qoraal-hoosaad buuxa si aad u raaci karto."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebapali se ikhethela tsena ka bo sona ha sehlooho se qala. Forced e bontša feela litlaleho tsa lipuisano tsa kantle ho naha; Always e bontša litlaleho tse felletseng ka puo ea hau. Lihlooho tsa puo ea kantle kamehla li fumana litlaleho tse felletseng e le hore u ka latela."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamuter otomatis milih ieu iraha judul dimimitian. Dipaksa ngan némbongkeun teks dialog asing; Salawasna némbongkeun subjudul pinuh dina basa anjeun. Judul basa asing salawasna meunang subjudul pinuh ambéh anjeun bisa ngiluan."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Плеер ҳангоми оғози унвон инҳоро ба таври худкор интихоб мекунад. «Маҷбурӣ» танҳо зерунвонҳои муколамаи хориҷиро нишон медиҳад; «Ҳамеша» зерунвонҳои пурраро бо забони шумо нишон медиҳад. Унвонҳои забони хориҷӣ ҳамеша зерунвонҳои пурра мегиранд, то шумо пайгирӣ карда тавонед."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Исем башлангач плеер боларны автоматик сайлый. Мәҗбүри тик чит телдәге диалог язмаларын гына күрсәтә; Һәрчак телеңдә тулы субтитрлар күрсәтә. Чит телдәге исемнәр өчен һәрчак тулы субтитрлар бирелә, шулай итеп син күзәтеп бара аласың."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "قويغۇچ ماۋزۇ باشلانغاندا بۇلارنى ئاپتوماتىك تاللايدۇ. مەجبۇرىي پەقەت چەت تىل سۆھبەت خەتكۈشلىرىنىلا كۆرسىتىدۇ؛ ھەمىشە تىلىڭىزدىكى تولۇق خەتكۈشلەرنى كۆرسىتىدۇ. چەت تىل ماۋزۇلىرى ھەمىشە تولۇق خەتكۈش ئالىدۇ، شۇنداق قىلىپ ئەگىشەلەيسىز."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarlavha boshlanganda pleyer bularni avtomatik tanlaydi. Majburiy rejim faqat chet tildagi dialog izohlarini ko'rsatadi; Har doim rejim tilingizda to'liq subtitrlarni ko'rsatadi. Chet tildagi sarlavhalar har doim to'liq subtitrlar oladi, shunda kuzatib borishingiz mumkin."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "Umdlali ukhetha ezi ngokuzenzekelayo xa umxholo uqala. IForced ibonisa kuphela izihloko zencoko yolwimi lwasemzini; iAlways ibonisa izihloko ezipheleleyo ngolwimi lwakho. Imixholo yolwimi lwasemzini isoloko ifumana izihloko ezipheleleyo ukuze ukwazi ukulandela."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẹ̀rọ-ìtúfò máa ń yan àwọn wọ̀nyí fúnraarẹ̀ nígbà tí àkọ́lé bá bẹ̀rẹ̀. Forced máa ń fi kìkì àwọn àkọlé ọ̀rọ̀-àjèjì hàn; Always máa ń fi àwọn àkọlé-abẹ́ kíkún hàn ní èdè rẹ. Àwọn àkọ́lé èdè-àjèjì máa ń gba àkọlé-abẹ́ kíkún nígbà gbogbo kí o lè tẹ̀lé."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Umdlali uzikhethela ngokuzenzakalelayo lezi lapho isihloko siqala. I-Forced ibonisa kuphela izicaphuno zezingxoxo zolimi lwangaphandle; i-Always ibonisa izingcaphuno ezigcwele ngolimi lwakho. Izihloko zolimi lwangaphandle zihlala zithola izingcaphuno ezigcwele ukuze ukwazi ukulandela."
          }
        }
      }
    },
    "This account's profiles differ from this device. Merge both to keep every profile (recommended), or force one side.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I profili di questo account differiscono da quelli di questo dispositivo. Unisci entrambi per mantenere ogni profilo (consigliato), oppure forza un lato."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles de esta cuenta difieren de los de este dispositivo. Fusiona ambos para conservar todos los perfiles (recomendado), o fuerza un lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils de ce compte diffèrent de ceux de cet appareil. Fusionnez les deux pour conserver tous les profils (recommandé), ou forcez un côté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Profile dieses Kontos unterscheiden sich von diesem Gerät. Führe beide zusammen, um jedes Profil zu behalten (empfohlen), oder erzwinge eine Seite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfis desta conta diferem dos deste dispositivo. Mescle os dois para manter todos os perfis (recomendado) ou force um dos lados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントのプロファイルは、このデバイスと異なります。両方をマージしてすべてのプロファイルを保持する（推奨）か、いずれか一方を強制してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 프로필이 이 기기와 다릅니다. 모든 프로필을 유지하려면 양쪽을 병합하거나(권장), 한쪽을 강제 적용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户的配置文件与本设备不同。合并双方以保留每个配置文件（推荐），或强制采用一方。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профили этого аккаунта отличаются от профилей на этом устройстве. Объедините оба, чтобы сохранить все профили (рекомендуется), или принудительно выберите одну сторону."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस खाते की प्रोफ़ाइलें इस डिवाइस से भिन्न हैं। हर प्रोफ़ाइल रखने के लिए दोनों को मर्ज करें (अनुशंसित), या किसी एक पक्ष को बाध्य करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختلف الملفات الشخصية لهذا الحساب عن هذا الجهاز. ادمج الجانبين للاحتفاظ بكل ملف شخصي (مُوصى به)، أو افرض جانبًا واحدًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesabın profilleri bu cihazdakinden farklı. Her profili korumak için ikisini birleştirin (önerilir) veya bir tarafı zorlayın."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfis desta conta diferem dos deste dispositivo. Junte ambos para manter todos os perfis (recomendado) ou force um dos lados."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De profielen van dit account verschillen van dit apparaat. Voeg beide samen om elk profiel te behouden (aanbevolen), of forceer één kant."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile na tym koncie różnią się od tych na tym urządzeniu. Scal oba, aby zachować każdy profil (zalecane), lub wymuś jedną stronę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här kontots profiler skiljer sig från den här enheten. Slå ihop båda för att behålla alla profiler (rekommenderas), eller tvinga fram en sida."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號的設定檔與此裝置上的不同。可合併兩者以保留每個設定檔（建議），或強制以某一方為準。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil akun ini berbeda dari perangkat ini. Gabungkan keduanya untuk menyimpan setiap profil (disarankan), atau paksa salah satu sisi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรไฟล์ของบัญชีนี้แตกต่างจากอุปกรณ์นี้ ผสานทั้งสองเพื่อเก็บทุกโปรไฟล์ (แนะนำ) หรือบังคับใช้ฝ่ายใดฝ่ายหนึ่ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ của tài khoản này khác với thiết bị này. Hợp nhất cả hai để giữ mọi hồ sơ (khuyến nghị), hoặc buộc theo một bên."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профілі цього акаунта відрізняються від цього пристрою. Об’єднайте обидва, щоб зберегти всі профілі (рекомендовано), або примусово виберіть один бік."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Profily tohoto účtu se liší od tohoto zařízení. Sloučením obou zachováte všechny profily (doporučeno), nebo vynuťte jednu stranu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα προφίλ αυτού του λογαριασμού διαφέρουν από αυτή τη συσκευή. Συγχωνεύστε και τα δύο για να διατηρήσετε κάθε προφίλ (συνιστάται) ή επιβάλετε τη μία πλευρά."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרופילים בחשבון הזה שונים מאלה במכשיר הזה. מזג את שניהם כדי לשמור כל פרופיל (מומלץ), או כפה צד אחד."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kontos profiler adskiller sig fra denne enhed. Flet begge for at beholde alle profiler (anbefales), eller gennemtving den ene side."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän tilin profiilit eroavat tästä laitteesta. Yhdistä molemmat säilyttääksesi kaikki profiilit (suositeltava), tai pakota toinen puoli."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilene på denne kontoen er forskjellige fra denne enheten. Slå sammen begge for å beholde hver profil (anbefalt), eller tving fram én side."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilurile acestui cont diferă de cele de pe acest dispozitiv. Îmbină-le pe ambele pentru a păstra fiecare profil (recomandat) sau forțează una dintre părți."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek a fióknak a profiljai eltérnek ettől az eszköztől. Egyesítsd a kettőt minden profil megtartásához (ajánlott), vagy kényszerítsd az egyik oldalt."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil akaun ini berbeza daripada peranti ini. Gabungkan kedua-duanya untuk mengekalkan setiap profil (disyorkan), atau paksa satu pihak."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naiiba ang mga profile ng account na ito sa device na ito. Pagsamahin ang dalawa para mapanatili ang bawat profile (inirerekomenda), o piliting isulong ang isang panig."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایه‌های این حساب با این دستگاه متفاوت‌اند. هر دو را ادغام کنید تا همه نمایه‌ها حفظ شوند (توصیه‌شده)، یا یک طرف را اجبار کنید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাকাউন্টের প্রোফাইল এই ডিভাইস থেকে আলাদা। প্রতিটি প্রোফাইল রাখতে উভয়টি মার্জ করুন (সুপারিশকৃত), অথবা একটি দিক জোর করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கணக்கின் சுயவிவரங்கள் இந்தச் சாதனத்திலிருந்து வேறுபடுகின்றன. ஒவ்வொரு சுயவிவரத்தையும் வைத்திருக்க இரண்டையும் இணைக்கவும் (பரிந்துரைக்கப்படுகிறது), அல்லது ஒரு பக்கத்தைக் கட்டாயப்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఖాతా ప్రొఫైల్‌లు ఈ పరికరం నుండి భిన్నంగా ఉన్నాయి. ప్రతి ప్రొఫైల్‌ను ఉంచుకోవడానికి రెండింటినీ విలీనం చేయండి (సిఫార్సు చేయబడింది), లేదా ఒక వైపును బలవంతం చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या खात्याची प्रोफाइल या डिव्हाइसपेक्षा वेगळी आहेत. प्रत्येक प्रोफाइल ठेवण्यासाठी दोन्ही विलीन करा (शिफारस केलेले), किंवा एका बाजूची सक्ती करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ account ની પ્રોફાઇલ આ ઉપકરણથી અલગ છે. દરેક પ્રોફાઇલ રાખવા બંનેને મર્જ કરો (ભલામણ કરેલ), અથવા એક બાજુ ફરજિયાત કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಖಾತೆಯ ಪ್ರೊಫೈಲ್‌ಗಳು ಈ ಸಾಧನದಿಂದ ಭಿನ್ನವಾಗಿವೆ. ಪ್ರತಿ ಪ್ರೊಫೈಲ್ ಅನ್ನು ಇರಿಸಿಕೊಳ್ಳಲು ಎರಡನ್ನೂ ವಿಲೀನಗೊಳಿಸಿ (ಶಿಫಾರಸು ಮಾಡಲಾಗಿದೆ), ಅಥವಾ ಒಂದು ಬದಿಯನ್ನು ಒತ್ತಾಯಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ അക്കൗണ്ടിന്റെ പ്രൊഫൈലുകൾ ഈ ഉപകരണത്തിൽ നിന്ന് വ്യത്യാസപ്പെട്ടിരിക്കുന്നു. എല്ലാ പ്രൊഫൈലുകളും നിലനിർത്താൻ രണ്ടും ലയിപ്പിക്കുക (ശുപാർശ ചെയ്യുന്നു), അല്ലെങ്കിൽ ഒരു വശം നിർബന്ധമാക്കുക."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس اکاؤنٹ کے پروفائلز اس ڈیوائس سے مختلف ہیں۔ ہر پروفائل رکھنے کے لیے دونوں کو ضم کریں (تجویز کردہ)، یا کسی ایک طرف پر مجبور کریں۔"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Profily tohto účtu sa líšia od tohto zariadenia. Zlúčte oba, aby ste zachovali každý profil (odporúčané), alebo vynúťte jednu stranu."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Профилите на този акаунт се различават от това устройство. Обединете и двете, за да запазите всеки профил (препоръчително), или наложете една страна."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profili ovog računa razlikuju se od ovog uređaja. Spojite oba kako biste zadržali svaki profil (preporučeno) ili nametnite jednu stranu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Профили овог налога се разликују од овог уређаја. Споједините оба да задржите сваки профил (препоручено), или приморајте једну страну."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profili tega računa se razlikujejo od te naprave. Združite oba, da ohranite vsak profil (priporočeno), ali prisilite eno stran."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šios paskyros profiliai skiriasi nuo šio įrenginio. Sujunkite abu, kad išsaugotumėte kiekvieną profilį (rekomenduojama), arba priverstinai pasirinkite vieną pusę."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī konta profili atšķiras no šīs ierīces. Apvienojiet abus, lai paturētu katru profilu (ieteicams), vai piespiediet vienu pusi."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle konto profiilid erinevad selle seadme omadest. Ühenda mõlemad, et säilitada kõik profiilid (soovitatav), või sunni üks pool peale."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els perfils d'aquest compte difereixen dels d'aquest dispositiu. Fusiona'ls tots dos per conservar cada perfil (recomanat), o força un dels costats."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfís desta conta difiren dos deste dispositivo. Combínaos para conservar todos os perfís (recomendado) ou forza un dos lados."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontu honen profilak gailu honetatik desberdinak dira. Batu biak profil guztiak mantentzeko (gomendatuta), edo behartu alde bat."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie rekening se profiele verskil van hierdie toestel. Saamvoeg albei om elke profiel te behou (aanbeveel), of forseer een kant."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesabın profilləri bu cihazdan fərqlidir. Hər iki profili saxlamaq üçün birləşdirin (tövsiyə olunur) və ya bir tərəfi məcburi edin."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilet e kësaj llogarie ndryshojnë nga kjo pajisje. Bashkojini të dyja për të mbajtur çdo profil (rekomandohet), ose detyroni njërën anë."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Prófílar þessa reiknings eru ólíkir þessum tæki. Sameina báðar hliðar til að geyma alla prófíla (mælt með), eða þvinga annarri hlið."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профилите на оваа сметка се разликуваат од овој уред. Спојте ги двете за да ги задржите сите профили (препорачано) или принудете една страна."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasifu wa akaunti hii unatofautiana na kifaa hiki. Unganisha vyote ili kuweka kila wasifu (inayopendekezwa), au lazimisha upande mmoja."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл тіркелгінің профильдері осы құрылғыдан өзгеше. Әрбір профильді сақтау үшін екеуін де біріктіріңіз (ұсынылады) немесе бір жақты таңдаңыз."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս հաշվի պրոֆիլները տարբերվում են այս սարքի պրոֆիլներից։ Միաձուլեք երկուսն էլ, որ պահեք բոլոր պրոֆիլները (խորհուրդ է տրվում), կամ ընտրեք մեկ կողմ։"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ ანგარიშის პროფილები განსხვავდება ამ მოწყობილობისგან. გაერთიანება ინახავს ყველა პროფილს (რეკომენდებულია), ან ძალით გაიმარჯვებს ერთ მხარეს."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਖਾਤੇ ਦੀਆਂ ਪ੍ਰੋਫ਼ਾਈਲਾਂ ਇਸ ਡਿਵਾਈਸ ਤੋਂ ਵੱਖਰੀਆਂ ਹਨ। ਹਰ ਪ੍ਰੋਫ਼ਾਈਲ ਰੱਖਣ ਲਈ ਦੋਵੇਂ ਮਿਲਾਓ (ਸਿਫਾਰਸ਼ਿਤ), ਜਾਂ ਇੱਕ ਪਾਸੇ ਨੂੰ ਲਾਜ਼ਮੀ ਕਰੋ।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यस खाताका प्रोफाइलहरू यस उपकरणसँग भिन्न छन्। प्रत्येक प्रोफाइल राख्न दुबै मर्ज गर्नुहोस् (सिफारिस गरिन्छ), वा एक पक्षलाई जबर्जस्ती लागू गर्नुहोस्।"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ መለያ መገለጫዎቹ ከዚህ መሳሪያ ጋር ይለያያሉ። ሁሉንም ለማቆየት ሁለቱን ዋህድ (የሚመከር)፣ ወይም አንዱን ጎን ብቻ ጠቀምት።"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រវត្តិរូបរបស់គណនីនេះខុសពីឧបករណ៍នេះ។ បញ្ចូលគ្នាទាំងពីរ ដើម្បីរក្សាប្រវត្តិរូបទាំងអស់ (ត្រូវបានណែនាំ) ឬបង្ខំផ្នែកម្ខាង។"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এই একাউণ্টৰ প্ৰ'ফাইলবোৰ এই ডিভাইচৰ পৰা পৃথক। প্ৰতিটো প্ৰ'ফাইল ৰাখিবলৈ দুয়োটা একত্ৰিত কৰক (পৰামৰ্শিত), নাইবা এটা দিশ বলপূৰ্বক কৰক।"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Профілі гэтага акаўнта адрозніваюцца ад гэтай прылады. Аб'яднайце абодва, каб захаваць кожны профіль (рэкамендуецца), ці прымусова выберыце адзін бок."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Aeladoù ar gont-mañ a zo disheñvel diouzh an ardivink-mañ. Kendeuzit an daou evit mirout pep aelad (erbedet), pe rediit un tu."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Profili ovog računa razlikuju se od ovog uređaja. Spojite oba da zadržite svaki profil (preporučeno) ili prisilite jednu stranu."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga profile niini nga account lahi sa niini nga device. I-merge ang duha aron matipigan ang matag profile (girekomendar), o pugsa ang usa ka bahin."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae proffiliau'r cyfrif hwn yn wahanol i'r ddyfais hon. Cyfunwch y ddau i gadw pob proffil (argymhellir), neu orfodi un ochr."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Vangamyndir hesarar kontu eru øðrvísi enn á hesi eind. Sameina bæði fyri at halda hvørja vangamynd (mælt til), ella noyð eina síðu."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "De profilen fan dit akkount ferskille fan dit apparaat. Foegje beide gear om elk profyl te hâlden (oanrikkemandearre), of twing ien kant."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá difríocht idir próifílí an chuntais seo agus an gléas seo. Cumaisc an dá cheann chun gach próifíl a choinneáil (molta), nó cuir taobh amháin i bhfeidhm."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Tha pròifilean a' chunntais seo eadar-dhealaichte on inneal seo. Co-mheasgaich an dà chuid gus a h-uile pròifil a chumail (mholta), no sparr aon taobh."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayanan martaba na wannan asusun sun bambanta da na wannan na'urar. Haɗa dukansu don riƙe kowane bayanin martaba (an ba da shawara), ko tilasta gefe ɗaya."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Pwofil kont sa a diferan de aparèy sa a. Fizyone toude pou kenbe chak pwofil (rekòmande), oswa fòse yon bò."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Profaịlụ akaụntụ a dị iche na ngwaọrụ a. Jikọta ha abụọ iji debe profaịlụ ọ bụla (a na-akwado ya), ma ọ bụ manye otu akụkụ."
          }
        },
        "jv": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil akun iki béda karo piranti iki. Gabungaké loro-loroné kanggo njaga saben profil (disaranaké), utawa peksa siji sisih."
          }
        },
        "ku": {
          "stringUnit": {
            "state": "translated",
            "value": "Profîlên vî hesabî ji vê amûrê cuda ne. Herduyan tevbike da ku her profîlê biparêzî (pêşniyar tê kirin), an aliyekî bi zorê ferz bike."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул аккаунттун профилдери бул түзмөктөгүдөн айырмаланат. Ар бир профилди сактоо үчүн экөөнү бириктириңиз (сунушталат), же бир жагын мажбурлаңыз."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "D'Profiler vun dësem Kont ënnerscheede sech vun dësem Apparat. Verschmëlz béid fir all Profil ze behalen (recommandéiert), oder erzwéng eng Säit."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂປຣໄຟລ໌ຂອງບັນຊີນີ້ແຕກຕ່າງຈາກອຸປະກອນນີ້. ໃຫ້ລວມທັງສອງເພື່ອຮັກສາທຸກໂປຣໄຟລ໌ (ແນະນຳ), ຫຼື ບັງຄັບໃຊ້ຝ່າຍໃດຝ່າຍໜຶ່ງ."
          }
        },
        "mg": {
          "stringUnit": {
            "state": "translated",
            "value": "Tsy mitovy amin'ity fitaovana ity ny profilan'ity kaonty ity. Akambano izy roa mba hitazonana ny profil rehetra (aroso), na tereo ny lafiny iray."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "He rerekē ngā kōtaha o tēnei pūkete i tēnei pūrere. Whakakotahitia ērua kia mau ai ia kōtaha (e tūtohutia ana), kōkukua rānei tētahi taha."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ дансны профайлууд энэ төхөөрөмжөөс ялгаатай. Профайл бүрийг хадгалахын тулд хоёуланг нь нэгтгэх (санал болгосон), эсвэл нэг талыг албадаарай."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-profili ta' dan il-kont huma differenti minn dan l-apparat. Għaqqad it-tnejn biex iżżomm kull profil (rakkomandat), jew isforza naħa waħda."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤအကောင့်၏ ပရိုဖိုင်များသည် ဤစက်နှင့် ကွဲပြားသည်။ ပရိုဖိုင်တိုင်း ထားရှိရန် နှစ်ဖက်လုံးကို ပေါင်းစည်းပါ (အကြံပြု)၊ သို့မဟုတ် တစ်ဖက်ကို အတင်းသုံးပါ။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma profile a akaunti iyi ndi osiyana ndi a chipangizo ichi. Phatikizani zonse kuti musunge profile iliyonse (zolimbikitsidwa), kapena kakamizani mbali imodzi."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfils d'aqueste compte diferisson d'aqueles d'aqueste aparelh. Fusionatz los dos per gardar totes los perfils (recomandat), o forçatz un costat."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଆକାଉଣ୍ଟର ପ୍ରୋଫାଇଲ ଏହି ଡିଭାଇସଠାରୁ ଭିନ୍ନ। ପ୍ରତ୍ୟେକ ପ୍ରୋଫାଇଲ ରଖିବାକୁ ଦୁହିଁଙ୍କୁ ମିଶାନ୍ତୁ (ସୁପାରିଶ), କିମ୍ବା ଗୋଟିଏ ପାର୍ଶ୍ୱକୁ ବାଧ୍ୟ କରନ୍ତୁ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "د دې حساب پروفایلونه له دې وسیلې سره توپیر لري. د هر پروفایل ساتلو لپاره دواړه یوځای کړئ (وړاندیز شوی)، یا یو اړخ اجبار کړئ."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imyirondoro y'iyi konti itandukanye n'iy'iki cyuma. Huza byombi kugira ngo ugumane buri mwirondoro (birasabwa), cyangwa ushyireho uruhande rumwe ku ngufu."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "هن اڪائونٽ جا پروفائل هن ڊوائيس کان مختلف آهن. هر پروفائل رکڻ لاءِ ٻنھي کي ملايو (سفارش ٿيل)، يا هڪ پاسي کي زور سان لاڳو ڪريو."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙම ගිණුමේ පැතිකඩ මෙම උපාංගයට වඩා වෙනස් ය. සෑම පැතිකඩක්ම තබා ගැනීමට දෙකම ඒකාබද්ධ කරන්න (නිර්දේශිත), නැතහොත් එක් පැත්තක් බලෙන් යොදන්න."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "E ese tala faasino patino a lenei tala mai lenei masini. Tuufaatasi uma e taofia ai tala faasino patino uma (fautuaina), pe faamalosi le tasi itu."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "Maprofaira e account iyi akasiyana neanodhivhaisi iyi. Sanganisa zvese kuti uchengete purofaira yega yega (zvinokurudzirwa), kana umanikidze rimwe divi."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile-yada akoonkani way ka duwan yihiin qalabkan. Isku dar labada si aad u hayso profile kasta (waa la talinayaa), ama qasab dhinac."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "Liprofaele tsa akhaonto ena li fapane le tsa sesebelisoa sena. Kopanya ka bobeli ho boloka profaele e 'ngoe le e 'ngoe (ho khothaletsoa), kapa u qobelle lehlakore le le leng."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil akun ieu béda ti alat ieu. Gabungkeun duanana pikeun nahan unggal profil (disarankeun), atawa paksakeun hiji sisi."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Профилҳои ин ҳисоб аз ин дастгоҳ фарқ мекунанд. Ҳардуро якҷоя кунед, то ҳар профил нигоҳ дошта шавад (тавсияшуда), ё як тарафро маҷбур кунед."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Бу хисапның профильләре бу җиһаздагылардан аерыла. Һәр профильне сакларга икесен берләштер (тәкъдим ителә), яки бер якны мәҗбүр ит."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بۇ ھېساباتنىڭ سەپلىمىلىرى بۇ ئۈسكۈنىدىكىدىن پەرقلىق. ھەر بىر سەپلىمىنى ساقلاپ قېلىش ئۈچۈن ئىككىسىنى بىرلەشتۈرۈڭ (تەۋسىيە قىلىنىدۇ)، ياكى بىر تەرەپنى مەجبۇرلاڭ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hisobning profillari shu qurilmadan farq qiladi. Har bir profilni saqlab qolish uchun ikkalasini birlashtiring (tavsiya etiladi) yoki bir tomonni majburlang."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "Iiprofayile zale akhawunti zahlukile kwesi sixhobo. Dibanisa zombini ukugcina iprofayile nganye (kucetyiswa), okanye unyanzelise icala elinye."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Àwọn profaìlì àkàwé yìí yàtọ̀ sí ti ẹ̀rọ yìí. Da àwọn méjèèjì pọ̀ láti pa gbogbo profaìlì mọ́ (a gbà ní ìyànjú), tàbí fipá mú ẹ̀gbẹ́ kan."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaphrofayela ale-akhawunti ahluke kwale divayisi. Hlanganisa kokubili ukuze ugcine wonke amaphrofayela (okunconyiwe), noma uphoqe uhlangothi olulodwa."
          }
        }
      }
    },
    "This is shown only once. It is the only way back in if you forget your password and lose your devices. Store it somewhere safe.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene mostrato una sola volta. È l'unico modo per rientrare se dimentichi la password e perdi i tuoi dispositivi. Conservalo in un luogo sicuro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto se muestra una sola vez. Es la única forma de volver a entrar si olvidas tu contraseña y pierdes tus dispositivos. Guárdalo en un lugar seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci n'est affiché qu'une seule fois. C'est le seul moyen de revenir si vous oubliez votre mot de passe et perdez vos appareils. Conservez-le en lieu sûr."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies wird nur einmal angezeigt. Es ist der einzige Weg zurück, falls du dein Passwort vergisst und deine Geräte verlierst. Bewahre es an einem sicheren Ort auf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto é exibido apenas uma vez. É a única forma de voltar a entrar caso esqueça sua senha e perca seus dispositivos. Guarde-o em um lugar seguro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは一度だけ表示されます。パスワードを忘れてデバイスを失った場合に戻る唯一の方法です。安全な場所に保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드는 한 번만 표시됩니다. 비밀번호를 잊고 기기를 잃었을 때 다시 들어올 수 있는 유일한 방법입니다. 안전한 곳에 보관하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此内容仅显示一次。这是你忘记密码并丢失设备后唯一的找回方式。请将其存放在安全的地方。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это показывается только один раз. Это единственный способ вернуться, если вы забудете пароль и потеряете устройства. Храните его в надёжном месте."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह केवल एक बार दिखाया जाता है। यदि आप अपना पासवर्ड भूल जाते हैं और अपने डिवाइस खो देते हैं तो वापस आने का यही एकमात्र रास्ता है। इसे कहीं सुरक्षित रखें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعرَض هذا مرة واحدة فقط. إنه الطريقة الوحيدة للعودة إذا نسيت كلمة المرور وفقدت أجهزتك. خزّنه في مكان آمن."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yalnızca bir kez gösterilir. Parolanızı unutur ve cihazlarınızı kaybederseniz geri dönmenin tek yolu budur. Güvenli bir yerde saklayın."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto é mostrado apenas uma vez. É a única forma de voltar a entrar se esquecer a palavra-passe e perder os dispositivos. Guarde-o num local seguro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit wordt maar één keer getoond. Het is de enige manier om weer binnen te komen als je je wachtwoord vergeet en je apparaten kwijtraakt. Bewaar het op een veilige plek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jest pokazane tylko raz. To jedyny sposób na odzyskanie dostępu, jeśli zapomnisz hasła i utracisz urządzenia. Przechowuj go w bezpiecznym miejscu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta visas bara en gång. Det är enda sättet tillbaka in om du glömmer ditt lösenord och förlorar dina enheter. Förvara det på en säker plats."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此內容只會顯示一次。若你忘記密碼且失去裝置，這是唯一的回復途徑。請妥善保存在安全的地方。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini hanya ditampilkan sekali. Ini satu-satunya cara masuk kembali jika Anda lupa kata sandi dan kehilangan perangkat. Simpan di tempat yang aman."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะแสดงเพียงครั้งเดียวเท่านั้น เป็นทางเดียวที่จะกลับเข้าได้หากคุณลืมรหัสผ่านและสูญเสียอุปกรณ์ เก็บไว้ในที่ปลอดภัย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã này chỉ hiển thị một lần. Đây là cách duy nhất để vào lại nếu bạn quên mật khẩu và mất các thiết bị. Hãy cất giữ ở nơi an toàn."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це показується лише раз. Це єдиний спосіб повернутися, якщо ви забудете пароль і втратите свої пристрої. Зберігайте його в надійному місці."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto se zobrazí jen jednou. Je to jediná cesta zpět, pokud zapomenete heslo a přijdete o svá zařízení. Uložte si jej na bezpečné místo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό εμφανίζεται μόνο μία φορά. Είναι ο μόνος τρόπος επανεισόδου αν ξεχάσετε τον κωδικό πρόσβασής σας και χάσετε τις συσκευές σας. Φυλάξτε το σε ασφαλές μέρος."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה מוצג פעם אחת בלבד. זו הדרך היחידה לחזור פנימה אם תשכח את הסיסמה ותאבד את המכשירים שלך. שמור אותו במקום בטוח."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vises kun én gang. Det er den eneste vej tilbage, hvis du glemmer din adgangskode og mister dine enheder. Opbevar det et sikkert sted."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä näytetään vain kerran. Se on ainoa tapa päästä takaisin, jos unohdat salasanasi ja menetät laitteesi. Säilytä se turvallisessa paikassa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vises bare én gang. Det er eneste vei inn igjen hvis du glemmer passordet og mister enhetene dine. Oppbevar det et trygt sted."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta este afișat o singură dată. Este singura modalitate de a reintra dacă îți uiți parola și îți pierzi dispozitivele. Păstrează-l undeva în siguranță."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez csak egyszer jelenik meg. Ez az egyetlen mód a visszajutásra, ha elfelejted a jelszavad és elveszíted az eszközeidet. Tárold biztonságos helyen."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini ditunjukkan hanya sekali. Ia satu-satunya jalan masuk semula jika anda terlupa kata laluan dan kehilangan peranti anda. Simpan di tempat yang selamat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita lamang ito nang isang beses. Ito ang tanging paraan pabalik kung makakalimutan mo ang iyong password at mawawala ang iyong mga device. Itago ito sa ligtas na lugar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این فقط یک‌بار نشان داده می‌شود. این تنها راه بازگشت است اگر رمز عبور خود را فراموش کنید و دستگاه‌هایتان را از دست بدهید. آن را جایی امن نگه دارید."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি শুধু একবারই দেখানো হয়। আপনি পাসওয়ার্ড ভুলে গেলে এবং আপনার ডিভাইস হারালে ফিরে আসার এটিই একমাত্র উপায়। এটি নিরাপদ কোথাও সংরক্ষণ করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது ஒரு முறை மட்டுமே காட்டப்படும். உங்கள் கடவுச்சொல்லை மறந்து உங்கள் சாதனங்களை இழந்தால் மீண்டும் உள்ளே வர இதுவே ஒரே வழி. பாதுகாப்பான இடத்தில் வைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ఒక్కసారి మాత్రమే చూపబడుతుంది. మీరు మీ పాస్‌వర్డ్ మర్చిపోయి మీ పరికరాలను కోల్పోతే తిరిగి లోపలికి వచ్చే ఏకైక మార్గం ఇదే. దీన్ని సురక్షితమైన చోట భద్రపరచండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे फक्त एकदाच दाखवले जाते. तुम्ही तुमचा पासवर्ड विसरलात आणि तुमची डिव्हाइस गमावलीत तर परत येण्याचा हाच एकमेव मार्ग आहे. ते सुरक्षित ठिकाणी जतन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફક્ત એક જ વાર બતાવાય છે. જો તમે તમારો પાસવર્ડ ભૂલી જાઓ અને તમારા ઉપકરણો ગુમાવો તો અંદર પાછા આવવાનો આ એકમાત્ર માર્ગ છે. તેને ક્યાંક સલામત રાખો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದನ್ನು ಒಮ್ಮೆ ಮಾತ್ರ ತೋರಿಸಲಾಗುತ್ತದೆ. ನೀವು ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಮರೆತು ನಿಮ್ಮ ಸಾಧನಗಳನ್ನು ಕಳೆದುಕೊಂಡರೆ ಮರಳಿ ಪ್ರವೇಶಿಸಲು ಇದೇ ಏಕೈಕ ಮಾರ್ಗ. ಇದನ್ನು ಸುರಕ್ಷಿತ ಸ್ಥಳದಲ್ಲಿ ಇರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് ഒരിക്കൽ മാത്രമേ കാണിക്കൂ. നിങ്ങളുടെ പാസ്‌വേഡ് മറക്കുകയും നിങ്ങളുടെ ഉപകരണങ്ങൾ നഷ്ടപ്പെടുകയും ചെയ്താൽ തിരികെ വരാനുള്ള ഏക മാർഗ്ഗമാണിത്. ഇത് സുരക്ഷിതമായ ഒരിടത്ത് സൂക്ഷിക്കുക."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ صرف ایک بار دکھایا جاتا ہے۔ اگر آپ اپنا پاس ورڈ بھول جائیں اور اپنی ڈیوائسز کھو دیں تو واپس آنے کا یہی واحد راستہ ہے۔ اسے کسی محفوظ جگہ رکھیں۔"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto sa zobrazí len raz. Je to jediná cesta späť, ak zabudnete heslo a stratíte zariadenia. Uložte si ho na bezpečné miesto."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това се показва само веднъж. То е единственият начин да влезете отново, ако забравите паролата си и загубите устройствата си. Съхранявайте го на сигурно място."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo se prikazuje samo jednom. To je jedini način povratka ako zaboravite lozinku i izgubite uređaje. Pohranite ga na sigurno mjesto."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ово се приказује само једном. То је једини начин да се вратите ако заборавите лозинку и изгубите уређаје. Сачувајте га на безбедном месту."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To je prikazano samo enkrat. Je edini način za vrnitev, če pozabite geslo in izgubite naprave. Shranite jo na varno mesto."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai rodoma tik vieną kartą. Tai vienintelis būdas grįžti, jei pamiršite slaptažodį ir prarasite įrenginius. Laikykite jį saugioje vietoje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas tiek rādīts tikai vienreiz. Tas ir vienīgais veids, kā atgriezties, ja aizmirstat paroli un pazaudējat ierīces. Glabājiet to drošā vietā."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seda kuvatakse ainult ühe korra. See on ainus viis tagasi pääseda, kui unustad parooli ja kaotad oma seadmed. Hoia seda turvalises kohas."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això es mostra una sola vegada. És l'única manera de recuperar l'accés si oblides la contrasenya i perds els dispositius. Desa'l en un lloc segur."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto móstrase só unha vez. É a única forma de recuperar o acceso se esqueces o contrasinal e perdes os dispositivos. Gárdao nun lugar seguro."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hau behin soilik erakusten da. Pasahitza ahaztu eta zure gailuak galtzen badituzu itzultzeko modu bakarra da. Gorde leku seguru batean."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit word slegs een keer gewys. Dit is die enigste manier terug as jy jou wagwoord vergeet en jou toestelle verloor. Stoor dit êrens veilig."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yalnız bir dəfə göstərilir. Şifrənizi unutsanız və cihazlarınızı itirsəniz geri dönməyin yeganə yoludur. Onu təhlükəsiz bir yerdə saxlayın."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjo tregohet vetëm një herë. Është mënyra e vetme e kthimit nëse harroni fjalëkalimin dhe humbisni pajisjet tuaja. Ruajeni diku të sigurt."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta er aðeins sýnt einu sinni. Þetta er eina leiðin aftur inn ef þú gleymir lykilorðinu og missir tækin þín. Geymdu það á öruggum stað."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова се прикажува само еднаш. Тоа е единствениот начин за пристап ако ја заборавите лозинката и ги изгубите уредите. Зачувајте го на безбедно место."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hii inaonyeshwa mara moja tu. Ndiyo njia pekee ya kurudi ndani ikiwa utasahau nenosiri lako na kupoteza vifaa vyako. Ihifadhi mahali salama."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл тек бір рет көрсетіледі. Егер құпия сөзіңізді ұмытып, құрылғыларыңызды жоғалтсаңыз, бұл — жалғыз кіру жолы. Оны қауіпсіз жерде сақтаңыз."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սա ցուցադրվում է միայն մեկ անգամ։ Եթե մոռանաք ձեր գաղտնաբառը և կորցնեք ձեր սարքերը, վերականգնման միակ ճանապարհն այն է։ Պահեք ապահով վայրում։"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ნაჩვენებია მხოლოდ ერთხელ. ეს არის ერთადერთი გზა შიგნით, თუ პაროლი დაგავიწყდათ და მოწყობილობები დაკარგეთ. შეინახეთ უსაფრთხო ადგილას."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਸਿਰਫ਼ ਇੱਕ ਵਾਰ ਦਿਖਾਇਆ ਜਾਂਦਾ ਹੈ। ਜੇ ਤੁਸੀਂ ਆਪਣਾ ਪਾਸਵਰਡ ਭੁੱਲ ਜਾਓ ਅਤੇ ਆਪਣੇ ਡਿਵਾਈਸ ਗੁਆ ਦਿਓ ਤਾਂ ਵਾਪਸ ਅੰਦਰ ਆਉਣ ਦਾ ਇਹ ਇੱਕੋ ਰਾਹ ਹੈ। ਇਸਨੂੰ ਕਿਸੇ ਸੁਰੱਖਿਅਤ ਜਗ੍ਹਾ ਸਟੋਰ ਕਰੋ।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो एकपटक मात्र देखाइन्छ। यदि तपाईं आफ्नो पासवर्ड बिर्सनुभयो र उपकरणहरू गुमाउनुभयो भने यही एकमात्र फिर्ती बाटो हो। यसलाई कतै सुरक्षित राख्नुहोस्।"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ አንዴ ብቻ ይታያሉ። የይለፍ ቃሉን ከረሱ እና መሳሪያዎቹን ከጣሉ ወደ ውስጥ ለመመለስ ብቸኛው መንገድ ነው። ደህና ቦታ ያስቀምጡ።"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វត្ថុនេះត្រូវបានបង្ហាញតែម្តងប៉ុណ្ណោះ។ វាជាមធ្យោបាយតែមួយដើម្បីចូលឡើងវិញ ប្រសិនបើអ្នកភ្លេចពាក្យសម្ងាត់ ហើយបាត់ឧបករណ៍របស់អ្នក។ រក្សាទុកវានៅកន្លែងមានសុវត្ថិភាព។"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এইটো কেৱল এবাৰহে দেখুওৱা হয়। আপুনি আপোনাৰ পাছৱৰ্ড পাহৰি ডিভাইচবোৰ হেৰুৱালে ভিতৰলৈ ঘূৰি অহাৰ এইটোৱেই একমাত্ৰ উপায়। ইয়াক কোনো সুৰক্ষিত ঠাইত ৰাখক।"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта паказваецца толькі адзін раз. Гэта адзіны спосаб вярнуцца, калі вы забудзеце пароль і страціце свае прылады. Захавайце яго ў бяспечным месцы."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskouezet e vez ur wech hepken. An hini nemetañ eo evit dont en-dro ma ankouahait ho ker-tremen ha ma kollit ho ardivinkoù. Mirit anezhañ en ul lec'h diarvar."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo se prikazuje samo jednom. To je jedini način za povratak ako zaboravite lozinku i izgubite uređaje. Pohranite ga na sigurno mjesto."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kini gipakita kausa ra. Kini ra ang paagi aron makabalik kung makalimtan nimo ang imong password ug mawala ang imong mga device. Tipigi kini sa luwas nga dapit."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dangosir hyn unwaith yn unig. Dyma'r unig ffordd yn ôl i mewn os ydych yn anghofio'ch cyfrinair ac yn colli'ch dyfeisiau. Cadwch ef mewn lle diogel."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Hetta verður víst bara eina ferð. Tað er einasta vegurin inn aftur, um tú gloymir loyniorð títt og missir eindir tínar. Goym tað einaðni tryggan."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit wurdt mar ien kear toand. It is de iennige manier om wer binnen te kommen as jo jo wachtwurd ferjitte en jo apparaten kwytreitsje. Bewarje it earne feilich."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Taispeántar é seo aon uair amháin. Is é an t-aon bhealach ar ais isteach é má dhéanann tú dearmad ar do phasfhocal agus má chailleann tú do ghléasanna. Stóráil in áit shábháilte é."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Chithear seo aon turas a-mhàin. 'S e an aon dòigh air ais a-steach ma dhìochuimhnicheas tu am facal-faire agad agus ma chailleas tu na h-innealan agad. Glèidh e ann an àite sàbhailte."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana nuna wannan sau ɗaya kawai. Ita ce kaɗai hanyar dawowa idan ka manta kalmar sirrinka kuma ka rasa na'urorinka. Ajiye ta a wani wuri mai aminci."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa a montre yon sèl fwa. Se sèl fason pou ou antre ankò si ou bliye modpas ou epi ou pèdi aparèy ou yo. Konsève l yon kote ki an sekirite."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "A na-egosi nke a naanị otu ugboro. Ọ bụ naanị ụzọ ị ga-esi lọghachi ma ọ bụrụ na ị chefuo okwuntụghe gị ma tufuo ngwaọrụ gị. Chekwaa ya n'ebe echekwara echekwa."
          }
        },
        "jv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iki mung ditampilaké sepisan. Iki siji-sijiné cara mlebu manèh yèn sampeyan lali sandhi lan kélangan piranti. Simpen ing panggonan sing aman."
          }
        },
        "ku": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev tenê carekê tê nîşandan. Ew tenê rêya vegerê ye eger tu şîfreya xwe ji bîr bikî û amûrên xwe winda bikî. Wê li cihekî ewle biparêze."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул бир гана жолу көрсөтүлөт. Сырсөзүңүздү унутуп, түзмөктөрүңүздү жоготсоңуз, кайра кирүүнүн бирден-бир жолу ушул. Аны коопсуз жерде сактаңыз."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dëst gëtt nëmmen eng Kéier ugewisen. Et ass deen eenzege Wee zréck eran, wann s du däi Passwuert vergëss an deng Apparate verléiers. Verwahr et enzwousch sécher."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ອັນນີ້ຈະສະແດງພຽງຄັ້ງດຽວ. ມັນເປັນທາງດຽວທີ່ຈະກັບເຂົ້າໄດ້ ຖ້າທ່ານລືມລະຫັດຜ່ານ ແລະ ເສຍອຸປະກອນ. ເກັບໄວ້ໃນບ່ອນທີ່ປອດໄພ."
          }
        },
        "mg": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseho indray mandeha ihany ity. Izy no hany lalana hidirana indray raha hadinonao ny tenimiafinao ary very ny fitaovanao. Tehirizo any amin'ny toerana azo antoka."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka whakaatuhia kotahi anake tēnei. Koinei anake te huarahi hoki mai mēnā ka wareware tō kupuhipa ka ngaro hoki ō pūrere. Rongoatia ki tētahi wāhi haumaru."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ зөвхөн нэг удаа харагдана. Хэрэв та нууц үгээ мартаж, төхөөрөмжөө алдвал буцаж орох цорын ганц арга юм. Аюулгүй газар хадгалаарай."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan jintwera darba biss. Huwa l-uniku mod biex tidħol lura jekk tinsa l-password tiegħek u titlef l-apparati tiegħek. Aħżnu f'post sigur."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤအရာကို တစ်ကြိမ်သာ ပြသည်။ သင့်စကားဝှက်ကို မေ့ပြီး သင့်စက်များ ဆုံးရှုံးသွားပါက ၎င်းသည် ပြန်ဝင်ရန် တစ်ခုတည်းသော နည်းလမ်းဖြစ်သည်။ လုံခြုံသောနေရာတွင် သိမ်းထားပါ။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "Izi zimawonetsedwa kamodzi kokha. Ndi njira yokhayo yobwerera ngati muiwala password yanu ndikutaya zipangizo zanu. Zisungeni pamalo otetezeka."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquò s'aficha pas qu'un sol còp. Es l'unic mejan de tornar dintrar se doblidatz vòstre senhal e perdètz vòstres aparelhs. Gardatz-lo dins un endrech segur."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା କେବଳ ଥରେ ଦେଖାଯାଏ। ଆପଣ ଆପଣଙ୍କ ପାସୱାର୍ଡ ଭୁଲିଗଲେ ଏବଂ ଆପଣଙ୍କ ଡିଭାଇସ ହରାଇଲେ ଏହା ଫେରି ଆସିବାର ଏକମାତ୍ର ଉପାୟ। ଏହାକୁ କୌଣସି ସୁରକ୍ଷିତ ସ୍ଥାନରେ ରଖନ୍ତୁ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "دا یوازې یوځل ښودل کیږي. که تاسو خپل پټنوم هیر کړئ او خپلې وسیلې له لاسه ورکړئ، دا یوازینۍ لار ده چې بیرته ننوځئ. په یو خوندي ځای کې یې وساتئ."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibi byerekanwa rimwe gusa. Ni bwo buryo bwonyine bwo kongera kwinjira niba wibagiwe ijambobanga kandi ukabura ibyuma byawe. Bibike ahantu hizewe."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "هيءُ رڳو هڪ ڀيرو ڏيکاريو وڃي ٿو. جيڪڏهن اوهان پنھنجو پاسورڊ وساري ويٺا ۽ ڊوائيسون وڃائي ويٺا ته اندر واپس اچڻ جو اهو ئي واحد رستو آهي. ان کي ڪنھن محفوظ جاءِ تي رکو."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙය එක් වරක් පමණක් පෙන්වයි. ඔබ ඔබේ මුරපදය අමතක කර ඔබේ උපාංග නැති කළහොත් ආපසු ඇතුළු වීමට ඇති එකම මාර්ගය එයයි. එය ආරක්ෂිත තැනක ගබඩා කරන්න."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "E na o le taimi e tasi e faaali ai lenei mea. Naʻo le pau lea o le auala e toe ulufale ai pe a e galo lau upu faataga ma leiloa au masini. Teu i se mea saogalemu."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvi zvinoratidzwa kamwe chete. Ndiyo nzira chete yokudzokera mukati kana ukakanganwa password yako uye ukarasikirwa nemadhivhaisi ako. Zvichengete panzvimbo yakachengeteka."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Tan waxaa la tusaa hal mar oo keliya. Waa habka kaliya ee lagu soo gelo haddii aad ilowdo furaha sirtaada oo aad lumiso qalabkaaga. Meel ammaan ah keydi."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "Sena se bontšoa hang feela. Ke eona feela tsela ea ho khutla haeba u lebala password ea hau 'me u lahleheloa ke lisebelisoa tsa hau. E boloke sebakeng se sireletsehileng."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieu ngan dipintonkeun sakali. Ieu hiji-hijina jalan asup deui lamun anjeun poho kecap sandi jeung leungit alat. Simpen di tempat nu aman."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ин танҳо як бор нишон дода мешавад. Ин ягона роҳи баргаштан аст, агар шумо пароли худро фаромӯш кунед ва дастгоҳҳоятонро гум кунед. Онро дар ҷои бехатар нигоҳ доред."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Бу бер генә тапкыр күрсәтелә. Әгәр серсүзеңне онытсаң һәм җиһазларыңны югалтсаң, бу кире керүнең бердәнбер юлы. Аны куркынычсыз җирдә сакла."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بۇ پەقەت بىر قېتىملا كۆرسىتىلىدۇ. ئەگەر پارولىڭىزنى ئۇنتۇپ ئۈسكۈنىلىرىڭىزنى يوقاتسىڭىز، بۇ قايتىپ كىرىشنىڭ بىردىنبىر يولى. ئۇنى بىخەتەر يەرگە ساقلاڭ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu faqat bir marta ko'rsatiladi. Agar parolingizni unutsangiz va qurilmalaringizni yo'qotsangiz, bu qaytishning yagona yo'li. Uni xavfsiz joyda saqlang."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "Oku kuboniswa kanye kuphela. Yiyona ndlela yokubuyela ukuba ulibala igama lakho lokugqitha kwaye ulahlekelwe zizixhobo zakho. Yigcine kwindawo ekhuselekileyo."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A fi èyí hàn ẹ̀ẹ̀kan ṣoṣo. Òun ni ọ̀nà kan ṣoṣo padà wọlé bí o bá gbàgbé ọ̀rọ̀ ìṣínà rẹ tí o sì pàdánù àwọn ẹ̀rọ rẹ. Tọ́jú rẹ̀ síbi tí ó láàbò."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokhu kuboniswa kanye kuphela. Kuwukuphela kwendlela yokubuyela ngaphakathi uma ukhohlwa iphasiwedi yakho futhi ulahlekelwa amadivayisi akho. Kugcine endaweni ephephile."
          }
        }
      }
    },
