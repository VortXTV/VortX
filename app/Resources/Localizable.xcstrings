    "VortX needs to quit and reopen to display the app in the new language. Open it again from the Home Screen.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX moet afsluit en heropen om die toepassing in die nuwe taal te wys. Maak dit weer vanaf die tuisskerm oop."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መተግበሪያውን በአዲሱ ቋንቋ ለማሳየት VortX መዘጋትና እንደገና መከፈት አለበት። ከመነሻ ማያ ገጹ ላይ እንደገና ይክፈቱት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج VortX إلى الإنهاء وإعادة الفتح لعرض التطبيق باللغة الجديدة. افتحه من جديد من الشاشة الرئيسية."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqi yeni dildə göstərmək üçün VortX bağlanıb yenidən açılmalıdır. Onu Ana ekrandan yenidən açın."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX трябва да се затвори и отвори отново, за да покаже приложението на новия език. Отворете го отново от началния екран."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন ভাষায় অ্যাপটি দেখাতে VortX বন্ধ করে আবার খুলতে হবে। হোম স্ক্রিন থেকে এটি আবার খুলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX s'ha de tancar i tornar a obrir per mostrar l'aplicació en el nou idioma. Torna a obrir-la des de la pantalla d'inici."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby se aplikace zobrazila v novém jazyce, VortX se musí ukončit a znovu otevřít. Otevřete ji znovu z plochy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX skal lukke og åbne igen for at vise appen på det nye sprog. Åbn den igen fra hjemmeskærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX muss beendet und neu geöffnet werden, um die App in der neuen Sprache anzuzeigen. Öffne sie erneut vom Home-Bildschirm aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το VortX πρέπει να κλείσει και να ανοίξει ξανά για να εμφανιστεί η εφαρμογή στη νέα γλώσσα. Ανοίξτε το ξανά από την αρχική οθόνη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX necesita cerrarse y volver a abrirse para mostrar la app en el nuevo idioma. Vuelve a abrirla desde la pantalla de inicio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakenduse uues keeles kuvamiseks peab VortX sulguma ja uuesti avanema. Ava see uuesti avaekraanilt."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX itxi eta berriro ireki behar da aplikazioa hizkuntza berrian erakusteko. Ireki berriro hasierako pantailatik."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای نمایش برنامه به زبان جدید، VortX باید بسته و دوباره باز شود. آن را از صفحه‌ی اصلی دوباره باز کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX on lopetettava ja avattava uudelleen, jotta sovellus näkyy uudella kielellä. Avaa se uudelleen aloitusnäytöltä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangang mag-quit at muling buksan ang VortX para ipakita ang app sa bagong wika. Buksan itong muli mula sa Home Screen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX doit quitter et redémarrer pour afficher l'app dans la nouvelle langue. Rouvrez-le depuis l'écran d'accueil."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX precisa pecharse e abrirse de novo para amosar a aplicación no novo idioma. Ábrea outra vez desde a pantalla de inicio."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપને નવી ભાષામાં બતાવવા VortX બંધ થઈને ફરી ખૂલવું જરૂરી છે. તેને હોમ સ્ક્રીન પરથી ફરી ખોલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לסגור את VortX ולפתוח אותו מחדש כדי להציג את האפליקציה בשפה החדשה. פתח אותו שוב ממסך הבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप को नई भाषा में दिखाने के लिए VortX को बंद करके फिर से खोलना ज़रूरी है। इसे होम स्क्रीन से दोबारा खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX se mora zatvoriti i ponovno otvoriti da bi se aplikacija prikazala na novom jeziku. Otvorite je ponovno s početnog zaslona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A VortX-nek ki kell lépnie, majd újra meg kell nyílnia, hogy az alkalmazás az új nyelven jelenjen meg. Nyisd meg újra a kezdőképernyőről."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX-ը պետք է փակվի և նորից բացվի՝ ծրագիրը նոր լեզվով ցուցադրելու համար։ Բացեք այն կրկին գլխավոր էկրանից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX perlu ditutup dan dibuka kembali untuk menampilkan aplikasi dalam bahasa baru. Buka lagi dari Layar Utama."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX þarf að loka og opna aftur til að birta forritið á nýja tungumálinu. Opnaðu það aftur af heimaskjánum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX deve chiudersi e riaprirsi per mostrare l'app nella nuova lingua. Riaprila dalla schermata Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい言語でアプリを表示するには、VortX を終了して再起動する必要があります。ホーム画面から再度開いてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ახალ ენაზე გამოსაჩენად VortX უნდა დაიხუროს და ხელახლა გაიხსნას. გახსენით ის თავიდან მთავარი ეკრანიდან."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бағдарламаны жаңа тілде көрсету үшін VortX жабылып, қайта ашылуы тиіс. Оны негізгі экраннан қайта ашыңыз."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX ត្រូវបិទ ហើយបើកឡើងវិញ ដើម្បីបង្ហាញកម្មវិធីជាភាសាថ្មី។ សូមបើកវាម្ដងទៀតពីអេក្រង់ដើម។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಪ್ಲಿಕೇಶನ್ ಅನ್ನು ಹೊಸ ಭಾಷೆಯಲ್ಲಿ ತೋರಿಸಲು VortX ಮುಚ್ಚಿ ಮತ್ತೆ ತೆರೆಯಬೇಕು. ಮುಖಪರದೆಯಿಂದ ಅದನ್ನು ಮತ್ತೆ ತೆರೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 언어로 표시하려면 VortX를 종료한 후 다시 열어야 합니다. 홈 화면에서 다시 실행하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad programa būtų rodoma nauja kalba, VortX turi išsijungti ir atsidaryti iš naujo. Atidarykite ją iš pradžios ekrano."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai parādītu lietotni jaunajā valodā, VortX ir jāaizver un jāatver no jauna. Atveriet to atkārtoti no sākuma ekrāna."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX мора да се затвори и повторно да се отвори за да ја прикаже апликацијата на новиот јазик. Отворете ја повторно од почетниот екран."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പ് പുതിയ ഭാഷയിൽ കാണിക്കാൻ VortX പുറത്തുകടന്ന് വീണ്ടും തുറക്കേണ്ടതുണ്ട്. ഹോം സ്ക്രീനിൽ നിന്ന് അത് വീണ്ടും തുറക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीन भाषेत ॲप दाखवण्यासाठी VortX बंद करून पुन्हा उघडणे आवश्यक आहे. होम स्क्रीनवरून ते पुन्हा उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX perlu keluar dan dibuka semula untuk memaparkan apl dalam bahasa baharu. Buka semula daripada Skrin Utama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX må avsluttes og åpnes på nytt for å vise appen på det nye språket. Åpne den igjen fra Hjem-skjermen."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "एपलाई नयाँ भाषामा देखाउन VortX बन्द भएर फेरि खुल्नुपर्छ। होम स्क्रिनबाट यसलाई फेरि खोल्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX moet afsluiten en opnieuw openen om de app in de nieuwe taal weer te geven. Open hem opnieuw vanaf het beginscherm."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਨੂੰ ਨਵੀਂ ਭਾਸ਼ਾ ਵਿੱਚ ਦਿਖਾਉਣ ਲਈ VortX ਨੂੰ ਬੰਦ ਕਰਕੇ ਮੁੜ ਖੋਲ੍ਹਣ ਦੀ ਲੋੜ ਹੈ। ਇਸਨੂੰ ਹੋਮ ਸਕ੍ਰੀਨ ਤੋਂ ਫਿਰ ਖੋਲ੍ਹੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby wyświetlić aplikację w nowym języku, VortX musi się zamknąć i otworzyć ponownie. Otwórz ją ponownie z ekranu głównego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VortX precisa ser fechado e reaberto para exibir o app no novo idioma. Abra-o novamente na Tela de Início."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O VortX precisa de sair e reabrir para apresentar a aplicação no novo idioma. Abra-o novamente a partir do ecrã principal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX trebuie să se închidă și să se redeschidă pentru a afișa aplicația în noua limbă. Deschide-o din nou de pe ecranul principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы отобразить приложение на новом языке, VortX нужно закрыть и открыть заново. Откройте его снова с главного экрана."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX sa musí ukončiť a znova otvoriť, aby sa aplikácia zobrazila v novom jazyku. Otvorte ju znova z plochy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX se mora zapreti in znova odpreti, da prikaže aplikacijo v novem jeziku. Znova jo odprite z začetnega zaslona."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX duhet të mbyllet dhe të rihapet që ta shfaqë aplikacionin në gjuhën e re. Hapeni sërish nga ekrani bazë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX мора да се затвори и поново отвори да би се приказао на новом језику. Отворите га поново са почетног екрана."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX måste avslutas och öppnas igen för att visa appen på det nya språket. Öppna den igen från hemskärmen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX inahitaji kufunga na kufunguka upya ili kuonyesha programu katika lugha mpya. Ifungue tena kutoka Skrini ya Mwanzo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய மொழியில் செயலியைக் காட்ட VortX வெளியேறி மீண்டும் திறக்க வேண்டும். முகப்புத் திரையிலிருந்து அதை மீண்டும் திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్‌ను కొత్త భాషలో చూపించడానికి VortX నిష్క్రమించి మళ్లీ తెరవాలి. హోమ్ స్క్రీన్ నుండి దాన్ని మళ్లీ తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX ต้องปิดแล้วเปิดใหม่เพื่อแสดงแอปเป็นภาษาใหม่ เปิดอีกครั้งจากหน้าจอโฮม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı yeni dilde göstermek için VortX'in kapatılıp yeniden açılması gerekir. Ana Ekran'dan tekrar açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб показати застосунок новою мовою, VortX потрібно закрити й відкрити знову. Відкрийте його з екрана «Початок»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ کو نئی زبان میں دکھانے کے لیے VortX کو بند کر کے دوبارہ کھولنا ضروری ہے۔ اِسے ہوم اسکرین سے دوبارہ کھولیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX cần thoát và mở lại để hiển thị ứng dụng bằng ngôn ngữ mới. Hãy mở lại từ Màn hình chính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX 需退出并重新打开才能以新语言显示。请从主屏幕再次打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX 必須結束並重新開啟，才能以新語言顯示。請從主畫面再次開啟。"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন ভাষাত এপ্‌টো দেখুৱাবলৈ VortX বন্ধ কৰি পুনৰ খোলিব লাগিব। Home Screen-ৰ পৰা ইয়াক পুনৰ খোলক।"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX павінен закрыцца і адкрыцца зноў, каб паказаць дадатак на новай мове. Адкрыйце яго зноў з галоўнага экрана."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezhomm en deus VortX da serriñ hag adigeriñ evit diskouez an arload er yezh nevez. Digorit anezhañ en-dro adalek ar Skramm Degemer."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX se mora zatvoriti i ponovo otvoriti da prikaže aplikaciju na novom jeziku. Otvorite je ponovo sa početnog ekrana."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang VortX kinahanglan moundang ug moabli pag-usab aron ipakita ang app sa bag-ong pinulongan. Ablihi kini pag-usab gikan sa Home Screen."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae angen i VortX gau ac ailagor i ddangos yr ap yn yr iaith newydd. Agorwch ef eto o'r Sgrin Cartref."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX má lata aftur og upp aftur fyri at vísa appið á nýggja málinum. Lat tað upp aftur frá Heimaskíggjanum."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX moat ôfslute en op 'e nij iepenje om de app yn de nije taal te toanen. Iepenje him op 'e nij fanút it Thússkerm."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní mór do VortX scor agus athoscailt chun an aip a thaispeáint sa teanga nua. Oscail arís í ón Scáileán Baile."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Feumaidh VortX dùnadh agus ath-fhosgladh gus an aplacaid a shealltainn sa chànan ùr. Fosgail a-rithist i on Sgrìn Dachaigh."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX yana buƙatar fita kuma ya sake buɗewa don nuna manhajar a sabon harshe. Buɗe ta kuma daga Allon Gida."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX bezwen fèmen epi relouvri pou montre aplikasyon an nan nouvo lang lan. Louvri l ankò soti nan Ekran Akèy la."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX chọrọ ịkwụsị wee meghee ọzọ iji gosipụta ngwa n'asụsụ ọhụrụ. Meghee ya ọzọ site na Ihuenyo Ụlọ."
          }
        },
        "jv": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX kudu metu lan mbukak manèh kanggo nampilaké app ing basa anyar. Bukak manèh saka Layar Ngarep."
          }
        },
        "ku": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX divê derkeve û ji nû ve veke da ku sepanê bi zimanê nû nîşan bide. Ji Dîmenerê Malê wê ji nû ve veke."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Колдонмону жаңы тилде көрсөтүү үчүн VortX жабылып, кайра ачылышы керек. Аны Башкы экрандан кайра ачыңыз."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX muss zoumaachen an nei opgoen fir d'App an der neier Sprooch unzeweisen. Maach se erëm op vum Startbildschierm."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX ຕ້ອງປິດ ແລະ ເປີດຄືນເພື່ອສະແດງແອັບໃນພາສາໃໝ່. ເປີດມັນອີກຄັ້ງຈາກໜ້າຈໍຫຼັກ."
          }
        },
        "mg": {
          "stringUnit": {
            "state": "translated",
            "value": "Mila mijanona sy misokatra indray ny VortX mba hanehoana ny app amin'ny teny vaovao. Sokafy indray avy amin'ny Efijery Fandraisana."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Me whakamutu, me whakatuwhera anō a VortX kia whakaatu ai i te taupānga i te reo hou. Whakatuwherahia anō mai i te Mata Kāinga."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Аппыг шинэ хэл дээр харуулахын тулд VortX гарч дахин нээгдэх шаардлагатай. Нүүр дэлгэцээс дахин нээнэ үү."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX jeħtieġ jagħlaq u jerġa' jiftaħ biex juri l-app fil-lingwa l-ġdida. Iftaħha mill-ġdid mill-Home Screen."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "app ကို ဘာသာစကားအသစ်ဖြင့် ပြသရန် VortX သည် ထွက်၍ ပြန်ဖွင့်ရန် လိုအပ်သည်။ Home Screen မှ ၎င်းကို ပြန်ဖွင့်ပါ။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX iyenera kutseka ndikutsekulanso kuti iwonetse app mu chilankhulo chatsopano. Itsekulireni kuchokera ku Home Screen."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX se deu tampar e tornar dobrir per afichar l'aplicacion dins la novèla lenga. Tornatz-la dobrir dempuèi l'ecran d'acuèlh."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନୂଆ ଭାଷାରେ ଆପ୍ ଦେଖାଇବାକୁ VortX ବନ୍ଦ ହୋଇ ପୁନଃ ଖୋଲିବା ଆବଶ୍ୟକ। ଏହାକୁ Home ସ୍କ୍ରିନରୁ ପୁନଃ ଖୋଲନ୍ତୁ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX باید وتړل او بیا خلاص شي چې اپ په نوې ژبه وښیي. له کور پردې نه یې بیا خلاص کړئ."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX ikeneye gusohoka no kongera gufungura kugira ngo yerekane porogaramu mu rurimi rushya. Ongera uyifungure uhereye ku Ntangiriro."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "ايپ کي نئين ٻوليءَ ۾ ڏيکارڻ لاءِ VortX کي بند ٿي ٻيهر کلڻو پوندو. ان کي گھر اسڪرين مان ٻيهر کوليو."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "නව භාෂාවෙන් යෙදුම පෙන්වීමට VortX ඉවත් වී නැවත විවෘත විය යුතුය. එය මුල් තිරයෙන් නැවත විවෘත කරන්න."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "E manaomia e VortX ona tapuni ma toe tatala e faaali ai le app i le gagana fou. Toe tatala mai le Mata Home."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX inoda kubuda nokuvhurazve kuti iratidze app mumutauro mutsva. Ivhurezve kubva paHome Screen."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX wuxuu u baahan yahay inuu ka baxo oo dib u furmo si uu app-ka ugu tuso luqadda cusub. Dib uga fur Shaashadda Home."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX e hloka ho koala le ho bula hape ho bontša app ka puo e ncha. E bule hape ho tsoa Home Screen."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX perlu nutup jeung buka deui pikeun némbongkeun aplikasi dina basa anyar. Buka deui tina Layar Utama."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои намоиши барнома бо забони нав VortX бояд баста шуда, аз нав кушода шавад. Онро аз экрани асосӣ аз нав кушоед."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Кушымтаны яңа телдә күрсәтү өчен VortX ябылып кабат ачылырга тиеш. Аны Баш экраннан кабат ач."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "دېتالنى يېڭى تىلدا كۆرسىتىش ئۈچۈن VortX چېكىنىپ قايتا ئېچىلىشى كېرەك. ئۇنى باش ئېكراندىن قايتا ئېچىڭ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilovani yangi tilda ko'rsatish uchun VortX chiqib, qayta ochilishi kerak. Uni Bosh ekrandan qayta oching."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "IVortX ifuna ukuvala ivule kwakhona ukubonisa i-app ngolwimi olutsha. Yivule kwakhona kwiskrini seKhaya."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX nílò láti jáde kí ó sì tún ṣí láti fi app náà hàn ní èdè tuntun. Ṣí i padà láti Home Screen."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "I-VortX idinga ukuphuma iphinde ivuleke ukuze ibonise i-app ngolimi olusha. Yivule futhi kusukela kuSikrini Sasekhaya."
          }
        }
      }
    },
    "Safety filter": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Veiligheidsfilter"
          }
