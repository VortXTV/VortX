        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बिल्ड में टोरेंट इंजन शामिल नहीं है। केवल डायरेक्ट और debrid लिंक ही चल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova verzija ne uključuje torrent pogon. Mogu se reproducirati samo izravne i debrid poveznice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a verzió nem tartalmazza a torrentmotort. Csak közvetlen és debrid linkek játszhatók le."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս տարբերակը չի ներառում թորենտի շարժիչը։ Կարող են նվագարկվել միայն ուղիղ և debrid հղումները։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Build ini tidak menyertakan mesin torrent. Hanya tautan langsung dan debrid yang dapat diputar."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi útgáfa inniheldur ekki torrent-vélina. Aðeins beinir og debrid-tenglar geta spilað."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa build non include il motore torrent. Possono essere riprodotti solo i link diretti e debrid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドにはトレントエンジンが含まれていません。ダイレクトリンクと debrid リンクのみ再生できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს ვერსია არ შეიცავს ტორენტ-ძრავას. მხოლოდ პირდაპირი და debrid ბმულები იკვრება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл құрастырмаға торрент қозғалтқышы кірмеген. Тек тікелей және debrid сілтемелері ойнатылады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កំណែនេះមិនបានភ្ជាប់ម៉ាស៊ីន torrent ទេ។ មានតែតំណផ្ទាល់ និងតំណ debrid ប៉ុណ្ណោះដែលអាចចាក់បាន។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಬಿಲ್ಡ್ ಟೊರೆಂಟ್ ಇಂಜಿನ್ ಅನ್ನು ಒಳಗೊಂಡಿಲ್ಲ. ಕೇವಲ ನೇರ ಮತ್ತು debrid ಲಿಂಕ್‌ಗಳು ಮಾತ್ರ ಪ್ಲೇ ಆಗಬಲ್ಲವು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에는 토렌트 엔진이 포함되어 있지 않습니다. 직접 링크와 debrid 링크만 재생할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šioje versijoje torentų variklio nėra. Leidžiamos tik tiesioginės ir debrid nuorodos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šajā būvējumā nav iekļauts torentu dzinis. Atskaņot var tikai tiešās un debrid saites."
