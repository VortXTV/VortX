    "Preview: plays 2s before start, jumps to end": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorskou: speel 2s voor begin, spring na einde"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ቅድመ እይታ፦ ከመጀመሪያው 2 ሰከንድ በፊት ይጫወታል፣ ወደ መጨረሻ ይዘላል"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معاينة: يُشغَّل قبل البداية بثانيتين، ثم ينتقل إلى النهاية"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "পূৰ্বদৰ্শন: আৰম্ভণিৰ ২ছেকেণ্ড আগতে চলে, শেষলৈ যায়"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Önizləmə: başlanğıcdan 2 san əvvəl oynadılır, sona keçir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Папярэдні прагляд: прайграе 2 с да пачатку, пераходзіць у канец"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преглед: пуска 2 сек преди началото, прескача към края"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রিভিউ: শুরুর ২ সেকেন্ড আগে চালায়, শেষে চলে যায়"
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakwel: seniñ 2e a-raok an deroù, lammat d'an dibenn"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregled: pušta 2s prije početka, skače na kraj"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista prèvia: reprodueix 2 s abans de l'inici i salta al final"
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview: mag-play 2s sa dili pa ang sinugdanan, mo-ambak sa kataposan"
