        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ħadd mill-%1$@ add-on%2$@ tiegħek ma rritorna sors li jista' jindaqq għal dan it-titlu."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင့် add-on %1$@ ခု%2$@ မှ မည်သည့်ခုမျှ ဤခေါင်းစဉ်အတွက် ဖွင့်၍ရသော အရင်းအမြစ်ကို မပြန်ပေးပါ။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "Palibe pa ma add-on anu %1$@%2$@ omwe anapereka gwero losewereseka la mutu uwu."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap de vòstre%2$@ %1$@ modul renviguèt pas una font legibla per aqueste títol."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କ %1$@ ଆଡ୍-ଅନ%2$@ ମଧ୍ୟରୁ କୌଣସିଟି ଏହି ଟାଇଟଲ ପାଇଁ ଏକ ପ୍ଲେ କରିବା ଯୋଗ୍ୟ ଉତ୍ସ ଫେରାଇ ନାହିଁ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "ستاسو له %1$@ اضافه‌ونو%2$@ نه یوه هم د دې سرلیک لپاره د غږولو وړ سرچینه رانه‌ولوله."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nta na kimwe mu byongeramo byawe %1$@ %2$@ cyagaragaje inkomoko ishobora gukina y'iyi nsanganyamatsiko."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "اوهان جي %1$@ ايڊ-آن%2$@ مان ڪنھن به هن عنوان لاءِ هلائڻ لائق ذريعو نه موٽايو."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ %1$@ ඇඩෝන%2$@ කිසිවක් මෙම මාතෘකාව සඳහා වාදනය කළ හැකි මූලාශ්‍රයක් ලබා දුන්නේ නැත."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "E leai se tasi o au %1$@ add-on%2$@ na toe tuuina mai se puna e mafai ona taalo mo lenei ulutala."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapana pane %1$@ chinowedzera chako%2$@ chakadzosa nzvimbo yemvura inotambika yechinyorwa ichi."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Midkoodna %1$@ add-on%2$@-kaaga ma soo celin il la ciyaari karo cinwaankan."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha ho le e 'ngoe ea litlatsetso%2$@ tsa hau %1$@ e fanang ka mohloli o ka bapaloang bakeng sa sehlooho sena."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Taya add-on %1$@%2$@ anjeun nu méré sumber nu bisa diputer pikeun judul ieu."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ҳеҷ яке аз %1$@ иловаи%2$@ шумо барои ин унвон манбаи пахшшаванда барнагардонд."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ өстәмәңнең%2$@ берсе дә бу исем өчен уйнатыла торган чыганак бирмәде."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ قوشۇلمىڭىزنىڭ%2$@ ھېچقايسىسى بۇ ماۋزۇغا قويغىلى بولىدىغان مەنبە قايتۇرمىدى."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ta qo'shimchangizning%2$@ hech biri bu sarlavha uchun ijro etiladigan manba qaytarmadi."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "Akukho nanye kwii-add-on%2$@ zakho ezingu-%1$@ ekhuphe umthombo odlalekayo walo mxholo."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Kò sí ọ̀kan nínú %1$@ add-on%2$@ rẹ tí ó dá orísun tí a lè tú padà fún àkọ́lé yìí."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alikho kwezengezo zakho ezingu-%1$@%2$@ elibuyise umthombo odlalekayo walesi sihloko."
          }
        }
      }
    },
