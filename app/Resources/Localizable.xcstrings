    "%@ can only be edited from that profile": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ può essere modificato solo da quel profilo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ solo puede editarse desde ese perfil"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut être modifié que depuis ce profil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann nur über dieses Profil bearbeitet werden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ só pode ser editado por aquele perfil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はそのプロファイルからのみ編集できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 해당 프로필에서만 편집할 수 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 只能从该配置文件中编辑"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ можно редактировать только из этого профиля"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को केवल उसी प्रोफ़ाइल से संपादित किया जा सकता है"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تعديل %@ من ذلك الملف الشخصي فقط"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yalnızca o profilden düzenlenebilir"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ só pode ser editado a partir desse perfil"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan alleen vanuit dat profiel worden bewerkt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ można edytować tylko z tego profilu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan bara redigeras från den profilen"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 只能從該設定檔編輯"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hanya dapat diedit dari profil tersebut"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ แก้ไขได้จากโปรไฟล์นั้นเท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chỉ có thể chỉnh sửa từ hồ sơ đó"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ можна редагувати лише з того профілю"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lze upravit jen z daného profilu"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ μπορεί να επεξεργαστεί μόνο από εκείνο το προφίλ"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ניתן לעריכה רק מאותו פרופיל"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan kun redigeres fra den profil"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ voidaan muokata vain kyseisestä profiilista"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan bare redigeres fra den profilen"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ poate fi editat doar din acel profil"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ csak abból a profilból szerkeszthető"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hanya boleh disunting daripada profil itu"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ay ma-e-edit lamang mula sa profile na iyon"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ فقط از همان نمایه قابل ویرایش است"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ শুধু সেই প্রোফাইল থেকেই সম্পাদনা করা যায়"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ அந்தச் சுயவிவரத்திலிருந்து மட்டுமே திருத்த முடியும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఆ ప్రొఫైల్ నుండి మాత్రమే ఎడిట్ చేయవచ్చు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ फक्त त्या प्रोफाइलमधूनच संपादित करता येईल"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ફક્ત તે પ્રોફાઇલમાંથી જ સંપાદિત કરી શકાય છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಅನ್ನು ಆ ಪ್ರೊಫೈಲ್‌ನಿಂದ ಮಾತ್ರ ಸಂಪಾದಿಸಬಹುದು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ആ പ്രൊഫൈലിൽ നിന്ന് മാത്രമേ എഡിറ്റ് ചെയ്യാനാകൂ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کو صرف اسی پروفائل سے ترمیم کیا جا سکتا ہے"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ možno upraviť len z daného profilu"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ може да се редактира само от този профил"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se može uređivati samo iz tog profila"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ се може уређивати само са тог профила"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je mogoče urejati samo iz tega profila"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ galima redaguoti tik iš to profilio"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ var rediģēt tikai no šī profila"
          }
        },
        "et": {
          "stringUnit": {
