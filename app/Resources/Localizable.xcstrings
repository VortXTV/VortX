    "Keep this file safe. Restore it in VortX to bring your settings across.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou hierdie lêer veilig. Herstel dit in VortX om jou instellings oor te bring."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህን ፋይል በደህና ይያዙት። ቅንብሮችዎን ለማስተላለፍ በVortX ውስጥ ያድሱት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بهذا الملف في مكان آمن. استعِده في VortX لنقل إعداداتك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu faylı təhlükəsiz saxlayın. Ayarlarınızı köçürmək üçün onu VortX-də bərpa edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пазете този файл на сигурно място. Възстановете го във VortX, за да прехвърлите настройките си."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফাইলটি নিরাপদে রাখুন। আপনার সেটিংস ফিরিয়ে আনতে VortX-এ এটি রিস্টোর করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda aquest fitxer en un lloc segur. Restaura'l a VortX per recuperar la teva configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchovejte tento soubor v bezpečí. Obnovte jej ve VortX a přeneste si tak svá nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opbevar denne fil sikkert. Gendan den i VortX for at overføre dine indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre diese Datei sicher auf. Stelle sie in VortX wieder her, um deine Einstellungen zu übertragen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φυλάξτε αυτό το αρχείο. Επαναφέρετέ το στο VortX για να μεταφέρετε τις ρυθμίσεις σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda este archivo en un lugar seguro. Restáuralo en VortX para trasladar tus ajustes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia see fail kindlas kohas. Taasta see VortXis, et oma seaded üle tuua."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gorde fitxategi hau leku seguruan. Berrezarri VortXen zure ezarpenak ekartzeko."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این فایل را در جای امنی نگه دارید. برای انتقال تنظیمات‌تان، آن را در VortX بازیابی کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilytä tämä tiedosto turvallisesti. Palauta se VortX:ssä siirtääksesi asetuksesi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itago nang ligtas ang file na ito. I-restore ito sa VortX para mailipat ang iyong mga setting."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez ce fichier en lieu sûr. Restaurez-le dans VortX pour récupérer vos réglages."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Garda este ficheiro nun lugar seguro. Restáurao en VortX para recuperar a túa configuración."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફાઇલ સલામત રાખો. તમારી સેટિંગ પાછી લાવવા VortX માં તેને રિસ્ટોર કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור על קובץ זה במקום בטוח. שחזר אותו ב-VortX כדי להעביר את ההגדרות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ाइल को सुरक्षित रखें। अपनी सेटिंग्स को वापस लाने के लिए इसे VortX में पुनर्स्थापित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čuvajte ovu datoteku na sigurnom. Vratite je u VortX da biste prenijeli svoje postavke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Őrizd meg biztonságos helyen ezt a fájlt. Állítsd vissza a VortX-ben, hogy átvigyed a beállításaidat."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահեք այս ֆայլն ապահով տեղում։ Վերականգնեք այն VortX-ում՝ ձեր կարգավորումները փոխանցելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan berkas ini dengan aman. Pulihkan di VortX untuk membawa pengaturan Anda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Geymdu þessa skrá á öruggum stað. Endurheimtu hana í VortX til að flytja stillingarnar þínar yfir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva questo file in un luogo sicuro. Ripristinalo in VortX per trasferire le tue impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは大切に保管してください。VortX で復元すると設定を引き継げます。"
