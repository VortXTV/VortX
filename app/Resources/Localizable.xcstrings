    "Saved this profile's titles and watch history. Import it on another device or into another profile.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie profiel se titels en kykgeskiedenis is gestoor. Voer dit op 'n ander toestel of in 'n ander profiel in."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የዚህን መገለጫ ርዕሶችና የመመልከት ታሪክ አስቀምጧል። በሌላ መሣሪያ ላይ ወይም ወደ ሌላ መገለጫ ያስገቡት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ عناوين هذا الملف الشخصي وسجل المشاهدة. استورِدها على جهاز آخر أو في ملف شخصي آخر."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profilin başlıqları və izləmə tarixçəsi yadda saxlanıldı. Onu başqa cihaza və ya başqa profilə idxal edin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Заглавията и историята на гледане за този профил са запазени. Импортирайте ги на друго устройство или в друг профил."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই প্রোফাইলের টাইটেল ও দেখার ইতিহাস সংরক্ষণ করা হয়েছে। অন্য ডিভাইসে বা অন্য প্রোফাইলে এটি ইম্পোর্ট করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'han desat els títols i l'historial de reproducció d'aquest perfil. Importa'l a un altre dispositiu o a un altre perfil."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tituly a historie sledování tohoto profilu byly uloženy. Naimportujte je na jiném zařízení nebo do jiného profilu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemte denne profils titler og se-historik. Importer den på en anden enhed eller til en anden profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel und Wiedergabeverlauf dieses Profils wurden gespeichert. Importiere sie auf einem anderen Gerät oder in ein anderes Profil."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύτηκαν οι τίτλοι και το ιστορικό παρακολούθησης αυτού του προφίλ. Εισαγάγετέ τα σε άλλη συσκευή ή σε άλλο προφίλ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han guardado los títulos y el historial de este perfil. Impórtalo en otro dispositivo o en otro perfil."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle profiili pealkirjad ja vaatamisajalugu salvestati. Impordi need teise seadmesse või teise profiili."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil honen izenburuak eta ikusketa historia gorde dira. Inportatu beste gailu batean edo beste profil batean."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان‌ها و تاریخچه‌ی تماشای این نمایه ذخیره شد. آن را در دستگاهی دیگر یا در نمایه‌ای دیگر درون‌بری کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallensi tämän profiilin nimikkeet ja katseluhistorian. Tuo se toiselle laitteelle tai toiseen profiiliin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-save ang mga title at history ng panonood ng profile na ito. I-import ito sa ibang device o sa ibang profile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres et l'historique de visionnage de ce profil ont été enregistrés. Importez-les sur un autre appareil ou dans un autre profil."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardáronse os títulos e o historial de visualizado deste perfil. Impórtao noutro dispositivo ou noutro perfil."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ પ્રોફાઇલની ટાઇટલ અને જોવાનો ઇતિહાસ સાચવ્યો. તેને બીજા ઉપકરણ પર અથવા બીજી પ્રોફાઇલમાં ઇમ્પોર્ટ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכותרים והיסטוריית הצפייה של פרופיל זה נשמרו. ייבא אותם במכשיר אחר או לפרופיל אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रोफ़ाइल के शीर्षक और देखने का इतिहास सहेज लिया। इसे किसी अन्य डिवाइस पर या किसी अन्य प्रोफ़ाइल में आयात करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljeni su naslovi i povijest gledanja ovog profila. Uvezite ih na drugi uređaj ili u drugi profil."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentve ennek a profilnak a címei és megtekintési előzményei. Importáld egy másik eszközre vagy egy másik profilba."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահպանվեցին այս պրոֆիլի վերնագրերն ու դիտման պատմությունը։ Ներմուծեք այն մեկ այլ սարքում կամ մեկ այլ պրոֆիլ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan judul dan riwayat tontonan profil ini. Impor di perangkat lain atau ke profil lain."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vistaði titla og áhorfssögu þessa notandasniðs. Fluttu það inn í annað tæki eða annað notandasnið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono stati salvati i titoli e la cronologia di visione di questo profilo. Importali su un altro dispositivo o in un altro profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロフィールのタイトルと視聴履歴を保存しました。別のデバイスや別のプロフィールに読み込めます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენახულია ამ პროფილის ერთეულები და ყურების ისტორია. დააიმპორტეთ სხვა მოწყობილობაზე ან სხვა პროფილში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы профильдің атаулары мен көру тарихы сақталды. Оны басқа құрылғыда немесе басқа профильге импорттаңыз."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានរក្សាទុកចំណងជើង និងប្រវត្តិមើលរបស់ប្រវត្តិរូបនេះ។ នាំចូលវានៅលើឧបករណ៍ផ្សេង ឬចូលក្នុងប្រវត្តិរូបផ្សេង។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಪ್ರೊಫೈಲ್‌ನ ಶೀರ್ಷಿಕೆಗಳು ಮತ್ತು ವೀಕ್ಷಣಾ ಇತಿಹಾಸವನ್ನು ಉಳಿಸಲಾಗಿದೆ. ಅದನ್ನು ಇನ್ನೊಂದು ಸಾಧನದಲ್ಲಿ ಅಥವಾ ಇನ್ನೊಂದು ಪ್ರೊಫೈಲ್‌ಗೆ ಆಮದು ಮಾಡಿಕೊಳ್ಳಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필의 콘텐츠와 시청 기록을 저장했습니다. 다른 기기나 다른 프로필로 가져올 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išsaugoti šio profilio pavadinimai ir žiūrėjimo istorija. Importuokite juos kitame įrenginyje arba į kitą profilį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī profila ieraksti un skatīšanās vēsture ir saglabāti. Importējiet tos citā ierīcē vai citā profilā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ги зачував насловите и историјата на гледање на овој профил. Увезете ги на друг уред или во друг профил."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പ്രൊഫൈലിന്റെ ടൈറ്റിലുകളും കാണൽ ചരിത്രവും സംരക്ഷിച്ചു. മറ്റൊരു ഉപകരണത്തിലോ മറ്റൊരു പ്രൊഫൈലിലേക്കോ ഇത് ഇമ്പോർട്ട് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या प्रोफाइलची शीर्षके आणि पाहण्याचा इतिहास जतन केला. ती दुसऱ्या डिव्हाइसवर किंवा दुसऱ्या प्रोफाइलमध्ये इम्पोर्ट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan tajuk dan sejarah tontonan profil ini. Importnya pada peranti lain atau ke dalam profil lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret denne profilens titler og avspillingshistorikk. Importer den på en annen enhet eller inn i en annen profil."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो प्रोफाइलका शीर्षक र हेराइ इतिहास सुरक्षित गरियो। अर्को उपकरणमा वा अर्को प्रोफाइलमा यसलाई आयात गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De titels en kijkgeschiedenis van dit profiel zijn opgeslagen. Importeer ze op een ander apparaat of in een ander profiel."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਪ੍ਰੋਫ਼ਾਈਲ ਦੇ ਟਾਈਟਲ ਅਤੇ ਦੇਖਣ ਦਾ ਇਤਿਹਾਸ ਸੰਭਾਲ ਲਏ। ਇਸਨੂੰ ਕਿਸੇ ਹੋਰ ਡਿਵਾਈਸ 'ਤੇ ਜਾਂ ਕਿਸੇ ਹੋਰ ਪ੍ਰੋਫ਼ਾਈਲ ਵਿੱਚ ਇੰਪੋਰਟ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano tytuły i historię oglądania tego profilu. Zaimportuj je na innym urządzeniu lub do innego profilu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvou os títulos e o histórico de exibição deste perfil. Importe em outro dispositivo ou em outro perfil."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardou os títulos e o histórico de visualização deste perfil. Importe-os noutro dispositivo ou noutro perfil."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Au fost salvate titlurile și istoricul vizionărilor acestui profil. Importă-le pe alt dispozitiv sau într-un alt profil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи и история просмотра этого профиля сохранены. Импортируйте их на другом устройстве или в другой профиль."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložili sa tituly a história sledovania tohto profilu. Naimportujte ich do iného zariadenia alebo do iného profilu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslovi in zgodovina gledanja tega profila so shranjeni. Uvozite jih v drugo napravo ali drug profil."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "U ruajtën titujt dhe historiku i shikimit i këtij profili. Importojeni në një pajisje tjetër ose në një profil tjetër."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Сачувани су наслови и историја гледања овог профила. Увезите их на други уређај или у други профил."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparade den här profilens titlar och tittarhistorik. Importera den på en annan enhet eller till en annan profil."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imehifadhi vichwa vya habari na historia ya kutazama ya wasifu huu. Iingize katika kifaa kingine au katika wasifu mwingine."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சுயவிவரத்தின் தலைப்புகள் மற்றும் பார்த்த வரலாறு சேமிக்கப்பட்டது. இதை மற்றொரு சாதனத்தில் அல்லது மற்றொரு சுயவிவரத்தில் இறக்குமதி செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ప్రొఫైల్ టైటిల్‌లు మరియు చూసిన చరిత్రను సేవ్ చేసింది. దీన్ని మరో పరికరంలో లేదా మరో ప్రొఫైల్‌లోకి దిగుమతి చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกเรื่องและประวัติการดูของโปรไฟล์นี้แล้ว นำเข้าในอุปกรณ์อื่นหรือโปรไฟล์อื่นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profilin içerikleri ve izleme geçmişi kaydedildi. Başka bir cihaza veya başka bir profile içe aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережено фільми й серіали та історію перегляду цього профілю. Імпортуйте їх на іншому пристрої або в інший профіль."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اِس پروفائل کے عنوانات اور دیکھنے کی تاریخ محفوظ کر لی۔ اِسے کسی دوسرے ڈیوائس پر یا کسی دوسری پروفائل میں امپورٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu các tựa phim và lịch sử xem của hồ sơ này. Hãy nhập vào thiết bị khác hoặc hồ sơ khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存此用户的影片和观看记录。可在其他设备上或导入到其他用户中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存此設定檔的影片與觀看記錄。可在其他裝置或匯入至其他設定檔。"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এই প্ৰ'ফাইলৰ শিৰোনাম আৰু চোৱাৰ ইতিহাস সাঁচি থোৱা হ'ল। ইয়াক আন এটা ডিভাইচত বা আন এটা প্ৰ'ফাইলত ইম্প'ৰ্ট কৰক।"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Захаваны тайтлы і гісторыя прагляду гэтага профілю. Імпартуйце іх на іншай прыладзе ці ў іншы профіль."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Enrollet titloù an aelad-mañ hag e istor sellet. Enporzhiit anezhañ war un ardivink all pe en un aelad all."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sačuvani su naslovi ovog profila i historija gledanja. Uvezite ih na drugi uređaj ili u drugi profil."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-save ang mga titulo ug watch history niini nga profile. I-import kini sa laing device o ngadto sa laing profile."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadwyd teitlau a hanes gwylio'r proffil hwn. Mewnforiwch ef ar ddyfais arall neu i broffil arall."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Goymdi titlar og hyggisøgu hesarar vangamyndar. Innflyt tað á eina aðra eind ella í eina aðra vangamynd."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "De titels en sjochskiednis fan dit profyl binne bewarre. Ymportearje it op in oar apparaat of yn in oar profyl."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Sábháladh teidil na próifíle seo agus a stair féachana. Iompórtáil é ar ghléas eile nó isteach i bpróifíl eile."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaidh tiotalan na pròifil seo agus eachdraidh coimhid a shàbhaladh. Ion-phortaich air inneal eile no gu pròifil eile e."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An adana taken wannan bayanin martaba da tarihin kallo. Shigo da shi a wata na'ura ko cikin wani bayanin martaba."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Sove tit ak istorik gade pwofil sa a. Enpòte l sou yon lòt aparèy oswa nan yon lòt pwofil."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Echekwara aha na akụkọ nlele nke profaịlụ a. Bubata ya na ngwaọrụ ọzọ ma ọ bụ n'ime profaịlụ ọzọ."
          }
        },
        "jv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyimpen judhul lan riwayat tonton profil iki. Impor ing piranti liyané utawa menyang profil liyané."
          }
        },
        "ku": {
          "stringUnit": {
            "state": "translated",
            "value": "Sernav û dîroka temaşekirina vê profîlê hat tomarkirin. Wê li amûrek an profîleke din împort bike."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Бул профилдин аталыштарын жана көрүү тарыхын сактады. Аны башка түзмөккө же башка профилге импорттоңуз."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "D'Titelen an d'Kucks-Historik vun dësem Profil gespäichert. Importéier se op engem aneren Apparat oder an en anere Profil."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບັນທຶກລາຍການ ແລະ ປະຫວັດການເບິ່ງຂອງໂປຣໄຟລ໌ນີ້ແລ້ວ. ນຳເຂົ້າມັນໃນອຸປະກອນອື່ນ ຫຼື ເຂົ້າໃນໂປຣໄຟລ໌ອື່ນ."
          }
        },
        "mg": {
          "stringUnit": {
            "state": "translated",
            "value": "Voatahiry ny lohatenin'ity profil ity sy ny tantaram-pijerena. Afaro amin'ny fitaovana hafa na anaty profil hafa."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kua tiakina ngā taitara me te hītori mātakitaki o tēnei kōtaha. Kawemaihia ki tētahi atu pūrere, ki tētahi atu kōtaha rānei."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ профайлын контент болон үзсэн түүхийг хадгаллаа. Өөр төхөөрөмж эсвэл өөр профайл руу импортлоно уу."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ħżint it-titli u l-istorja tal-wiri ta' dan il-profil. Importah fuq apparat ieħor jew ġo profil ieħor."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤပရိုဖိုင်၏ ခေါင်းစဉ်များနှင့် ကြည့်ရှုမှုမှတ်တမ်းကို သိမ်းပြီးပါပြီ။ ၎င်းကို အခြားစက်ပေါ်တွင် သို့မဟုတ် အခြားပရိုဖိုင်ထဲသို့ တင်သွင်းပါ။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasunga mitu ndi mbiri ya kuwonera ya profile iyi. Tumizani pa chipangizo china kapena mu profile ina."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títols e l'istoric de visionatge d'aqueste perfil son enregistrats. Importatz-los sus un autre aparelh o dins un autre perfil."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ପ୍ରୋଫାଇଲର ଟାଇଟଲ ଏବଂ ୱାଚ୍ ଇତିହାସ ସାଇତ ହୋଇଗଲା। ଏହାକୁ ଅନ୍ୟ ଏକ ଡିଭାଇସରେ କିମ୍ବା ଅନ୍ୟ ଏକ ପ୍ରୋଫାଇଲରେ ଆମଦାନୀ କରନ୍ତୁ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "د دې پروفایل سرلیکونه او د کتلو تاریخچه وساتل شوه. په بله وسیله یا بل پروفایل کې یې راوارد کړئ."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Byabitse insanganyamatsiko z'uyu mwirondoro n'amateka yo kureba. Yinjize ku kindi cyuma cyangwa mu wundi mwirondoro."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "هن پروفائل جا عنوان ۽ ڏسڻ جي تاريخ محفوظ ٿي. ان کي ٻئي ڊوائيس تي يا ٻئي پروفائل ۾ امپورٽ ڪريو."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙම පැතිකඩේ මාතෘකා සහ නැරඹීම් ඉතිහාසය සුරැකිණි. එය වෙනත් උපාංගයක හෝ වෙනත් පැතිකඩකට ආයාත කරන්න."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "Ua sefe ulutala a lenei tala faasino patino ma tala faasolopito o le matamata. Faaulufale i se isi masini pe i se isi tala faasino patino."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvachengetwa zvinyorwa zvepurofaira iyi nenhoroondo yokuona. Zvipinze pane imwe dhivhaisi kana mune imwe purofaira."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Waxaa la kaydiyay cinwaannada profile-kan iyo taariikhda daawashada. Ku soo deji qalab kale ama profile kale."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "E bolokile lihlooho tsa profaele ena le nalane ea ho shebella. E kenye ho sesebelisoa se seng kapa profaeleng e 'ngoe."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyimpen judul jeung riwayat lalajo profil ieu. Impor dina alat séjén atawa kana profil séjén."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Унвонҳо ва таърихи тамошои ин профил нигоҳ дошта шуданд. Онро дар дастгоҳи дигар ё ба профили дигар ворид кунед."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Бу профильнең исемнәрен һәм карау тарихын сакладым. Аны башка җиһазда яки башка профильгә импортла."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بۇ سەپلىمىنىڭ ماۋزۇلىرى ۋە كۆرۈش تارىخى ساقلاندى. ئۇنى باشقا ئۈسكۈنى ياكى باشقا سەپلىمىگە ئەكىرىڭ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profilning sarlavhalari va ko'rish tarixi saqlandi. Uni boshqa qurilmada yoki boshqa profilga import qiling."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kugcinwe imixholo yale profayile kunye nembali yokubukela. Yingenise kwesinye isixhobo okanye kwenye iprofayile."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A tọ́jú àwọn àkọ́lé profaìlì yìí àti ìtàn ìwò. Kó o wọlé sórí ẹ̀rọ mìíràn tàbí sínú profaìlì mìíràn."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulondolozwe izihloko zale phrofayela nomlando wokubuka. Yingenise kwenye idivayisi noma kwenye iphrofayela."
          }
        }
      }
    },
