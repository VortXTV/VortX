    "Switches the whole app to this language. VortX must quit and reopen to apply it.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel die hele toepassing na hierdie taal toe. VortX moet afsluit en heropen om dit toe te pas."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሙሉ መተግበሪያውን ወደዚህ ቋንቋ ይቀይራል። ይህን ለመተግበር VortX መዘጋትና እንደገና መከፈት አለበት።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحوّل التطبيق بالكامل إلى هذه اللغة. يجب إنهاء VortX وإعادة فتحه لتطبيق التغيير."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün tətbiqi bu dilə keçirir. Tətbiq edilməsi üçün VortX bağlanıb yenidən açılmalıdır."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Превключва цялото приложение на този език. VortX трябва да се затвори и отвори отново, за да се приложи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুরো অ্যাপটিকে এই ভাষায় পরিবর্তন করে। প্রয়োগ করতে VortX বন্ধ করে আবার খুলতে হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvia tota l'aplicació a aquest idioma. VortX s'ha de tancar i tornar a obrir per aplicar-ho."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepne celou aplikaci do tohoto jazyka. Aby se změna projevila, VortX se musí ukončit a znovu otevřít."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skifter hele appen til dette sprog. VortX skal lukke og åbne igen for at anvende det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt die gesamte App auf diese Sprache um. VortX muss beendet und neu geöffnet werden, um die Änderung anzuwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάζει ολόκληρη την εφαρμογή σε αυτή τη γλώσσα. Το VortX πρέπει να κλείσει και να ανοίξει ξανά για να εφαρμοστεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia toda la app a este idioma. VortX debe cerrarse y volver a abrirse para aplicarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülitab kogu rakenduse sellele keelele. Rakendamiseks peab VortX sulguma ja uuesti avanema."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikazio osoa hizkuntza honetara aldatzen du. VortX itxi eta berriro ireki behar da aldaketa aplikatzeko."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کل برنامه را به این زبان تغییر می‌دهد. برای اعمال، VortX باید بسته و دوباره باز شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihtaa koko sovelluksen tälle kielelle. VortX on lopetettava ja avattava uudelleen, jotta muutos tulee voimaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Inililipat ang buong app sa wikang ito. Kailangang mag-quit at muling buksan ang VortX para mailapat ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bascule toute l'app dans cette langue. VortX doit quitter et redémarrer pour l'appliquer."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia toda a aplicación a este idioma. VortX debe pecharse e abrirse de novo para aplicalo."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આખી ઍપને આ ભાષામાં બદલે છે. તેને લાગુ કરવા VortX બંધ થઈને ફરી ખૂલવું જરૂરી છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחליף את כל האפליקציה לשפה זו. יש לסגור את VortX ולפתוח אותו מחדש כדי להחיל את השינוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे ऐप को इस भाषा में बदल देता है। इसे लागू करने के लिए VortX को बंद करके फिर से खोलना ज़रूरी है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prebacuje cijelu aplikaciju na ovaj jezik. VortX se mora zatvoriti i ponovno otvoriti da bi se primijenilo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egész alkalmazást erre a nyelvre váltja. A VortX-nek ki kell lépnie, majd újra meg kell nyílnia az alkalmazáshoz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխում է ամբողջ ծրագիրն այս լեզվի։ VortX-ը պետք է փակվի և նորից բացվի՝ կիրառելու համար։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah seluruh aplikasi ke bahasa ini. VortX harus ditutup dan dibuka kembali untuk menerapkannya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skiptir öllu forritinu yfir á þetta tungumál. VortX þarf að loka og opna aftur til að virkja það."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta l'intera app su questa lingua. VortX deve chiudersi e riaprirsi per applicarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ全体をこの言語に切り替えます。適用するには VortX を終了して再起動する必要があります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მთელ აპლიკაციას ამ ენაზე გადართავს. გამოსაყენებლად VortX უნდა დაიხუროს და ხელახლა გაიხსნას."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүкіл бағдарламаны осы тілге ауыстырады. Қолдану үшін VortX жабылып, қайта ашылуы тиіс."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្ដូរកម្មវិធីទាំងមូលទៅភាសានេះ។ VortX ត្រូវបិទ ហើយបើកឡើងវិញ ដើម្បីអនុវត្តវា។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಪೂರ್ಣ ಅಪ್ಲಿಕೇಶನ್ ಅನ್ನು ಈ ಭಾಷೆಗೆ ಬದಲಾಯಿಸುತ್ತದೆ. ಇದನ್ನು ಅನ್ವಯಿಸಲು VortX ಮುಚ್ಚಿ ಮತ್ತೆ ತೆರೆಯಬೇಕು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 전체를 이 언어로 전환합니다. 적용하려면 VortX를 종료한 후 다시 열어야 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perjungia visą programą į šią kalbą. Kad pakeitimas įsigaliotų, VortX turi išsijungti ir atsidaryti iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārslēdz visu lietotni uz šo valodu. Lai to lietotu, VortX ir jāaizver un jāatver no jauna."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ја префрла целата апликација на овој јазик. VortX мора да се затвори и повторно да се отвори за да се примени."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പ് മുഴുവൻ ഈ ഭാഷയിലേക്ക് മാറ്റുന്നു. ഇത് പ്രയോഗിക്കാൻ VortX പുറത്തുകടന്ന് വീണ്ടും തുറക്കണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संपूर्ण ॲप या भाषेत बदलते. लागू करण्यासाठी VortX बंद करून पुन्हा उघडावे लागेल."
          }
        },
        "ms": {
