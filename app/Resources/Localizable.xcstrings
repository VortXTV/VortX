        "jv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dhelikaké / Wajibaké cocog karo tembung dipisah koma ing jeneng sumber. Uripaké regex kanggo pola lengkap."
          }
        },
        "ku": {
          "stringUnit": {
            "state": "translated",
            "value": "Veşêre / Hewce peyvên bi bêhnok veqetandî di navê çavkaniyê de hevber dikin. Ji bo şêweyên tijî regexê veke."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жашыруу / Талап кылуу булак атындагы үтүр менен ажыратылган сөздөргө дал келет. Толук үлгүлөр үчүн regex'ти күйгүзүңүз."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstoppen / Verlaangen gläicht mat Komma getrennt Wierder am Quellennumm of. Schalt Regex un fir voll Muster."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຊື່ອງ / ຕ້ອງມີ ຈະຈັບຄູ່ຄຳທີ່ຄັ່ນດ້ວຍຈຸດໃນຊື່ແຫຼ່ງ. ເປີດ regex ສຳລັບຮູບແບບເຕັມ."
          }
        },
        "mg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ny Afeno / Takio dia mifanaraka amin'ny teny misaraka amin'ny faingo ao amin'ny anaran'ny loharano. Alefaso ny regex ho an'ny lamina feno."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka taurite te Huna / Hiahia i ngā kupu kua wehea-e-te-piko i te ingoa pūtake. Whakakāhia te regex mō ngā tauira katoa."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нуух / Шаардах нь эх сурвалжийн нэрэнд байгаа таслалаар тусгаарласан үгсийг тааруулна. Бүрэн загварын хувьд regex-г асаагаарай."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aħbi / Ħtieġ iqabblu kliem separat bil-virgola fl-isem tas-sors. Ixgħel ir-regex għal patterns sħaħ."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide / Require သည် အရင်းအမြစ်အမည်ရှိ ကော်မာခြားထားသော စကားလုံးများနှင့် တိုက်ဆိုင်သည်။ ပုံစံအပြည့်အစုံအတွက် regex ကို ဖွင့်ပါ။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide / Require amafananitsa mawu olekanitsidwa ndi koma mu dzina la gwero. Yatsani regex kuti mupeze ma pattern athunthu."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Amagar / Requerir correspondon a de mots separats per virgula dins lo nom de la font. Activatz lo regex pels motius complets."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide / Require ଉତ୍ସ ନାମରେ କମା-ଅଲଗା ଶବ୍ଦ ମେଳାଏ। ପୂର୍ଣ୍ଣ ପ୍ୟାଟର୍ନ ପାଇଁ regex ଚାଲୁ କରନ୍ତୁ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "پټول / اړینول د سرچینې په نوم کې د کامې په واسطه جلا کلیمې سره برابروي. د بشپړو نمونو لپاره regex فعال کړئ."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Guhisha / Gusaba bihuza amagambo atandukanijwe n'akitso mu izina ry'inkomoko. Fungura regex ku miterere yuzuye."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "لڪايو / لازمي ذريعي جي نالي ۾ ڪاما سان الڳ ٿيل لفظن سان ملن ٿا. مڪمل نمونن لاءِ regex آن ڪريو."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සඟවන්න / අවශ්‍යයි මූලාශ්‍ර නාමයේ කොමා වලින් වෙන් කළ වචන ගළපයි. සම්පූර්ණ රටා සඳහා regex ක්‍රියාත්මක කරන්න."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "E fetaui le Nana / Manaomia ma upu vaevae-i-koma i le igoa o le puna. Ki le regex mo mamanu atoatoa."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide / Require zvinoenzanisa mazwi akaparadzaniswa nekoma muzita renzvimbo. Batidza regex kuti uwane mapatani azere."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide / Require waxay u barbardhigaan erayo hakad ku kala go'ay magaca isha. Shid regex qaababka buuxa."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide / Require e bapisa mantsoe a arohantsoeng ka comma lebitsong la mohloli. Bulela regex bakeng sa di-pattern tse felletseng."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumputkeun / Wajibkeun nyocogkeun kecap nu dipisah koma dina ngaran sumber. Hurungkeun regex pikeun pola pinuh."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пинҳон / Талаб калимаҳои бо вергул ҷудошударо дар номи манбаъ мутобиқ мекунанд. Барои қолибҳои пурра regex-ро фаъол кунед."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Яшер / Кирәк чыганак атамасында өтер белән аерылган сүзләрне тәңгәлләштерә. Тулы үрнәкләр өчен regex'ны кабыз."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "«يوشۇرۇش / تەلەپ قىلىش» مەنبە ئىسمىدىكى پەش بىلەن ئايرىلغان سۆزلەرگە ماسلىشىدۇ. تولۇق ئەندىزىلەر ئۈچۈن مۇنتىزىم ئىپادىنى ئېچىڭ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yashirish / Talab qilish manba nomidagi vergul bilan ajratilgan so'zlarga mos keladi. To'liq naqshlar uchun regex'ni yoqing."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "IFihla / Funa ifanisa amagama ahlulwe ngekoma kwigama lomthombo. Vula i-regex kwiipateni ezipheleleyo."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide / Require máa ń bá àwọn ọ̀rọ̀ tí kọ́mà pín mu nínú orúkọ orísun. Ṣí regex fún àwọn àpẹẹrẹ kíkún."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "I-Fihla / Dinga kufanisa amagama ahlukaniswe ngokhefana egameni lomthombo. Vula i-regex kumaphethini agcwele."
          }
        }
      }
    },
