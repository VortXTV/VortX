        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piilottaa CAM- ja valelaatuiset lähteet. Piilota- ja Vaadi-sanat suodattavat luettelon nimen perusteella (pilkuin eroteltuna)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinatago ang mga CAM at pekeng-kalidad na source. Ang mga salitang Itago / Kailanganin ay nagsasala ng listahan ayon sa pangalan (pinaghihiwalay ng kuwit)."
          }
        },
        "fr": {
