    "%@ %@ skipped: only standard catalog titles can be added to the main profile's account library.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ oorgeslaan: net standaard-katalogustitels kan by die hoofprofiel se rekeningbiblioteek gevoeg word."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ ተዘሏል፦ ወደ ዋናው መገለጫ መለያ ቤተ-መጻሕፍት ሊታከሉ የሚችሉት መደበኛ የካታሎግ ርዕሶች ብቻ ናቸው።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخطّي %@ %@: يمكن إضافة عناوين الكتالوج القياسية فقط إلى مكتبة حساب الملف الشخصي الرئيسي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ ötürüldü: əsas profilin hesab kitabxanasına yalnız standart kataloq başlıqları əlavə edilə bilər."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ пропуснати: към библиотеката на основния профил могат да се добавят само стандартни заглавия от каталога."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ বাদ দেওয়া হয়েছে: মূল প্রোফাইলের অ্যাকাউন্ট লাইব্রেরিতে শুধু স্ট্যান্ডার্ড ক্যাটালগ টাইটেল যোগ করা যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ omès: només es poden afegir títols del catàleg estàndard a la biblioteca del compte del perfil principal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ přeskočeno: do knihovny účtu hlavního profilu lze přidat pouze standardní tituly z katalogu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ sprunget over: kun standardkatalogtitler kan tilføjes til hovedprofilens kontobibliotek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ übersprungen: Nur Titel aus dem Standardkatalog können zur Konto-Bibliothek des Hauptprofils hinzugefügt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ παραλείφθηκαν: μόνο τυπικοί τίτλοι καταλόγου μπορούν να προστεθούν στη βιβλιοθήκη λογαριασμού του κύριου προφίλ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ omitió: solo se pueden añadir títulos del catálogo estándar a la biblioteca de la cuenta del perfil principal."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ jäeti vahele: põhiprofiili konto teeki saab lisada ainult standardseid katalooginimetusi."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ saltatu d(ir)a: katalogo estandarreko izenburuak baino ezin dira gehitu profil nagusiaren kontuko liburutegira."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ نادیده گرفته شد: فقط عنوان‌های کاتالوگ استاندارد را می‌توان به کتابخانه‌ی حساب نمایه‌ی اصلی افزود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ ohitettu: vain tavallisia luettelon nimikkeitä voi lisätä pääprofiilin tilikirjastoon."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ nilaktawan: mga standard na catalog title lang ang maaaring idagdag sa account library ng pangunahing profile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ ignoré : seuls les titres du catalogue standard peuvent être ajoutés à la bibliothèque du compte du profil principal."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitíronse %@ %@: só se poden engadir á biblioteca da conta do perfil principal os títulos do catálogo estándar."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ છોડી દેવાઈ: માત્ર પ્રમાણભૂત કૅટલૉગ ટાઇટલ જ મુખ્ય પ્રોફાઇલની ખાતા લાઇબ્રેરીમાં ઉમેરી શકાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ דולגו: רק כותרים מהקטלוג הסטנדרטי ניתן להוסיף לספריית החשבון של הפרופיל הראשי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ छोड़ दिए गए: मुख्य प्रोफ़ाइल की खाता लाइब्रेरी में केवल मानक कैटलॉग शीर्षक ही जोड़े जा सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ preskočeno: samo se standardni naslovi iz kataloga mogu dodati u knjižnicu računa glavnog profila."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ kihagyva: csak normál katalógusbeli címek adhatók hozzá a fő profil fiókkönyvtárához."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ բաց թողնվեց՝ գլխավոր պրոֆիլի հաշվի գրադարանին կարող են ավելացվել միայն ստանդարտ կատալոգի վերնագրերը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ dilewati: hanya judul katalog standar yang dapat ditambahkan ke pustaka akun profil utama."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ sleppt: aðeins er hægt að bæta venjulegum skráartitlum við reikningssafn aðalnotandasniðsins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ ignorati: solo i titoli del catalogo standard possono essere aggiunti alla libreria dell'account del profilo principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ をスキップしました：メインプロフィールのアカウントライブラリには、標準カタログのタイトルのみ追加できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ გამოტოვებულია: მთავარი პროფილის ანგარიშის ბიბლიოთეკაში მხოლოდ სტანდარტული კატალოგის ერთეულების დამატებაა შესაძლებელი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ аттап өтілді: негізгі профиль тіркелгісінің кітапханасына тек стандартты каталог атаулары қосыла алады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ ត្រូវបានរំលង ៖ មានតែចំណងជើងកាតាឡុកស្តង់ដារប៉ុណ្ណោះដែលអាចបន្ថែមទៅបណ្ណាល័យគណនីរបស់ប្រវត្តិរូបមេបាន។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ ಬಿಟ್ಟುಬಿಡಲಾಗಿದೆ: ಮುಖ್ಯ ಪ್ರೊಫೈಲ್‌ನ ಖಾತೆ ಲೈಬ್ರರಿಗೆ ಕೇವಲ ಪ್ರಮಾಣಿತ ಕ್ಯಾಟಲಾಗ್ ಶೀರ್ಷಿಕೆಗಳನ್ನು ಮಾತ್ರ ಸೇರಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠 %@%@ 건너뛰었습니다: 표준 카탈로그 콘텐츠만 기본 프로필의 계정 보관함에 추가할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ praleista: į pagrindinio profilio paskyros biblioteką galima pridėti tik standartinius katalogo pavadinimus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ izlaists: galvenā profila konta bibliotēkai var pievienot tikai standarta kataloga ierakstus."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ прескокнати: само стандардни наслови од каталогот може да се додадат во библиотеката на главниот профил."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ ഒഴിവാക്കി: സ്റ്റാൻഡേർഡ് കാറ്റലോഗ് ടൈറ്റിലുകൾ മാത്രമേ പ്രധാന പ്രൊഫൈലിന്റെ അക്കൗണ്ട് ലൈബ്രറിയിലേക്ക് ചേർക്കാനാകൂ."
          }
        },
        "mr": {
          "stringUnit": {
