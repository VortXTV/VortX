        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தனது சொந்த பார்வை வரலாற்றை வைத்திருக்கிறது, உங்கள் Stremio கணக்கின் வழியாக உங்கள் பிற சாதனங்களுடன் ஒத்திசைக்கப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీని స్వంత చూసిన చరిత్రను ఉంచుకుంటుంది, మీ Stremio ఖాతా ద్వారా మీ ఇతర పరికరాలకు సింక్ చేయబడుతుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वतःचा पाहण्याचा इतिहास ठेवते, जो तुमच्या Stremio खात्याद्वारे तुमच्या इतर डिव्हाइसशी सिंक होतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તેનો પોતાનો જોવાનો ઇતિહાસ રાખે છે, જે તમારા Stremio account દ્વારા તમારા અન્ય ઉપકરણો સાથે સિંક થાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತನ್ನದೇ ಆದ ವೀಕ್ಷಣಾ ಇತಿಹಾಸವನ್ನು ಇರಿಸಿಕೊಳ್ಳುತ್ತದೆ, ನಿಮ್ಮ Stremio ಖಾತೆಯ ಮೂಲಕ ನಿಮ್ಮ ಇತರ ಸಾಧನಗಳಿಗೆ ಸಿಂಕ್ ಆಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വന്തം കാഴ്ച ചരിത്രം നിലനിർത്തുന്നു, നിങ്ങളുടെ Stremio അക്കൗണ്ടിലൂടെ നിങ്ങളുടെ മറ്റ് ഉപകരണങ്ങളിലേക്ക് സിങ്ക് ചെയ്യപ്പെടുന്നു."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی الگ دیکھنے کی تاریخ رکھتا ہے، جو آپ کے Stremio اکاؤنٹ کے ذریعے آپ کی دیگر ڈیوائسز پر سنک ہوتی ہے۔"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchováva si vlastnú históriu sledovania, synchronizovanú cez váš účet Stremio do vašich ostatných zariadení."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддържа собствена история на гледане, синхронизирана чрез вашия Stremio акаунт към другите ви устройства."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržava vlastitu povijest gledanja, sinkroniziranu putem vašeg Stremio računa na druge uređaje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Чува сопствену историју гледања, синхронизовану кроз ваш Stremio налог са осталим уређајима."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ima svojo zgodovino gledanja, sinhronizirano prek vašega računa Stremio z drugimi napravami."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saugo savo paties žiūrėjimo istoriją, sinchronizuojamą per jūsų Stremio paskyrą su kitais įrenginiais."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uztur savu skatīšanās vēsturi, kas sinhronizēta caur jūsu Stremio kontu ar jūsu citām ierīcēm."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoiab oma vaatamisajalugu, mis sünkroonitakse su Stremio konto kaudu su teistesse seadmetesse."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Manté el seu propi historial de visualització, sincronitzat a través del teu compte de Stremio als altres dispositius."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén o seu propio historial de visualización, sincronizado coa túa conta de Stremio nos teus outros dispositivos."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bere ikusteko historia propioa mantentzen du, Stremio kontuaren bidez beste gailuekin sinkronizatuta."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hou sy eie kykvorderingby, gesinkroniseer deur jou Stremio-rekening na jou ander toestelle."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Öz izlənmə tarixçəsini saxlayır, Stremio hesabınız vasitəsilə digər cihazlarınızla sinxronlaşır."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mban historinë e vet të shikimit, sinkronizuar nëpërmjet llogarisë tuaj Stremio me pajisjet e tjera."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Heldur eigin horfuferli, samstillt í gegnum Stremio-reikninginn þinn við önnur tæki þín."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ја чува сопствената историја на гледање, синхронизирана преку вашата Stremio сметка на другите ваши уреди."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaweka historia yake ya kutazama, iliyosawazishwa kupitia akaunti yako ya Stremio kwenye vifaa vyako vingine."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stremio тіркелгіңіз арқылы басқа құрылғылармен синхрондалған, жеке қараушы тарихын сақтайды."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահպանում է իր սեփական դիտման պատմությունը, համաժամեցված ձեր Stremio հաշվի միջոցով ձեր մյուս սարքերում։"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ინახავს საკუთარ ყურების ისტორიას, სინქრონიზებულს Stremio ანგარიშის მეშვეობით სხვა მოწყობილობებთან."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣਾ ਵੇਖਣ ਦਾ ਇਤਿਹਾਸ ਰੱਖਦਾ ਹੈ, ਤੁਹਾਡੇ Stremio ਖਾਤੇ ਰਾਹੀਂ ਦੂਜੇ ਡਿਵਾਈਸਾਂ ਨਾਲ ਸਿੰਕ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आफ्नो Stremio खातामार्फत अन्य उपकरणहरूमा सिङ्क गर्दै आफ्नै हेर्ने इतिहास राख्छ।"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የዝርዝር የሰዓት ታሪኩን ከሌሎቹ መሳሪያዎቹ ጋር በ Stremio መለያዎ ያምሳምሳሉ።"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រក្សាប្រវត្តិមើលផ្ទាល់ខ្លួន ធ្វើសមកាលកម្មតាមរយៈគណនី Stremio របស់អ្នកទៅឧបករណ៍ផ្សេងទៀតរបស់អ្នក។"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "নিজৰ চোৱাৰ ইতিহাস ৰাখে, আপোনাৰ Stremio একাউণ্টৰ যোগেদি আপোনাৰ অন্য ডিভাইচলৈ ছিংক কৰা হয়।"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Захоўвае ўласную гісторыю прагляду, сінхранізаваную праз ваш акаўнт Stremio з іншымі прыладамі."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirout a ra e istor sellet dezhañ e-unan, koubladet dre ho kont Stremio d'ho ardivinkoù all."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržava vlastitu historiju gledanja, sinhroniziranu putem vašeg Stremio računa na vaše druge uređaje."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagtipig sa kaugalingong watch history, gi-sync pinaagi sa imong Stremio account ngadto sa imong ubang device."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn cadw ei hanes gwylio ei hun, wedi'i gydweddu drwy'ch cyfrif Stremio i'ch dyfeisiau eraill."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Heldur sína egnu hyggisøgu, samstillaða gjøgnum Stremio-kontu tína til hinar eindir tínar."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "Hâldt syn eigen sjochskiednis by, syngronisearre fia jo Stremio-akkount nei jo oare apparaten."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Coinníonn sé a stair féachana féin, sioncronaithe trí do chuntas Stremio chuig do ghléasanna eile."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumaidh e eachdraidh coimhid fhèin, air a shioncronachadh tron chunntas Stremio agad dha na h-innealan eile agad."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana riƙe tarihin kallonsa, wanda aka daidaita ta asusunka na Stremio zuwa sauran na'urorinka."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenbe pwòp istorik gade li, senkronize atravè kont Stremio ou an nan lòt aparèy ou yo."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-edobe akụkọ nlele nke ya, jikọtara site na akaụntụ Stremio gị na ngwaọrụ ndị ọzọ gị."
          }
        },
        "jv": {
          "stringUnit": {
            "state": "translated",
            "value": "Njaga riwayat tonton dhéwé, disinkron liwat akun Stremio sampeyan menyang piranti liyané."
          }
        },
        "ku": {
          "stringUnit": {
            "state": "translated",
            "value": "Dîroka temaşekirina xwe diparêze, bi rêya hesabê te yê Stremio bi amûrên te yên din re hevdem dibe."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Өзүнүн көрүү тарыхын сактайт, Stremio аккаунтуңуз аркылуу башка түзмөктөрүңүзгө шайкештелет."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält seng eege Kucks-Historik, synchroniséiert iwwer däi Stremio-Kont mat dengen aneren Apparaten."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເກັບປະຫວັດການເບິ່ງຂອງຕົນເອງ, ຊິງຜ່ານບັນຊີ Stremio ຂອງທ່ານໄປຫາອຸປະກອນອື່ນ."
          }
        },
        "mg": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitazona ny tantaram-pijerena manokana, mifandanja amin'ny alalan'ny kaonty Stremio-nao mankany amin'ny fitaovanao hafa."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka pupuri i tōna ake hītori mātakitaki, kua tukutahia mā tō pūkete Stremio ki ō atu pūrere."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өөрийн үзсэн түүхийг хадгалж, таны Stremio дансаар бусад төхөөрөмж рүү синк болдог."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iżomm l-istorja tal-wiri tiegħu stess, issinkronizzata permezz tal-kont Stremio tiegħek mal-apparati l-oħra tiegħek."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ကိုယ်ပိုင် ကြည့်ရှုမှုမှတ်တမ်းကို ထားရှိပြီး သင့် Stremio အကောင့်မှတစ်ဆင့် သင့်အခြားစက်များသို့ ချိန်ကိုက်သိမ်းဆည်းသည်။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "Imasunga mbiri yake ya kuwonera, yoyenderana kudzera mu akaunti yanu ya Stremio ku zipangizo zanu zina."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Garda son pròpri istoric de visionatge, sincronizat via vòstre compte Stremio amb vòstres autres aparelhs."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନିଜର ୱାଚ୍ ଇତିହାସ ରଖେ, ଆପଣଙ୍କ Stremio ଆକାଉଣ୍ଟ ମାଧ୍ୟମରେ ଆପଣଙ୍କ ଅନ୍ୟ ଡିଭାଇସକୁ ସିଙ୍କ ହୁଏ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "خپله د کتلو تاریخچه ساتي، چې ستاسو د Stremio حساب له لارې ستاسو نورو وسیلو ته همغږي کیږي."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Igumana amateka yayo bwite yo kureba, ayiyunga binyuze kuri konti yawe ya Stremio ku bindi byuma byawe."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "پنھنجي ڏسڻ جي تاريخ رکي ٿو، اوهان جي Stremio اڪائونٽ ذريعي اوهان جي ٻين ڊوائيسن سان سنڪ ٿيل."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "එහිම නැරඹීම් ඉතිහාසය තබා ගනී, ඔබේ Stremio ගිණුම හරහා ඔබේ අනෙකුත් උපාංග වෙත සමමුහුර්ත වේ."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "E tausia lana lava tala faasolopito o le matamata, faapenapena e ala i lau tala Stremio i au isi masini."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "Inochengeta nhoroondo yayo yokuona, yakasync-wa kuburikidza ne account yako yeStremio kune mamwe madhivhaisi ako."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wuxuu hayaa taariikhdiisa daawashada u gaarka ah, oo lagu wada socodsiiyay akoonkaaga Stremio ilaa qalabkaaga kale."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "E boloka nalane ea eona ea ho shebella, e sync ka akhaonto ea hau ea Stremio ho lisebelisoa tsa hau tse ling."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahan riwayat lalajo sorangan, disinkronkeun ngaliwatan akun Stremio anjeun ka alat séjén anjeun."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Таърихи тамошои худро нигоҳ медорад, ки тавассути ҳисоби Stremio-и шумо ба дигар дастгоҳҳоятон ҳамоҳанг мешавад."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Үзенең карау тарихын саклый, ул Stremio хисабың аша башка җиһазларыңа синхронлаша."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ئۆزىنىڭ كۆرۈش تارىخىنى ساقلايدۇ، Stremio ھېساباتىڭىز ئارقىلىق باشقا ئۈسكۈنىلىرىڭىزگە قەدەمداشلىنىدۇ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "O'zining ko'rish tarixini saqlaydi, Stremio hisobingiz orqali boshqa qurilmalaringizga sinxronlanadi."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "Igcina imbali yayo yokubukela, ivunyelaniswe ngeakhawunti yakho yeStremio kwezinye izixhobo zakho."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ó máa ń pa ìtàn ìwò tirẹ̀ mọ́, tí a múra síra nípasẹ̀ àkàwé Stremio rẹ sí àwọn ẹ̀rọ rẹ mìíràn."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Igcina umlando wayo wokubuka, ovumelaniswe nge-akhawunti yakho ye-Stremio kwamanye amadivayisi akho."
          }
        }
      }
    },
