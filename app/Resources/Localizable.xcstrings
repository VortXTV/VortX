          "stringUnit": {
            "state": "translated",
            "value": "સાઇન ઇન કરવાથી તમારા add-ons અને library એપમાં ખેંચાય છે. તમારું account આ ઉપકરણ પર રહે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೈನ್ ಇನ್ ಮಾಡುವುದರಿಂದ ನಿಮ್ಮ ಆಡ್-ಆನ್‌ಗಳು ಮತ್ತು ಲೈಬ್ರರಿಯನ್ನು ಆ್ಯಪ್‌ಗೆ ಎಳೆಯುತ್ತದೆ. ನಿಮ್ಮ ಖಾತೆ ಈ ಸಾಧನದಲ್ಲಿ ಉಳಿಯುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൈൻ ഇൻ ചെയ്യുന്നത് നിങ്ങളുടെ ആഡ്-ഓണുകളും ലൈബ്രറിയും ആപ്പിലേക്ക് കൊണ്ടുവരുന്നു. നിങ്ങളുടെ അക്കൗണ്ട് ഈ ഉപകരണത്തിൽ തന്നെ തുടരുന്നു."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن اِن کرنے سے آپ کے ایڈ-آنز اور لائبریری ایپ میں آ جاتے ہیں۔ آپ کا اکاؤنٹ اسی ڈیوائس پر رہتا ہے۔"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihlásenie načíta vaše doplnky a knižnicu do aplikácie. Váš účet zostáva v tomto zariadení."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Влизането изтегля вашите добавки и библиотека в приложението. Вашият акаунт остава на това устройство."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava povlači vaše dodatke i biblioteku u aplikaciju. Vaš račun ostaje na ovom uređaju."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Пријава учитава ваше додатке и библиотеку у апликацију. Ваш налог остаје на овом уређају."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava prenese vaše dodatke in knjižnico v aplikacijo. Vaš račun ostane v tej napravi."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisijungus jūsų papildiniai ir biblioteka įkeliami į programą. Jūsų paskyra lieka šiame įrenginyje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierakstoties, jūsu papildinājumi un bibliotēka tiek ievilkti lietotnē. Jūsu konts paliek šajā ierīcē."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisselogimine toob su lisad ja teegi rakendusse. Su konto jääb sellesse seadmesse."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sessió importa els teus complements i biblioteca a l'app. El teu compte es queda en aquest dispositiu."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao iniciar sesión importáronse os teus complementos e biblioteca á app. A túa conta permanece neste dispositivo."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Saioa hasteak zure gehigarriak eta liburutegia aplikaziora eramaten ditu. Zure kontua gailu honetan geratzen da."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanmelding haal jou byvoegings en biblioteek in die app in. Jou rekening bly op hierdie toestel."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Daxil olmaq əlavələrinizi və kitabxananızı tətbiqə çəkir. Hesabınız bu cihazda qalır."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyrja sjell shtesat dhe bibliotekën tuaj në aplikacion. Llogaria juaj qëndron në këtë pajisje."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Innskráning sækir viðbæturnar þínar og safnið inn í forritið. Reikningurinn þinn er geymdur á þessum tæki."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пријавувањето ги внесува вашите додатоци и библиотека во апликацијата. Вашата сметка останува на овој уред."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuingia kunachomoa viongezi vyako na maktaba kwenye programu. Akaunti yako inabaki kwenye kifaa hiki."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кіру қондырмалар мен кітапхананы қосымшаға тартады. Тіркелгіңіз осы құрылғыда сақталады."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտք գործելը ձեր հավելանյութերն ու գրադարանն ծրագիր կբեռնի։ Ձեր հաշիվը կպահվի այս սարքում։"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შესვლა ნაკადის დამატებებსა და ბიბლიოთეკას აპლიკაციაში ჩაიტვირთება. ანგარიში ინახება ამ მოწყობილობაზე."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਈਨ ਇਨ ਕਰਨ ਨਾਲ ਤੁਹਾਡੇ ਐਡ-ਆਨ ਅਤੇ ਲਾਇਬ੍ਰੇਰੀ ਐਪ ਵਿੱਚ ਆ ਜਾਂਦੇ ਹਨ। ਤੁਹਾਡਾ ਖਾਤਾ ਇਸ ਡਿਵਾਈਸ 'ਤੇ ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन गर्दा तपाईंका add-on हरू र लाइब्रेरी एपमा आउँछन्। तपाईंको खाता यस उपकरणमा रहन्छ।"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መግባት ተጨማሪዎቹ እና ቤተ-መፅሐፍቱ ወደ መተግበሪያው ያምጣሉ። መለያዎ በዚህ መሳሪያ ላይ ይቆያሉ።"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការចូលទាញ add-ons និងបណ្ណាល័យរបស់អ្នកចូលកម្មវិធី។ គណនីរបស់អ្នករក្សាទុកនៅលើឧបករណ៍នេះ។"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "ছাইন ইন কৰিলে আপোনাৰ এড-অন আৰু লাইব্ৰেৰী এপ্‌লৈ আহে। আপোনাৰ একাউণ্ট এই ডিভাইচতে থাকে।"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уваход падцягвае вашы дадаткі і бібліятэку ў дадатак. Ваш акаўнт застаецца на гэтай прыладзе."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Kennaskañ a zeg ho enlugelladoù hag ho levraoueg en arload. Ho kont a chom war an ardivink-mañ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava povlači vaše dodatke i biblioteku u aplikaciju. Vaš račun ostaje na ovom uređaju."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pag-sign in nagbira sa imong add-ons ug library ngadto sa app. Ang imong account magpabilin niini nga device."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae mewngofnodi'n tynnu eich ychwanegion a'ch llyfrgell i mewn i'r ap. Mae'ch cyfrif yn aros ar y ddyfais hon."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Innritan dregur eykingar og savn tíni inn í appið. Konta tín verður verandi á hesi eind."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "Troch oan te melden helje jo jo add-ons en bibleteek yn de app. Jo akkount bliuwt op dit apparaat."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarraingíonn síniú isteach do bhreiseáin agus do leabharlann isteach san aip. Fanann do chuntas ar an ngléas seo."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarraingidh clàradh a-steach na tuilleadain agus an leabharlann agad a-steach dhan aplacaid. Fanaidh do chunntas air an inneal seo."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiga yana jawo ƙarin abubuwanka da ɗakin karatunka cikin manhajar. Asusunka yana zama a wannan na'urar."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksyon rale add-on ou yo ak bibliyotèk ou nan aplikasyon an. Kont ou rete sou aparèy sa a."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Nbanye na-adọta ngwakọ na ọba akwụkwọ gị n'ime ngwa. Akaụntụ gị na-anọ na ngwaọrụ a."
          }
        },
        "jv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mlebu narik add-on lan perpustakaan sampeyan menyang app. Akun sampeyan tetep ing piranti iki."
          }
        },
        "ku": {
          "stringUnit": {
            "state": "translated",
            "value": "Têketin pêvek û pirtûkxaneya te dikişîne sepanê. Hesabê te li ser vê amûrê dimîne."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Кирүү кошумчаларыңызды жана китепканаңызды колдонмого тартып алат. Аккаунтуңуз ушул түзмөктө калат."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "D'Umelde holt deng Add-ons an deng Bibliothéik an d'App. Däi Kont bleift op dësem Apparat."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການເຂົ້າສູ່ລະບົບຈະດຶງສ່ວນເສີມ ແລະ ຄັງເກັບຂອງທ່ານເຂົ້າມາໃນແອັບ. ບັນຊີຂອງທ່ານຈະຢູ່ໃນອຸປະກອນນີ້."
          }
        },
        "mg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ny fidirana dia mitarika ny add-ons sy ny tranombokinao ho ao amin'ny app. Mijanona amin'ity fitaovana ity ny kaontinao."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mā te takiuru e kukume ō apataki me tō whare pukapuka ki te taupānga. Ka noho tō pūkete ki tēnei pūrere."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэвтрэх нь таны нэмэлтүүд болон санг апп руу татна. Таны данс энэ төхөөрөмж дээр үлдэнэ."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta tidħol iġġib l-add-ons u l-librerija tiegħek fl-app. Il-kont tiegħek jibqa' fuq dan l-apparat."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "လက်မှတ်ထိုးဝင်ခြင်းသည် သင့် add-on များနှင့် library ကို app ထဲသို့ ဆွဲယူပေးသည်။ သင့်အကောင့်သည် ဤစက်ပေါ်တွင် ရှိနေသည်။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulowa kumakoka ma add-on anu ndi laibulale mu app. Akaunti yanu imakhalabe pa chipangizo ichi."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion importa vòstres moduls e vòstra bibliotèca dins l'aplicacion. Vòstre compte rèsta sus aqueste aparelh."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସାଇନ୍-ଇନ କରିବା ଆପଣଙ୍କ ଆଡ୍-ଅନ ଏବଂ ଲାଇବ୍ରେରୀକୁ ଆପ୍‌ରେ ଆଣିଥାଏ। ଆପଣଙ୍କ ଆକାଉଣ୍ଟ ଏହି ଡିଭାଇସରେ ରହେ।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "ننوتل ستاسو اضافه‌ونې او کتابتون اپ ته راکاږي. ستاسو حساب په دې وسیله پاتې کیږي."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwinjira bizana ibyongeramo byawe n'isomero muri porogaramu. Konti yawe isigara kuri iki cyuma."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن-ان ڪرڻ اوهان جا ايڊ-آنز ۽ لائبريري ايپ ۾ آڻي ٿو. اوهان جو اڪائونٽ هن ڊوائيس تي رهي ٿو."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "පිවිසීම ඔබේ ඇඩෝන සහ පුස්තකාලය යෙදුමට ඇද ගනී. ඔබේ ගිණුම මෙම උපාංගයේ රැඳේ."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "E toso mai e le ulufale au add-ons ma le faletusi i le app. E tumau lau tala i lenei masini."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupinda kunopinza zvinowedzera zvako neraibhurari mu app. Account yako inogara padhivhaisi iyi."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelitaanku wuxuu app-ka gudihiisa keenaa add-ons-kaaga iyo maktabaddaada. Akoonkaagu wuxuu ku sii jiraa qalabkan."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho kena ho hulela litlatsetso le laebrari ea hau kahara app. Akhaonto ea hau e lula sesebelisoeng sena."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Asup narik add-on jeung pustaka anjeun kana aplikasi. Akun anjeun tetep dina alat ieu."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Воридшавӣ иловагиҳо ва китобхонаи шуморо ба барнома мекашад. Ҳисоби шумо дар ин дастгоҳ мемонад."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Кереш өстәмәләреңне һәм китапханәңне кушымтага тарта. Хисабың бу җиһазда кала."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "كىرىش قوشۇلمىلىرىڭىز ۋە ئامبارىڭىزنى دېتالغا تارتىدۇ. ھېساباتىڭىز مۇشۇ ئۈسكۈنىدە قالىدۇ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tizimga kirish qo'shimchalaringiz va kutubxonangizni ilovaga tortadi. Hisobingiz shu qurilmada qoladi."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukungena kutsala ii-add-on zakho nethala ziye kwi-app. Iakhawunti yakho ihlala kwesi sixhobo."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ìwọlé máa ń fa àwọn add-on àti ìkàwé rẹ wọ inú app náà. Àkàwé rẹ máa ń dúró sórí ẹ̀rọ yìí."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukungena kudonsela izengezo zakho nelabhulali ku-app. I-akhawunti yakho ihlala kule divayisi."
          }
        }
      }
