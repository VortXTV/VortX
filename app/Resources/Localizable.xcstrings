    "Use the server embedded on this device, or point VortX at a remote / dedicated Stremio server (for example one you run at home).": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il server integrato in questo dispositivo, oppure punta VortX a un server Stremio remoto / dedicato (ad esempio uno che gestisci a casa)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el servidor integrado en este dispositivo, o apunta VortX a un servidor Stremio remoto / dedicado (por ejemplo uno que ejecutes en casa)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le serveur intégré à cet appareil, ou pointez VortX vers un serveur Stremio distant / dédié (par exemple un que vous hébergez chez vous)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende den auf diesem Gerät eingebetteten Server oder richte VortX auf einen entfernten / dedizierten Stremio-Server aus (zum Beispiel einen, den du zu Hause betreibst)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o servidor integrado neste dispositivo ou aponte a VortX para um servidor Stremio remoto / dedicado (por exemplo, um que você rode em casa)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに内蔵されたサーバーを使用するか、VortX をリモート／専用の Stremio サーバー（例えば自宅で運用しているもの）に向けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 내장된 서버를 사용하거나, VortX를 원격/전용 Stremio 서버(예: 집에서 직접 운영하는 서버)로 연결하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用本设备上内置的服务器，或让 VortX 指向远程／专用的 Stremio 服务器（例如你在家运行的服务器）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте сервер, встроенный в это устройство, или укажите VortX удалённый / выделенный сервер Stremio (например, тот, что вы запускаете дома)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर एम्बेडेड सर्वर का उपयोग करें, या VortX को किसी रिमोट / समर्पित Stremio सर्वर की ओर इंगित करें (उदाहरण के लिए जिसे आप घर पर चलाते हों)।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الخادم المدمج على هذا الجهاز، أو وجّه VortX إلى خادم Stremio بعيد / مخصّص (على سبيل المثال خادم تشغّله في منزلك)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda yerleşik sunucuyu kullanın veya VortX'i uzak / özel bir Stremio sunucusuna yönlendirin (örneğin evinizde çalıştırdığınız bir tane)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o servidor incorporado neste dispositivo ou aponte a VortX para um servidor Stremio remoto / dedicado (por exemplo, um que execute em casa)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de server die op dit apparaat is ingebouwd, of wijs VortX naar een externe / aparte Stremio-server (bijvoorbeeld een die je thuis draait)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj serwera wbudowanego na tym urządzeniu lub wskaż VortX zdalny / dedykowany serwer Stremio (na przykład taki, który prowadzisz w domu)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd servern som är inbäddad på den här enheten, eller rikta VortX mot en fjärr-/dedikerad Stremio-server (till exempel en du kör hemma)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此裝置上的內嵌伺服器，或讓 VortX 指向遠端／專用的 Stremio 伺服器（例如你在家自架的伺服器）。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan server yang tertanam di perangkat ini, atau arahkan VortX ke server Stremio jarak jauh / khusus (misalnya yang Anda jalankan di rumah)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เซิร์ฟเวอร์ที่ฝังอยู่บนอุปกรณ์นี้ หรือชี้ VortX ไปยังเซิร์ฟเวอร์ Stremio ระยะไกล/เฉพาะ (เช่น เซิร์ฟเวอร์ที่คุณรันที่บ้าน)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng máy chủ được nhúng trên thiết bị này, hoặc trỏ VortX tới một máy chủ Stremio từ xa / chuyên dụng (ví dụ máy chủ bạn tự chạy ở nhà)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте сервер, вбудований у цей пристрій, або спрямуйте VortX на віддалений / виділений сервер Stremio (наприклад, той, що ви тримаєте вдома)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte server vestavěný v tomto zařízení, nebo nasměrujte VortX na vzdálený / vyhrazený server Stremio (například ten, který provozujete doma)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε τον διακομιστή που είναι ενσωματωμένος σε αυτή τη συσκευή ή κατευθύνετε το VortX σε έναν απομακρυσμένο / αποκλειστικό διακομιστή Stremio (για παράδειγμα έναν που τρέχετε στο σπίτι)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש בשרת המוטמע במכשיר הזה, או הפנה את VortX לשרת Stremio מרוחק / ייעודי (לדוגמה כזה שאתה מפעיל בבית)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug serveren indbygget på denne enhed, eller peg VortX mod en ekstern/dedikeret Stremio-server (for eksempel en, du kører hjemme)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä tällä laitteella sisäänrakennettua palvelinta tai osoita VortX etä- tai erilliseen Stremio-palvelimeen (esimerkiksi kotonasi pyörivään)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk serveren som er innebygd på denne enheten, eller pek VortX mot en ekstern / dedikert Stremio-server (for eksempel en du kjører hjemme)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește serverul încorporat pe acest dispozitiv sau direcționează VortX către un server Stremio la distanță / dedicat (de exemplu unul pe care îl rulezi acasă)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használd az ezen az eszközön beépített szervert, vagy irányítsd a VortX-et egy távoli / dedikált Stremio-szerverre (például egy otthon futtatottra)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Guna pelayan terbenam pada peranti ini, atau arahkan VortX ke pelayan Stremio jauh / khusus (contohnya yang anda jalankan di rumah)."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin ang server na naka-embed sa device na ito, o ituro ang VortX sa isang remote / dedicated na Stremio server (halimbawa isang pinapatakbo mo sa bahay)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از سرور تعبیه‌شده روی این دستگاه استفاده کنید، یا VortX را به یک سرور Stremio راه دور / اختصاصی متصل کنید (برای مثال سروری که در خانه اجرا می‌کنید)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে অন্তর্নির্মিত সার্ভার ব্যবহার করুন, অথবা VortX-কে একটি দূরবর্তী / নিবেদিত Stremio সার্ভারে নির্দেশ করুন (যেমন আপনি বাড়িতে চালানো একটি)।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்தில் உள்ளமைந்த சர்வரைப் பயன்படுத்தவும், அல்லது VortX-ஐ ஒரு தொலைநிலை / பிரத்தியேக Stremio சர்வருக்கு (எடுத்துக்காட்டாக நீங்கள் வீட்டில் இயக்குவது) சுட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పరికరంలో ఎంబెడ్ చేసిన సర్వర్‌ను వాడండి, లేదా VortXను రిమోట్ / అంకిత Stremio సర్వర్‌కు సూచించండి (ఉదాహరణకు మీరు ఇంట్లో నడిపేది)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या डिव्हाइसवर अंगभूत असलेला सर्व्हर वापरा, किंवा VortX ला रिमोट / समर्पित Stremio सर्व्हरकडे निर्देशित करा (उदाहरणार्थ तुम्ही घरी चालवता तो)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ઉપકરણ પર એમ્બેડેડ સર્વર વાપરો, અથવા VortX ને દૂરના / સમર્પિત Stremio સર્વર પર નિર્દેશ કરો (ઉદાહરણ તરીકે તમે ઘરે ચલાવો છો તે)."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸಾಧನದಲ್ಲಿ ಅಂತರ್ನಿರ್ಮಿತ ಸರ್ವರ್ ಅನ್ನು ಬಳಸಿ, ಅಥವಾ VortX ಅನ್ನು ದೂರಸ್ಥ / ಮೀಸಲಾದ Stremio ಸರ್ವರ್‌ಗೆ ಸೂಚಿಸಿ (ಉದಾಹರಣೆಗೆ ನೀವು ಮನೆಯಲ್ಲಿ ಚಲಾಯಿಸುವಂತಹದ್ದು)."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഉപകരണത്തിൽ എംബഡ് ചെയ്ത സെർവർ ഉപയോഗിക്കുക, അല്ലെങ്കിൽ ഒരു റിമോട്ട് / സമർപ്പിത Stremio സെർവറിലേക്ക് VortX-നെ ചൂണ്ടിക്കാട്ടുക (ഉദാഹരണത്തിന് നിങ്ങൾ വീട്ടിൽ പ്രവർത്തിപ്പിക്കുന്ന ഒന്ന്)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ڈیوائس پر ایمبیڈڈ سرور استعمال کریں، یا VortX کو کسی ریموٹ / مخصوص Stremio سرور کی طرف منتقل کریں (مثلاً وہ جو آپ گھر پر چلاتے ہیں)۔"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite server zabudovaný v tomto zariadení, alebo nasmerujte VortX na vzdialený / dedikovaný server Stremio (napríklad taký, ktorý prevádzkujete doma)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Използвайте сървъра, вграден на това устройство, или насочете VortX към отдалечен / специализиран Stremio сървър (например такъв, който поддържате вкъщи)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite poslužitelj ugrađen na ovom uređaju ili usmjerite VortX na udaljeni / namjenski Stremio poslužitelj (na primjer onaj koji pokrećete kod kuće)."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Користите сервер уграђен на овом уређају, или усмерите VortX на удаљени / наменски Stremio сервер (на пример онај који имате код куће)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite strežnik, vgrajen v tej napravi, ali usmerite VortX na oddaljeni/namenski strežnik Stremio (na primer tistega, ki ga poganjate doma)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naudokite serverį, įtaisytą šiame įrenginyje, arba nukreipkite VortX į nuotolinį / dedikuotą Stremio serverį (pavyzdžiui, tą, kurį turite namuose)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmantojiet šajā ierīcē iegulto serveri vai norādiet VortX uz attālu / dedicētu Stremio serveri (piemēram, tādu, kuru darbināt mājās)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasuta selles seadmes sisseehitatud serverit või suuna VortX kaug- / sihtotstarbelisele Stremio serverile (näiteks sellisele, mida pead kodus)."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitza el servidor integrat en aquest dispositiu, o apunta VortX a un servidor de Stremio remot o dedicat (per exemple, un que tinguis a casa)."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o servidor integrado neste dispositivo ou apunta VortX a un servidor Stremio remoto/dedicado (por exemplo, un que teñas na casa)."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erabili gailu honetan integratutako zerbitzaria, edo zuzendu VortX urruneko / dedikaturiko Stremio zerbitzari batera (adibidez, etxean exekutatzen duzun bat)."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik die bediener wat op hierdie toestel ingebed is, of wys VortX na 'n afgeleë/toegewyde Stremio-bediener (byvoorbeeld een wat jy tuis bedryf)."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda yerləşdirilmiş serverdən istifadə edin və ya VortX-i uzaqdan/xüsusi Stremio serverinə yönəldin (məsələn evdə işlətdiyiniz biri)."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përdorni serverin e integruar në këtë pajisje, ose drejtoni VortX drejt një serveri të largët/të dedikuar Stremio (për shembull njerit që e drejtoni në shtëpi)."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Notaðu þjóninn sem er innbyggður á þessu tæki, eða beindu VortX að fjarlægu / sérsniðnu Stremio-þjóni (til dæmis einum sem þú keyrir heima hjá þér)."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Користете го серверот вграден на овој уред или насочете го VortX кон оддалечен / наменски Stremio сервер (на пример еден кој го стартувате дома)."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumia seva iliyojumuishwa kwenye kifaa hiki, au elekeza VortX kwenye seva ya mbali/iliyowekwa (kwa mfano moja unayoendesha nyumbani)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы құрылғыдағы кірістірілген серверді пайдаланыңыз немесе VortX-ті қашықтағы/арнайы Stremio серверіне бағыттаңыз (мысалы, үйіңізде іске қосқан сервер)."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Օգտագործեք այս սարքում ներկառուցված սերվերը, կամ VortX-ն ուղղեք հեռավոր/նվիրված Stremio սերվերի (օրինակ՝ տանն աշխատող)։"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოიყენეთ ამ მოწყობილობაზე ჩაშენებული სერვერი, ან მიუთითეთ VortX-ს დისტანციური/გამოყოფილი Stremio სერვერი (მაგ., სახლში გაშვებული)."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਡਿਵਾਈਸ 'ਤੇ ਐਂਬੈੱਡ ਕੀਤਾ ਸਰਵਰ ਵਰਤੋ, ਜਾਂ VortX ਨੂੰ ਕਿਸੇ ਰਿਮੋਟ/ਸਮਰਪਿਤ Stremio ਸਰਵਰ ਵੱਲ ਦੱਸੋ (ਉਦਾਹਰਨ ਲਈ ਜੋ ਤੁਸੀਂ ਘਰ ਵਿੱਚ ਚਲਾਉਂਦੇ ਹੋ)।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यस उपकरणमा एम्बेडेड सर्भर प्रयोग गर्नुहोस्, वा VortX लाई रिमोट/समर्पित Stremio सर्भरतिर निर्देशित गर्नुहोस् (उदाहरणका लागि, तपाईंले घरमा चलाउनुभएको)।"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በዚህ መሳሪያ ላይ የተቀናጀ አገልጋዩን ተጠቀሙ፣ ወይም VortX ወደ ሩቅ/ቀጥ ያለ Stremio አገልጋይ ጠቁሙ (ለምሳሌ ቤት ላይ የሚሮጡ)።"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រើ server ដែលបង្កប់នៅឧបករណ៍នេះ ឬចង្អុល VortX ទៅ Stremio server ពីចម្ងាយ/ឯករាជ្យ (ឧ. ដែលអ្នករត់នៅផ្ទះ)។"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইচত এম্বেড কৰা ছাৰ্ভাৰটো ব্যৱহাৰ কৰক, নাইবা VortX-ক এটা ৰিম'ট / ডেডিকেটেড Stremio ছাৰ্ভাৰলৈ নিৰ্দেশ কৰক (উদাহৰণস্বৰূপে আপুনি ঘৰত চলোৱা এটা)।"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкарыстоўвайце сервер, убудаваны ў гэтую прыладу, ці накіруйце VortX на аддалены / выдзелены сервер Stremio (напрыклад, той, што вы запускаеце дома)."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Implijit ar servijer enframmet war an ardivink-mañ, pe poentit VortX war-du ur servijer Stremio a-bell / gouestlet (da skouer unan a rit war-dro er gêr)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite server ugrađen na ovom uređaju ili usmjerite VortX na udaljeni / namjenski Stremio server (na primjer onaj koji pokrećete kod kuće)."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamita ang server nga naka-embed niini nga device, o itudlo ang VortX sa remote / dedicated nga Stremio server (pananglitan usa nga imong gipadagan sa balay)."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Defnyddiwch y gweinydd sydd wedi'i fewnosod ar y ddyfais hon, neu bwyntiwch VortX at weinydd Stremio pell / pwrpasol (er enghraifft un rydych yn ei redeg gartref)."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Brúka ambætaran, ið er innbygdur á hesi eind, ella beina VortX móti einum fjar / serskildum Stremio-ambætara (til dømis einum, tú koyrir heima)."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "Brûk de server dy't op dit apparaat ynbêde is, of wiis VortX nei in ekstern / spesjaal Stremio-server (bygelyks ien dy't jo thús draaie)."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Úsáid an freastalaí atá leabaithe ar an ngléas seo, nó dírigh VortX ar fhreastalaí Stremio cianda / tiomnaithe (mar shampla ceann a ritheann tú sa bhaile)."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleachd am frithealaiche a tha freumhaichte san inneal seo, no cuir VortX gu frithealaiche Stremio iomallach / sònraichte (mar eisimpleir fear a ruitheas tu aig an taigh)."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yi amfani da sabar da aka gina a wannan na'urar, ko kuma nuna VortX zuwa sabar Stremio mai nisa / keɓaɓɓe (misali ɗaya da kake gudanarwa a gida)."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Sèvi ak sèvè ki entegre sou aparèy sa a, oswa pwente VortX sou yon sèvè Stremio adistans / dedye (pa egzanp youn ou kouri lakay ou)."
          }
        },
        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "Jiri sava arụnyere na ngwaọrụ a, ma ọ bụ tụọ VortX na sava Stremio dịpụrụ adịpụ / raara onwe ya nye (dịka otu ị na-agba n'ụlọ)."
          }
        },
        "jv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakké server sing kaèmbèd ing piranti iki, utawa arahaké VortX menyang server Stremio jarak jauh / khusus (contoné sing sampeyan mlakokaké ing omah)."
          }
        },
        "ku": {
          "stringUnit": {
            "state": "translated",
            "value": "Servera di vê amûrê de hatî bikaranîn, an VortX ber bi servereke Stremio ya dûr / taybet ve nîşan bide (mînak yeke ku tu li malê dixebitînî)."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Ушул түзмөккө кыналган серверди колдонуңуз, же VortX'ти алыскы / атайын Stremio серверине багыттаңыз (мисалы, үйдө иштеткениңизге)."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Benotz de Server deen op dësem Apparat agebaut ass, oder riicht VortX op en entfernt / dediéierte Stremio-Server (zum Beispill een deen s du doheem bedreifs)."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃຊ້ເຊີບເວີທີ່ຝັງໃນອຸປະກອນນີ້, ຫຼື ຊີ້ VortX ໄປຫາເຊີບເວີ Stremio ໄລຍະໄກ / ສະເພາະ (ຕົວຢ່າງ ອັນທີ່ທ່ານແລ່ນຢູ່ບ້ານ)."
          }
        },
        "mg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ampiasao ny server napetaka amin'ity fitaovana ity, na atondroy ny VortX amin'ny server Stremio lavitra / natokana (ohatra ny iray ampiasainao ao an-trano)."
          }
        },
        "mi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whakamahia te tūmau kua whakaurua ki tēnei pūrere, whakaatu rānei i a VortX ki tētahi tūmau Stremio mamao / tauwhāiti (hei tauira tētahi e whakahaerehia ana e koe i te kāinga)."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ төхөөрөмжид суулгасан серверийг ашиглах, эсвэл VortX-г алсын / зориулалтын Stremio сервер рүү чиглүүлээрэй (жишээ нь та гэртээ ажиллуулдаг)."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uża s-server integrat fuq dan l-apparat, jew immira VortX lejn server Stremio remot / dedikat (pereżempju wieħed li tħaddem id-dar)."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤစက်ပေါ်တွင် ထည့်သွင်းထားသော server ကို သုံးပါ၊ သို့မဟုတ် VortX ကို အဝေးရှိ / သီးသန့် Stremio server (ဥပမာ သင်အိမ်တွင် လည်ပတ်နေသောတစ်ခု) သို့ ညွှန်ပြပါ။"
          }
        },
        "ny": {
          "stringUnit": {
            "state": "translated",
            "value": "Gwiritsani seva yamkati mwa chipangizo ichi, kapena lozerani VortX ku seva ya Stremio yakutali / yoperekedwa (mwachitsanzo imene mukuyendetsa kunyumba)."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizatz lo servidor integrat sus aqueste aparelh, o dirigissètz VortX cap a un servidor Stremio distant / dedicat (per exemple un que fasètz virar a l'ostal)."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଡିଭାଇସରେ ଏମ୍ବେଡେଡ୍ ସର୍ଭର ବ୍ୟବହାର କରନ୍ତୁ, କିମ୍ବା VortX‌କୁ ଏକ ରିମୋଟ / ଡେଡିକେଟେଡ୍ Stremio ସର୍ଭରକୁ ପଏଣ୍ଟ କରନ୍ତୁ (ଉଦାହରଣ ଆପଣ ଘରେ ଚଲାଉଥିବା ଗୋଟିଏ)।"
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "په دې وسیله کې دننه‌جوړ سرور وکاروئ، یا VortX یو لرې / ځانګړي Stremio سرور ته ونښلوئ (لکه هغه چې تاسو یې په کور کې چلوئ)."
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Koresha seriveri ihishe kuri iki cyuma, cyangwa uyobore VortX kuri seriveri ya Stremio ya kure / yihariye (urugero imwe ukoresha mu rugo)."
          }
        },
        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "هن ڊوائيس تي ايمبيڊ ٿيل سرور استعمال ڪريو، يا VortX کي ڪنھن ريموٽ / وقف ٿيل Stremio سرور ڏانھن اشارو ڪريو (مثال طور اهو جيڪو اوهان گھر ۾ هلايو ٿا)."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙම උපාංගයේ කාවැද්දූ සේවාදායකය භාවිත කරන්න, නැතහොත් දුරස්ථ / කැපවූ Stremio සේවාදායකයක් වෙත VortX යොමු කරන්න (උදාහරණයක් ලෙස ඔබ නිවසේ ධාවනය කරන එකක්)."
          }
        },
        "sm": {
          "stringUnit": {
            "state": "translated",
            "value": "Faaaoga le server o loo i totonu o lenei masini, pe faasino VortX i se server Stremio mamao / faapitoa (fai mai se tasi e te faagaoioia i le fale)."
          }
        },
        "sn": {
          "stringUnit": {
            "state": "translated",
            "value": "Shandisa sevha yakaiswa mukati medhivhaisi iyi, kana ubatanidze VortX kune remote / dedicated Stremio server (semuenzaniso iyo yaunoshandisa kumba)."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Isticmaal server-ka ku dhex jira qalabkan, ama VortX ku tilmaam server Stremio oo fog / gaar ah (tusaale mid aad guriga ku shaqaysiiso)."
          }
        },
        "st": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebelisa seva se kentsoeng sesebelisoeng sena, kapa u supise VortX ho seva sa hole / se inehetseng sa Stremio (mohlala se seng seo u se sebetsang lapeng)."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Paké sérver bawaan dina alat ieu, atawa arahkeun VortX ka sérver Stremio jarak jauh / khusus (contona nu anjeun jalankeun di imah)."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверро, ки дар ин дастгоҳ ҷойгир аст, истифода баред ё VortX-ро ба сервери дурдаст / ихтисосии Stremio равона кунед (масалан, касе ки шумо дар хона идора мекунед)."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Бу җиһазга эчкәрелгән серверны кулан, яки VortX'ны ерактагы / бүлеп бирелгән Stremio серверына юнәлт (мәсәлән, өйдә эшләтеп торганыңа)."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بۇ ئۈسكۈنىگە ئىچكى ساقلانغان مۇلازىمېتىرنى ئىشلىتىڭ، ياكى VortX نى يىراقتىكى / مەخسۇس Stremio مۇلازىمېتىرىغا يۆنەلتىڭ (مەسىلەن ئۆيدە يۈرگۈزىۋاتقان بىرى)."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shu qurilmaga o'rnatilgan serverdan foydalaning yoki VortX'ni masofaviy / maxsus Stremio serverga yo'naltiring (masalan, uyda ishga tushirganingizga)."
          }
        },
        "xh": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebenzisa iseva efakelwe kwesi sixhobo, okanye ukhombise iVortX kwiseva yeStremio ekude / ezinikeleyo (umzekelo leyo uyiqhubayo ekhaya)."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo sáfà tí a fi sínú ẹ̀rọ yìí, tàbí darí VortX sí sáfà Stremio jíjìnnà / àfínúfún (fún àpẹẹrẹ ọ̀kan tí o ń ṣiṣẹ́ ní ilé)."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebenzisa iseva eshunyekwe kule divayisi, noma ukhombise i-VortX kwiseva ye-Stremio ekude / eyodwa (isibonelo eyodwa oyisebenzisa ekhaya)."
          }
        }
      }
    },
