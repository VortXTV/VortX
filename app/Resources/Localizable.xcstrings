        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub නිකුතු පිටුවෙන් නව build ස්ථාපනය කරන්න; ඔබේ පිවිසුම සහ සැකසුම් රැගෙන යයි."
