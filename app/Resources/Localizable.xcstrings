    "This build does not bundle the torrent engine. Only direct and debrid links can play.": {
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie bou sluit nie die torrent-enjin in nie. Net direkte en debrid-skakels kan speel."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ ግንባታ የtorrent ሞተርን አያካትትም። ቀጥተኛ እና የdebrid አገናኞች ብቻ ሊጫወቱ ይችላሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه النسخة لا تتضمّن محرك التورنت. يمكن تشغيل الروابط المباشرة وروابط debrid فقط."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu versiya torrent mühərrikini ehtiva etmir. Yalnız birbaşa və debrid linklər oynadıla bilər."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази версия не включва торент енджина. Може да се възпроизвеждат само директни и debrid връзки."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বিল্ডে টরেন্ট ইঞ্জিন অন্তর্ভুক্ত নেই। শুধু সরাসরি ও debrid লিঙ্ক চালানো যাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta versió no inclou el motor de torrents. Només es poden reproduir enllaços directes i de debrid."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato verze neobsahuje torrentové jádro. Přehrát lze pouze přímé a debrid odkazy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne build indeholder ikke torrent-motoren. Kun direkte links og debrid-links kan afspilles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build enthält keine Torrent-Engine. Es können nur direkte und Debrid-Links abgespielt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η έκδοση δεν περιλαμβάνει τη μηχανή torrent. Αναπαράγονται μόνο απευθείας σύνδεσμοι και σύνδεσμοι debrid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión no incluye el motor de torrents. Solo se pueden reproducir enlaces directos y de debrid."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See versioon ei sisalda torrentimootorit. Esitada saab ainult otse- ja debrid-linke."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bertsio honek ez du torrent motorra barneratzen. Esteka zuzenak eta debrid estekak baino ezin dira erreproduzitu."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نسخه شامل موتور تورنت نیست. فقط لینک‌های مستقیم و debrid قابل پخش هستند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä versio ei sisällä torrent-moottoria. Vain suorat ja debrid-linkit toistuvat."
          }
