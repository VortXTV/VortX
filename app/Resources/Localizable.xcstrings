        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalirajte novu verziju sa GitHub stranice izdanja; vaša prijava i postavke se prenose."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "I-install ang bag-ong build gikan sa GitHub releases page; ang imong sign-in ug settings madala."
