        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл файлды қауіпсіз сақтаңыз. Баптауларыңды көшіру үшін оны VortX-те қалпына келтіріңіз."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សូមរក្សាឯកសារនេះឱ្យមានសុវត្ថិភាព។ ស្ដារវានៅក្នុង VortX ដើម្បីនាំការកំណត់របស់អ្នកមកវិញ។"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೈಲ್ ಅನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ಇರಿಸಿಕೊಳ್ಳಿ. ನಿಮ್ಮ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತರಲು VortX ನಲ್ಲಿ ಅದನ್ನು ಮರುಸ್ಥಾಪಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일을 안전하게 보관하세요. VortX에서 복원하면 설정을 그대로 가져올 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saugokite šį failą. Atkurkite jį VortX, kad perkeltumėte savo nustatymus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glabājiet šo failu drošā vietā. Atjaunojiet to programmā VortX, lai pārnestu savus iestatījumus."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чувајте ја оваа датотека на безбедно. Вратете ја во VortX за да ги пренесете вашите поставки."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫയൽ സുരക്ഷിതമായി സൂക്ഷിക്കുക. നിങ്ങളുടെ ക്രമീകരണങ്ങൾ കൊണ്ടുവരാൻ VortX-ൽ ഇത് പുനഃസ്ഥാപിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही फाइल सुरक्षित ठेवा. तुमची सेटिंग्ज आणण्यासाठी ती VortX मध्ये पुनर्संचयित करा."
          }
