        "sd": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub رليز پيج تان نئون بلڊ انسٽال ڪريو؛ اوهان جي سائن-ان ۽ سيٽنگون منتقل ٿي وينديون."
