        "ig": {
          "stringUnit": {
            "state": "translated",
            "value": "VortX chọrọ ịkwụsị wee meghee ọzọ iji gosipụta ngwa n'asụsụ ọhụrụ. Meghee ya ọzọ mgbe ọ mechiri."
