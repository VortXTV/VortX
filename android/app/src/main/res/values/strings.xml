<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App label everywhere the OS shows it (launcher, recents, share sheet, Settings > Apps). -->
    <string name="app_name">VortX</string>

    <!-- Home-tab wordmark: "Vort" in the serif face + the mark as the "X" (DESIGN-SYSTEM.md §2 "The
         mark"/"Wordmark"). Split so the composable can color only the "X" with the live accent;
         translatable="false" because the brand name itself is never localized. -->
    <string name="wordmark_prefix" translatable="false">Vort</string>
    <string name="wordmark_suffix" translatable="false">X</string>

    <!-- Offline downloads (Round 5). The notification channel is user-visible in Settings > Apps > VortX >
         Notifications, so both of these are localizable copy, not identifiers. -->
    <string name="downloads_channel_name">Downloads</string>
    <string name="downloads_channel_description">Progress for titles you save for offline viewing.</string>
    <string name="downloads_notification_title">Downloading</string>

    <!-- Android TV debrid-key settings. Credentials remain masked and only status is shown. -->
    <string name="tv_settings_section_services">Services</string>
    <string name="tv_debrid_services_title">Debrid services</string>
    <string name="tv_debrid_services_navigation_description">Add or replace API keys using the TV keyboard.</string>
    <string name="tv_debrid_services_description">Add a provider API key to play cached torrents through your own debrid account.</string>
    <string name="tv_debrid_action_back">Back</string>
    <string name="tv_debrid_api_key">API key</string>
    <string name="tv_debrid_replacement_api_key">Replacement API key</string>
    <string name="tv_debrid_action_save">Save</string>
    <string name="tv_debrid_action_replace">Replace</string>
    <string name="tv_debrid_action_clear">Clear</string>
    <string name="tv_debrid_status_not_set">Not set</string>
    <string name="tv_debrid_status_set">Set</string>
    <string name="tv_debrid_status_cleared">Cleared</string>
    <string name="tv_debrid_status_storage_unavailable">Secure storage unavailable</string>
