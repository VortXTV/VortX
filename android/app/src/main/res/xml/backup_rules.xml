<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules (API 30 and below; API 31+ reads data_extraction_rules.xml instead).

  This is the Android analogue of the Apple store's `isExcludedFromBackup` resource value on its Downloads
  directory (app/SourcesShared/DownloadStore.swift). Downloaded media is large and re-downloadable, and Auto
  Backup would otherwise try to ship multi-GB files to the user's cloud backup quota. Excluding the directory
  also keeps index.json out, which is correct and NOT an oversight: the index describes files that exist on THIS
  device only, so restoring it onto another device would list downloads whose bytes are not there.
-->
<full-backup-content>
    <exclude domain="file" path="Downloads" />
    <!-- Download queue-manager state (concurrency cap, drain order, the parked-for-unlock set). Meaningless
         without the files above, so it travels with them. -->
    <exclude domain="sharedpref" path="vortx.downloads.xml" />
    <exclude domain="sharedpref" path="vortx_sync_session.xml" />
    <exclude domain="sharedpref" path="vortx_sync_session_plain.xml" />
    <exclude domain="sharedpref" path="vortx_debrid_keys.xml" />
    <exclude domain="sharedpref" path="vortx_debrid_keys_plain.xml" />
    <exclude domain="sharedpref" path="vortx_auth_identity.xml" />
    <exclude domain="sharedpref" path="vortx_auth_identity_plain.xml" />
    <exclude domain="sharedpref" path="vortx_trakt_tokens.xml" />
    <exclude domain="sharedpref" path="vortx_trakt_tokens_plain.xml" />
    <exclude domain="sharedpref" path="vortx_simkl_tokens.xml" />
    <exclude domain="sharedpref" path="vortx_simkl_tokens_plain.xml" />
    <exclude domain="sharedpref" path="vortx_mediaserver_tokens.xml" />
    <exclude domain="sharedpref" path="vortx_mediaserver_tokens_plain.xml" />
    <exclude domain="sharedpref" path="vortx_iptv_creds.xml" />
    <exclude domain="sharedpref" path="vortx_iptv_creds_plain.xml" />
    <exclude domain="sharedpref" path="vortx_metadata_credentials.xml" />
    <exclude domain="sharedpref" path="vortx_metadata_credentials_plain.xml" />
    <exclude domain="sharedpref" path="vortx_metadata_credential_owner.xml" />
    <exclude domain="sharedpref" path="vortx_settings_sync_ledger.xml" />
</full-backup-content>
